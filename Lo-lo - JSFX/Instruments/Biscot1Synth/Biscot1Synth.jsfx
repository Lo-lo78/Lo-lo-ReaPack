    op3_target_note = note;
    op3_cur_note < 0 ? op3_cur_note = note;
  );

  op3_note = note;
  op3_gate = vel / 127;
  retrig = arp_on ? !was_down : (((slider3 == 1 ? slider10 : slider12) < 0.5) || !was_down);

  retrig ? (
    op3_stage = 1;
    op3_mod_stage = 1;
    // LSH-2 style: do not restart the arp clock when adding notes to an already running arp.
    !was_down ? arp_reset_op3();
    slider4 > 0 ? reset_op3();
  );
);

function note_off_op1(note)
local(n) (
  // Do not refresh the release latch here: on the last note-off it would become
  // a one-note latch and the release would lose the full arp.
  held_remove(op1_stack, op1_held_count, note);
  n = held_top(op1_stack, op1_held_count);
  n >= 0 ? (
    op1_note = n;
    // In ARP mode, note-off must not bend/transpose the running arp.
    !(slider76 > 0 && op1_arp_latch_count > 0) ? op1_target_note = n;
    op1_gate = 1;
  ) : (
    op1_gate = 0;
    op1_rel_latched = op1_rel_coef;
    op1_mod_rel_latched = op1_pitch_rel_coef;
    op1_stage = 4;
    op1_mod_stage = 4;
    // Freeze the ARP base/root for release. Do not let note-off order transpose the arpeggio.
    op1_arp_latch_count > 0 ? op1_arp_release_base = op1_arp_latch_root;
  );
);
function note_off_op2(note)
local(n) (
  // Do not refresh the release latch here: on the last note-off it would become
  // a one-note latch and the release would lose the full arp.
  held_remove(op2_stack, op2_held_count, note);
  n = held_top(op2_stack, op2_held_count);
  n >= 0 ? (
    op2_note = n;
    // In ARP mode, note-off must not bend/transpose the running arp.
    !(slider77 > 0 && op2_arp_latch_count > 0) ? op2_target_note = n;
    op2_gate = 1;
  ) : (
    op2_gate = 0;
    op2_rel_latched = op2_rel_coef;
    op2_mod_rel_latched = op2_pitch_rel_coef;
    op2_stage = 4;
    op2_mod_stage = 4;
    // Freeze the ARP base/root for release. Do not let note-off order transpose the arpeggio.
    op2_arp_latch_count > 0 ? op2_arp_release_base = op2_arp_latch_root;
  );
);
function note_off_op3(note)
local(n) (
  // Do not refresh the release latch here: on the last note-off it would become
  // a one-note latch and the release would lose the full arp.
  held_remove(op3_stack, op3_held_count, note);
  n = held_top(op3_stack, op3_held_count);
  n >= 0 ? (
    op3_note = n;
    // In ARP mode, note-off must not bend/transpose the running arp.
    !(slider78 > 0 && op3_arp_latch_count > 0) ? op3_target_note = n;
    op3_gate = 1;
  ) : (
    op3_gate = 0;
    op3_rel_latched = op3_rel_coef;
    op3_mod_rel_latched = op3_pitch_rel_coef;
    op3_stage = 4;
    op3_mod_stage = 4;
    // Freeze the ARP base/root for release. Do not let note-off order transpose the arpeggio.
    op3_arp_latch_count > 0 ? op3_arp_release_base = op3_arp_latch_root;
  );
);

function filter_note_on(note, vel)
local(was_down, retrig) (
  was_down = filter_held_count > 0;
  held_add(filter_stack, filter_held_count, note);
  filter_key_note = note;

  // LFO Trigger / One Shot follows the same musical rule as Op1 Mode Trigger
  // and the filter ADSR: Trigger = every note; Legato = first note only.
  // This keeps one-shot from restarting on legato notes.
  retrig = (slider10 < 0.5) || !was_down;
  retrig ? (
    filter_stage = 1;
    lfo_note_trigger();
  );
);

function filter_note_off(note)
local(n) (
  held_remove(filter_stack, filter_held_count, note);
  n = held_top(filter_stack, filter_held_count);
  n >= 0 ? filter_key_note = n;
  filter_held_count <= 0 ? (filter_rel_latched = filter_rel_coef; filter_stage = 4;);
);

function chord_note_on(note, vel)
local(chord_was_down) (
  // Keep a separate complete chord pool for the three independent frequency arps.
  // Voice allocation remains mono and independent, but every arp can traverse all held notes.
  chord_was_down = chord_arp_count > 0;
  held_add(chord_arp_stack, chord_arp_count, note);

  // SID Seq has its own recorded memory, unlike Up/Down/Held modes which read the
  // live chord pool directly. Feed every incoming chord note to every enabled SID
  // sequence. Each operator records at its own current clock step, so the three
  // sequences remain rhythmically independent.
  slider76 == 1 ? (
    !chord_was_down ? sid_seq_clear(op1_sid_seq, note, op1_sid_seq_len)
                    : sid_seq_record(op1_sid_seq, op1_arp_step_idx, note, op1_sid_seq_len);
  );
  slider77 == 1 ? (
    !chord_was_down ? sid_seq_clear(op2_sid_seq, note, op2_sid_seq_len)
                    : sid_seq_record(op2_sid_seq, op2_arp_step_idx, note, op2_sid_seq_len);
  );
  slider78 == 1 ? (
    !chord_was_down ? sid_seq_clear(op3_sid_seq, note, op3_sid_seq_len)
                    : sid_seq_record(op3_sid_seq, op3_arp_step_idx, note, op3_sid_seq_len);
  );

  op1_held_count <= 0 ? note_on_op1(note, vel) :
  op2_held_count <= 0 ? note_on_op2(note, vel) :
  op3_held_count <= 0 ? note_on_op3(note, vel) :
  note_on_op1(note, vel);
);
function chord_note_off(note) (
  held_remove(chord_arp_stack, chord_arp_count, note);
  note_off_op1(note);
  note_off_op2(note);
  note_off_op3(note);
);

function extreme_pwm(base, ext)
local(x, a) (
  x = max(-64, min(64, ext)) / 64;
  x >= 0 ? (
    a = x ^ 1.35;
    base + (1.25 - base) * a;
  ) : (
    a = (-x) ^ 1.15;
    base - (base - 0.0002) * a;
  );
);


@slider
inv_srate = 1 / srate;
master_gain = 10^(slider8/20);
filter_input_gain = 10^(slider6/20);
filter_gain = 10^(slider7/20);

// External SID/C64 output RC network. The low-pass softens the final digital
// edge without darkening the musical band heavily; the high-pass removes the
// amplifier bias/DC extremely slowly. Cached here, never recomputed per sample.
out_lp_alpha = 1 - exp(-two_pi * min(16000, srate * 0.45) / srate);
out_hp_r = exp(-two_pi * 1.6 / srate);

// LFO sleep flags. If all depths for a strip are zero, the whole LFO engine sleeps.
lfo1_used = (abs(slider132)+abs(slider133)+abs(slider134)+abs(slider135)+abs(slider136)+abs(slider137)+abs(slider138)+abs(slider139)+abs(slider140)+abs(slider141)+abs(slider142)+abs(slider143)+abs(slider144)) > 0.0000001;
lfo2_used = (abs(slider155)+abs(slider156)+abs(slider157)+abs(slider158)+abs(slider159)+abs(slider160)+abs(slider161)+abs(slider162)+abs(slider163)+abs(slider164)+abs(slider165)+abs(slider166)+abs(slider167)) > 0.0000001;
lfo3_used = (abs(slider178)+abs(slider179)+abs(slider180)+abs(slider181)+abs(slider182)+abs(slider183)+abs(slider184)+abs(slider185)+abs(slider186)+abs(slider187)+abs(slider188)+abs(slider189)+abs(slider190)) > 0.0000001;
lfo_any_used = lfo1_used || lfo2_used || lfo3_used;
lfo_rate_mod_used = (abs(slider61)+abs(slider62)+abs(slider63)) > 0.0000001;

// Smooth coefficients are expensive because they use exp(); cache them here.
lfo1_smooth_coef = lfo_smooth_coef(slider124, slider128);
lfo2_smooth_coef = lfo_smooth_coef(slider147, slider151);
lfo3_smooth_coef = lfo_smooth_coef(slider170, slider174);

chord_master_op1_cached = slider3 == 1;
model_6581_cached = slider5 >= 1;
voice3_off_cached = slider103 >= 1;

// CPU fast-path flags and static effective controls.
audio_multichannel_cached = slider2 >= 0.5;
midi_mode_cached = floor(slider3 + 0.5);
// Oversampling is controlled only by the dedicated Off/Auto selector.
// Keep it completely independent from MIDI Mode so Auto works identically in
// All Operators Same Note, Chord Allocate and MIDI Channels 1-3.
// Oversampling is intentionally not cached here. It is sampled directly in @block.
op1_test_cached = slider100 >= 1;
op2_test_cached = slider101 >= 1;
op3_test_cached = slider102 >= 1;
op2_audio_test_cached = chord_master_op1_cached ? op1_test_cached : op2_test_cached;
op3_audio_test_cached = chord_master_op1_cached ? op1_test_cached : op3_test_cached;

op1_arp_mode_cached = floor(slider76 + 0.5);
op2_arp_mode_cached = floor(slider77 + 0.5);
op3_arp_mode_cached = floor(slider78 + 0.5);
arp_any_mode_cached = op1_arp_mode_cached > 0 || op2_arp_mode_cached > 0 || op3_arp_mode_cached > 0;
op3_osc_mod_target_cached = floor(slider104 + 0.5);
op3_env_mod_target_cached = floor(slider106 + 0.5);
op3_osc_mod_depth_cached = slider105;
op3_env_mod_depth_cached = slider107;
op3_osc_mod_active_cached = op3_osc_mod_target_cached > 0 && abs(op3_osc_mod_depth_cached) > 0.0000001;
op3_env_mod_active_cached = op3_env_mod_target_cached > 0 && abs(op3_env_mod_depth_cached) > 0.0000001;

sid_amp_bias_cached = model_6581_cached ? 0.012 : 0.003;
sid_amp_pos_drive_cached = model_6581_cached ? 1.10 : 1.025;
sid_amp_neg_drive_cached = model_6581_cached ? 0.96 : 0.99;
sid_amp_wet_cached = model_6581_cached ? 0.085 : 0.022;
sid_amp_dry_cached = 1 - sid_amp_wet_cached;
sid_amp_makeup_cached = model_6581_cached ? 1.022 : 1.004;

// Static choices cached outside @sample. These change only when a slider changes.
op1_ring_cached = slider94 >= 1; op2_ring_cached = slider95 >= 1; op3_ring_cached = slider96 >= 1;
op1_sync_cached = slider97 >= 1; op2_sync_cached = slider98 >= 1; op3_sync_cached = slider99 >= 1;
op1_wave_cached = floor(slider22 + 0.5);
op2_wave_cached = chord_master_op1_cached ? op1_wave_cached : floor(slider23 + 0.5);
op3_wave_cached = chord_master_op1_cached ? op1_wave_cached : floor(slider24 + 0.5);
// Combined waves need extra source headroom before polynomial interaction. Cache the
// multiplier so mip selection does not rediscover it in every oscillator call.
op1_aa_inc_mul_cached = op1_wave_cached == 7 ? 4 : (op1_wave_cached >= 4 ? 2 : 1);
op2_aa_inc_mul_cached = op2_wave_cached == 7 ? 4 : (op2_wave_cached >= 4 ? 2 : 1);
op3_aa_inc_mul_cached = op3_wave_cached == 7 ? 4 : (op3_wave_cached >= 4 ? 2 : 1);
op1_level_cached = slider16;
op2_level_cached = chord_master_op1_cached ? slider16 : slider17;
op3_level_cached = chord_master_op1_cached ? slider16 : slider18;
op2_fine_cached = chord_master_op1_cached ? slider28 : slider29;
op3_fine_cached = chord_master_op1_cached ? slider28 : slider30;
op2_bend_range_cached = chord_master_op1_cached ? slider91 : slider92;
op3_bend_range_cached = chord_master_op1_cached ? slider91 : slider93;
op2_pitch_mod_depth_cached = chord_master_op1_cached ? slider52 : slider53;
op3_pitch_mod_depth_cached = chord_master_op1_cached ? slider52 : slider54;
op2_pwm_mod_depth_cached = chord_master_op1_cached ? slider55 : slider56;
op3_pwm_mod_depth_cached = chord_master_op1_cached ? slider55 : slider57;
op2_to_filter_cached = chord_master_op1_cached ? slider114 : slider115;
op3_to_filter_cached = chord_master_op1_cached ? slider114 : slider116;


// Modular stereo routing. A voice remains mono while Fixed Pan, Mod Env Pan and
// all three LFO Pan depths that can control it are exactly zero. The expensive
// second filter path is enabled only when a filtered operator can actually pan.
pan_eps = 0.0000001;
op1_pan_stereo_cached = (abs(slider19) + abs(slider49) + abs(slider142) + abs(slider165) + abs(slider188)) > pan_eps;
op2_lfo_pan_depth_cached = chord_master_op1_cached ? (abs(slider142) + abs(slider165) + abs(slider188)) : (abs(slider143) + abs(slider166) + abs(slider189));
op3_lfo_pan_depth_cached = chord_master_op1_cached ? (abs(slider142) + abs(slider165) + abs(slider188)) : (abs(slider144) + abs(slider167) + abs(slider190));
op2_pan_stereo_cached = (abs(slider20) + abs(slider50) + op2_lfo_pan_depth_cached) > pan_eps;
op3_pan_stereo_cached = (abs(slider21) + abs(slider51) + op3_lfo_pan_depth_cached) > pan_eps;
filter_stereo_needed_cached =
  ((slider114 >= 1) && op1_pan_stereo_cached) ||
  ((op2_to_filter_cached >= 1) && op2_pan_stereo_cached) ||
  ((op3_to_filter_cached >= 1) && op3_pan_stereo_cached);
// The complete mix is mono only when every possible pan source is centered. A stereo
// excursion disables the mono output fast path until the next cold reset, preserving
// analogue output-state continuity if Pan is moved while a note is sounding.
mix_stereo_needed_cached = op1_pan_stereo_cached || op2_pan_stereo_cached || op3_pan_stereo_cached;
mix_stereo_needed_cached ? mono_output_fast_safe = 0;
(!mix_stereo_needed_cached && idle_block) ? mono_output_fast_safe = 1;

// Distinguish a fixed pan position from a moving pan source.
op1_lfo_pan_used_cached = (abs(slider142) + abs(slider165) + abs(slider188)) > pan_eps;
op2_lfo_pan_used_cached = op2_lfo_pan_depth_cached > pan_eps;
op3_lfo_pan_used_cached = op3_lfo_pan_depth_cached > pan_eps;
op1_pan_dynamic_cached = abs(slider49) > pan_eps || op1_lfo_pan_used_cached;
op2_pan_dynamic_cached = abs(slider50) > pan_eps || op2_lfo_pan_used_cached;
op3_pan_dynamic_cached = abs(slider51) > pan_eps || op3_lfo_pan_used_cached;
op1_pan_l_static = 1 - max(0, max(-1, min(1, slider19)));
op1_pan_r_static = 1 + min(0, max(-1, min(1, slider19)));
op2_pan_l_static = 1 - max(0, max(-1, min(1, slider20)));
op2_pan_r_static = 1 + min(0, max(-1, min(1, slider20)));
op3_pan_l_static = 1 - max(0, max(-1, min(1, slider21)));
op3_pan_r_static = 1 + min(0, max(-1, min(1, slider21)));

// Destination-specific LFO flags avoid neutral VCA/PWM/pitch work.
op1_lfo_pitch_used_cached = (abs(slider133) + abs(slider156) + abs(slider179)) > pan_eps;
op2_lfo_pitch_used_cached = chord_master_op1_cached ? op1_lfo_pitch_used_cached : ((abs(slider134) + abs(slider157) + abs(slider180)) > pan_eps);
op3_lfo_pitch_used_cached = chord_master_op1_cached ? op1_lfo_pitch_used_cached : ((abs(slider135) + abs(slider158) + abs(slider181)) > pan_eps);
op1_lfo_pwm_used_cached = (abs(slider136) + abs(slider159) + abs(slider182)) > pan_eps;
op2_lfo_pwm_used_cached = chord_master_op1_cached ? op1_lfo_pwm_used_cached : ((abs(slider137) + abs(slider160) + abs(slider183)) > pan_eps);
op3_lfo_pwm_used_cached = chord_master_op1_cached ? op1_lfo_pwm_used_cached : ((abs(slider138) + abs(slider161) + abs(slider184)) > pan_eps);
op1_lfo_level_used_cached = (abs(slider139) + abs(slider162) + abs(slider185)) > pan_eps;
op2_lfo_level_used_cached = chord_master_op1_cached ? op1_lfo_level_used_cached : ((abs(slider140) + abs(slider163) + abs(slider186)) > pan_eps);
op3_lfo_level_used_cached = chord_master_op1_cached ? op1_lfo_level_used_cached : ((abs(slider141) + abs(slider164) + abs(slider187)) > pan_eps);
lfo_cut_used_cached = (abs(slider132) + abs(slider155) + abs(slider178)) > pan_eps;

// Filter switches and resonance mix denominators are static between slider changes.
filter_lp_on_cached = slider110 >= 1;
filter_bp_on_cached = slider111 >= 1;
filter_hp_on_cached = slider112 >= 1;
filter_mode_count_cached = filter_lp_on_cached + filter_bp_on_cached + filter_hp_on_cached;
filter_mode_inv_cached = filter_mode_count_cached > 0 ? 1 / filter_mode_count_cached : 0;
filter_res_mix_6581_cached = (slider110 + slider111 * 0.70 + slider112 * 0.36) * filter_mode_inv_cached;
filter_res_mix_8580_cached = (slider110 + slider111 * 0.72 + slider112 * 0.38) * filter_mode_inv_cached;
filter_all_modes_cached = filter_lp_on_cached && filter_bp_on_cached && filter_hp_on_cached;
filter_sustain_cached = slider120;
norm_total_cached = 0.0001 + (chord_master_op1_cached ? 3 : 1);

// Cutoff is intentionally virtual-bipolar now.
// Negative values are below the real SID register floor: the audio cutoff is still clamped at 0,
// but negative offset lets a positive filter envelope start from silence and open later.
cut_norm = max(0, slider108) / 2047;
res_norm = slider109 / 15;

op1_porta_coef = slider46 <= 0 ? 1 : (1 - exp(-1 / max(1, slider46 * srate)));
op2_porta_time = chord_master_op1_cached ? slider46 : slider47;
op3_porta_time = chord_master_op1_cached ? slider46 : slider48;
op2_porta_coef = op2_porta_time <= 0 ? 1 : (1 - exp(-1 / max(1, op2_porta_time * srate)));
op3_porta_coef = op3_porta_time <= 0 ? 1 : (1 - exp(-1 / max(1, op3_porta_time * srate)));

// Per-sample pitch is required only for sources that actually move within a block.
op1_internal_pitch_dynamic_cached = ((slider104 == 2) && abs(slider105) > pan_eps) || ((slider106 == 2) && abs(slider107) > pan_eps);
op2_internal_pitch_dynamic_cached = ((slider104 == 3) && abs(slider105) > pan_eps) || ((slider106 == 3) && abs(slider107) > pan_eps);
op1_pitch_dynamic_cached = op1_porta_coef < 1 || op1_arp_mode_cached > 0 || abs(op1_arp_pitch_cur) >= 0.00001 || abs(slider52) > pan_eps || op1_lfo_pitch_used_cached || op1_internal_pitch_dynamic_cached;
op2_pitch_dynamic_cached = op2_porta_coef < 1 || op2_arp_mode_cached > 0 || abs(op2_arp_pitch_cur) >= 0.00001 || abs(op2_pitch_mod_depth_cached) > pan_eps || op2_lfo_pitch_used_cached || op2_internal_pitch_dynamic_cached;
op3_pitch_dynamic_cached = op3_porta_coef < 1 || op3_arp_mode_cached > 0 || abs(op3_arp_pitch_cur) >= 0.00001 || abs(op3_pitch_mod_depth_cached) > pan_eps || op3_lfo_pitch_used_cached;

op1_internal_pwm_dynamic_cached = ((slider104 == 4) && abs(slider105) > pan_eps) || ((slider106 == 4) && abs(slider107) > pan_eps);
op2_internal_pwm_dynamic_cached = ((slider104 == 5) && abs(slider105) > pan_eps) || ((slider106 == 5) && abs(slider107) > pan_eps);
op1_pwm_dynamic_cached = op1_lfo_pwm_used_cached || abs(slider55) > pan_eps || op1_internal_pwm_dynamic_cached;
op2_pwm_dynamic_cached = op2_lfo_pwm_used_cached || abs(op2_pwm_mod_depth_cached) > pan_eps || op2_internal_pwm_dynamic_cached;
op3_pwm_dynamic_cached = op3_lfo_pwm_used_cached || abs(op3_pwm_mod_depth_cached) > pan_eps;

// Per-operator Mod Env coefficients. Envelope is normalized 0..1 and can drive pitch, PWM and an LFO rate.
op1_mod_sus = slider70; op2_mod_sus = chord_master_op1_cached ? slider70 : slider71; op3_mod_sus = chord_master_op1_cached ? slider70 : slider72;
op1_mod_att_step = 1 / max(1, slider64 * srate);
op2_mod_att_step = 1 / max(1, (chord_master_op1_cached ? slider64 : slider65) * srate);
op3_mod_att_step = 1 / max(1, (chord_master_op1_cached ? slider64 : slider66) * srate);
op1_mod_dec_step = (1 - op1_mod_sus) / max(1, slider67 * srate);
op2_mod_dec_step = (1 - op2_mod_sus) / max(1, (chord_master_op1_cached ? slider67 : slider68) * srate);
op3_mod_dec_step = (1 - op3_mod_sus) / max(1, (chord_master_op1_cached ? slider67 : slider69) * srate);
op1_pitch_rel_coef = 1 / max(1, slider73 * srate);
op2_pitch_rel_coef = 1 / max(1, (chord_master_op1_cached ? slider73 : slider74) * srate);
op3_pitch_rel_coef = 1 / max(1, (chord_master_op1_cached ? slider73 : slider75) * srate);

// ARP glide depth: 0 = square SID-player step, 1 = maximum rounded ARP corners.
// LSH-2 style: this is an independent smoothing coefficient for arp frequency jumps,
// not a multiplier of the normal operator portamento. So it works even when Op Portamento = 0.
op1_arp_glide_sq = max(0, slider88) * max(0, slider88);
op2_arp_glide_src = slider89;
op2_arp_glide_sq = max(0, op2_arp_glide_src) * max(0, op2_arp_glide_src);
op3_arp_glide_src = slider90;
op3_arp_glide_sq = max(0, op3_arp_glide_src) * max(0, op3_arp_glide_src);
op1_arp_glide_coef = op1_arp_glide_sq > 0 ? (1 / (1 + op1_arp_glide_sq * 2000)) : 1;
op2_arp_glide_coef = op2_arp_glide_sq > 0 ? (1 / (1 + op2_arp_glide_sq * 2000)) : 1;
op3_arp_glide_coef = op3_arp_glide_sq > 0 ? (1 / (1 + op3_arp_glide_sq * 2000)) : 1;


// Cached ADSR steps/coefs. These only depend on sliders and sample rate.
op1_sus_eff = slider40;
op2_sus_eff = chord_master_op1_cached ? slider40 : slider41;
op3_sus_eff = chord_master_op1_cached ? slider40 : slider42;
op1_att_step = 1 / max(1, slider34 * srate);
op2_att_step = 1 / max(1, (chord_master_op1_cached ? slider34 : slider35) * srate);
op3_att_step = 1 / max(1, (chord_master_op1_cached ? slider34 : slider36) * srate);
op1_dec_step = (1 - op1_sus_eff) / max(1, slider37 * srate);
op2_dec_step = (1 - op2_sus_eff) / max(1, (chord_master_op1_cached ? slider37 : slider38) * srate);
op3_dec_step = (1 - op3_sus_eff) / max(1, (chord_master_op1_cached ? slider37 : slider39) * srate);
op1_rel_coef = 1 / max(1, slider43 * srate);
op2_rel_coef = 1 / max(1, (chord_master_op1_cached ? slider43 : slider44) * srate);
op3_rel_coef = 1 / max(1, (chord_master_op1_cached ? slider43 : slider45) * srate);
filter_att_step = 1 / max(1, slider118 * srate);
filter_dec_step = (1 - slider120) / max(1, slider119 * srate);
filter_rel_coef = 1 / max(1, slider121 * srate);
op1_rel_latched = op1_rel_coef; op2_rel_latched = op2_rel_coef; op3_rel_latched = op3_rel_coef;
op1_mod_rel_latched = op1_pitch_rel_coef; op2_mod_rel_latched = op2_pitch_rel_coef; op3_mod_rel_latched = op3_pitch_rel_coef;
filter_rel_latched = filter_rel_coef;

// PWM Extended is the only visible pulse-width control now.
// It is still centered around a neutral 50% square at 0.
// Positive can go beyond the useful audible duty range up to a flat high state.
// Negative goes almost to a vanishing needle pulse, but stops just before full silence.
op1_pw_base = extreme_pwm(0.5, slider31);
op2_pw_base = extreme_pwm(0.5, chord_master_op1_cached ? slider31 : slider32);
op3_pw_base = extreme_pwm(0.5, chord_master_op1_cached ? slider31 : slider33);

// Two deliberately different register-to-cutoff curves.
// The cutoff frequency itself is recalculated at audio rate because
// the filter now has its own ADSR envelope.
!model_6581_cached ? (
  // 8580 R5: stronger three-stage resonance. v1.86 doubles the effective
  // resonance slope while retaining a safety floor below self-oscillation.
  filter_damp = 1.16 - res_norm * 0.90;
  filter_lp_weight = 1.00;
  filter_bp_weight = 0.94;
  filter_hp_weight = 0.99;
) : (
  // 6581 R4: keep the actual feedback core below self-oscillation.
  // Resonant character is added later as a controlled output presence, not by
  // letting the SVF feedback loop run unstable.
  filter_damp = 1.30 - res_norm * 0.36;
  filter_lp_weight = 1.00;
  filter_bp_weight = 1.00;
  filter_hp_weight = 0.98;
);

filter_damp = max(model_6581_cached ? 1.06 : 0.62, min(1.55, filter_damp));
filter_state_loss = model_6581_cached ? (0.99780 - res_norm * 0.00055) : 0.99980;

// Cached output/model gain constants. These used to be recalculated per sample.
clean_makeup_6581 = model_6581_cached ? 1.122018454 : 1.00; // +1 dB
filter_makeup_6581 = model_6581_cached ? ((3.45 + res_norm * 0.16) * 1.995262315) : 1.00;
out_drive = 1 + (model_6581_cached ? 0.006 : 0);
composite_makeup_gain = 1.00;
sid_6581_global_gain = 1.00; // v1.82: removed previous +3 dB global lift for 6581

r4_body_f = 2 * sin($pi * 135 / srate);
r4_body_f = min(0.20, max(0.0001, r4_body_f));


// v2.09: static resonance/output coefficients used by both stereo filter paths.
filter_state_bp_mul = model_6581_cached ? (0.9992 - res_norm * 0.00035) : 1;
filter_state_hp_mul = model_6581_cached ? (0.9994 - res_norm * 0.00025) : 1;
filter_state_lp_mul = model_6581_cached ? (0.9995 - res_norm * 0.00020) : 1;
filter_cream_gain = 1 + res_norm * 0.36;
filter_res_presence_6581_coef = res_norm * (1.04 + res_norm * 1.56) * filter_res_mix_6581_cached;
filter_lp_res_presence_coef = res_norm * (0.36 + res_norm * 0.64) * filter_mode_inv_cached;
filter_post_col = 1.06 + 0.020 * res_norm;
filter_post_col_inv = 1 / filter_post_col;
filter_post_mix = 0.23 + 0.10 * res_norm;
filter_post_clean_mix = 1 - filter_post_mix;
filter_res_presence_8580_coef = res_norm * (0.24 + res_norm * 0.32) * filter_res_mix_8580_cached;

// v2.15: LFO half-wave squash gains. 0 = original half, 1 = flattened to zero.
lfo1_upper_gain = 1 - slider125;
lfo1_lower_gain = 1 - slider126;
lfo2_upper_gain = 1 - slider148;
lfo2_lower_gain = 1 - slider149;
lfo3_upper_gain = 1 - slider171;
lfo3_lower_gain = 1 - slider172;

// A static cutoff does not need pow() and sin() at audio rate. The filter ADSR
// still runs normally; it simply has no audible cutoff destination when Amount=0.
filter_cut_dynamic_cached =
  abs(slider117) > pan_eps || abs(slider113) > pan_eps || lfo_cut_used_cached ||
  (((slider104 == 1) && abs(slider105) > pan_eps) || ((slider106 == 1) && abs(slider107) > pan_eps));
!filter_cut_dynamic_cached ? (
  static_cut_reg_cached = max(0, min(2047, slider108));
  static_cut_norm_cached = static_cut_reg_cached / 2047;
  !model_6581_cached ? (
    static_filter_fc_cached = 4 + pow(static_cut_norm_cached, 1.38) * 12500;
  ) : (
    static_filter_fc_cached = 28 + pow(static_cut_norm_cached, 2.12) * 8170;
  );
  static_filter_fc_cached = min(static_filter_fc_cached, srate * 0.42);
  static_filter_f_cached = 2 * sin($pi * static_filter_fc_cached / srate);
  static_filter_f_cached = min(0.98, max(0.00015, static_filter_f_cached));
  static_r4_body_amt_cached = model_6581_cached ? (0.22 * pow(1 - static_cut_norm_cached, 2.35)) : 0;
);

@block
// v2.21: deep idle block sleep.
// MIDI is always consumed/passed through first. After that we decide immediately whether
// the synth is silent. Expensive block-rate pitch/ARP/drift work is skipped completely
// while idle instead of being calculated before the old idle test.
while (midirecv(offset, msg1, msg23)) (
  status = msg1 & 240;
  chan = msg1 & 15;
  note = msg23 & 127;
  vel = (msg23 >> 8) & 127;

  (status == 224) ? (
    bend_lsb = msg23 & 127;
    bend_msb = (msg23 >> 8) & 127;
    bend_norm = (bend_lsb + bend_msb * 128 - 8192) / 8192;
    bend_norm = max(-1, min(1, bend_norm));

    // Mode 0 keeps the classic shared pitch bend on MIDI channel 1.
    // Modes 1/2 allow independent bends on MIDI channels 1, 2 and 3.
    ((slider3 == 0 || slider3 == 1) && chan == 0) ? (
      op1_bend = bend_norm; op2_bend = bend_norm; op3_bend = bend_norm;
    ) : (
      chan == 0 ? op1_bend = bend_norm;
      chan == 1 ? op2_bend = bend_norm;
      chan == 2 ? op3_bend = bend_norm;
    );
  ) :
  (status == 144 && vel > 0) ? (
    filter_note_on(note, vel);
    slider3 == 0 ? (
      note_on_op1(note, vel);
      note_on_op2(note, vel);
      note_on_op3(note, vel);
    ) :
    slider3 == 1 ? (
      chord_note_on(note, vel);
    ) :
    (
      chan == 0 ? note_on_op1(note, vel);
      chan == 1 ? note_on_op2(note, vel);
      chan == 2 ? note_on_op3(note, vel);
    );
  ) :
  ((status == 128) || (status == 144 && vel == 0)) ? (
    filter_note_off(note);
    slider3 == 0 ? (
      note_off_op1(note);
      note_off_op2(note);
      note_off_op3(note);
    ) :
    slider3 == 1 ? (
      chord_note_off(note);
    ) :
    (
      chan == 0 ? note_off_op1(note);
      chan == 1 ? note_off_op2(note);
      chan == 2 ? note_off_op3(note);
    );
  );

  midisend(offset, msg1, msg23);
);

// v2.25 TEST Cold Reset Idle:
// Do not trust note/stage bookkeeping as the sleep criterion. The authoritative
// condition is: no MIDI key is physically held and every audible VCA has reached
// the exact silence threshold. At that point no oscillator/filter/control state can
// produce audible output, so collapse the runtime state back to the cold @init state.
// This reset happens only once on the transition into sleep (idle_block_latched=0).
cold_sleep_ready =
  filter_held_count <= 0 &&
  op1_gate < 0.5 && op2_gate < 0.5 && op3_gate < 0.5 &&
  op1_env <= 0.0001 && op2_env <= 0.0001 && op3_env <= 0.0001;

cold_sleep_ready && !idle_block_latched ? (
  // Output/filter states are zeroed below, so a centered patch can safely share its
  // left/right final analogue stage again on the next note.
  mono_output_fast_safe = !mix_stereo_needed_cached;

  // Audible envelopes / note ownership.
  op1_env = 0; op2_env = 0; op3_env = 0;
  op1_stage = 0; op2_stage = 0; op3_stage = 0;
  op1_note = -1; op2_note = -1; op3_note = -1;
  op1_target_note = -1; op2_target_note = -1; op3_target_note = -1;
  op1_cur_note = -1; op2_cur_note = -1; op3_cur_note = -1;
  op1_gate = 0; op2_gate = 0; op3_gate = 0;

  // Inaudible modulation/filter envelopes must not keep the engine logically alive.
  op1_mod_env = 0; op2_mod_env = 0; op3_mod_env = 0;
  op1_mod_stage = 0; op2_mod_stage = 0; op3_mod_stage = 0;
  filter_env = 0; filter_stage = 0;

  // Drop every release/ARP ownership token so the next note starts exactly like a
  // freshly loaded instance. Free-running LFO phase is intentionally preserved below.
  op1_held_count = 0; op2_held_count = 0; op3_held_count = 0;
  chord_arp_count = 0; filter_held_count = 0;
  op1_arp_latch_count = 0; op2_arp_latch_count = 0; op3_arp_latch_count = 0;
  op1_sid_seq_len = 0; op2_sid_seq_len = 0; op3_sid_seq_len = 0;
  arp_reset_op1(); arp_reset_op2(); arp_reset_op3();
);

// Once cold_sleep_ready is true, @sample has no active branch at all.
idle_block = cold_sleep_ready;

idle_block ? (
  // Preserve only FREE LFO clocks at block rate. Triggered/one-shot strips do no work.
  lfo1_used && slider122 < 0.5 && slider129 < 1 ? (
    lfo1_base_inc = lfo_bpm_inc(slider123);
    lfo1_phase += lfo1_base_inc * samplesblock;
    lfo1_phase -= floor(lfo1_phase);
  );
  lfo2_used && slider145 < 0.5 && slider152 < 1 ? (
    lfo2_base_inc = lfo_bpm_inc(slider146);
    lfo2_phase += lfo2_base_inc * samplesblock;
    lfo2_phase -= floor(lfo2_phase);
  );
  lfo3_used && slider168 < 0.5 && slider175 < 1 ? (
    lfo3_base_inc = lfo_bpm_inc(slider169);
    lfo3_phase += lfo3_base_inc * samplesblock;
    lfo3_phase -= floor(lfo3_phase);
  );

  // Clear residual DSP memory only once when entering idle.
  !idle_block_latched ? (
    filter_lp = filter_bp = filter_hp = filter_r4_body_lp = 0;
    filter_lp_l = filter_bp_l = filter_hp_l = filter_r4_body_lp_l = 0;
    filter_lp_r = filter_bp_r = filter_hp_r = filter_r4_body_lp_r = 0;

    out_lp_mix_l = out_hp_x_mix_l = out_hp_y_mix_l = 0;
    out_lp_mix_r = out_hp_x_mix_r = out_hp_y_mix_r = 0;
    out_lp_op1_l = out_hp_x_op1_l = out_hp_y_op1_l = 0;
    out_lp_op1_r = out_hp_x_op1_r = out_hp_y_op1_r = 0;
    out_lp_op2_l = out_hp_x_op2_l = out_hp_y_op2_l = 0;
    out_lp_op2_r = out_hp_x_op2_r = out_hp_y_op2_r = 0;
    out_lp_op3_l = out_hp_x_op3_l = out_hp_y_op3_l = 0;
    out_lp_op3_r = out_hp_x_op3_r = out_hp_y_op3_r = 0;
    out_lp_filter_l = out_hp_x_filter_l = out_hp_y_filter_l = 0;
    out_lp_filter_r = out_hp_x_filter_r = out_hp_y_filter_r = 0;

    idle_block_latched = 1;
  );
) : (
  idle_block_latched = 0;

  // Tempo can change while transport runs. Active LFO increments are block-rate work.
  lfo1_base_inc = lfo1_used ? lfo_bpm_inc(slider123) : 0;
  lfo2_base_inc = lfo2_used ? lfo_bpm_inc(slider146) : 0;
  lfo3_base_inc = lfo3_used ? lfo_bpm_inc(slider169) : 0;

  // ARP clock conversion and static note frequencies are active-block work only.
  arp_any_mode_cached ? (
    arp_bpm_cached = max(1, tempo);
    arp_samples_per_beat_cached = srate * 60 / arp_bpm_cached;
    spb4_inv = 1 / (arp_samples_per_beat_cached * 4);
  ) : (
    spb4_inv = 0;
  );

  op1_porta_coef >= 1 && op1_note >= 0 ? op1_cur_note = op1_target_note;
  op2_porta_coef >= 1 && op2_note >= 0 ? op2_cur_note = op2_target_note;
  op3_porta_coef >= 1 && op3_note >= 0 ? op3_cur_note = op3_target_note;

  drift1_cents_cached = drift1_unit * slider13 * 50;
  drift2_amount_cached = chord_master_op1_cached ? slider13 : slider14;
  drift3_amount_cached = chord_master_op1_cached ? slider13 : slider15;
  drift2_cents_cached = drift2_unit * drift2_amount_cached * 50;
  drift3_cents_cached = drift3_unit * drift3_amount_cached * 50;

  (!op1_pitch_dynamic_cached && op1_note >= 0) ? (
    op1_static_freq_cached = note_hz(op1_cur_note + slider25 + slider28/100 + drift1_cents_cached/100 + op1_bend * slider91);
    op1_static_inc_cached = op1_static_freq_cached * inv_srate;
    op1_static_aa_lev_cached = op1_wave_cached == 3 ? 0 : aa_mip_level(max(0.0000001, op1_static_inc_cached * op1_aa_inc_mul_cached));
  );
  (!op2_pitch_dynamic_cached && op2_note >= 0) ? (
    op2_static_freq_cached = note_hz(op2_cur_note + slider26 + op2_fine_cached/100 + drift2_cents_cached/100 + op2_bend * op2_bend_range_cached);
    op2_static_inc_cached = op2_static_freq_cached * inv_srate;
    op2_static_aa_lev_cached = op2_wave_cached == 3 ? 0 : aa_mip_level(max(0.0000001, op2_static_inc_cached * op2_aa_inc_mul_cached));
  );
  (!op3_pitch_dynamic_cached && op3_note >= 0) ? (
    op3_static_freq_cached = note_hz(op3_cur_note + slider27 + op3_fine_cached/100 + drift3_cents_cached/100 + op3_bend * op3_bend_range_cached);
    op3_static_inc_cached = op3_static_freq_cached * inv_srate;
    op3_static_aa_lev_cached = op3_wave_cached == 3 ? 0 : aa_mip_level(max(0.0000001, op3_static_inc_cached * op3_aa_inc_mul_cached));
  );
);

@sample
// v2.24 TEST Zero-Work Idle:
// With in_pin:none there is no audio input to clear or pass through.
// When the synth is asleep execute no per-sample output writes at all; only the
// active branch exists at run time. This mirrors the near-zero state seen before
// the first Note On as closely as JSFX permits.
!idle_block ? (
// -------------------- SID OSCILLATOR CORE --------------------
// Real SID topology used here:
//   Ring: Op1 is affected by Op3, Op2 by Op1, Op3 by Op2.
//   Sync: Op1 is reset by Op3, Op2 by Op1, Op3 by Op2.
// Sync is a hard accumulator reset on the RISING MSB edge of the modulator,
// not on normal phase wrap. Ring uses the modulator accumulator MSB and affects
// only the triangle component of the affected oscillator.

chord_master_op1 = chord_master_op1_cached;

op1_active = op1_note >= 0;
op2_active = op2_note >= 0;
op3_active = op3_note >= 0;

// Audio activity and oscillator activity are separate.
// In a real SID, Gate/envelope level does not stop the accumulator.
// If an operator is being used as a ring/sync source for another operator that is
// still releasing, its phase must continue running, even if its own VCA has faded out.
// Three BPM-synced LFO strips. CPU rule: a strip sleeps completely until at least
// one of its destination depths is non-zero. Mod Env rate control is also bypassed
// when its bipolar depth is exactly zero. Each full-scale envelope/depth spans
// four octaves of rate: +1 = 16x faster, -1 = 16x slower.
lfo_any_used ? (
  lfo_rate_mod_used ? (
    lfo1_rate_oct = 0; lfo2_rate_oct = 0; lfo3_rate_oct = 0;
    abs(slider61) > 0.0000001 ? (
      slider58 == 1 ? lfo1_rate_oct += op1_mod_env * slider61 * 4;
      slider58 == 2 ? lfo2_rate_oct += op1_mod_env * slider61 * 4;
      slider58 == 3 ? lfo3_rate_oct += op1_mod_env * slider61 * 4;
    );
    op2_rate_depth_eff = chord_master_op1 ? slider61 : slider62;
    op2_rate_target_eff = chord_master_op1 ? slider58 : slider59;
    abs(op2_rate_depth_eff) > 0.0000001 ? (
      op2_rate_target_eff == 1 ? lfo1_rate_oct += op2_mod_env * op2_rate_depth_eff * 4;
      op2_rate_target_eff == 2 ? lfo2_rate_oct += op2_mod_env * op2_rate_depth_eff * 4;
      op2_rate_target_eff == 3 ? lfo3_rate_oct += op2_mod_env * op2_rate_depth_eff * 4;
    );
    op3_rate_depth_eff = chord_master_op1 ? slider61 : slider63;
    op3_rate_target_eff = chord_master_op1 ? slider58 : slider60;
    abs(op3_rate_depth_eff) > 0.0000001 ? (
      op3_rate_target_eff == 1 ? lfo1_rate_oct += op3_mod_env * op3_rate_depth_eff * 4;
      op3_rate_target_eff == 2 ? lfo2_rate_oct += op3_mod_env * op3_rate_depth_eff * 4;
      op3_rate_target_eff == 3 ? lfo3_rate_oct += op3_mod_env * op3_rate_depth_eff * 4;
    );

    lfo1_inc = lfo1_base_inc * 2^(max(-8, min(8, lfo1_rate_oct)));
    lfo2_inc = lfo2_base_inc * 2^(max(-8, min(8, lfo2_rate_oct)));
    lfo3_inc = lfo3_base_inc * 2^(max(-8, min(8, lfo3_rate_oct)));
  ) : (
    lfo1_inc = lfo1_base_inc;
    lfo2_inc = lfo2_base_inc;
    lfo3_inc = lfo3_base_inc;
  );
  lfo1_out = lfo1_used ? lfo_process(lfo1_phase, lfo1_age, lfo1_delay_clock, lfo1_active, lfo1_sh, lfo1_seed, lfo1_smooth_out, slider122, lfo1_inc, slider124, slider127, lfo1_smooth_coef, slider129, slider131, slider130) : 0;
  lfo2_out = lfo2_used ? lfo_process(lfo2_phase, lfo2_age, lfo2_delay_clock, lfo2_active, lfo2_sh, lfo2_seed, lfo2_smooth_out, slider145, lfo2_inc, slider147, slider150, lfo2_smooth_coef, slider152, slider154, slider153) : 0;
  lfo3_out = lfo3_used ? lfo_process(lfo3_phase, lfo3_age, lfo3_delay_clock, lfo3_active, lfo3_sh, lfo3_seed, lfo3_smooth_out, slider168, lfo3_inc, slider170, slider173, lfo3_smooth_coef, slider175, slider177, slider176) : 0;

  lfo1_out >= 0 ? lfo1_out *= lfo1_upper_gain : lfo1_out *= lfo1_lower_gain;
  lfo2_out >= 0 ? lfo2_out *= lfo2_upper_gain : lfo2_out *= lfo2_lower_gain;
  lfo3_out >= 0 ? lfo3_out *= lfo3_upper_gain : lfo3_out *= lfo3_lower_gain;

  lfo_cut_mod = lfo1_out * slider132 + lfo2_out * slider155 + lfo3_out * slider178;
  lfo_op1_pitch_mod = lfo1_out * slider133 + lfo2_out * slider156 + lfo3_out * slider179;
  lfo_op2_pitch_mod = chord_master_op1 ? (lfo1_out * slider133 + lfo2_out * slider156 + lfo3_out * slider179) : (lfo1_out * slider134 + lfo2_out * slider157 + lfo3_out * slider180);
  lfo_op3_pitch_mod = chord_master_op1 ? (lfo1_out * slider133 + lfo2_out * slider156 + lfo3_out * slider179) : (lfo1_out * slider135 + lfo2_out * slider158 + lfo3_out * slider181);
  lfo_op1_pwm_mod = lfo1_out * slider136 + lfo2_out * slider159 + lfo3_out * slider182;
  lfo_op2_pwm_mod = chord_master_op1 ? (lfo1_out * slider136 + lfo2_out * slider159 + lfo3_out * slider182) : (lfo1_out * slider137 + lfo2_out * slider160 + lfo3_out * slider183);
  lfo_op3_pwm_mod = chord_master_op1 ? (lfo1_out * slider136 + lfo2_out * slider159 + lfo3_out * slider182) : (lfo1_out * slider138 + lfo2_out * slider161 + lfo3_out * slider184);
  lfo_op1_level_mod = lfo1_out * slider139 + lfo2_out * slider162 + lfo3_out * slider185;
  lfo_op2_level_mod = chord_master_op1 ? (lfo1_out * slider139 + lfo2_out * slider162 + lfo3_out * slider185) : (lfo1_out * slider140 + lfo2_out * slider163 + lfo3_out * slider186);
  lfo_op3_level_mod = chord_master_op1 ? (lfo1_out * slider139 + lfo2_out * slider162 + lfo3_out * slider185) : (lfo1_out * slider141 + lfo2_out * slider164 + lfo3_out * slider187);
  lfo_op1_pan_mod = lfo1_out * slider142 + lfo2_out * slider165 + lfo3_out * slider188;
  lfo_op2_pan_mod = chord_master_op1 ? lfo_op1_pan_mod : (lfo1_out * slider143 + lfo2_out * slider166 + lfo3_out * slider189);
  lfo_op3_pan_mod = chord_master_op1 ? lfo_op1_pan_mod : (lfo1_out * slider144 + lfo2_out * slider167 + lfo3_out * slider190);

) : (
  // These variables are already zero while every LFO strip sleeps. Retain a
  // single assignment so a just-disabled strip clears its previous output.
  lfo1_out = lfo2_out = lfo3_out = 0;
  lfo_cut_mod = 0;
  lfo_op1_pitch_mod = lfo_op2_pitch_mod = lfo_op3_pitch_mod = 0;
  lfo_op1_pwm_mod = lfo_op2_pwm_mod = lfo_op3_pwm_mod = 0;
  lfo_op1_level_mod = lfo_op2_level_mod = lfo_op3_level_mod = 0;
  lfo_op1_pan_mod = lfo_op2_pan_mod = lfo_op3_pan_mod = 0;
);

op1_ring_eff = op1_ring_cached;
op2_ring_eff = op2_ring_cached;
op3_ring_eff = op3_ring_cached;
op1_sync_eff = op1_sync_cached;
op2_sync_eff = op2_sync_cached;
op3_sync_eff = op3_sync_cached;

op1_phase_active = op1_active || (op2_active && (op2_ring_eff || op2_sync_eff));
op2_phase_active = op2_active || (op3_active && (op3_ring_eff || op3_sync_eff));
op3_phase_active = op3_active || (op1_active && (op1_ring_eff || op1_sync_eff));

// ARP work sleeps when all modes are off and no glide tail remains.
arp_work_active = arp_any_mode_cached ||
  abs(op1_arp_pitch_cur) >= 0.00001 || abs(op2_arp_pitch_cur) >= 0.00001 || abs(op3_arp_pitch_cur) >= 0.00001;

arp_work_active ? (
  chord_arp_root = chord_arp_count > 0 ? held_top(chord_arp_stack, chord_arp_count) : 60;

  op1_arp_mode_cached > 0 ? (
    op1_arp_src_base = op1_stack; op1_arp_src_count = op1_held_count; op1_arp_src_root = held_top(op1_stack, op1_held_count);
    midi_mode_cached == 1 && chord_arp_count > 0 ? (
      op1_arp_src_base = chord_arp_stack; op1_arp_src_count = chord_arp_count; op1_arp_src_root = chord_arp_root;
    );
    midi_mode_cached != 1 && op1_arp_latch_count > 0 ? (
      op1_arp_src_base = op1_arp_latch; op1_arp_src_count = op1_arp_latch_count; op1_arp_src_root = op1_arp_latch_root;
    );
    op1_arp_pitch_tgt = op1_arp_mode_cached == 1
      ? sid_seq_process(op1_sid_seq, op1_sid_seq_len, op1_arp_src_count, (midi_mode_cached == 1 ? chord_arp_root : op1_arp_latch_root), slider79, op1_arp_clock, op1_arp_step_idx, op1_arp_pitch_tgt)
      : arp_process(op1_arp_src_base, op1_arp_src_count, op1_arp_pool, op1_arp_mode_cached, slider79, slider82, slider85, op1_arp_clock, op1_arp_step_idx, op1_arp_pitch_tgt, op1_arp_seed);
  ) : (
    op1_arp_clock = 0; op1_arp_step_idx = -1; op1_arp_pitch_tgt = 0;
  );

  op2_arp_mode_cached > 0 ? (
    op2_arp_src_base = op2_stack; op2_arp_src_count = op2_held_count; op2_arp_src_root = held_top(op2_stack, op2_held_count);
    midi_mode_cached == 1 && chord_arp_count > 0 ? (
      op2_arp_src_base = chord_arp_stack; op2_arp_src_count = chord_arp_count; op2_arp_src_root = chord_arp_root;
    );
    midi_mode_cached != 1 && op2_arp_latch_count > 0 ? (
      op2_arp_src_base = op2_arp_latch; op2_arp_src_count = op2_arp_latch_count; op2_arp_src_root = op2_arp_latch_root;
    );
    op2_arp_pitch_tgt = op2_arp_mode_cached == 1
      ? sid_seq_process(op2_sid_seq, op2_sid_seq_len, op2_arp_src_count, (midi_mode_cached == 1 ? chord_arp_root : op2_arp_latch_root), slider80, op2_arp_clock, op2_arp_step_idx, op2_arp_pitch_tgt)
      : arp_process(op2_arp_src_base, op2_arp_src_count, op2_arp_pool, op2_arp_mode_cached, slider80, slider83, slider86, op2_arp_clock, op2_arp_step_idx, op2_arp_pitch_tgt, op2_arp_seed);
  ) : (
    op2_arp_clock = 0; op2_arp_step_idx = -1; op2_arp_pitch_tgt = 0;
  );

  op3_arp_mode_cached > 0 ? (
    op3_arp_src_base = op3_stack; op3_arp_src_count = op3_held_count; op3_arp_src_root = held_top(op3_stack, op3_held_count);
    midi_mode_cached == 1 && chord_arp_count > 0 ? (
      op3_arp_src_base = chord_arp_stack; op3_arp_src_count = chord_arp_count; op3_arp_src_root = chord_arp_root;
    );
    midi_mode_cached != 1 && op3_arp_latch_count > 0 ? (
      op3_arp_src_base = op3_arp_latch; op3_arp_src_count = op3_arp_latch_count; op3_arp_src_root = op3_arp_latch_root;
    );
    op3_arp_pitch_tgt = op3_arp_mode_cached == 1
      ? sid_seq_process(op3_sid_seq, op3_sid_seq_len, op3_arp_src_count, (midi_mode_cached == 1 ? chord_arp_root : op3_arp_latch_root), slider81, op3_arp_clock, op3_arp_step_idx, op3_arp_pitch_tgt)
      : arp_process(op3_arp_src_base, op3_arp_src_count, op3_arp_pool, op3_arp_mode_cached, slider81, slider84, slider87, op3_arp_clock, op3_arp_step_idx, op3_arp_pitch_tgt, op3_arp_seed);
  ) : (
    op3_arp_clock = 0; op3_arp_step_idx = -1; op3_arp_pitch_tgt = 0;
  );

  op1_arp_glide_coef >= 1 ? (
    op1_arp_pitch_cur = op1_arp_pitch_tgt;
  ) : (
    op1_arp_pitch_cur += (op1_arp_pitch_tgt - op1_arp_pitch_cur) * op1_arp_glide_coef;
    abs(op1_arp_pitch_tgt - op1_arp_pitch_cur) < 0.00001 ? op1_arp_pitch_cur = op1_arp_pitch_tgt;
  );
  op2_arp_glide_coef >= 1 ? (
    op2_arp_pitch_cur = op2_arp_pitch_tgt;
  ) : (
    op2_arp_pitch_cur += (op2_arp_pitch_tgt - op2_arp_pitch_cur) * op2_arp_glide_coef;
    abs(op2_arp_pitch_tgt - op2_arp_pitch_cur) < 0.00001 ? op2_arp_pitch_cur = op2_arp_pitch_tgt;
  );
  op3_arp_glide_coef >= 1 ? (
    op3_arp_pitch_cur = op3_arp_pitch_tgt;
  ) : (
    op3_arp_pitch_cur += (op3_arp_pitch_tgt - op3_arp_pitch_cur) * op3_arp_glide_coef;
    abs(op3_arp_pitch_tgt - op3_arp_pitch_cur) < 0.00001 ? op3_arp_pitch_cur = op3_arp_pitch_tgt;
  );

  op1_arp_pitch_semi = op1_arp_pitch_cur;
  op2_arp_pitch_semi = op2_arp_pitch_cur;
  op3_arp_pitch_semi = op3_arp_pitch_cur;
);

// Op3 internal modulation. Op3 can simply be made silent with Op3 Level = 0,
// while its oscillator/envelope still remain available as SID-style internal sources.
op1_pitch_mod = op1_lfo_pitch_used_cached ? lfo_op1_pitch_mod : 0;
op2_pitch_mod = op2_lfo_pitch_used_cached ? lfo_op2_pitch_mod : 0;
op3_pitch_mod = op3_lfo_pitch_used_cached ? lfo_op3_pitch_mod : 0;
op1_pwm_mod = op1_lfo_pwm_used_cached ? (lfo_op1_pwm_mod * 0.50) : 0;
op2_pwm_mod = op2_lfo_pwm_used_cached ? (lfo_op2_pwm_mod * 0.50) : 0;
op3_pwm_mod = op3_lfo_pwm_used_cached ? (lfo_op3_pwm_mod * 0.50) : 0;
filter_cut_mod = lfo_cut_used_cached ? (lfo_cut_mod * 2047) : 0;

op3_osc_mod_active_cached ? (
  op3_osc_mod_src = op3_mod_prev;
  op3_osc_mod_target_cached == 1 ? filter_cut_mod += op3_osc_mod_src * op3_osc_mod_depth_cached * 2047;
  op3_osc_mod_target_cached == 2 ? op1_pitch_mod += op3_osc_mod_src * op3_osc_mod_depth_cached * 24;
  op3_osc_mod_target_cached == 3 ? op2_pitch_mod += op3_osc_mod_src * op3_osc_mod_depth_cached * 24;
  op3_osc_mod_target_cached == 4 ? op1_pwm_mod += op3_osc_mod_src * op3_osc_mod_depth_cached * 0.50;
  op3_osc_mod_target_cached == 5 ? op2_pwm_mod += op3_osc_mod_src * op3_osc_mod_depth_cached * 0.50;
);
op3_env_mod_active_cached ? (
  op3_env_mod_src = op3_env * 2 - 1;
  op3_env_mod_target_cached == 1 ? filter_cut_mod += op3_env_mod_src * op3_env_mod_depth_cached * 2047;
  op3_env_mod_target_cached == 2 ? op1_pitch_mod += op3_env_mod_src * op3_env_mod_depth_cached * 24;
  op3_env_mod_target_cached == 3 ? op2_pitch_mod += op3_env_mod_src * op3_env_mod_depth_cached * 24;
  op3_env_mod_target_cached == 4 ? op1_pwm_mod += op3_env_mod_src * op3_env_mod_depth_cached * 0.50;
  op3_env_mod_target_cached == 5 ? op2_pwm_mod += op3_env_mod_src * op3_env_mod_depth_cached * 0.50;
);

// In Chord Allocate mode the three oscillators are still three independent mono voices,
// but Op1 becomes the shared SID control panel for timbre/VCA.
// This lets one pulse/saw/composite setup play all three allocated notes without
// needing to copy Op1 settings into Op2 and Op3 manually.
op1_wave_eff = op1_wave_cached;
op2_wave_eff = op2_wave_cached;
op3_wave_eff = op3_wave_cached;

op1_level_base = op1_level_cached;
op2_level_base = op2_level_cached;
op3_level_base = op3_level_cached;

// LFO Level Depth is tremolo/VCA modulation, not an additive voice opener.
// This keeps a silent operator silent, and makes level modulation audible because
// normalization below uses the unmodulated base levels.
op1_level_eff = op1_lfo_level_used_cached ? max(0, min(2, op1_level_base * max(0, 1 + lfo_op1_level_mod))) : op1_level_base;
op2_level_eff = op2_lfo_level_used_cached ? max(0, min(2, op2_level_base * max(0, 1 + lfo_op2_level_mod))) : op2_level_base;
op3_level_eff = op3_lfo_level_used_cached ? max(0, min(2, op3_level_base * max(0, 1 + lfo_op3_level_mod))) : op3_level_base;

// Per-operator stereo pan. Center is exactly unity on both channels so old
// centered presets keep the same level. LFO modulation is bipolar and clamped.
// The per-operator Mod Env can also sweep pan. In Chord Allocate, Op1 Pan Mod Depth
// is the shared panel control, while each allocated voice keeps its own envelope phase.
op1_pan_dynamic_cached ? (
  op1_pan_env_mod = op1_mod_env * slider49;
  op1_pan_eff = max(-1, min(1, slider19 + lfo_op1_pan_mod + op1_pan_env_mod));
  op1_pan_l = 1 - max(0, op1_pan_eff); op1_pan_r = 1 + min(0, op1_pan_eff);
) : (
  op1_pan_l = op1_pan_l_static; op1_pan_r = op1_pan_r_static;
);
op2_pan_dynamic_cached ? (
  op2_pan_env_mod = op2_mod_env * slider50;
  op2_pan_eff = max(-1, min(1, slider20 + lfo_op2_pan_mod + op2_pan_env_mod));
  op2_pan_l = 1 - max(0, op2_pan_eff); op2_pan_r = 1 + min(0, op2_pan_eff);
) : (
  op2_pan_l = op2_pan_l_static; op2_pan_r = op2_pan_r_static;
);
op3_pan_dynamic_cached ? (
  op3_pan_env_mod = op3_mod_env * slider51;
  op3_pan_eff = max(-1, min(1, slider21 + lfo_op3_pan_mod + op3_pan_env_mod));
  op3_pan_l = 1 - max(0, op3_pan_eff); op3_pan_r = 1 + min(0, op3_pan_eff);
) : (
  op3_pan_l = op3_pan_l_static; op3_pan_r = op3_pan_r_static;
);

// ADSR steps/coefs are cached in @slider. In Chord Allocate mode, Op2/Op3
// use Op1 envelope coefficients while their pitch/legato remain independent.
// Selectable PWM envelope source for each operator. The source is unipolar 0..1;
// the bipolar Depth chooses direction and amount. Depth 0 is completely off.
op1_pwm_dynamic_cached ? (
  op1_pwm_mod += op1_mod_env * slider55;
  op1_pw_eff = max(0.0002, min(1.25, op1_pw_base + op1_pwm_mod));
) : (
  op1_pw_eff = op1_pw_base;
);
op2_pwm_dynamic_cached ? (
  op2_pwm_mod += op2_mod_env * op2_pwm_mod_depth_cached;
  op2_pw_eff = chord_master_op1 ? max(0.0002, min(1.25, op1_pw_base + op2_pwm_mod)) : max(0.0002, min(1.25, op2_pw_base + op2_pwm_mod));
) : (
  op2_pw_eff = chord_master_op1 ? op1_pw_base : op2_pw_base;
);
op3_pwm_dynamic_cached ? (
  op3_pwm_mod += op3_mod_env * op3_pwm_mod_depth_cached;
  op3_pw_eff = chord_master_op1 ? max(0.0002, min(1.25, op1_pw_base + op3_pwm_mod)) : max(0.0002, min(1.25, op3_pw_base + op3_pwm_mod));
) : (
  op3_pw_eff = chord_master_op1 ? op1_pw_base : op3_pw_base;
);

// -------------------- PER-OPERATOR MOD ENV STATE MACHINES --------------------
// These run before oscillator frequency calculation; their current values also control optional LFO-rate modulation.
op1_mod_stage == 1 ? (
  op1_mod_env += op1_mod_att_step;
  op1_mod_env >= 1 ? (op1_mod_env = 1; op1_mod_stage = 2;);
) : op1_mod_stage == 2 ? (
  op1_mod_env -= op1_mod_dec_step;
  op1_mod_env <= op1_mod_sus ? (op1_mod_env = op1_mod_sus; op1_mod_stage = 3;);
) : op1_mod_stage == 3 ? (
  op1_mod_env = op1_mod_sus;
) : op1_mod_stage == 4 ? (
  op1_mod_env -= max(0.0000001, op1_mod_env) * max(0.0000000001, op1_mod_rel_latched);
  op1_mod_env <= 0.0001 ? (op1_mod_env = 0; op1_mod_stage = 0;);
);

op2_mod_stage == 1 ? (
  op2_mod_env += op2_mod_att_step;
  op2_mod_env >= 1 ? (op2_mod_env = 1; op2_mod_stage = 2;);
) : op2_mod_stage == 2 ? (
  op2_mod_env -= op2_mod_dec_step;
  op2_mod_env <= op2_mod_sus ? (op2_mod_env = op2_mod_sus; op2_mod_stage = 3;);
) : op2_mod_stage == 3 ? (
  op2_mod_env = op2_mod_sus;
) : op2_mod_stage == 4 ? (
  op2_mod_env -= max(0.0000001, op2_mod_env) * max(0.0000000001, op2_mod_rel_latched);
  op2_mod_env <= 0.0001 ? (op2_mod_env = 0; op2_mod_stage = 0;);
);

op3_mod_stage == 1 ? (
  op3_mod_env += op3_mod_att_step;
  op3_mod_env >= 1 ? (op3_mod_env = 1; op3_mod_stage = 2;);
) : op3_mod_stage == 2 ? (
  op3_mod_env -= op3_mod_dec_step;
  op3_mod_env <= op3_mod_sus ? (op3_mod_env = op3_mod_sus; op3_mod_stage = 3;);
) : op3_mod_stage == 3 ? (
  op3_mod_env = op3_mod_sus;
) : op3_mod_stage == 4 ? (
  op3_mod_env -= max(0.0000001, op3_mod_env) * max(0.0000000001, op3_mod_rel_latched);
  op3_mod_env <= 0.0001 ? (op3_mod_env = 0; op3_mod_stage = 0;);
);

// -------------------- INDEPENDENT NOTE-ON DRIFT --------------------
// Drift is sampled on Note On and converted to cents once per audio block.

op1_active ? (
  op1_pitch_dynamic_cached ? (
    op1_porta_coef < 1 ? op1_cur_note += (op1_target_note - op1_cur_note) * op1_porta_coef;
    op1_arp_base_note = (midi_mode_cached == 1 && chord_arp_count > 0 && op1_arp_mode_cached > 0) ? chord_arp_root : ((op1_arp_mode_cached > 0 && op1_arp_latch_count > 0) ? op1_arp_release_base : op1_cur_note);
    op1_mod_env_semi = abs(slider52) > pan_eps ? (op1_mod_env * slider52) : 0;
    op1_freq = note_hz(op1_arp_base_note + op1_arp_pitch_semi + slider25 + slider28/100 + op1_mod_env_semi + op1_pitch_mod + drift1_cents_cached/100 + op1_bend * slider91);
    op1_inc = op1_freq * inv_srate;
    op1_aa_lev = op1_wave_cached == 3 ? 0 : aa_mip_level(max(0.0000001, op1_inc * op1_aa_inc_mul_cached));
  ) : (
    op1_freq = op1_static_freq_cached;
    op1_inc = op1_static_inc_cached;
    op1_aa_lev = op1_static_aa_lev_cached;
  );
) : (
  !op1_phase_active ? op1_inc = 0;
);

op2_active ? (
  op2_pitch_dynamic_cached ? (
    op2_porta_coef < 1 ? op2_cur_note += (op2_target_note - op2_cur_note) * op2_porta_coef;
    op2_arp_base_note = (midi_mode_cached == 1 && chord_arp_count > 0 && op2_arp_mode_cached > 0) ? chord_arp_root : ((op2_arp_mode_cached > 0 && op2_arp_latch_count > 0) ? op2_arp_release_base : op2_cur_note);
    op2_mod_env_semi = abs(op2_pitch_mod_depth_cached) > pan_eps ? (op2_mod_env * op2_pitch_mod_depth_cached) : 0;
    op2_freq = note_hz(op2_arp_base_note + op2_arp_pitch_semi + slider26 + op2_fine_cached/100 + op2_mod_env_semi + op2_pitch_mod + drift2_cents_cached/100 + op2_bend * op2_bend_range_cached);
    op2_inc = op2_freq * inv_srate;
    op2_aa_lev = op2_wave_cached == 3 ? 0 : aa_mip_level(max(0.0000001, op2_inc * op2_aa_inc_mul_cached));
  ) : (
    op2_freq = op2_static_freq_cached;
    op2_inc = op2_static_inc_cached;
    op2_aa_lev = op2_static_aa_lev_cached;
  );
) : (
  !op2_phase_active ? op2_inc = 0;
);

op3_active ? (
  op3_pitch_dynamic_cached ? (
    op3_porta_coef < 1 ? op3_cur_note += (op3_target_note - op3_cur_note) * op3_porta_coef;
    op3_arp_base_note = (midi_mode_cached == 1 && chord_arp_count > 0 && op3_arp_mode_cached > 0) ? chord_arp_root : ((op3_arp_mode_cached > 0 && op3_arp_latch_count > 0) ? op3_arp_release_base : op3_cur_note);
    op3_mod_env_semi = abs(op3_pitch_mod_depth_cached) > pan_eps ? (op3_mod_env * op3_pitch_mod_depth_cached) : 0;
    op3_freq = note_hz(op3_arp_base_note + op3_arp_pitch_semi + slider27 + op3_fine_cached/100 + op3_mod_env_semi + op3_pitch_mod + drift3_cents_cached/100 + op3_bend * op3_bend_range_cached);
    op3_inc = op3_freq * inv_srate;
    op3_aa_lev = op3_wave_cached == 3 ? 0 : aa_mip_level(max(0.0000001, op3_inc * op3_aa_inc_mul_cached));
  ) : (
    op3_freq = op3_static_freq_cached;
    op3_inc = op3_static_inc_cached;
    op3_aa_lev = op3_static_aa_lev_cached;
  );
) : (
  !op3_phase_active ? op3_inc = 0;
);

// -------------------- LIGHTWEIGHT OSC/RING OVERSAMPLING --------------------
// Auto is permanent. Normal mipmapped waves remain at 1x; only Ring/Sync
// enter the adaptive oversampling path. slider1 is deliberately free.
os_factor = 1;

max_inc = max(max(op1_phase_active ? op1_inc : 0, op2_phase_active ? op2_inc : 0), op3_phase_active ? op3_inc : 0);
ring_sync_hot = (op1_ring_eff || op2_ring_eff || op3_ring_eff || op1_sync_eff || op2_sync_eff || op3_sync_eff);

ring_sync_hot ? (
  // Only genuinely discontinuous cross-oscillator operations keep oversampling.
  // Plain Triangle/Saw/Pulse use source-band-limited mip tables and always remain 1x.
  os_factor = 2;
  max_inc > 0.032 ? os_factor = 4;
  max_inc > 0.065 ? os_factor = 8;
  max_inc > 0.105 ? os_factor = 16;
);

aa_on = 1;
aa_wt_enable = !ring_sync_hot;
op1_acc = 0; op2_acc = 0; op3_acc = 0;

os_factor == 1 ? (
  op1_prevphase = op1_phase; op2_prevphase = op2_phase; op3_prevphase = op3_phase;

  op1_test_cached ? (
    op1_phase = 0;
  ) : (
    op1_phase_active ? (
      op1_phase += op1_inc;
      op1_phase >= 1 ? op1_phase -= floor(op1_phase);
      op1_noise_clock += op1_inc * 4;
      while (op1_noise_clock >= 1) (
        op1_noise_clock -= 1;
        op1_noise = next_noise_blend(op1_seed, op1_sid_seed, slider9);
      );
    );
  );
  op2_test_cached ? (
    op2_phase = 0;
  ) : (
    op2_phase_active ? (
      op2_phase += op2_inc;
      op2_phase >= 1 ? op2_phase -= floor(op2_phase);
      op2_noise_clock += op2_inc * 4;
      while (op2_noise_clock >= 1) (
        op2_noise_clock -= 1;
        op2_noise = next_noise_blend(op2_seed, op2_sid_seed, slider9);
      );
    );
  );
  op3_test_cached ? (
    op3_phase = 0;
  ) : (
    op3_phase_active ? (
      op3_phase += op3_inc;
      op3_phase >= 1 ? op3_phase -= floor(op3_phase);
      op3_noise_clock += op3_inc * 4;
      while (op3_noise_clock >= 1) (
        op3_noise_clock -= 1;
        op3_noise = next_noise_blend(op3_seed, op3_sid_seed, slider9);
      );
    );
  );

  op1_msb_rise = (op1_prevphase < 0.5) && (op1_phase >= 0.5);
  op2_msb_rise = (op2_prevphase < 0.5) && (op2_phase >= 0.5);
  op3_msb_rise = (op3_prevphase < 0.5) && (op3_phase >= 0.5);
  (op1_sync_eff && op3_msb_rise) ? op1_phase = 0;
  (op2_sync_eff && op1_msb_rise) ? op2_phase = 0;
  (op3_sync_eff && op2_msb_rise) ? op3_phase = 0;

  op1_acc = (op1_active && !op1_test_cached) ? osc_wave(op1_wave_eff, op1_phase, op1_inc, op1_pw_eff, op1_noise, 0, slider5, op1_ring_eff, op3_phase, op3_inc, aa_on, op1_aa_lev) : 0;
  op2_acc = (op2_active && !op2_audio_test_cached) ? osc_wave(op2_wave_eff, op2_phase, op2_inc, op2_pw_eff, op2_noise, 0, slider5, op2_ring_eff, op1_phase, op1_inc, aa_on, op2_aa_lev) : 0;
  op3_acc = (op3_active && !op3_audio_test_cached) ? osc_wave(op3_wave_eff, op3_phase, op3_inc, op3_pw_eff, op3_noise, 0, slider5, op3_ring_eff, op2_phase, op2_inc, aa_on, op3_aa_lev) : 0;

  op1_raw = op1_acc; op2_raw = op2_acc; op3_raw = op3_acc;
) : (
  os_step = 1 / os_factor;
  os_i = 0;
  while (os_i < os_factor) (
    op1_prevphase = op1_phase; op2_prevphase = op2_phase; op3_prevphase = op3_phase;

    op1_test_cached ? (
      op1_phase = 0;
    ) : (
      op1_phase_active ? (
        op1_phase += op1_inc * os_step;
        op1_phase >= 1 ? op1_phase -= floor(op1_phase);
        op1_noise_clock += op1_inc * 4 * os_step;
        while (op1_noise_clock >= 1) (
          op1_noise_clock -= 1;
          op1_noise = next_noise_blend(op1_seed, op1_sid_seed, slider9);
        );
      );
    );
    op2_test_cached ? (
      op2_phase = 0;
    ) : (
      op2_phase_active ? (
        op2_phase += op2_inc * os_step;
        op2_phase >= 1 ? op2_phase -= floor(op2_phase);
        op2_noise_clock += op2_inc * 4 * os_step;
        while (op2_noise_clock >= 1) (
          op2_noise_clock -= 1;
          op2_noise = next_noise_blend(op2_seed, op2_sid_seed, slider9);
        );
      );
    );
    op3_test_cached ? (
      op3_phase = 0;
    ) : (
      op3_phase_active ? (
        op3_phase += op3_inc * os_step;
        op3_phase >= 1 ? op3_phase -= floor(op3_phase);
        op3_noise_clock += op3_inc * 4 * os_step;
        while (op3_noise_clock >= 1) (
          op3_noise_clock -= 1;
          op3_noise = next_noise_blend(op3_seed, op3_sid_seed, slider9);
        );
      );
    );

    op1_msb_rise = (op1_prevphase < 0.5) && (op1_phase >= 0.5);
    op2_msb_rise = (op2_prevphase < 0.5) && (op2_phase >= 0.5);
    op3_msb_rise = (op3_prevphase < 0.5) && (op3_phase >= 0.5);
    (op1_sync_eff && op3_msb_rise) ? op1_phase = 0;
    (op2_sync_eff && op1_msb_rise) ? op2_phase = 0;
    (op3_sync_eff && op2_msb_rise) ? op3_phase = 0;

    op1_acc += (op1_active && !op1_test_cached) ? osc_wave(op1_wave_eff, op1_phase, op1_inc * os_step, op1_pw_eff, op1_noise, 0, slider5, op1_ring_eff, op3_phase, op3_inc * os_step, aa_on, op1_aa_lev) : 0;
    op2_acc += (op2_active && !op2_audio_test_cached) ? osc_wave(op2_wave_eff, op2_phase, op2_inc * os_step, op2_pw_eff, op2_noise, 0, slider5, op2_ring_eff, op1_phase, op1_inc * os_step, aa_on, op2_aa_lev) : 0;
    op3_acc += (op3_active && !op3_audio_test_cached) ? osc_wave(op3_wave_eff, op3_phase, op3_inc * os_step, op3_pw_eff, op3_noise, 0, slider5, op3_ring_eff, op2_phase, op2_inc * os_step, aa_on, op3_aa_lev) : 0;
    os_i += 1;
  );
  op1_raw = op1_acc / os_factor;
  op2_raw = op2_acc / os_factor;
  op3_raw = op3_acc / os_factor;
);

// High-register BLEP make-up. Keep it before VCA/filter so the rest of the synth
// behaves normally, but avoid the "cleaned until it disappears" effect on high notes.
((aa_on && !aa_wt_enable) && op1_active) ? op1_raw *= aa_energy_comp(op1_inc, op1_wave_eff, op1_ring_eff, op1_sync_eff, os_factor, aa_on);
((aa_on && !aa_wt_enable) && op2_active) ? op2_raw *= aa_energy_comp(op2_inc, op2_wave_eff, op2_ring_eff, op2_sync_eff, os_factor, aa_on);
((aa_on && !aa_wt_enable) && op3_active) ? op3_raw *= aa_energy_comp(op3_inc, op3_wave_eff, op3_ring_eff, op3_sync_eff, os_factor, aa_on);

// -------------------- ADSR STATE MACHINES --------------------
op1_active ? (
  op1_stage == 1 ? (
    op1_env += op1_att_step;
    op1_env >= 1 ? (op1_env = 1; op1_stage = 2;);
  ) :
  op1_stage == 2 ? (
    op1_env -= op1_dec_step;
    op1_env <= op1_sus_eff ? (op1_env = op1_sus_eff; op1_stage = 3;);
  ) :
  op1_stage == 3 ? (
    op1_env = op1_sus_eff;
  ) :
  op1_stage == 4 ? (
    op1_env -= max(0.0000001, op1_env) * max(0.0000000001, op1_rel_latched);
    op1_env <= 0.0001 ? (op1_env = 0; op1_stage = 0; op1_note = -1; arp_latch_clear(op1_arp_latch_count); op1_sid_seq_len = 0; arp_reset_op1(););
  );
) : op1_raw = 0;

op2_active ? (
  op2_stage == 1 ? (
    op2_env += op2_att_step;
    op2_env >= 1 ? (op2_env = 1; op2_stage = 2;);
  ) :
  op2_stage == 2 ? (
    op2_env -= op2_dec_step;
    op2_env <= op2_sus_eff ? (op2_env = op2_sus_eff; op2_stage = 3;);
  ) :
  op2_stage == 3 ? (
    op2_env = op2_sus_eff;
  ) :
  op2_stage == 4 ? (
    op2_env -= max(0.0000001, op2_env) * max(0.0000000001, op2_rel_latched);
    op2_env <= 0.0001 ? (op2_env = 0; op2_stage = 0; op2_note = -1; arp_latch_clear(op2_arp_latch_count); op2_sid_seq_len = 0; arp_reset_op2(););
  );
) : op2_raw = 0;

op3_active ? (
  op3_stage == 1 ? (
    op3_env += op3_att_step;
    op3_env >= 1 ? (op3_env = 1; op3_stage = 2;);
  ) :
  op3_stage == 2 ? (
    op3_env -= op3_dec_step;
    op3_env <= op3_sus_eff ? (op3_env = op3_sus_eff; op3_stage = 3;);
  ) :
  op3_stage == 3 ? (
    op3_env = op3_sus_eff;
  ) :
  op3_stage == 4 ? (
    op3_env -= max(0.0000001, op3_env) * max(0.0000000001, op3_rel_latched);
    op3_env <= 0.0001 ? (op3_env = 0; op3_stage = 0; op3_note = -1; arp_latch_clear(op3_arp_latch_count); op3_sid_seq_len = 0; arp_reset_op3(););
  );
) : op3_raw = 0;

op1_sig = op1_raw * op1_env * op1_level_eff;
op2_sig = op2_raw * op2_env * op2_level_eff;
op3_sig = op3_raw * op3_env * op3_level_eff;
op3_mod_prev = op3_raw * op3_env;
op3_audio_sig = op3_sig;

// Dedicated filter ADSR. It follows Op1 Mode Trigger as the shared filter gate rule:
// Trigger = every Note On restarts the filter envelope.
// Legato  = only the first held note restarts it; overlapped notes only move pitch.
filter_stage == 1 ? (
  filter_env += filter_att_step;
  filter_env >= 1 ? (filter_env = 1; filter_stage = 2;);
) :
filter_stage == 2 ? (
  filter_env -= filter_dec_step;
  filter_env <= filter_sustain_cached ? (filter_env = filter_sustain_cached; filter_stage = 3;);
) :
filter_stage == 3 ? (
  filter_env = filter_sustain_cached;
) :
filter_stage == 4 ? (
  filter_env -= max(0.0000001, filter_env) * max(0.0000000001, filter_rel_latched);
  filter_env <= 0.0001 ? (filter_env = 0; filter_stage = 0;);
);

// Bipolar filter envelope:
// positive Amount opens the cutoff, negative Amount closes it.
// slider108 may also be negative as a virtual undercut below register 0.
// The real filter register is finally clamped to 0..2047.
filter_cut_dynamic_cached ? (
  filter_key_mod = (filter_key_note - 60) * 32 * slider113;
  dyn_cut_reg = max(0, min(2047, slider108 + slider117 * filter_env + filter_cut_mod + filter_key_mod));
  dyn_cut_norm = dyn_cut_reg / 2047;
  !model_6581_cached ? (
    dyn_filter_fc = 4 + pow(dyn_cut_norm, 1.38) * 12500;
  ) : (
    dyn_filter_fc = 28 + pow(dyn_cut_norm, 2.12) * 8170;
  );
  dyn_filter_fc = min(dyn_filter_fc, srate * 0.42);
  filter_f = 2 * sin($pi * dyn_filter_fc / srate);
  filter_f = min(0.98, max(0.00015, filter_f));
  r4_body_amt = model_6581_cached ? (0.22 * pow(1 - dyn_cut_norm, 2.35)) : 0;
) : (
  filter_f = static_filter_f_cached;
  r4_body_amt = static_r4_body_amt_cached;
);

// Stereo per-operator routing. Each voice is panned before the shared filter,
// so filtered and direct paths preserve the same pan position. Center remains
// bit-for-bit level-compatible in principle: both channel gains are unity.
filter_in_l = 0; filter_in_r = 0;
dry_out_l = 0; dry_out_r = 0;
norm_total = norm_total_cached;
mono_mix_fast = mono_output_fast_safe && !mix_stereo_needed_cached;

slider114 >= 1 ? (
  filter_in_l += op1_sig * op1_pan_l;
  filter_stereo_needed_cached ? filter_in_r += op1_sig * op1_pan_r;
) : (
  dry_out_l += op1_sig * op1_pan_l; !mono_mix_fast ? dry_out_r += op1_sig * op1_pan_r;
);
op2_to_filter_cached >= 1 ? (
  filter_in_l += op2_sig * op2_pan_l;
  filter_stereo_needed_cached ? filter_in_r += op2_sig * op2_pan_r;
) : (
  dry_out_l += op2_sig * op2_pan_l; !mono_mix_fast ? dry_out_r += op2_sig * op2_pan_r;
);
op3_to_filter_cached >= 1 ? (
  filter_in_l += op3_audio_sig * op3_pan_l;
  filter_stereo_needed_cached ? filter_in_r += op3_audio_sig * op3_pan_r;
) : (
  !voice3_off_cached ? (dry_out_l += op3_audio_sig * op3_pan_l; !mono_mix_fast ? dry_out_r += op3_audio_sig * op3_pan_r;);
);

filter_x_l = filter_in_l * filter_input_gain;
// Composite Character removed: no additional fixed pre-filter character drive.

// SID-style multimode core:
// one shared filter state, then LP/BP/HP outputs are switched and summed.
// 6581 uses a softly-limited feedback term and a tiny analog-style state loss;
// this keeps resonance alive but below free self-oscillation.
// Linear feedback path. The 6581 character must not be created by clipping
// inside the resonant loop, otherwise high resonance reshapes the oscillator.
filter_hp_l = filter_x_l - filter_lp_l - filter_damp * filter_bp_l;
filter_bp_l += filter_f * filter_hp_l;
filter_lp_l += filter_f * filter_bp_l;
filter_bp_l *= filter_state_loss;
filter_lp_l *= filter_state_loss;

// Safety rails: this Lab should not self-oscillate or explode.
// Keep the state variables inside a musical analog-ish range.
filter_bp_l = max(-2.5, min(2.5, filter_bp_l));
filter_lp_l = max(-2.5, min(2.5, filter_lp_l));
filter_hp_l = max(-2.5, min(2.5, filter_hp_l));

// No note-off gate here: free oscillation is prevented upstream by damping,
// feedback soft-limiting and continuous analog-style state loss.
filter_idle_gate = 0;

// Separate 6581 R4 low body leakage. This is not "dry bypass":
// it is a dark residual path so LP closed is still alive/corporeal.
filter_r4_body_lp_l += r4_body_f * (filter_x_l - filter_r4_body_lp_l);

// Small internal containment. More obvious on 6581, very gentle on 8580.
model_6581_cached ? (
  // No saturation inside the 6581 resonant states. Just a tiny, clean
  // level shaping/containment so the BP presence remains musical.
  filter_bp_l *= filter_state_bp_mul;
  filter_hp_l *= filter_state_hp_mul;
  filter_lp_l *= filter_state_lp_mul;
) : (
  // 8580: cleaner, but resonance can still make useful kick transients.
  abs(filter_bp_l) > 5 ? filter_bp_l *= 0.5;
  abs(filter_lp_l) > 5 ? filter_lp_l *= 0.5;
);

filter_out_l = 0;
// clean_makeup_6581 is cached in @slider.

filter_lp_on_cached ? (
  filter_out_l += filter_lp_l * filter_lp_weight;
  // 6581 LP never fully disappears at low cutoff.
  filter_out_l += filter_r4_body_lp_l * r4_body_amt;
);
filter_bp_on_cached ? filter_out_l += filter_bp_l * filter_bp_weight;
filter_hp_on_cached ? filter_out_l += filter_hp_l * filter_hp_weight;

// Lab behavior:
// if LP/BP/HP are all Off, the routed operators bypass the filter.
// So the oscillator/VCA part remains audible before choosing VCF outputs.
filter_mode_count_cached <= 0 ? (
  // No filter mode selected: routed operators are clean/bypassed.
  // Give only the 6581 clean path a small +1 dB match, separate from filter make-up.
  filter_out_l = filter_in_l * clean_makeup_6581;
) : (
  // Resonance should bring cream_l, not screaming auto-oscillation.
  // The 6581 uses a hybrid strategy: stable core + clean resonant presence
  // from the already-damped BP state. This adds bite without raising feedback.
  model_6581_cached ? (
    filter_out_l *= filter_cream_gain;
    // Clean post-filter resonance: no softclip here, so resonance enhances the
    // filter peak without turning the pre-filter saw into a square/pulse.
    filter_out_l += filter_bp_l * filter_res_presence_6581_coef;
    // Extra clean 6581 LP resonance. This is post-core only: it raises the
    // low-pass resonant peak without driving/squaring the pre-filter saw.
    filter_lp_on_cached ? (
      filter_out_l += filter_bp_l * filter_lp_res_presence_coef;
    );
    // 6581 colour after the resonant stage. Use parallel saturation instead of
    // replacing the whole signal: this keeps the R4 dirt but preserves more ADSR
    // movement and avoids the swollen, sustain-like envelope flattening.
    // v1.84: slightly stronger post-filter colour, still parallel and dynamic.
    // The -12 dB trim remains later in the chain, so this restores density rather
    // than raising the filtered output level.
    post_dirty_l = softclip(filter_out_l * filter_post_col) * filter_post_col_inv;
    filter_out_l = filter_out_l * filter_post_clean_mix + post_dirty_l * filter_post_mix;
  ) : (
    // v1.86: twice the previous clean 8580 resonance presence. This follows
    // the stronger core feedback without adding a simple fixed output boost.
    filter_out_l *= filter_cream_gain;
    filter_out_l += filter_bp_l * filter_res_presence_8580_coef;
  );

  // 6581 three-state mode (LP+BP+HP) was perceptually lower: lift only that combo.
  (model_6581_cached && filter_all_modes_cached) ? filter_out_l *= 1.052; // v1.56: previous 1.18 lift lowered by 1 dB

  // 6581 compensation belongs to the filter path, not to the oscillator model.
  // The 6581 curve is darker and the filtered output loses much more perceived level
  // than the 8580, especially in LP mode and with lower cutoff values.
  // Apply make-up only when at least one filter output mode is selected.
  filter_out_l *= filter_makeup_6581;

  // v1.83: reduce only the active 6581 filtered branch by 12 dB.
  // This is deliberately post-filter/post-colour so cutoff, resonance, saturation
  // and model character remain unchanged; only the resulting level is lower.
  model_6581_cached ? filter_out_l *= 0.2511886432;
);

filter_out_l *= filter_gain;

filter_stereo_needed_cached ? (
filter_x_r = filter_in_r * filter_input_gain;
// Composite Character removed: no additional fixed pre-filter character drive.

// SID-style multimode core:
// one shared filter state, then LP/BP/HP outputs are switched and summed.
// 6581 uses a softly-limited feedback term and a tiny analog-style state loss;
// this keeps resonance alive but below free self-oscillation.
// Linear feedback path. The 6581 character must not be created by clipping
// inside the resonant loop, otherwise high resonance reshapes the oscillator.
filter_hp_r = filter_x_r - filter_lp_r - filter_damp * filter_bp_r;
filter_bp_r += filter_f * filter_hp_r;
filter_lp_r += filter_f * filter_bp_r;
filter_bp_r *= filter_state_loss;
filter_lp_r *= filter_state_loss;

// Safety rails: this Lab should not self-oscillate or explode.
// Keep the state variables inside a musical analog-ish range.
filter_bp_r = max(-2.5, min(2.5, filter_bp_r));
filter_lp_r = max(-2.5, min(2.5, filter_lp_r));
filter_hp_r = max(-2.5, min(2.5, filter_hp_r));

// No note-off gate here: free oscillation is prevented upstream by damping,
// feedback soft-limiting and continuous analog-style state loss.
filter_idle_gate = 0;

// Separate 6581 R4 low body leakage. This is not "dry bypass":
// it is a dark residual path so LP closed is still alive/corporeal.
filter_r4_body_lp_r += r4_body_f * (filter_x_r - filter_r4_body_lp_r);

// Small internal containment. More obvious on 6581, very gentle on 8580.
model_6581_cached ? (
  // No saturation inside the 6581 resonant states. Just a tiny, clean
  // level shaping/containment so the BP presence remains musical.
  filter_bp_r *= filter_state_bp_mul;
  filter_hp_r *= filter_state_hp_mul;
  filter_lp_r *= filter_state_lp_mul;
) : (
  // 8580: cleaner, but resonance can still make useful kick transients.
  abs(filter_bp_r) > 5 ? filter_bp_r *= 0.5;
  abs(filter_lp_r) > 5 ? filter_lp_r *= 0.5;
);

filter_out_r = 0;
// clean_makeup_6581 is cached in @slider.

filter_lp_on_cached ? (
  filter_out_r += filter_lp_r * filter_lp_weight;
  // 6581 LP never fully disappears at low cutoff.
  filter_out_r += filter_r4_body_lp_r * r4_body_amt;
);
filter_bp_on_cached ? filter_out_r += filter_bp_r * filter_bp_weight;
filter_hp_on_cached ? filter_out_r += filter_hp_r * filter_hp_weight;

// Lab behavior:
// if LP/BP/HP are all Off, the routed operators bypass the filter.
// So the oscillator/VCA part remains audible before choosing VCF outputs.
filter_mode_count_cached <= 0 ? (
  // No filter mode selected: routed operators are clean/bypassed.
  // Give only the 6581 clean path a small +1 dB match, separate from filter make-up.
  filter_out_r = filter_in_r * clean_makeup_6581;
) : (
  // Resonance should bring cream_r, not screaming auto-oscillation.
  // The 6581 uses a hybrid strategy: stable core + clean resonant presence
  // from the already-damped BP state. This adds bite without raising feedback.
  model_6581_cached ? (
    filter_out_r *= filter_cream_gain;
    // Clean post-filter resonance: no softclip here, so resonance enhances the
    // filter peak without turning the pre-filter saw into a square/pulse.
    filter_out_r += filter_bp_r * filter_res_presence_6581_coef;
    // Extra clean 6581 LP resonance. This is post-core only: it raises the
    // low-pass resonant peak without driving/squaring the pre-filter saw.
    filter_lp_on_cached ? (
      filter_out_r += filter_bp_r * filter_lp_res_presence_coef;
    );
    // 6581 colour after the resonant stage. Use parallel saturation instead of
    // replacing the whole signal: this keeps the R4 dirt but preserves more ADSR
    // movement and avoids the swollen, sustain-like envelope flattening.
    // v1.84: slightly stronger post-filter colour, still parallel and dynamic.
    // The -12 dB trim remains later in the chain, so this restores density rather
    // than raising the filtered output level.
    post_dirty_r = softclip(filter_out_r * filter_post_col) * filter_post_col_inv;
    filter_out_r = filter_out_r * filter_post_clean_mix + post_dirty_r * filter_post_mix;
  ) : (
    // v1.86: twice the previous clean 8580 resonance presence. This follows
    // the stronger core feedback without adding a simple fixed output boost.
    filter_out_r *= filter_cream_gain;
    filter_out_r += filter_bp_r * filter_res_presence_8580_coef;
  );

  // 6581 three-state mode (LP+BP+HP) was perceptually lower: lift only that combo.
  (model_6581_cached && filter_all_modes_cached) ? filter_out_r *= 1.052; // v1.56: previous 1.18 lift lowered by 1 dB

  // 6581 compensation belongs to the filter path, not to the oscillator model.
  // The 6581 curve is darker and the filtered output loses much more perceived level
  // than the 8580, especially in LP mode and with lower cutoff values.
  // Apply make-up only when at least one filter output mode is selected.
  filter_out_r *= filter_makeup_6581;

  // v1.83: reduce only the active 6581 filtered branch by 12 dB.
  // This is deliberately post-filter/post-colour so cutoff, resonance, saturation
  // and model character remain unchanged; only the resulting level is lower.
  model_6581_cached ? filter_out_r *= 0.2511886432;
);

filter_out_r *= filter_gain;
) : (
  // All filtered voices are centered: reuse the mono filter result and keep the
  // right state synchronized so enabling Pan later does not wake an old state.
  filter_hp_r = filter_hp_l;
  filter_bp_r = filter_bp_l;
  filter_lp_r = filter_lp_l;
  filter_r4_body_lp_r = filter_r4_body_lp_l;
  filter_out_r = filter_out_l;
);

mono_mix_fast ? dry_out_r = dry_out_l;
model_6581_cached ? (
  dry_out_l *= clean_makeup_6581;
  mono_mix_fast ? dry_out_r = dry_out_l : dry_out_r *= clean_makeup_6581;
);

mix_l = (filter_out_l + dry_out_l) / norm_total;
mono_mix_fast ? mix_r = mix_l : mix_r = (filter_out_r + dry_out_r) / norm_total;

model_6581_cached ? (
  final_dirty_l = softclip(mix_l * out_drive) / out_drive;
  mix_l = mix_l * 0.88 + final_dirty_l * 0.12;
  mono_mix_fast ? (
    mix_r = mix_l;
  ) : (
    final_dirty_r = softclip(mix_r * out_drive) / out_drive;
    mix_r = mix_r * 0.88 + final_dirty_r * 0.12;
  );
);

mix_l *= composite_makeup_gain * sid_6581_global_gain;
mono_mix_fast ? mix_r = mix_l : mix_r *= composite_makeup_gain * sid_6581_global_gain;

// Final SID output stage. In a proven-synchronized mono state, process the analogue
// amplifier/RC/DC chain once and mirror both the sample and its state to the right.
out_amp_l = sid_output_amp(mix_l);
out_lp_mix_l += (out_amp_l - out_lp_mix_l) * out_lp_alpha;
out_stage_l = out_lp_mix_l - out_hp_x_mix_l + out_hp_r * out_hp_y_mix_l;
out_hp_x_mix_l = out_lp_mix_l; out_hp_y_mix_l = out_stage_l;
mix_l = out_stage_l * master_gain;

mono_mix_fast ? (
  out_lp_mix_r = out_lp_mix_l;
  out_hp_x_mix_r = out_hp_x_mix_l;
  out_hp_y_mix_r = out_hp_y_mix_l;
  mix_r = mix_l;
) : (
  out_amp_r = sid_output_amp(mix_r);
  out_lp_mix_r += (out_amp_r - out_lp_mix_r) * out_lp_alpha;
  out_stage_r = out_lp_mix_r - out_hp_x_mix_r + out_hp_r * out_hp_y_mix_r;
  out_hp_x_mix_r = out_lp_mix_r; out_hp_y_mix_r = out_stage_r;
  mix_r = out_stage_r * master_gain;
);

// Audio Mode:
// Stereo skips all artificial stem preparation and output-stage processing.
audio_multichannel_cached ? (
  stem_pre_gain = composite_makeup_gain * sid_6581_global_gain / norm_total;
  filter_stem_pre_l = filter_out_l * stem_pre_gain;
  filter_stem_pre_r = filter_out_r * stem_pre_gain;
  op1_stem_pre_l = (slider114 < 0.5 ? op1_sig * op1_pan_l : 0) * stem_pre_gain;
  op1_stem_pre_r = (slider114 < 0.5 ? op1_sig * op1_pan_r : 0) * stem_pre_gain;
  op2_stem_pre_l = (op2_to_filter_cached < 0.5 ? op2_sig * op2_pan_l : 0) * stem_pre_gain;
  op2_stem_pre_r = (op2_to_filter_cached < 0.5 ? op2_sig * op2_pan_r : 0) * stem_pre_gain;
  op3_stem_pre_l = ((op3_to_filter_cached < 0.5 && !voice3_off_cached) ? op3_audio_sig * op3_pan_l : 0) * stem_pre_gain;
  op3_stem_pre_r = ((op3_to_filter_cached < 0.5 && !voice3_off_cached) ? op3_audio_sig * op3_pan_r : 0) * stem_pre_gain;

  out_amp = sid_output_amp(op1_stem_pre_l); out_lp_op1_l += (out_amp-out_lp_op1_l)*out_lp_alpha; op1_stem_l=out_lp_op1_l-out_hp_x_op1_l+out_hp_r*out_hp_y_op1_l; out_hp_x_op1_l=out_lp_op1_l; out_hp_y_op1_l=op1_stem_l;
  out_amp = sid_output_amp(op1_stem_pre_r); out_lp_op1_r += (out_amp-out_lp_op1_r)*out_lp_alpha; op1_stem_r=out_lp_op1_r-out_hp_x_op1_r+out_hp_r*out_hp_y_op1_r; out_hp_x_op1_r=out_lp_op1_r; out_hp_y_op1_r=op1_stem_r;
  out_amp = sid_output_amp(op2_stem_pre_l); out_lp_op2_l += (out_amp-out_lp_op2_l)*out_lp_alpha; op2_stem_l=out_lp_op2_l-out_hp_x_op2_l+out_hp_r*out_hp_y_op2_l; out_hp_x_op2_l=out_lp_op2_l; out_hp_y_op2_l=op2_stem_l;
  out_amp = sid_output_amp(op2_stem_pre_r); out_lp_op2_r += (out_amp-out_lp_op2_r)*out_lp_alpha; op2_stem_r=out_lp_op2_r-out_hp_x_op2_r+out_hp_r*out_hp_y_op2_r; out_hp_x_op2_r=out_lp_op2_r; out_hp_y_op2_r=op2_stem_r;
  out_amp = sid_output_amp(op3_stem_pre_l); out_lp_op3_l += (out_amp-out_lp_op3_l)*out_lp_alpha; op3_stem_l=out_lp_op3_l-out_hp_x_op3_l+out_hp_r*out_hp_y_op3_l; out_hp_x_op3_l=out_lp_op3_l; out_hp_y_op3_l=op3_stem_l;
  out_amp = sid_output_amp(op3_stem_pre_r); out_lp_op3_r += (out_amp-out_lp_op3_r)*out_lp_alpha; op3_stem_r=out_lp_op3_r-out_hp_x_op3_r+out_hp_r*out_hp_y_op3_r; out_hp_x_op3_r=out_lp_op3_r; out_hp_y_op3_r=op3_stem_r;
  out_amp = sid_output_amp(filter_stem_pre_l); out_lp_filter_l += (out_amp-out_lp_filter_l)*out_lp_alpha; filter_stem_l=out_lp_filter_l-out_hp_x_filter_l+out_hp_r*out_hp_y_filter_l; out_hp_x_filter_l=out_lp_filter_l; out_hp_y_filter_l=filter_stem_l;
  out_amp = sid_output_amp(filter_stem_pre_r); out_lp_filter_r += (out_amp-out_lp_filter_r)*out_lp_alpha; filter_stem_r=out_lp_filter_r-out_hp_x_filter_r+out_hp_r*out_hp_y_filter_r; out_hp_x_filter_r=out_lp_filter_r; out_hp_y_filter_r=filter_stem_r;
  spl0=mix_l; spl1=mix_r;
  spl2=op1_stem_l*master_gain; spl3=op1_stem_r*master_gain;
  spl4=op2_stem_l*master_gain; spl5=op2_stem_r*master_gain;
  spl6=op3_stem_l*master_gain; spl7=op3_stem_r*master_gain;
  spl8=filter_stem_l*master_gain; spl9=filter_stem_r*master_gain;
) : (
  spl0 = mix_l; spl1 = mix_r;
  spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = spl8 = spl9 = 0;
);
);
