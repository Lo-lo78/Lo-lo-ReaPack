  arp_latch_copy(op3_stack, op3_held_count, op3_arp_latch, op3_arp_latch_count, op3_arp_latch_root);
  slider78 == 1 && slider3 != 1 ? (
    !was_down ? sid_seq_clear(op3_sid_seq, note, op3_sid_seq_len)
              : sid_seq_record(op3_sid_seq, op3_arp_step_idx, note, op3_sid_seq_len);
  );

  // In ARP mode, note-on must only feed the arp material. It must not move
  // the oscillator pitch immediately. The pitch is changed only by arp_process()
  // on a clock step. On the first note of a phrase we initialize the base.
  (!arp_on || !was_down) ? (
