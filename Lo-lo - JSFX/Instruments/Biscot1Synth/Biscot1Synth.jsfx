  op2_gate = vel / 127;
  retrig = arp_on ? !was_down : (((slider3 == 1 ? slider10 : slider11) < 0.5) || !was_down);

  retrig ? (
    op2_stage = 1;
    op2_mod_stage = 1;
    // LSH-2 style: do not restart the arp clock when adding notes to an already running arp.
    !was_down ? arp_reset_op2();
    slider4 > 0 ? reset_op2();
  );
);

