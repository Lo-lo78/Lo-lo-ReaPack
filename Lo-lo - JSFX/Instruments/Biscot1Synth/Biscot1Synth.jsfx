slider163:0<-1,1,0.001>LFO2 Op2 Level Depth
slider164:0<-1,1,0.001>LFO2 Op3 Level Depth
slider165:0<-1,1,0.001>LFO2 Op1 Pan Depth
slider166:0<-1,1,0.001>LFO2 Op2 Pan Depth
slider167:0<-1,1,0.001>LFO2 Op3 Pan Depth
slider168:0<0,1,1{Free,Trigger}>LFO3 Mode
slider169:1<0.125,512,0.125>LFO3 Rate
slider170:1<0,6,1{Sine,Triangle,Saw Up,Saw Down,Square,Sample Hold,Smooth Random}>LFO3 Wave
slider171:0<0,1,0.01>LFO3 Upper Squash
slider172:0<0,1,0.01>LFO3 Lower Squash
slider173:0<0,10,0.001>LFO3 Delay
slider174:0<0,1,0.001>LFO3 Smooth
slider175:0<0,1,1{Off,On}>LFO3 One Shot
slider176:1<0,1,0.001>LFO3 One Shot Length
slider177:0<0,1,0.001>LFO3 Phase
slider178:0<-1,1,0.001>LFO3 Cutoff Depth
slider179:0<-96,96,0.01>LFO3 Op1 Pitch Depth
slider180:0<-96,96,0.01>LFO3 Op2 Pitch Depth
slider181:0<-96,96,0.01>LFO3 Op3 Pitch Depth
slider182:0<-1.5,1.5,0.001>LFO3 Op1 PWM Depth
slider183:0<-1.5,1.5,0.001>LFO3 Op2 PWM Depth
slider184:0<-1.5,1.5,0.001>LFO3 Op3 PWM Depth
slider185:0<-1,1,0.001>LFO3 Op1 Level Depth
slider186:0<-1,1,0.001>LFO3 Op2 Level Depth
slider187:0<-1,1,0.001>LFO3 Op3 Level Depth
slider188:0<-1,1,0.001>LFO3 Op1 Pan Depth
slider189:0<-1,1,0.001>LFO3 Op2 Pan Depth
slider190:0<-1,1,0.001>LFO3 Op3 Pan Depth
@init
// This instrument produces exact silence from silence. Ask REAPER to detect the real
// output tail automatically, then allow host-side auto-bypass once the state settles.
// -1 is the documented automatic-tail mode; unlike -2 it does NOT claim zero state/tail.
ext_tail_size = -1;
// There is no audio input (in_pin:none), so input anti-denormal noise is unnecessary
// and can only make exact-silence detection less clean.
ext_nodenorm = 1;

two_pi = 2*$pi;
inv_srate = 1 / srate;
log2 = log(2);

mono_output_fast_safe = 1;
op1_note = -1; op2_note = -1; op3_note = -1;
op1_target_note = -1; op2_target_note = -1; op3_target_note = -1;
op1_cur_note = -1; op2_cur_note = -1; op3_cur_note = -1;
op1_held_count = 0; op2_held_count = 0; op3_held_count = 0; chord_arp_count = 0;
// Chord Allocate Poly 2: fixed rotating operator registers.
filter_held_count = 0;
op1_stack = 1000; op2_stack = 1040; op3_stack = 1080; filter_stack = 1120; chord_arp_stack = 1160;
op1_arp_pool = 1200; op2_arp_pool = 1340; op3_arp_pool = 1480; arp_tmp = 1620;
op1_arp_latch = 2300; op2_arp_latch = 2440; op3_arp_latch = 2580;
op1_sid_seq = 2800; op2_sid_seq = 3060; op3_sid_seq = 3320; // 128 active + 128 shadow slots each
op1_arp_latch_count = 0; op2_arp_latch_count = 0; op3_arp_latch_count = 0;
op1_arp_latch_root = 60; op2_arp_latch_root = 60; op3_arp_latch_root = 60;
op1_arp_release_base = 60; op2_arp_release_base = 60; op3_arp_release_base = 60;
// SID Seq is a dynamic-length frequency sequence: 128 max capacity, actual length grows as notes are added.
sid_seq_empty = -9999;
op1_arp_clock = 0; op2_arp_clock = 0; op3_arp_clock = 0;
op1_arp_step_idx = -1; op2_arp_step_idx = -1; op3_arp_step_idx = -1;
op1_arp_pitch_semi = 0; op2_arp_pitch_semi = 0; op3_arp_pitch_semi = 0;
op1_arp_pitch_tgt = 0; op2_arp_pitch_tgt = 0; op3_arp_pitch_tgt = 0;
op1_arp_pitch_cur = 0; op2_arp_pitch_cur = 0; op3_arp_pitch_cur = 0;
op1_arp_seed = 101; op2_arp_seed = 202; op3_arp_seed = 303;
op1_sid_seq_last = -1; op2_sid_seq_last = -1; op3_sid_seq_last = -1;
op1_sid_seq_len = 0; op2_sid_seq_len = 0; op3_sid_seq_len = 0;
i = 0;
loop(128,
  op1_sid_seq[i] = sid_seq_empty; op1_sid_seq[128 + i] = sid_seq_empty;
  op2_sid_seq[i] = sid_seq_empty; op2_sid_seq[128 + i] = sid_seq_empty;
  op3_sid_seq[i] = sid_seq_empty; op3_sid_seq[128 + i] = sid_seq_empty;
  i += 1;
);
op1_gate = 0; op2_gate = 0; op3_gate = 0;
op1_bend = 0; op2_bend = 0; op3_bend = 0;
op1_env = 0; op2_env = 0; op3_env = 0;
// Keep each release coefficient fixed from the exact Note Off.
op1_rel_latched = 1; op2_rel_latched = 1; op3_rel_latched = 1;
op1_mod_rel_latched = 1; op2_mod_rel_latched = 1; op3_mod_rel_latched = 1;
op1_stage = 0; op2_stage = 0; op3_stage = 0; // 0 idle, 1 attack, 2 decay, 3 sustain, 4 release
op1_mod_env = 0; op2_mod_env = 0; op3_mod_env = 0;
op1_mod_stage = 0; op2_mod_stage = 0; op3_mod_stage = 0; // independent pitch ADSR
op1_phase = 0; op2_phase = 0; op3_phase = 0;
op1_prevphase = 0; op2_prevphase = 0; op3_prevphase = 0;
op1_noise = 0; op2_noise = 0; op3_noise = 0;
op1_noise_clock = 0; op2_noise_clock = 0; op3_noise_clock = 0;
op1_seed = 1234567; op2_seed = 2345678; op3_seed = 3456789;
op1_sid_seed = 5930003; op2_sid_seed = 3592873; op3_sid_seed = 7281093;
filter_key_note = 60;
op3_mod_prev = 0;

lfo1_phase = 0; lfo2_phase = 0; lfo3_phase = 0;
lfo1_age = 2; lfo2_age = 2; lfo3_age = 2;
lfo1_delay_clock = 1000000; lfo2_delay_clock = 1000000; lfo3_delay_clock = 1000000;
lfo1_active = 1; lfo2_active = 1; lfo3_active = 1;
lfo1_out = 0; lfo2_out = 0; lfo3_out = 0;
lfo1_smooth_out = 0; lfo2_smooth_out = 0; lfo3_smooth_out = 0;
lfo1_sh = 0; lfo2_sh = 0; lfo3_sh = 0;
lfo1_seed = 7654321; lfo2_seed = 8765432; lfo3_seed = 9876543;

// Independent Note-On drift for the three operators.
// Each normalized value (-1..+1) is refreshed only when that operator receives a Note On.
drift1_unit = 0; drift2_unit = 0; drift3_unit = 0;
drift1_seed = 24681357; drift2_seed = 97531864; drift3_seed = 19283746;

filter_lp = 0;
filter_bp = 0;
filter_hp = 0;
filter_r4_body_lp = 0;
filter_env = 0;
filter_rel_latched = 1;
filter_stage = 0; // 0 idle, 1 attack, 2 decay, 3 sustain, 4 release

// SID/C64-style final analogue output state.
// One state for the summed stereo bus and one for each artificial multichannel bus.
out_lp_mix = 0; out_hp_x_mix = 0; out_hp_y_mix = 0;
out_lp_op1 = 0; out_hp_x_op1 = 0; out_hp_y_op1 = 0;
out_lp_op2 = 0; out_hp_x_op2 = 0; out_hp_y_op2 = 0;
out_lp_op3 = 0; out_hp_x_op3 = 0; out_hp_y_op3 = 0;
out_lp_filter = 0; out_hp_x_filter = 0; out_hp_y_filter = 0;

// -------------------- TRUE BAND-LIMITED OSCILLATOR TABLES --------------------
// Ten mip levels contain 1,2,4,...512 harmonics. They are built once at @init.
// At run time an oscillator only reads/interpolates the table whose highest harmonic
// stays below 45% of sample rate. No oscillator oversampling is required for normal waves.
aa_tbl_n = 2048;
aa_tbl_stride = aa_tbl_n + 1;
aa_tbl_levels = 10;
aa_saw_base = 10000;
aa_tri_base = aa_saw_base + aa_tbl_stride * aa_tbl_levels;
aa_square_base = aa_tri_base + aa_tbl_stride * aa_tbl_levels;

aa_i = 0;
loop(aa_tbl_n + 1,
  aa_ph = aa_i / aa_tbl_n;
  aa_saw_sum = 0;
  aa_tri_sum = 0;
  aa_h = 1;
  aa_target = 1;
  aa_lev = 0;
  loop(512,
    aa_ang = two_pi * aa_h * aa_ph;
    aa_saw_sum += sin(aa_ang) / aa_h;
    (aa_h % 2) == 1 ? aa_tri_sum += cos(aa_ang) / (aa_h * aa_h);
    aa_h == aa_target ? (
      aa_saw_base[aa_lev * aa_tbl_stride + aa_i] = (-2 / $pi) * aa_saw_sum;
      aa_tri_base[aa_lev * aa_tbl_stride + aa_i] = (-8 / ($pi * $pi)) * aa_tri_sum;
      aa_lev += 1;
      aa_target *= 2;
    );
    aa_h += 1;
  );
  aa_i += 1;
);

// Precompute the exact 50% Pulse/Square result produced by the current two-Saw
// construction. Because a half-cycle is exactly 1024 samples in a 2048 table,
// linear interpolation of this difference is algebraically the same waveform while
// requiring one table read instead of two at run time.
aa_lev = 0;
loop(aa_tbl_levels,
  aa_b = aa_saw_base + aa_lev * aa_tbl_stride;
  aa_sq_b = aa_square_base + aa_lev * aa_tbl_stride;
  aa_i = 0;
  loop(aa_tbl_n + 1,
    aa_shift_i = aa_i + aa_tbl_n * 0.5;
    aa_shift_i >= aa_tbl_n ? aa_shift_i -= aa_tbl_n;
    aa_sq_b[aa_i] = aa_b[aa_shift_i] - aa_b[aa_i];
    aa_i += 1;
  );
  aa_lev += 1;
);

function note_hz(note) (
  440 * exp(log2 * ((note - 69) / 12));
);

function softclip(x) local(ax) (
  ax = abs(x);
  x / (1 + ax);
);

// Final SID output amplifier. Deliberately subtle: the filter/oscillator models
// retain their character, while the last stage contributes a small analogue
// asymmetry and peak rounding before the external RC network.
function sid_output_amp(x) local(z, drive, clipped) (
  // Model constants are cached in @slider. This function is called twice in
  // Stereo and up to ten times in Multichannel, so avoid resolving the model here.
  z = x + sid_amp_bias_cached;
  drive = z >= 0 ? sid_amp_pos_drive_cached : sid_amp_neg_drive_cached;
  clipped = softclip(z * drive) / drive;
  (z * sid_amp_dry_cached + clipped * sid_amp_wet_cached) * sid_amp_makeup_cached;
);

function poly_blep(t, dt)
local(x) (
  dt = max(0.0000001, min(0.5, dt));
  t < dt ? (
    x = t / dt;
    x + x - x * x - 1;
  ) : (
    t > 1 - dt ? (
      x = (t - 1) / dt;
      x * x + x + x + 1;
    ) : 0;
  );
);

function wrap01(x) (
  x -= floor(x);
  x < 0 ? x += 1;
  x;
);

// Pick the richest mip that still leaves a 10% guard band below Nyquist.
// Hmax ~= 0.45/inc, quantized downward to powers of two. Pure comparisons keep this cheap.
function aa_mip_level(inc) (
  inc <= 0.00087890625 ? 9 :
  inc <= 0.00175781250 ? 8 :
  inc <= 0.00351562500 ? 7 :
  inc <= 0.00703125000 ? 6 :
  inc <= 0.01406250000 ? 5 :
  inc <= 0.02812500000 ? 4 :
  inc <= 0.05625000000 ? 3 :
  inc <= 0.11250000000 ? 2 :
  inc <= 0.22500000000 ? 1 : 0;
);

// Fast table read for phases already guaranteed in [0,1). Oscillator accumulators
// are wrapped before osc_wave(), so paying another wrap/floor here is redundant.
function aa_tbl_read01(base, lev, ph)
local(pos, idx, frac, b) (
  b = base + lev * aa_tbl_stride;
  pos = ph * aa_tbl_n;
  idx = floor(pos);
  frac = pos - idx;
  b[idx] + (b[idx + 1] - b[idx]) * frac;
);

function aa_wt_saw_lev(ph, lev) (
  aa_tbl_read01(aa_saw_base, lev, ph);
);

function aa_wt_tri_lev(ph, lev) (
  aa_tbl_read01(aa_tri_base, lev, ph);
);

function aa_wt_pulse_lev(ph, pw, lev)
local(a, b, p2) (
  pw = max(0.0002, min(0.9998, pw));
  pw == 0.5 ? (
    // Dedicated 50% Square mip: one interpolation instead of two Saw reads.
    aa_tbl_read01(aa_square_base, lev, ph);
  ) : (
    p2 = ph - pw;
    p2 < 0 ? p2 += 1;
    a = aa_tbl_read01(aa_saw_base, lev, p2);
    b = aa_tbl_read01(aa_saw_base, lev, ph);
    a - b + 2 * pw - 1;
  );
);

function blep_saw(ph, dt)
local(v) (
  v = 2 * ph - 1;
  v -= poly_blep(ph, dt);
  max(-1, min(1, v));
);

function blep_pulse(ph, pw, dt)
local(v, t2) (
  pw = max(0.0002, min(0.9998, pw));
  v = ph < pw ? 1 : -1;
  v += poly_blep(ph, dt);
  t2 = wrap01(ph - pw);
  v -= poly_blep(t2, dt);
  max(-1, min(1, v));
);

function blep_ring_sign(ph, dt)
local(v, t2) (
  // +1 for the first half-cycle, -1 for the second half-cycle.
  // This is the SID ring source MSB, but with band-limited edges.
  v = ph < 0.5 ? 1 : -1;
  v += poly_blep(ph, dt);
  t2 = wrap01(ph - 0.5);
  v -= poly_blep(t2, dt);
  max(-1, min(1, v));
);

function aa_energy_comp(inc, wave, ring_on, sync_on, osf, aa_on)
local(x, c, edge_bonus) (
  // BLEP removes the ugly foldback, but on this deliberately low-fi SID core
  // it can also make the top register feel too small. This is not a hi-fi EQ;
  // it is a small oscillator-level make-up that grows only when the increment is high.
  aa_on ? (
    x = min(1, max(0, inc * 14));
    edge_bonus = 0;
    (wave == 1 || wave == 2 || wave == 6 || wave == 7) ? edge_bonus += 0.16; // saw/pulse-heavy
    ring_on ? edge_bonus += 0.28;
    sync_on ? edge_bonus += 0.14;
    c = 1 + x * (0.16 + edge_bonus);
    osf >= 8 ? c *= 1.035;
    osf >= 16 ? c *= 1.025;
    min(1.85, c);
  ) : 1;
);


function next_noise(seed*) (
  seed = (seed * 1103515245 + 12345) % 2147483647;
  (seed / 1073741823.5) - 1;
);

function bit_at(v, b) (
  floor(v / (2 ^ b)) % 2;
);

function next_sid23_noise(seed*)
local(bit17, bit22, fb, out) (
  // SID-style noise core: a 23-bit Fibonacci LFSR using taps 17 and 22.
  // The audible byte is assembled from selected register bits, like the SID noise DAC path.
  // Keep state non-zero so it cannot lock up silently.
  seed = floor(seed) % 8388608;
  seed <= 0 ? seed = 8388607;
  bit17 = bit_at(seed, 17);
  bit22 = bit_at(seed, 22);
  fb = (bit17 + bit22) % 2;
  seed = (seed * 2) % 8388608 + fb;

  out = bit_at(seed, 22) * 128 + bit_at(seed, 20) * 64 + bit_at(seed, 16) * 32 + bit_at(seed, 13) * 16 + bit_at(seed, 11) * 8 + bit_at(seed, 7) * 4 + bit_at(seed, 4) * 2 + bit_at(seed, 2);

  (out / 127.5) - 1;
);

function next_noise_blend(seed*, sid_seed*, sid_amt)
local(clean, sidv, a) (
  // Noise Character: 0 is the previous clean core; 1 is the SID 23-bit LFSR color.
  // The two states are kept separate, so Character 0 stays exactly like the older synth.
  a = max(0, min(1, sid_amt));
  a <= 0 ? (
    next_noise(seed);
  ) : (
    clean = next_noise(seed);
    sidv = next_sid23_noise(sid_seed);
    clean * (1 - a) + sidv * a;
  );
);

function held_add(base, count*, note)
local(i) (
  // Do not collapse duplicate Note On events.
  // Some keyboards, arpeggiators and REAPER MIDI items can send the same pitch again
  // before the previous Note Off. If duplicates are ignored, the first Note Off
  // releases the voice even though a second gate is still physically held.
  count >= 16 ? (
    // Small deterministic overflow guard: keep the newest 15 notes, drop the oldest.
    i = 0;
    loop(15,
      base[i] = base[i + 1];
      i += 1;
    );
    count = 15;
  );
  base[count] = note;
  count += 1;
);

function held_remove(base, count*, note)
local(i, j, found) (
  // Remove the newest matching note. This preserves the stack order better for legato return
  // and handles repeated same-note gates safely.
  found = -1;
  i = 0;
  loop(count,
    base[i] == note ? found = i;
    i += 1;
  );
  found >= 0 ? (
    j = found;
    loop(count - found - 1,
      base[j] = base[j + 1];
      j += 1;
    );
    count -= 1;
  );
);

function held_top(base, count) (
  count > 0 ? base[count - 1] : -1;
);

function arp_latch_copy(src, count, dst, latch_count*, latch_root*)
local(i) (
  latch_count = 0;
  count > 0 ? (
    // ARP root is the first note that started the current arp phrase.
    // New note-ons may extend the pool, but they must not instantly transpose
    // the oscillator outside the arp clock.
    latch_root = src[0];
    i = 0;
    loop(min(32, count),
      dst[i] = src[i];
      latch_count += 1;
      i += 1;
    );
  );
);

function arp_latch_clear(latch_count*) (
  latch_count = 0;
);

function arp_build_pool(base, count, pool, mode, oct_up, oct_down)
local(i, j, n, exists, src_count, swap, pool_count, octv, lin_count) (
  // Build a frequency-arpeggio note pool from the notes that are already held.
  // This is deliberately NOT MIDI Note On arpeggiation: it only later offsets oscillator frequency.
  mode = floor(mode + 0.5);
  oct_up = max(0, floor(oct_up + 0.5));
  oct_down = abs(min(0, floor(oct_down + 0.5)));

  // Unique notes for musical ARP pools. The held stack itself still keeps duplicates
  // for correct gate/note-off behavior, but the ARP should not double-step a duplicate note.
  src_count = 0;
  i = 0;
  loop(count,
    n = base[i];
    exists = 0;
    j = 0;
    loop(src_count,
      arp_tmp[j] == n ? exists = 1;
      j += 1;
    );
    (!exists && src_count < 16) ? (
      arp_tmp[src_count] = n;        // sorted workspace
      arp_tmp[32 + src_count] = n;   // original held order workspace
      src_count += 1;
    );
    i += 1;
  );

  // Sort ascending for UP/DOWN/PENDULUM/RANDOM. Held Order uses arp_tmp[32..].
  i = 0;
  loop(max(0, src_count - 1),
    j = i + 1;
    loop(src_count - i - 1,
      arp_tmp[j] < arp_tmp[i] ? (
        swap = arp_tmp[i];
        arp_tmp[i] = arp_tmp[j];
        arp_tmp[j] = swap;
      );
      j += 1;
    );
    i += 1;
  );

  pool_count = 0;

  src_count > 0 ? (
    // 2 = Up
    mode == 2 ? (
      octv = -oct_down;
      loop(oct_up + oct_down + 1,
        i = 0;
        loop(src_count,
          pool_count < 128 ? (pool[pool_count] = arp_tmp[i] + octv * 12; pool_count += 1;);
          i += 1;
        );
        octv += 1;
      );
    );

    // 3 = Down
    mode == 3 ? (
      octv = oct_up;
      loop(oct_up + oct_down + 1,
        i = src_count - 1;
        loop(src_count,
          pool_count < 128 ? (pool[pool_count] = arp_tmp[i] + octv * 12; pool_count += 1;);
          i -= 1;
        );
        octv -= 1;
      );
    );

    // 4 = Pendulum, without repeating the two end points on the way back.
    mode == 4 ? (
      lin_count = 0;
      octv = -oct_down;
      loop(oct_up + oct_down + 1,
        i = 0;
        loop(src_count,
          lin_count < 128 ? (arp_tmp[64 + lin_count] = arp_tmp[i] + octv * 12; lin_count += 1;);
          i += 1;
        );
        octv += 1;
      );

      lin_count <= 1 ? (
        pool_count = lin_count;
        lin_count > 0 ? pool[0] = arp_tmp[64];
      ) : (
        i = 0;
        loop(lin_count,
          pool[pool_count] = arp_tmp[64 + i]; pool_count += 1; i += 1;
        );
        i = lin_count - 2;
        loop(max(0, lin_count - 2),
          pool_count < 128 ? (pool[pool_count] = arp_tmp[64 + i]; pool_count += 1;);
          i -= 1;
        );
      );
    );

    // 5 = Held Order: LSH-2 ARP2 Free/Input Order, not sorted.
    mode == 5 ? (
      octv = -oct_down;
      loop(oct_up + oct_down + 1,
        i = 0;
        loop(src_count,
          pool_count < 128 ? (pool[pool_count] = arp_tmp[32 + i] + octv * 12; pool_count += 1;);
          i += 1;
        );
        octv += 1;
      );
    );

    // 6 = Random uses the same pool shape as Up; selection is random in arp_process().
    mode == 6 ? (
      octv = -oct_down;
      loop(oct_up + oct_down + 1,
        i = 0;
        loop(src_count,
          pool_count < 128 ? (pool[pool_count] = arp_tmp[i] + octv * 12; pool_count += 1;);
          i += 1;
        );
        octv += 1;
      );
    );
  );

  pool_count;
);


function sid_seq_clear(seq, root_note, seq_len*)
local(i) (
  i = 0;
  loop(128,
    seq[i] = sid_seq_empty;
    seq[128 + i] = sid_seq_empty;
    i += 1;
  );
  seq_len = 0;
  root_note >= 0 ? (
    seq[0] = root_note;
    seq[128] = root_note;
    seq_len = 1;
  );
);

function sid_seq_record(seq, step_idx, note, seq_len*)
local(pos, i) (
  // Dynamic SID-player sequence. 128 is the maximum capacity, not the playback length.
  // A new key is inserted just after the current clock step. If that point is ahead,
  // it can sound in the current loop; if it has just passed, it arrives at the next pass.
  seq_len <= 0 ? (
    seq[0] = note;
    seq[128] = note;
    seq_len = 1;
  ) : (
    seq_len < 128 ? (
      pos = step_idx < 0 ? 0 : step_idx + 1;
      pos < 0 ? pos = 0;
      pos > seq_len ? pos = seq_len;

      // Insert, not append-only: the note is placed at the musical clock position.
      i = seq_len;
      loop(seq_len - pos,
        seq[i] = seq[i - 1];
        seq[128 + i] = seq[128 + i - 1];
        i -= 1;
      );
      seq[pos] = note;
      seq[128 + pos] = note;
      seq_len += 1;
    ) : (
      pos = step_idx < 0 ? 0 : step_idx + 1;
      pos >= 128 ? pos = 0;
      pos = max(0, min(127, floor(pos + 0.5)));
      seq[pos] = note;
      seq[128 + pos] = note;
    );
  );
);

function sid_seq_process(seq, seq_len, count, root_note, rate, clock*, step_idx*, pitch_semi*)
local(new_step, sel) (
  count > 0 && root_note >= 0 && seq_len > 0 ? (
    clock += max(0.125, rate) * spb4_inv;
    new_step = 0;

    step_idx < 0 ? (
      step_idx = 0;
      clock = 0;
      new_step = 1;
    ) : (
      clock >= 1 ? (
        clock -= floor(clock);
        step_idx += 1;
        step_idx >= seq_len ? step_idx = 0;
        new_step = 1;
      );
    );

    new_step ? (
      step_idx >= seq_len ? step_idx = 0;
      sel = seq[step_idx];
      sel <= sid_seq_empty + 1 ? sel = root_note;
      pitch_semi = sel - root_note;
    );
  ) : (
    clock = 0;
    step_idx = -1;
    pitch_semi = 0;
  );

  pitch_semi;
);

function arp_process(base, count, pool, mode, rate, oct_up, oct_down, clock*, step_idx*, pitch_semi*, rand_seed*)
local(pool_count, new_step, root, sel, rv, rand_idx) (
  mode = floor(mode + 0.5);

  (mode > 1 && count > 0) ? (
    clock += max(0.125, rate) * spb4_inv;
    new_step = 0;

    step_idx < 0 ? (
      clock = 0;
      new_step = 1;
    ) : (
      clock >= 1 ? (
        clock -= floor(clock);
        new_step = 1;
      );
    );

    // The pool can only affect the selected pitch at a clock edge. Rebuilding
    // and sorting it between edges was pure repeated work.
    new_step ? (
      pool_count = arp_build_pool(base, count, pool, mode, oct_up, oct_down);
      root = base[0];

      pool_count > 0 ? (
        step_idx += 1;
        step_idx >= pool_count ? step_idx = 0;
        step_idx < 0 ? step_idx = 0;

        mode == 6 ? (
          rand_seed += 1;
          rv = abs(sin(rand_seed * 12.9898 + 78.233) * 43758.5453);
          rv -= floor(rv);
          rand_idx = floor(rv * pool_count);
          rand_idx >= pool_count ? rand_idx = pool_count - 1;
          rand_idx < 0 ? rand_idx = 0;
          sel = pool[rand_idx];
        ) : (
          sel = pool[step_idx];
        );

        pitch_semi = sel - root;
      ) : (
        clock = 0;
        step_idx = -1;
        pitch_semi = 0;
      );
    );
  ) : (
    clock = 0;
    step_idx = -1;
    pitch_semi = 0;
  );

  pitch_semi;
);

function arp_reset_op1() (
  op1_arp_clock = 0;
  op1_arp_step_idx = -1;
  op1_arp_pitch_semi = 0;
  op1_arp_pitch_tgt = 0;
  op1_arp_pitch_cur = 0;
  op1_sid_seq_last = -1;
);
function arp_reset_op2() (
  op2_arp_clock = 0;
  op2_arp_step_idx = -1;
  op2_arp_pitch_semi = 0;
  op2_arp_pitch_tgt = 0;
  op2_arp_pitch_cur = 0;
  op2_sid_seq_last = -1;
);
function arp_reset_op3() (
  op3_arp_clock = 0;
  op3_arp_step_idx = -1;
  op3_arp_pitch_semi = 0;
  op3_arp_pitch_tgt = 0;
  op3_arp_pitch_cur = 0;
  op3_sid_seq_last = -1;
);


function sid_dac_and2(a, b)
local(ia, ib, io) (
  // SID docs describe simultaneous non-noise waveforms as a logical AND.
  // This is an 8-bit DAC approximation: unipolar DAC values are ANDed,
  // then converted back to the synth's bipolar audio range.
  ia = floor(max(0, min(255, (a + 1) * 127.5)) + 0.5);
  ib = floor(max(0, min(255, (b + 1) * 127.5)) + 0.5);
  io = ia & ib;
  (io / 127.5) - 1;
);

function sid_dac_and3(a, b, c)
local(ia, ib, ic, io) (
  ia = floor(max(0, min(255, (a + 1) * 127.5)) + 0.5);
  ib = floor(max(0, min(255, (b + 1) * 127.5)) + 0.5);
  ic = floor(max(0, min(255, (c + 1) * 127.5)) + 0.5);
  io = ia & ib & ic;
  (io / 127.5) - 1;
);


// Continuous SID-style AND for the band-limited combined-wave path.
// In unipolar DAC space, multiplication is the smooth analogue of a logical AND.
// Unlike the 8-bit integer AND it creates no sample-scale staircase by itself.
function sid_aa_and2(a, b)
local(ua, ub) (
  ua = (a + 1) * 0.5;
  ub = (b + 1) * 0.5;
  2 * (ua * ub) - 1;
);

function sid_aa_and3(a, b, c)
local(ua, ub, uc) (
  ua = (a + 1) * 0.5;
  ub = (b + 1) * 0.5;
  uc = (c + 1) * 0.5;
  2 * (ua * ub * uc) - 1;
);

// Alias-controlled combined SID waves.
// The source tables are deliberately read with extra spectral headroom in osc_wave:
// 2-way combinations get about half the primitive bandwidth, the 3-way combination
// gets about one quarter. Therefore the polynomial interaction products remain below
// Nyquist without running the whole oscillator at a higher sample rate.
// No quantizer, hard clip or waveshaper is used here: each of those would generate a
// fresh unlimited harmonic series after the mip-map had already done its job.
// Analytic mean of the AA combined-wave equations. The primitive Saw/Triangle are
// zero-mean and Pulse has mean (2*pw-1). Removing this mean BEFORE the shared +3/+4 dB
// makeup prevents two/three-note chords from stacking a large negative DC bias into the
// SID output saturation. This changes only the waveform baseline, not its AC shape.
function sid_combo5_dc(pw, model)
local(d, dc) (
  d = max(0.0002, min(0.9998, pw));
  // Triangle changes slope at half-cycle, so its pulse-gated mean is piecewise quadratic.
  // This is the exact analytic mean of the current AA Triangle+Pulse equations, before
  // the shared +3 dB composite makeup. Horner form keeps the runtime cost tiny.
  model >= 1 ? (
    d <= 0.5 ?
      dc = (1.831168 * d - 0.030912) * d - 0.884672 :
      dc = (-1.831168 * d + 3.631424) * d - 1.800256;
  ) : (
    d <= 0.5 ?
      dc = (1.969408 * d - 0.00677376) * d - 0.97793024 :
      dc = (-1.969408 * d + 3.93204224) * d - 1.96263424;
  );
  dc;
);

function sid_combo6_dc(pw, model)
local(d, dc) (
  d = max(0.0002, min(0.9998, pw));
  // Horner form: two multiplies in the steady-state path.
  model >= 1 ?
    dc = (1.062864 * d - 0.200304) * d - 0.86256 :
    dc = (0.984704 * d - 0.00620928) * d - 0.97849472;
  dc;
);

function sid_combo7_dc(pw, model)
local(d, dc) (
  d = max(0.0002, min(0.9998, pw));
  // Piecewise cubic because Triangle changes slope at half-cycle. Horner form keeps
  // the correction cheap enough to use even when PWM is moving at audio rate.
  model >= 1 ? (
    d <= 0.5 ?
      dc = ((1.0602368 * d + 0.1295952) * d + 0.0545664) * d - 0.8361024 :
      dc = ((-1.0602368 * d + 1.5835344) * d + 0.1909824) * d - 1.002736;
  ) : (
    d <= 0.5 ?
      dc = ((1.17512533333333 * d + 0.095316) * d - 0.0063544) * d - 0.9385336 :
      dc = ((-1.17512533333333 * d + 1.730916) * d + 0.1207336) * d - 1.11719626666667;
  );
  dc;
);

function sid_combo_wave_aa(wave, tri, saw, pul, pw, model)
local(andv, analog, gate, out, pull) (
  wave == 4 ? ( // Triangle + Saw: zero-DC band-limited blend, maximum polynomial order 2
    // The previous continuous unipolar AND strongly reintroduced the triangle and a large
    // negative DC term, so Triangle+Saw sounded almost like Triangle and could click while
    // the output HP removed the offset. Keep the combination explicitly zero-mean instead:
    // direct Saw supplies the missing edge/brightness, Triangle keeps SID body, and the
    // small bipolar product adds combined-wave character without creating unlimited spectrum.
    model >= 1 ? (
      // 6581: a little more body/nonlinear interaction, still clearly Saw-bearing.
      out = 0.45 * tri + 0.55 * saw + 0.34 * tri * saw;
    ) : (
      // 8580: cleaner/brighter combined wave with stronger direct Saw contribution.
      out = 0.40 * tri + 0.60 * saw + 0.28 * tri * saw;
    );
  );

  wave == 5 ? ( // Triangle + Pulse: maximum polynomial order 2
    andv = sid_aa_and2(tri, pul);
    gate = (pul + 1) * 0.5;
    model >= 1 ? (
      pull = gate * tri + (1 - gate) * (-0.72 + 0.16 * tri);
      analog = 0.52 * andv + 0.56 * pull;
      out = andv * 0.50 + analog * 0.50;
      out *= 0.92;
    ) : (
      pull = gate * tri + (1 - gate) * -0.88;
      analog = 0.78 * andv + 0.24 * pull;
      out = andv * 0.76 + analog * 0.24;
      out *= 0.98;
    );
  );

  wave == 6 ? ( // Saw + Pulse: maximum polynomial order 2
    andv = sid_aa_and2(saw, pul);
    gate = (pul + 1) * 0.5;
    model >= 1 ? (
      pull = gate * saw + (1 - gate) * (-0.70 + 0.12 * saw);
      analog = 0.50 * andv + 0.60 * pull + 0.16 * saw * pul;
      out = andv * 0.48 + analog * 0.52;
      out *= 0.90;
    ) : (
      pull = gate * saw + (1 - gate) * -0.88;
      analog = 0.80 * andv + 0.22 * pull;
      out = andv * 0.76 + analog * 0.24;
      out *= 0.98;
    );
  );

  wave == 7 ? ( // Triangle + Saw + Pulse: maximum polynomial order 3
    andv = sid_aa_and3(tri, saw, pul);
    gate = (pul + 1) * 0.5;
    model >= 1 ? (
      pull = gate * (0.50 * tri + 0.50 * saw + 0.32 * tri * saw) + (1 - gate) * (-0.76 + 0.08 * tri);
      analog = 0.46 * andv + 0.70 * pull;
      out = andv * 0.42 + analog * 0.58;
      out *= 0.84;
    ) : (
      pull = gate * (0.50 * tri + 0.50 * saw) + (1 - gate) * -0.90;
      analog = 0.76 * andv + 0.26 * pull;
      out = andv * 0.74 + analog * 0.26;
      out *= 0.94;
    );
  );

  // Pulse-bearing AA composites can carry a same-sign negative DC offset. Waves 6/7
  // were the severe cases fixed in v2.27; Triangle+Pulse (5) has the same mechanism at
  // lower magnitude and can still make multi-note chords drive sid_output_amp() early.
  // Center the analytic mean BEFORE level compensation; AC waveform shape is unchanged.
  wave == 5 ? out -= sid_combo5_dc(pw, model);
  wave == 6 ? out -= sid_combo6_dc(pw, model);
  wave == 7 ? out -= sid_combo7_dc(pw, model);

  // Same broad level matching as the historical SID path, but deliberately no clipping.
  out *= 1.412537545;
  wave == 4 ? out *= 1.258925412;
  (wave == 6 || wave == 7) ? out *= 1.584893192;
  out;
);

function sid_combo_wave(wave, tri, saw, pul, char_amt, model)
local(ch, andv, analog, gate, out, pull, levels, q) (
  ch = min(1, char_amt / 16);

  // Only the documented/useful SID combinations are kept here:
  // TRI+SAW, TRI+PULSE, SAW+PULSE, TRI+SAW+PULSE.
  // Noise combined with other waves is deliberately not offered because on the real SID
  // it can collapse/zero the noise LFSR and is more a special abuse than a normal voice color.
  wave == 4 ? ( // Triangle + Saw
    andv = sid_dac_and2(tri, saw);
    model >= 1 ? (
      analog = softclip((0.58 * andv + 0.30 * tri + 0.18 * saw + 0.40 * tri * saw) * (1 + 1.55 * ch));
      out = andv * (0.55 - 0.20 * ch) + analog * (0.45 + 0.20 * ch);
      out *= 0.88;
    ) : (
      analog = softclip((0.82 * andv + 0.14 * tri + 0.10 * saw + 0.18 * tri * saw) * (1 + 0.70 * ch));
      out = andv * (0.78 - 0.18 * ch) + analog * (0.22 + 0.18 * ch);
      out *= 0.96;
    );
  );

  wave == 5 ? ( // Triangle + Pulse
    andv = sid_dac_and2(tri, pul);
    gate = (pul + 1) * 0.5;
    model >= 1 ? (
      // 6581 pulse mixes through the DAC bus and pulls the other waveform down.
      pull = gate * tri + (1 - gate) * (-0.72 + 0.16 * tri);
      analog = softclip((0.52 * andv + 0.56 * pull) * (1 + 1.35 * ch));
      out = andv * (0.50 - 0.15 * ch) + analog * (0.50 + 0.15 * ch);
      out *= 0.92;
    ) : (
      pull = gate * tri + (1 - gate) * -0.88;
      analog = softclip((0.78 * andv + 0.24 * pull) * (1 + 0.55 * ch));
      out = andv * (0.76 - 0.15 * ch) + analog * (0.24 + 0.15 * ch);
      out *= 0.98;
    );
  );

  wave == 6 ? ( // Saw + Pulse
    andv = sid_dac_and2(saw, pul);
    gate = (pul + 1) * 0.5;
    model >= 1 ? (
      pull = gate * saw + (1 - gate) * (-0.70 + 0.12 * saw);
      analog = softclip((0.50 * andv + 0.60 * pull + 0.16 * saw * pul) * (1 + 1.45 * ch));
      out = andv * (0.48 - 0.14 * ch) + analog * (0.52 + 0.14 * ch);
      out *= 0.90;
    ) : (
      pull = gate * saw + (1 - gate) * -0.88;
      analog = softclip((0.80 * andv + 0.22 * pull) * (1 + 0.55 * ch));
      out = andv * (0.76 - 0.15 * ch) + analog * (0.24 + 0.15 * ch);
      out *= 0.98;
    );
  );

  wave == 7 ? ( // Triangle + Saw + Pulse
    andv = sid_dac_and3(tri, saw, pul);
    gate = (pul + 1) * 0.5;
    model >= 1 ? (
      pull = gate * (0.50 * tri + 0.50 * saw + 0.32 * tri * saw) + (1 - gate) * (-0.76 + 0.08 * tri);
      analog = softclip((0.46 * andv + 0.70 * pull) * (1 + 1.75 * ch));
      out = andv * (0.42 - 0.12 * ch) + analog * (0.58 + 0.12 * ch);
      out *= 0.84;
    ) : (
      pull = gate * (0.50 * tri + 0.50 * saw) + (1 - gate) * -0.90;
      analog = softclip((0.76 * andv + 0.26 * pull) * (1 + 0.65 * ch));
      out = andv * (0.74 - 0.16 * ch) + analog * (0.26 + 0.16 * ch);
      out *= 0.94;
    );
  );

  // Composite waveforms are naturally lower after SID-style DAC AND/combo modelling;
  // retain the common +3 dB compensation used by the Core.
  out *= 1.412537545;

  // Core level matching: Wave 4 +2 dB, Waves 6 and 7 +4 dB.
  // Wave 5 keeps only the common compensation above.
  wave == 4 ? out *= 1.258925412;
  (wave == 6 || wave == 7) ? out *= 1.584893192;

  // Mild quantized DAC roughness only on combined waveforms when Character is used.
  char_amt > 0 ? (
    levels = max(8, floor(256 / (1 + char_amt * 0.55)));
    q = floor((out + 1) * 0.5 * (levels - 1) + 0.5) / (levels - 1);
    out = q * 2 - 1;
  );

  max(-1, min(1, out));
);

function osc_wave(wave, ph, inc, pw, n, char_amt, model, ring_on, ring_mod_phase, ring_mod_inc, aa_on, aa_lev)
local(tri_raw, tri, saw, pul, out, ch, levels, q, ring_sign, aa_dt, ring_dt, need_tri, need_saw, need_pul) (
  wave = max(0, min(7, wave));

  // A single SID waveform no longer pays for the other two components.
  // Combined waves still calculate exactly the same TRI/SAW/PULSE set.
  need_tri = (wave == 0 || wave == 4 || wave == 5 || wave == 7);
  need_saw = (wave == 1 || wave == 4 || wave == 6 || wave == 7);
  need_pul = (wave == 2 || wave == 5 || wave == 6 || wave == 7);

  // aa_lev is selected once per operator. Static pitches cache it at block rate;
  // dynamic pitches refresh it only when the frequency actually moves. Combined-wave
  // headroom (2x/4x source increment) is already included in that cached selection.

  need_tri ? (
    // With Auto and no Ring/Sync, read a genuinely band-limited triangle table.
    // Ring keeps the historical procedural path because multiplication by the modulator
    // creates new spectrum and is handled by the emergency oversampling path instead.
    (aa_wt_enable && !ring_on) ? (
      tri_raw = aa_wt_tri_lev(ph, aa_lev);
      tri = tri_raw;
    ) : (
      tri_raw = 1 - 4 * abs(ph - 0.5);
      ring_sign = ring_mod_phase < 0.5 ? 1 : -1;
      (aa_on && ring_on) ? (
        ring_dt = max(0.0000001, ring_mod_inc);
        ring_sign = blep_ring_sign(ring_mod_phase, ring_dt);
      );
      tri = ring_on ? (tri_raw * ring_sign) : tri_raw;
    );
  );

  (need_saw || need_pul) ? aa_dt = max(0.0000001, inc);
  need_saw ? (
    saw = aa_wt_enable ? aa_wt_saw_lev(ph, aa_lev) : (aa_on ? blep_saw(ph, aa_dt) : (2 * ph - 1));
  );
  need_pul ? (
    pul = aa_wt_enable ? aa_wt_pulse_lev(ph, pw, aa_lev) : (aa_on ? blep_pulse(ph, pw, aa_dt) : (ph < pw ? 1 : -1));
  );

  wave == 0 ? out = tri;
  wave == 1 ? out = saw;
  wave == 2 ? out = pul;
  wave == 3 ? out = n;
  wave >= 4 ? (
    aa_wt_enable ? out = sid_combo_wave_aa(wave, tri, saw, pul, pw, model)
                 : out = sid_combo_wave(wave, tri, saw, pul, char_amt, model);
  );

  // Character on single waves: unchanged, but normally bypassed in this synth.
  ch = min(1, char_amt / 16);
  (char_amt > 0 && wave < 4) ? (
    model >= 1 ? (
      out = softclip(out * (1 + 0.25 * ch));
    ) : (
      out = softclip(out * (1 + 0.10 * ch));
    );
    levels = max(16, floor(512 / (1 + char_amt * 0.25)));
    q = floor((out + 1) * 0.5 * (levels - 1) + 0.5) / (levels - 1);
    out = q * 2 - 1;
  );

  // Never hard-clip the band-limited primitive: Gibbs peaks are part of the
  // band-limited reconstruction and clipping them would generate fresh harmonics.
  // The complete mip-map path, including combined waves, must not be clipped here:
  // clipping would immediately recreate harmonics above Nyquist.
  (aa_wt_enable && wave != 3) ? out : max(-1, min(1, out));
);

function lfo_bpm_inc(rate)
local(bps) (
  // BPM-synced only: rate is cycles per 4/4 bar.
  // 1 = one bar, 4 = one beat, 8 = eighth, 16 = sixteenth.
  bps = max(1, tempo) / 60;
  (bps * max(0.125, rate) * 0.25) * inv_srate;
);

function lfo_smooth_coef(wave, smooth_amt)
local(w, smooth_time) (
  // Cached outside @sample. Smooth is applied to every wave; Smooth Random
  // keeps a minimum glide so it is not identical to raw Sample Hold.
  w = floor(wave + 0.5);
  smooth_amt = max(0, min(1, smooth_amt));
  w == 6 ? smooth_amt = max(smooth_amt, 0.12);
  smooth_amt <= 0 ? 1 : (
    smooth_time = 0.001 + smooth_amt * smooth_amt * 0.249;
    1 - exp(-1 / max(1, smooth_time * srate));
  );
);

function lfo_shape(ph, wave, sh)
local(w, x) (
  w = floor(wave + 0.5);
  w == 0 ? sin(two_pi * ph) :
  w == 1 ? (4 * abs(ph - 0.5) - 1) :
  w == 2 ? (ph * 2 - 1) :
  w == 3 ? (1 - ph * 2) :
  w == 4 ? (ph < 0.5 ? 1 : -1) :
  sh;
);

function lfo_trigger_one(phase*, age*, delay_clock*, active*, start_phase) (
  phase = start_phase - floor(start_phase);
  age = 0;
  delay_clock = 0;
  active = 1;
);

function lfo_note_trigger() (
  // Called only by an allowed note trigger. Op1 Mode Trigger decides whether
  // legato notes are allowed to restart phase/delay/one-shot.
  lfo1_delay_clock = 0; lfo2_delay_clock = 0; lfo3_delay_clock = 0;
  (slider122 >= 0.5 || slider129 >= 1) ? lfo_trigger_one(lfo1_phase, lfo1_age, lfo1_delay_clock, lfo1_active, slider131);
  (slider145 >= 0.5 || slider152 >= 1) ? lfo_trigger_one(lfo2_phase, lfo2_age, lfo2_delay_clock, lfo2_active, slider154);
  (slider168 >= 0.5 || slider175 >= 1) ? lfo_trigger_one(lfo3_phase, lfo3_age, lfo3_delay_clock, lfo3_active, slider177);
  lfo1_active = 1; lfo2_active = 1; lfo3_active = 1;
);

function lfo_process(phase*, age*, delay_clock*, active*, sh*, seed*, smooth_out*, mode, inc, wave, delay_sec, smooth_coef, one_shot, start_phase, one_shot_len)
local(raw, fade, w, inc_eff, prev_phase, len) (
  // CPU pass: inc and smooth_coef are cached outside @sample.
  // Delay is no longer a waiting timer: it fades modulation depth from 0 to 1.
  // One Shot Length is a fraction of the cycle: 1=full cycle, 0.5=half, 0.25=quarter.
  active < 0.5 && one_shot < 1 ? active = 1;

  active >= 0.5 ? (
    delay_clock += inv_srate;

    w = floor(wave + 0.5);
    inc_eff = inc; // S&H/Smooth Random use the same BPM phase rate as the other waves.

    prev_phase = phase;
    phase += inc_eff;
    phase >= 1 ? phase -= floor(phase);

    // S&H updates twice per normal LFO cycle: at half-cycle and wrap.
    (w == 5 || w == 6) ? (
      (phase < prev_phase || (prev_phase < 0.5 && phase >= 0.5)) ? (
        seed = (seed * 1103515245 + 12345) % 2147483647;
        sh = (seed / 1073741823.5) - 1;
      );
    ) : (
      phase < prev_phase ? (
        seed = (seed * 1103515245 + 12345) % 2147483647;
        sh = (seed / 1073741823.5) - 1;
      );
    );

    age += inc;
    len = max(0, min(1, one_shot_len));
    one_shot >= 1 && age >= len ? active = 0;
  );

  active >= 0.5 ? (
    raw = lfo_shape(phase, wave, sh);
    fade = delay_sec <= 0 ? 1 : min(1, delay_clock / max(0.000001, delay_sec));
    raw *= fade;
  ) : (
    raw = 0;
  );

  smooth_coef >= 1 ? (
    smooth_out = raw;
  ) : (
    smooth_out += (raw - smooth_out) * smooth_coef;
  );
  smooth_out;
);


function reset_op1() (
  op1_phase = 0; op1_prevphase = 0; op1_noise_clock = 0;
  op1_seed = (op1_seed + 33333) % 2147483647;
  op1_sid_seed = ((op1_sid_seed + 9029) % 8388608); op1_sid_seed <= 0 ? op1_sid_seed = 5930003;
  op1_noise = next_noise_blend(op1_seed, op1_sid_seed, slider9);
  slider4 >= 2 ? (op1_env = 0; op1_mod_env = 0;);
);

function reset_op2() (
  op2_phase = 0; op2_prevphase = 0; op2_noise_clock = 0;
  op2_seed = (op2_seed + 44444) % 2147483647;
  op2_sid_seed = ((op2_sid_seed + 13398) % 8388608); op2_sid_seed <= 0 ? op2_sid_seed = 3592873;
  op2_noise = next_noise_blend(op2_seed, op2_sid_seed, slider9);
  slider4 >= 2 ? (op2_env = 0; op2_mod_env = 0;);
);

function reset_op3() (
  op3_phase = 0; op3_prevphase = 0; op3_noise_clock = 0;
  op3_seed = (op3_seed + 55555) % 2147483647;
  op3_sid_seed = ((op3_sid_seed + 17767) % 8388608); op3_sid_seed <= 0 ? op3_sid_seed = 7281093;
  op3_noise = next_noise_blend(op3_seed, op3_sid_seed, slider9);
  slider4 >= 2 ? (op3_env = 0; op3_mod_env = 0;);
);


function note_on_op1(note, vel)
local(was_down, retrig, arp_on) (
  was_down = op1_held_count > 0;
  arp_on = slider76 > 0;
  drift1_unit = slider13 > 0 ? (rand(2) - 1) : 0;
  !was_down ? arp_latch_clear(op1_arp_latch_count);
  held_add(op1_stack, op1_held_count, note);
  // Keep a full live snapshot for release. Do it on note-on, not on final note-off,
  // otherwise the release latch collapses to the last released note only.
  arp_latch_copy(op1_stack, op1_held_count, op1_arp_latch, op1_arp_latch_count, op1_arp_latch_root);
  // In Chord Allocate the complete chord feeds all three SID Seq memories centrally
  // in chord_note_on(), so voice allocation must not record only the assigned note.
  slider76 == 1 && slider3 != 1 ? (
    !was_down ? sid_seq_clear(op1_sid_seq, note, op1_sid_seq_len)
              : sid_seq_record(op1_sid_seq, op1_arp_step_idx, note, op1_sid_seq_len);
  );

  // In ARP mode, note-on must only feed the arp material. It must not move
  // the oscillator pitch immediately. The pitch is changed only by arp_process()
  // on a clock step. On the first note of a phrase we initialize the base.
  (!arp_on || !was_down) ? (
    op1_arp_release_base = op1_arp_latch_root;
    op1_target_note = note;
    op1_cur_note < 0 ? op1_cur_note = note;
  );

  op1_note = note;
  op1_gate = vel / 127;
  retrig = arp_on ? !was_down : ((slider10 < 0.5) || !was_down);

  retrig ? (
    op1_stage = 1;
    op1_mod_stage = 1;
    // LSH-2 style: do not restart the arp clock when adding notes to an already running arp.
    !was_down ? arp_reset_op1();
    slider4 > 0 ? reset_op1();
  );
);

function note_on_op2(note, vel)
local(was_down, retrig, arp_on) (
  was_down = op2_held_count > 0;
  arp_on = slider77 > 0;
