  // otherwise the release latch collapses to the last released note only.
  arp_latch_copy(op2_stack, op2_held_count, op2_arp_latch, op2_arp_latch_count, op2_arp_latch_root);
  slider77 == 1 && slider3 != 1 ? (
    !was_down ? sid_seq_clear(op2_sid_seq, note, op2_sid_seq_len)
              : sid_seq_record(op2_sid_seq, op2_arp_step_idx, note, op2_sid_seq_len);
  );

  // In ARP mode, note-on must only feed the arp material. It must not move
