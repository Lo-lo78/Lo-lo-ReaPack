        v_active[i] ? v_os_dirty[i] = 1;
        i += 1;
      );
    ) : (
      drift_a = 0;
      drift_b = 0;
      drift_target_a = 0;
      drift_target_b = 0;
      drift_count_a = 1;
      drift_count_b = 1;
      drift_core_block = 0;
      drift_comb_block = 0;
      drift_pitch_cents_block = 0;
    );

    );

) : engine_now < 4.5 ? (

// Mallet Family MIDI path — only active while Engine = Mallet.
while(midirecv(ml_midi_ofs,ml_midi_msg1,ml_midi_msg23)) (
  ml_midi_status=ml_midi_msg1 & $xF0;
