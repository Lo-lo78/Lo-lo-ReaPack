local(wi_b)
(
  // Ocarina — complete user-approved FX Params snapshot.
  // All 26 banked Wind controls are written explicitly.
  wi_b=wi_WIN_BANK+5*wi_WIN_BANK_STRIDE;
  wi_b[0]=0; wi_b[1]=1; wi_b[2]=3.68; wi_b[3]=2; wi_b[4]=1;
  wi_b[5]=1.25; wi_b[6]=0.9; wi_b[7]=0; wi_b[8]=8780; wi_b[9]=1;
