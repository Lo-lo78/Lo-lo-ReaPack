              stereo_body(body_out, 3, v_key_gainL[3], v_key_gainR[3]);
              stereoL += stereo_tmpL;
              stereoR += stereo_tmpR;
            );
  
            v_phase[3] += phase_step;
            v_phase[3] >= twopi ? v_phase[3] -= twopi*floor(v_phase[3]*inv_twopi);
          );
  
          v_pick_env[3] > 0.00001 && step_pick_level > 0.000001 ? (
            pick_n = rand(2) - 1;
  
            v_pick_lp[3] += (pick_n - v_pick_lp[3]) * pick_lp_k;
            v_pick_dc[3] += (v_pick_lp[3] - v_pick_dc[3]) * pick_dc_k;
            pick_dark = v_pick_lp[3] - v_pick_dc[3];
            pick_edge = pick_n - v_pick_lp[3];
  
            pick_sig = pick_dark*pick_dark_mix + pick_edge*pick_edge_mix;
  
            pick_snap = max(0, (v_pick_env[3] - 0.72) / 0.28);
            pick_sig += pick_edge * pick_snap * pick_snap_mix;
  
            pick_out = pick_sig * v_pick_env[3] * v_pick_gain[3];
            out += pick_out;
            stereo_active ? (
              // Pick stays centered inside Stereo Fan but follows Keyboard Stereo.
              stereoL += pick_out * v_key_gainL[3];
              stereoR += pick_out * v_key_gainR[3];
            );
  
            v_pick_env[3] *= pick_decay_k;
          ) : v_pick_env[3] = 0;
          ); // full poly voice path
        );
  
      // ---- precompiled voice 4 ----
        v_active[4] ? (
          v_steady = v_stage[4] == 3
                  && !v_glide[4]
                  && !v_os_dirty[4]
                  && !vib_active
                  && step_steady_kernel
                  && (!step_finger_on || v_finger_stage[4] == 0)
                  && v_pick_env[4] == 0
                  // Silent held Strings voices must fall through once and self-release.
                  && !(sustain_level <= 0.00001 && v_env[4] <= 0.00001);
  
          v_steady ? (
            phase_step = v_phase_step[4];
            osc_out = render_rec_auto(v_phase[4], phase_step, 4, v_os[4]);
            body_out = osc_out * v_env[4] * v_vel[4];
            step_vel_tone_on ? body_out = apply_vel_tone(body_out, 4);
            out += body_out;
            stereo_active ? (
              stereo_body(body_out, 4, v_key_gainL[4], v_key_gainR[4]);
              stereoL += stereo_tmpL;
              stereoR += stereo_tmpR;
            );
            v_phase[4] += phase_step;
            v_phase[4] >= twopi ? v_phase[4] -= twopi*floor(v_phase[4]*inv_twopi);
          ) : (
          v_glide[4] ? (
            v_freq[4] += (v_target[4]-v_freq[4])*porta_k;
            abs(v_target[4]-v_freq[4]) <= max(0.000000000001, abs(v_target[4])*0.000000000001) ? (
              v_freq[4] = v_target[4];
              v_glide[4] = 0;
              v_os_dirty[4] = 1;
            );
          );
  
          step_attack_dynamic ? v_exc[4] += (0-v_exc[4])*attack_timbre_k;
          step_tension_on ? v_tension[4] += (0-v_tension[4])*tension_k;
  
          step_finger_on ? (
            v_finger_stage[4] == 1 ? (
              v_finger[4] += (1-v_finger[4])*finger_rise_k;
              v_finger[4] >= 0.999 ? (v_finger[4] = 1; v_finger_stage[4] = 2;);
            ) : v_finger_stage[4] == 2 ? (
              v_finger[4] += (0-v_finger[4])*finger_return_k;
              v_finger[4] <= 0.00001 ? (
                v_finger[4] = 0;
                v_finger_stage[4] = 0;
                v_os_dirty[4] = 1;
              );
            );
          );
  
          v_stage[4] == 1 ? (
            v_env[4] += (1-v_env[4])*atk_k;
            v_env[4] >= 0.9995 ? (
              v_env[4] = 1;
              v_stage[4] = 2;
            );
          ) : v_stage[4] == 2 ? (
            v_env[4] += (sustain_level-v_env[4])*dec_k;
            abs(v_env[4]-sustain_level) <= 0.00001 ? (
              v_env[4] = sustain_level;
              v_stage[4] = 3;
            );
          ) : v_stage[4] == 3 ? (
            // Sustain=0: release DSP ownership as soon as this held voice is
            // truly silent. A later MIDI Note Off may arrive, but no audio work
            // is needed in the meantime.
            sustain_level <= 0.00001 && v_env[4] <= 0.00001 && v_pick_env[4] <= 0.00001 ? (
              v_env[4] = 0;
              v_stage[4] = 0;
              v_active[4] = 0;
              poly_active_count -= 1;
              poly_active_count < 0 ? poly_active_count = 0;
              v_exc[4] = 0;
              v_tension[4] = 0;
              v_finger[4] = 0;
              v_finger_stage[4] = 0;
              v_finger_vel[4] = 0;
              v_glide[4] = 0;
              v_phase_step[4] = 0;
            );
          ) : (
            v_env[4] += (0-v_env[4])*rel_k;
            v_env[4] <= 0.00001 ? (
              v_env[4] = 0;
              v_stage[4] = 0;
              v_active[4] = 0;
              poly_active_count -= 1;
              poly_active_count < 0 ? poly_active_count = 0;
              v_exc[4] = 0;
              v_tension[4] = 0;
              v_finger[4] = 0;
              v_finger_stage[4] = 0;
              v_finger_vel[4] = 0;
              v_pick_env[4] = 0;
              v_pick_lp[4] = 0;
              v_pick_dc[4] = 0;
              v_glide[4] = 0;
              v_os_dirty[4] = 1;
              v_phase_step[4] = 0;
            );
          );
  
          v_active[4] ? (
            pitch_work = v_os_dirty[4] || v_glide[4] || vib_active
                      || (step_tension_on && abs(v_tension[4]) > 0.000000001)
                      || (step_finger_on && v_finger_stage[4] != 0);
  
            pitch_work ? (
              local_pitch_cents = drift_pitch_cents_block;
              step_tension_on ? local_pitch_cents += step_tension_cents*v_tension[4]*v_vel[4];
              step_finger_on && v_finger_stage[4] != 0
                ? local_pitch_cents += step_finger_cents*v_finger[4]*v_finger_vel[4];
  
              abs(local_pitch_cents) > 0.000000000001
                ? effective_hz = v_freq[4] * global_pitch_ratio * cents_ratio(local_pitch_cents)
                : effective_hz = v_freq[4] * global_pitch_ratio;
  
              new_os = os_for_pitch(effective_hz, v_os[4]);
              new_os != v_os[4] ? (
                osc_reset(4);
                v_os[4] = new_os;
              );
              v_phase_step[4] = effective_hz * phase_per_hz;
              v_os_dirty[4] = 0;
            );
  
            phase_step = v_phase_step[4];
            step_direct_fast ? (
              warp_static_now = !v_glide[4]
                             && !step_drift_on
                             && !vib_active
                             && (!step_tension_on || abs(v_tension[4]) <= 0.000000001)
                             && (!step_finger_on || v_finger_stage[4] == 0);
              warp_static_now ? (
                osc_out = render_rec_auto(v_phase[4],phase_step,4,v_os[4]);
              ) : (
                warp_rec_ready[4] = 0;
                v_os[4] <= 1 ? osc_out = render_fast_1x(v_phase[4])
                               : v_os[4] == 2 ? osc_out = render_fast_2x(v_phase[4],phase_step,4)
                                                : osc_out = render_fast_4x(v_phase[4],phase_step,4);
              );
            ) : osc_out = render_stepsine_os(
                  v_phase[4], phase_step, v_exc[4],
                  v_life_mod[4], v_timbre_scale[4], 4, v_os[4]
                );
            body_out = osc_out * v_env[4] * v_vel[4];
            step_vel_tone_on ? body_out = apply_vel_tone(body_out, 4);
            out += body_out;
            stereo_active ? (
              stereo_body(body_out, 4, v_key_gainL[4], v_key_gainR[4]);
              stereoL += stereo_tmpL;
              stereoR += stereo_tmpR;
            );
  
            v_phase[4] += phase_step;
            v_phase[4] >= twopi ? v_phase[4] -= twopi*floor(v_phase[4]*inv_twopi);
          );
  
          v_pick_env[4] > 0.00001 && step_pick_level > 0.000001 ? (
            pick_n = rand(2) - 1;
  
            v_pick_lp[4] += (pick_n - v_pick_lp[4]) * pick_lp_k;
            v_pick_dc[4] += (v_pick_lp[4] - v_pick_dc[4]) * pick_dc_k;
            pick_dark = v_pick_lp[4] - v_pick_dc[4];
            pick_edge = pick_n - v_pick_lp[4];
  
            pick_sig = pick_dark*pick_dark_mix + pick_edge*pick_edge_mix;
  
            pick_snap = max(0, (v_pick_env[4] - 0.72) / 0.28);
            pick_sig += pick_edge * pick_snap * pick_snap_mix;
  
            pick_out = pick_sig * v_pick_env[4] * v_pick_gain[4];
            out += pick_out;
            stereo_active ? (
              // Pick stays centered inside Stereo Fan but follows Keyboard Stereo.
              stereoL += pick_out * v_key_gainL[4];
              stereoR += pick_out * v_key_gainR[4];
            );
  
            v_pick_env[4] *= pick_decay_k;
          ) : v_pick_env[4] = 0;
          ); // full poly voice path
        );
  
      // ---- precompiled voice 5 ----
        v_active[5] ? (
          v_steady = v_stage[5] == 3
                  && !v_glide[5]
                  && !v_os_dirty[5]
                  && !vib_active
                  && step_steady_kernel
                  && (!step_finger_on || v_finger_stage[5] == 0)
                  && v_pick_env[5] == 0
                  // Silent held Strings voices must fall through once and self-release.
                  && !(sustain_level <= 0.00001 && v_env[5] <= 0.00001);
  
          v_steady ? (
            phase_step = v_phase_step[5];
            osc_out = render_rec_auto(v_phase[5], phase_step, 5, v_os[5]);
            body_out = osc_out * v_env[5] * v_vel[5];
            step_vel_tone_on ? body_out = apply_vel_tone(body_out, 5);
            out += body_out;
            stereo_active ? (
              stereo_body(body_out, 5, v_key_gainL[5], v_key_gainR[5]);
              stereoL += stereo_tmpL;
              stereoR += stereo_tmpR;
            );
            v_phase[5] += phase_step;
            v_phase[5] >= twopi ? v_phase[5] -= twopi*floor(v_phase[5]*inv_twopi);
          ) : (
          v_glide[5] ? (
            v_freq[5] += (v_target[5]-v_freq[5])*porta_k;
            abs(v_target[5]-v_freq[5]) <= max(0.000000000001, abs(v_target[5])*0.000000000001) ? (
              v_freq[5] = v_target[5];
              v_glide[5] = 0;
              v_os_dirty[5] = 1;
            );
          );
  
          step_attack_dynamic ? v_exc[5] += (0-v_exc[5])*attack_timbre_k;
          step_tension_on ? v_tension[5] += (0-v_tension[5])*tension_k;
  
          step_finger_on ? (
            v_finger_stage[5] == 1 ? (
              v_finger[5] += (1-v_finger[5])*finger_rise_k;
              v_finger[5] >= 0.999 ? (v_finger[5] = 1; v_finger_stage[5] = 2;);
            ) : v_finger_stage[5] == 2 ? (
              v_finger[5] += (0-v_finger[5])*finger_return_k;
              v_finger[5] <= 0.00001 ? (
                v_finger[5] = 0;
                v_finger_stage[5] = 0;
                v_os_dirty[5] = 1;
              );
            );
          );
  
          v_stage[5] == 1 ? (
            v_env[5] += (1-v_env[5])*atk_k;
            v_env[5] >= 0.9995 ? (
              v_env[5] = 1;
              v_stage[5] = 2;
            );
          ) : v_stage[5] == 2 ? (
            v_env[5] += (sustain_level-v_env[5])*dec_k;
            abs(v_env[5]-sustain_level) <= 0.00001 ? (
              v_env[5] = sustain_level;
              v_stage[5] = 3;
            );
          ) : v_stage[5] == 3 ? (
            // Sustain=0: release DSP ownership as soon as this held voice is
            // truly silent. A later MIDI Note Off may arrive, but no audio work
            // is needed in the meantime.
            sustain_level <= 0.00001 && v_env[5] <= 0.00001 && v_pick_env[5] <= 0.00001 ? (
              v_env[5] = 0;
              v_stage[5] = 0;
              v_active[5] = 0;
              poly_active_count -= 1;
              poly_active_count < 0 ? poly_active_count = 0;
              v_exc[5] = 0;
              v_tension[5] = 0;
              v_finger[5] = 0;
              v_finger_stage[5] = 0;
              v_finger_vel[5] = 0;
              v_glide[5] = 0;
              v_phase_step[5] = 0;
            );
          ) : (
            v_env[5] += (0-v_env[5])*rel_k;
            v_env[5] <= 0.00001 ? (
              v_env[5] = 0;
              v_stage[5] = 0;
              v_active[5] = 0;
              poly_active_count -= 1;
              poly_active_count < 0 ? poly_active_count = 0;
              v_exc[5] = 0;
              v_tension[5] = 0;
              v_finger[5] = 0;
              v_finger_stage[5] = 0;
              v_finger_vel[5] = 0;
              v_pick_env[5] = 0;
              v_pick_lp[5] = 0;
              v_pick_dc[5] = 0;
              v_glide[5] = 0;
              v_os_dirty[5] = 1;
              v_phase_step[5] = 0;
            );
          );
  
          v_active[5] ? (
            pitch_work = v_os_dirty[5] || v_glide[5] || vib_active
                      || (step_tension_on && abs(v_tension[5]) > 0.000000001)
                      || (step_finger_on && v_finger_stage[5] != 0);
  
            pitch_work ? (
              local_pitch_cents = drift_pitch_cents_block;
              step_tension_on ? local_pitch_cents += step_tension_cents*v_tension[5]*v_vel[5];
              step_finger_on && v_finger_stage[5] != 0
                ? local_pitch_cents += step_finger_cents*v_finger[5]*v_finger_vel[5];
  
              abs(local_pitch_cents) > 0.000000000001
                ? effective_hz = v_freq[5] * global_pitch_ratio * cents_ratio(local_pitch_cents)
                : effective_hz = v_freq[5] * global_pitch_ratio;
  
              new_os = os_for_pitch(effective_hz, v_os[5]);
              new_os != v_os[5] ? (
                osc_reset(5);
                v_os[5] = new_os;
              );
              v_phase_step[5] = effective_hz * phase_per_hz;
              v_os_dirty[5] = 0;
            );
  
            phase_step = v_phase_step[5];
            step_direct_fast ? (
              warp_static_now = !v_glide[5]
                             && !step_drift_on
                             && !vib_active
                             && (!step_tension_on || abs(v_tension[5]) <= 0.000000001)
                             && (!step_finger_on || v_finger_stage[5] == 0);
              warp_static_now ? (
                osc_out = render_rec_auto(v_phase[5],phase_step,5,v_os[5]);
              ) : (
                warp_rec_ready[5] = 0;
                v_os[5] <= 1 ? osc_out = render_fast_1x(v_phase[5])
                               : v_os[5] == 2 ? osc_out = render_fast_2x(v_phase[5],phase_step,5)
                                                : osc_out = render_fast_4x(v_phase[5],phase_step,5);
              );
            ) : osc_out = render_stepsine_os(
                  v_phase[5], phase_step, v_exc[5],
                  v_life_mod[5], v_timbre_scale[5], 5, v_os[5]
                );
            body_out = osc_out * v_env[5] * v_vel[5];
            step_vel_tone_on ? body_out = apply_vel_tone(body_out, 5);
            out += body_out;
            stereo_active ? (
              stereo_body(body_out, 5, v_key_gainL[5], v_key_gainR[5]);
              stereoL += stereo_tmpL;
              stereoR += stereo_tmpR;
            );
  
            v_phase[5] += phase_step;
            v_phase[5] >= twopi ? v_phase[5] -= twopi*floor(v_phase[5]*inv_twopi);
          );
  
          v_pick_env[5] > 0.00001 && step_pick_level > 0.000001 ? (
            pick_n = rand(2) - 1;
  
            v_pick_lp[5] += (pick_n - v_pick_lp[5]) * pick_lp_k;
            v_pick_dc[5] += (v_pick_lp[5] - v_pick_dc[5]) * pick_dc_k;
            pick_dark = v_pick_lp[5] - v_pick_dc[5];
            pick_edge = pick_n - v_pick_lp[5];
  
            pick_sig = pick_dark*pick_dark_mix + pick_edge*pick_edge_mix;
  
            pick_snap = max(0, (v_pick_env[5] - 0.72) / 0.28);
            pick_sig += pick_edge * pick_snap * pick_snap_mix;
  
            pick_out = pick_sig * v_pick_env[5] * v_pick_gain[5];
            out += pick_out;
            stereo_active ? (
              // Pick stays centered inside Stereo Fan but follows Keyboard Stereo.
              stereoL += pick_out * v_key_gainL[5];
              stereoR += pick_out * v_key_gainR[5];
            );
  
            v_pick_env[5] *= pick_decay_k;
          ) : v_pick_env[5] = 0;
          ); // full poly voice path
        );
  
      );
    );
  
    // Reverb is no longer inside Strings.
    // The selected engine is completed first; reverb is applied later.
    synth_active_pre = mode < 2 ? (mono_stage != 0) : (poly_active_count > 0);
    post_stereo_active = stereo_active;
  
    // ------------------------------------------------------------
    // POST-AA + SIGNATURE OUTPUT, WITH TRUE IDLE SLEEP
    // ------------------------------------------------------------
    engine_active = synth_active_pre;
    engine_active ? (
      output_tail_count = 0;
      output_sleep = 0;
    ) : (
      output_tail_count += 1;
    );
  
    // Let the AA/DC/glue tails decay for 512 samples, then stop all post DSP.
    // This materially lowers idle CPU without truncating an audible release.
    output_tail_count > 512 ? (
      !output_sleep ? (
        aa1_x1 = aa1_x2 = aa1_y1 = aa1_y2 = 0;
        aa2_x1 = aa2_x2 = aa2_y1 = aa2_y2 = 0;
        aa1R_x1 = aa1R_x2 = aa1R_y1 = aa1R_y2 = 0;
        aa2R_x1 = aa2R_x2 = aa2R_y1 = aa2R_y2 = 0;
        dc_x_prev = dc_y_prev = 0;
        dc_xR_prev = dc_yR_prev = 0;
        glue_env = 0;
        glue_gain = 1;
        output_sleep = 1;
      );
      spl0 = 0;
      spl1 = 0;
    ) : (
      post_stereo_active ? (
        postL = aa_biquad1(stereoL);
        postL = aa_biquad2(postL);
        postR = aa_biquad1R(stereoR);
        postR = aa_biquad2R(postR);
  
        dc_x = postL;
        dc_y = dc_x - dc_x_prev + dc_coeff_5hz * dc_y_prev;
        dc_x_prev = dc_x;
        dc_y_prev = dc_y;
  
        dc_xR = postR;
        dc_yR = dc_xR - dc_xR_prev + dc_coeff_5hz * dc_yR_prev;
        dc_xR_prev = dc_xR;
        dc_yR_prev = dc_yR;
  
        glue_in = max(abs(dc_y), abs(dc_yR));
        glue_env < glue_in
          ? glue_env += (glue_in-glue_env)*glue_att_inv
          : glue_env += (glue_in-glue_env)*glue_rel_inv;
  
        glue_env > glue_thresh_k ? (
          over = glue_env-glue_thresh_k;
          glue_gain = (glue_thresh_k + over/glue_ratio_k) / glue_env;
        ) : (
          glue_gain = 1;
        );
  
        sigL = dc_y  * glue_gain * post_in_gain;
        sigR = dc_yR * glue_gain * post_in_gain;
  
        abs_out = abs(sigL);
        abs_out > post_limit ? (
          excess = abs_out-post_limit;
          sigL = sign(sigL) * (post_limit + excess*0.15);
        );
  
        abs_out = abs(sigR);
        abs_out > post_limit ? (
          excess = abs_out-post_limit;
          sigR = sign(sigR) * (post_limit + excess*0.15);
        );
  
        master2 = master_gain_lin*2;
        spl0 = sigL*master2;
        spl1 = sigR*master2;
      ) : (
        // Exact legacy mono path: both new stereo sliders at zero change nothing.
      out = aa_biquad1(out);
      out = aa_biquad2(out);
  
      dc_x = out;
      dc_y = dc_x - dc_x_prev + dc_coeff_5hz * dc_y_prev;
      dc_x_prev = dc_x;
      dc_y_prev = dc_y;
  
      glue_in = abs(dc_y);
      glue_env < glue_in
        ? glue_env += (glue_in - glue_env) * glue_att_inv
        : glue_env += (glue_in - glue_env) * glue_rel_inv;
  
      glue_env > glue_thresh_k ? (
        over = glue_env - glue_thresh_k;
        glue_gain = (glue_thresh_k + over / glue_ratio_k) / glue_env;
      ) : (
        glue_gain = 1;
      );
  
      sig_out = dc_y * glue_gain * post_in_gain;
  
      abs_out = abs(sig_out);
      abs_out > post_limit ? (
        excess = abs_out - post_limit;
        sig_out = sign(sig_out) * (post_limit + excess * 0.15);
      );
  
      sig_out *= master_gain_lin * 2;
      spl0 = sig_out;
      spl1 = sig_out;
      );
    );
  

) : engine_now < 4.5 ? (

// Mallet Family audio renderer — selected internal instrument uses its Current Bank.
ml_sample_count+=1;
ml_sumL=0;
ml_sumR=0;

// One global motor phase. Mostly audible on Vibraphone;
 // Metallophone keeps a small optional amount by configuration.
ml_motor_phase+=ml_motor_rate/srate;
ml_motor_phase>=1 ? ml_motor_phase-=1;
ml_motor_sin=sin(ml_twopi*ml_motor_phase);
ml_motor_amt=ml_motor_depth*ml_inst_motor;
ml_motorL=1-ml_motor_amt*0.48+ml_motor_amt*0.48*ml_motor_sin;
ml_motorR=1-ml_motor_amt*0.48-ml_motor_amt*0.48*ml_motor_sin;

ml_active_count>0 ? (
  ml_i=0;
  loop(ml_voice_count,
    ml_VACTIVE[ml_i] ? (
      ml_y1=ml_M1C1[ml_i]*ml_M1Y1[ml_i]+ml_M1C2[ml_i]*ml_M1Y2[ml_i];
      ml_M1Y2[ml_i]=ml_M1Y1[ml_i]; ml_M1Y1[ml_i]=ml_y1;

      ml_y2=ml_M2C1[ml_i]*ml_M2Y1[ml_i]+ml_M2C2[ml_i]*ml_M2Y2[ml_i];
      ml_M2Y2[ml_i]=ml_M2Y1[ml_i]; ml_M2Y1[ml_i]=ml_y2;

      ml_y3=ml_M3C1[ml_i]*ml_M3Y1[ml_i]+ml_M3C2[ml_i]*ml_M3Y2[ml_i];
      ml_M3Y2[ml_i]=ml_M3Y1[ml_i]; ml_M3Y1[ml_i]=ml_y3;

      ml_y4=ml_M4C1[ml_i]*ml_M4Y1[ml_i]+ml_M4C2[ml_i]*ml_M4Y2[ml_i];
      ml_M4Y2[ml_i]=ml_M4Y1[ml_i]; ml_M4Y1[ml_i]=ml_y4;

      ml_y5=ml_M5C1[ml_i]*ml_M5Y1[ml_i]+ml_M5C2[ml_i]*ml_M5Y2[ml_i];
      ml_M5Y2[ml_i]=ml_M5Y1[ml_i]; ml_M5Y1[ml_i]=ml_y5;

      ml_y6=ml_M6C1[ml_i]*ml_M6Y1[ml_i]+ml_M6C2[ml_i]*ml_M6Y2[ml_i];
      ml_M6Y2[ml_i]=ml_M6Y1[ml_i]; ml_M6Y1[ml_i]=ml_y6;

      ml_ry=ml_RC1[ml_i]*ml_RY1[ml_i]+ml_RC2[ml_i]*ml_RY2[ml_i];
      ml_RY2[ml_i]=ml_RY1[ml_i]; ml_RY1[ml_i]=ml_ry;

      ml_a1=ml_A1C1[ml_i]*ml_A1Y1[ml_i]+ml_A1C2[ml_i]*ml_A1Y2[ml_i];
      ml_A1Y2[ml_i]=ml_A1Y1[ml_i]; ml_A1Y1[ml_i]=ml_a1;

      ml_a2=ml_A2C1[ml_i]*ml_A2Y1[ml_i]+ml_A2C2[ml_i]*ml_A2Y2[ml_i];
      ml_A2Y2[ml_i]=ml_A2Y1[ml_i]; ml_A2Y1[ml_i]=ml_a2;

      ml_VATT[ml_i]<1 ? ml_VATT[ml_i]=min(1,ml_VATT[ml_i]+ml_VATTSTEP[ml_i]);

      ml_bar=(ml_y1+ml_y2+ml_y3+ml_y4+ml_y5+ml_y6)*ml_VATT[ml_i];

      // Resonator/tube is a separate acoustic contribution and can breathe.
      ml_res=ml_ry*(0.40+0.60*ml_resonator_depth);

      // Deterministic impact path.
      ml_hit=ml_a1+ml_a2;

      ml_voice=ml_bar+ml_hit;
      ml_vL=(ml_voice+ml_res*ml_motorL)*ml_VPANL[ml_i];
      ml_vR=(ml_voice+ml_res*ml_motorR)*ml_VPANR[ml_i];

      abs(ml_vL)>16 ? ml_vL=sign(ml_vL)*16;
      abs(ml_vR)>16 ? ml_vR=sign(ml_vR)*16;

      ml_sumL+=ml_vL;
      ml_sumR+=ml_vR;

      ml_energy=max(
        max(abs(ml_y1),max(abs(ml_y2),abs(ml_y3))),
        max(
          max(abs(ml_y4),max(abs(ml_y5),abs(ml_y6))),
          max(abs(ml_ry),max(abs(ml_a1),abs(ml_a2)))
        )
      );

      ml_energy<0.00000010 ? (
        ml_VQUIET[ml_i]+=1;
        ml_VQUIET[ml_i]>512 ? (
          ml_VACTIVE[ml_i]=0;

          ml_M1Y1[ml_i]=ml_M1Y2[ml_i]=0;
          ml_M2Y1[ml_i]=ml_M2Y2[ml_i]=0;
          ml_M3Y1[ml_i]=ml_M3Y2[ml_i]=0;
          ml_M4Y1[ml_i]=ml_M4Y2[ml_i]=0;
          ml_M5Y1[ml_i]=ml_M5Y2[ml_i]=0;
          ml_M6Y1[ml_i]=ml_M6Y2[ml_i]=0;

          ml_RY1[ml_i]=ml_RY2[ml_i]=0;
          ml_A1Y1[ml_i]=ml_A1Y2[ml_i]=0;
          ml_A2Y1[ml_i]=ml_A2Y2[ml_i]=0;

          ml_VATT[ml_i]=0;
          ml_VQUIET[ml_i]=0;

          ml_active_count-=1;
          ml_active_count<0 ? ml_active_count=0;
        );
      ) : (
        ml_VQUIET[ml_i]=0;
      );
    );
    ml_i+=1;
  );
);

ml_outL=ml_sumL;
ml_outR=ml_sumR;

// Numerical bus airbag only.
abs(ml_outL)>64 ? ml_outL=sign(ml_outL)*64;
abs(ml_outR)>64 ? ml_outR=sign(ml_outR)*64;

// ------------------------------------------------------------
// Parallel saturation with protected bass.
// ------------------------------------------------------------
ml_sat_lowL+=(ml_outL-ml_sat_lowL)*ml_sat_hp_k;
ml_sat_lowR+=(ml_outR-ml_sat_lowR)*ml_sat_hp_k;

ml_sat_hiL=ml_outL-ml_sat_lowL;
ml_sat_hiR=ml_outR-ml_sat_lowR;

ml_sat_mix>0.0000001 && slider194>0.00001 ? (
  ml_sat_wetL=ml_mal_softclip(ml_sat_hiL*ml_sat_drive)/max(1,ml_sat_drive);
  ml_sat_wetR=ml_mal_softclip(ml_sat_hiR*ml_sat_drive)/max(1,ml_sat_drive);

  ml_sat_procL=ml_sat_lowL+ml_sat_wetL;
  ml_sat_procR=ml_sat_lowR+ml_sat_wetR;

  ml_outL=ml_outL+(ml_sat_procL-ml_outL)*ml_sat_mix;
  ml_outR=ml_outR+(ml_sat_procR-ml_outR)*ml_sat_mix;
);

// ------------------------------------------------------------
// AutoPan. Same oscillator, recurrence and +/-0.72 depth law as Rhodes Lab.
// Mallet is already stereo, so the modulation is applied to the existing
// left/right bus instead of collapsing Keyboard Stereo or Motor stereo to mono.
// Static original stereo image when depth=0.
// ------------------------------------------------------------
ml_autopan_depth>0.0000001 ? (
  ml_ap_old_s=ml_ap_sin;
  ml_ap_sin=ml_ap_sin*ml_ap_rot_c+ml_ap_cos*ml_ap_rot_s;
  ml_ap_cos=ml_ap_cos*ml_ap_rot_c-ml_ap_old_s*ml_ap_rot_s;

  // Rare normalization prevents long-term recurrence drift.
  (ml_sample_count & 16383)==0 ? (
    ml_ap_norm=max(0.000001,sqrt(ml_ap_sin*ml_ap_sin+ml_ap_cos*ml_ap_cos));
    ml_ap_sin/=ml_ap_norm;
    ml_ap_cos/=ml_ap_norm;
  );

  ml_ap_pan=ml_ap_sin*ml_autopan_depth;
  ml_outL*=1-ml_ap_pan*0.72;
  ml_outR*=1+ml_ap_pan*0.72;
);

// ------------------------------------------------------------
// Lo-lo fixed output signature.
// DC 5 Hz -> glue -> x0.4 -> soft limiter -> Master x2.
// ------------------------------------------------------------
ml_dcL=ml_outL-ml_dc_x1L+ml_dc_coeff_5hz*ml_dc_y1L;
ml_dc_x1L=ml_outL; ml_dc_y1L=ml_dcL;

ml_dcR=ml_outR-ml_dc_x1R+ml_dc_coeff_5hz*ml_dc_y1R;
ml_dc_x1R=ml_outR; ml_dc_y1R=ml_dcR;

ml_peak=max(abs(ml_dcL),abs(ml_dcR));
ml_peak>ml_glue_env ? (
  ml_glue_env+=(ml_peak-ml_glue_env)*ml_glue_att_inv;
) : (
  ml_glue_env+=(ml_peak-ml_glue_env)*ml_glue_rel_inv;
);

ml_glue_gain=1;
ml_glue_env>ml_glue_thresh_k ? (
  ml_glue_target=ml_glue_thresh_k+(ml_glue_env-ml_glue_thresh_k)/ml_glue_ratio_k;
  ml_glue_gain=ml_glue_target/max(0.000000001,ml_glue_env);
);

ml_outL=ml_dcL*ml_glue_gain*ml_post_in_gain;
ml_outR=ml_dcR*ml_glue_gain*ml_post_in_gain;

abs(ml_outL)>ml_post_limit ? (
  ml_outL=sign(ml_outL)*(ml_post_limit+(abs(ml_outL)-ml_post_limit)*0.15);
);
abs(ml_outR)>ml_post_limit ? (
  ml_outR=sign(ml_outR)*(ml_post_limit+(abs(ml_outR)-ml_post_limit)*0.15);
);

spl0=ml_outL*ml_master_gain*2;
spl1=ml_outR*ml_master_gain*2;

) : engine_now < 5.5 ? (

// Wind Family audio renderer — selected internal instrument uses its Current Bank.
wi_sumL=0; wi_sumR=0;

// One global performer vibrato phase; each voice keeps its own delayed ramp.
wi_vib_phase+=wi_vibrato_rate/srate;
wi_vib_phase>=1 ? wi_vib_phase-=1;
wi_vib_sin_global=sin(wi_twopi*wi_vib_phase);

wi_active_count>0 ? (
  wi_i=0;
  loop(wi_voice_count,
    wi_VACTIVE[wi_i] ? (
      // Breath envelope.
      wi_VSTAGE[wi_i]==1 ? (
        wi_VENV[wi_i]+=1/max(1,wi_breath_attack_ms*0.001*srate);
        wi_VENV[wi_i]>=1 ? (wi_VENV[wi_i]=1; wi_VSTAGE[wi_i]=2;);
      ) : wi_VSTAGE[wi_i]==3 ? (
        wi_VENV[wi_i]-=wi_VRELSTEP[wi_i];
        wi_VENV[wi_i]<=0 ? (wi_VENV[wi_i]=0; wi_VSTAGE[wi_i]=0; wi_VTAIL[wi_i]=0.55;);
      );

      wi_env=wi_VENV[wi_i];
      wi_vc=wi_VVEL[wi_i];

      // Physical release damping. While the breath envelope is releasing,
      // progressively lower the closed-loop reflection gain. After breath
      // reaches zero, decay the remaining loop so it cannot become a fixed tone.
      wi_VSTAGE[wi_i]==3 ? (
        wi_loop_life=0.55+0.45*sqrt(max(0,wi_env));
      ) : wi_VSTAGE[wi_i]==0 ? (
        wi_VTAIL[wi_i]*=wi_release_tail_decay;
        wi_loop_life=wi_VTAIL[wi_i];
      ) : (
        wi_VTAIL[wi_i]=1;
        wi_loop_life=1;
      );
      wi_edge_life=wi_VSTAGE[wi_i]>=3 ? wi_env : 1;

      // Vibrato ramp, pitch and pressure components.
      wi_VVIBCOUNT[wi_i]+=1;
      wi_vib_ramp=wi_vibrato_delay_ms<=0 ? 1 : min(1,wi_VVIBCOUNT[wi_i]/max(1,wi_vibrato_delay_ms*0.001*srate));
      wi_vib_sin=wi_vib_sin_global;
      wi_vib_cents=wi_vib_sin*wi_vibrato_depth_cents*wi_vib_ramp*(1+1.5*wi_modwheel);
      wi_vib_ratio=1+wi_vib_cents*(wi_ln2/1200);
      wi_vib_ratio=max(0.92,min(1.08,wi_vib_ratio));

      // Mono Legato changes tube length like a finger opening/closing a hole.
      // Trigger/poly notes already start with current == target, so this is
      // effectively free there. The residual difference also causes a tiny
      // temporary reflection loss, modelling the changing acoustic impedance.
      wi_VCURDELAY[wi_i]<=0 ? wi_VCURDELAY[wi_i]=wi_VBASEDELAY[wi_i];
      wi_tube_err=wi_VBASEDELAY[wi_i]-wi_VCURDELAY[wi_i];
      wi_VCURDELAY[wi_i]+=wi_tube_err*wi_legato_tube_k;
      wi_finger_motion=min(1,abs(wi_tube_err)/max(1,wi_VBASEDELAY[wi_i])*5);
      wi_bore_delay=wi_VCURDELAY[wi_i]/wi_vib_ratio;
      wi_jet_delay=max(1,min(wi_JET_LEN-3,wi_bore_delay*wi_jet_ratio));

      // Turbulent breath: one random source, spectrally colored.
      wi_n=rand(2)-1;
      wi_VBREATHLP[wi_i]+=(wi_n-wi_VBREATHLP[wi_i])*wi_breath_lp_k;
      wi_air=wi_VBREATHLP[wi_i];

      wi_vel_pressure=(1-wi_velocity_amount)+wi_velocity_amount*wi_vc;

      // Velocity ignition assist: physical edge-blown models have a threshold
      // below which the jet may fail to lock, especially with a curved MIDI
      // velocity response. Give only true attacks a brief extra air impulse.
      // The impulse is stronger when the velocity-derived pressure is low,
      // but it is NOT part of the sustained level and therefore preserves
      // the musical velocity range once the tube is speaking.
      wi_ignite_need=max(0,0.72-wi_vel_pressure)/0.72;
      wi_ignite=wi_VIGNITE[wi_i]*(0.10+0.32*wi_ignite_need);
      wi_VIGNITE[wi_i]*=wi_ignite_decay;
      wi_VIGNITE[wi_i]<0.00001 ? wi_VIGNITE[wi_i]=0;

      wi_pressure=wi_breath_pressure*(wi_vel_pressure*wi_env + wi_ignite)*(1+0.35*wi_aftertouch);
      wi_pressure*=1+wi_vib_sin*wi_vibrato_pressure*wi_vib_ramp*0.20;
      wi_pressure*=1+wi_overblow*0.22*max(0,wi_vc-0.55);
      wi_breath=wi_pressure*(1+wi_breath_noise*wi_air*0.55);

      wi_bb=wi_BORE_BUF+wi_i*wi_BORE_LEN;
      wi_jb=wi_JET_BUF+wi_i*wi_JET_LEN;
      wi_bw=wi_VBOREW[wi_i]; wi_jw=wi_VJETW[wi_i];

      // Read bore, filter the returning wave, form jet pressure difference.
      wi_bore_out=wi_win_delay_read(wi_bb,wi_BORE_LEN,wi_bw,wi_bore_delay);
      wi_VREFLP[wi_i]+=(wi_bore_out-wi_VREFLP[wi_i])*wi_ref_lp_k;
      wi_reflected=-wi_VREFLP[wi_i];
      wi_pdiff=wi_breath-wi_jet_reflection*wi_reflected*wi_loop_life*(1-0.10*wi_finger_motion);

      // Jet delay.
      wi_jet_out=wi_win_delay_read(wi_jb,wi_JET_LEN,wi_jw,wi_jet_delay);
      wi_jb[wi_jw]=wi_pdiff;
      wi_jw+=1; wi_jw>=wi_JET_LEN ? wi_jw=0;
      wi_VJETW[wi_i]=wi_jw;

      // Edge nonlinearity. Overblow strengthens the nonlinear region rather
      // than hard-switching octaves, so it remains playable across velocity.
      wi_jx=wi_jet_out*wi_jet_drive*(1+0.75*wi_overblow)+wi_edge_bias*0.32*wi_edge_life;
      wi_jx=max(-1.35,min(1.35,wi_jx));
      wi_jet_nl=wi_jx*(wi_jx*wi_jx-1);

      // DC block around the nonlinear jet.
      wi_jet_dc=wi_jet_nl-wi_VJETDCX[wi_i]+0.995*wi_VJETDCY[wi_i];
      wi_VJETDCX[wi_i]=wi_jet_nl; wi_VJETDCY[wi_i]=wi_jet_dc;

      wi_bore_in=wi_jet_dc+wi_end_reflection*wi_reflected*wi_loop_life*(1-0.14*wi_finger_motion);
      wi_bore_in=max(-3,min(3,wi_bore_in));
      wi_bb[wi_bw]=wi_bore_in;
      wi_bw+=1; wi_bw>=wi_BORE_LEN ? wi_bw=0;
      wi_VBOREW[wi_i]=wi_bw;
      wi_VBOREOUT[wi_i]=wi_bore_out;

      // Air-column output plus controllable harmonic edge.
      wi_voice=wi_bore_out*0.30*wi_inst_gain;
      wi_voice+=wi_bore_harmonics*(0.10*wi_voice*abs(wi_voice)+0.055*wi_voice*wi_voice*wi_voice);

      // Instrument body / vessel warmth. Strongest in Pan Flute and Ocarina.
      wi_VBODYLP[wi_i]+=(wi_voice-wi_VBODYLP[wi_i])*wi_body_lp_k;
      wi_voice+=wi_VBODYLP[wi_i]*wi_air_body*0.36;

      // Key/chiff transient.
      wi_VKEYLP[wi_i]+=(wi_n-wi_VKEYLP[wi_i])*wi_key_lp_k;
      wi_keyhit=wi_VKEYLP[wi_i]*wi_VKEYENV[wi_i]*wi_key_noise*0.11;
      wi_VKEYENV[wi_i]*=wi_key_env_decay;

      // A little direct breath keeps the attack alive before the tube locks.
      wi_direct_air=wi_air*wi_pressure*wi_breath_noise*wi_inst_air_gain*0.035;
      wi_voice+=wi_keyhit+wi_direct_air;

      // A single acoustic wind source is centered. Stereo placement belongs
      // to the host/ensemble context rather than to the instrument model.
      wi_sumL+=wi_voice; wi_sumR+=wi_voice;

      // Once release envelope and waveguide energy are both quiet, sleep voice.
      // Also force sleep after the residual feedback tail has fully decayed;
      // this is a safety against nonlinear limit cycles in extreme settings.
      wi_energy=max(abs(wi_bore_out),max(abs(wi_VREFLP[wi_i]),abs(wi_VJETDCY[wi_i])));
      wi_VSTAGE[wi_i]==0 && wi_VTAIL[wi_i]<0.0005 ? (
        wi_VACTIVE[wi_i]=0; wi_VQUIET[wi_i]=0;
        wi_VREFLP[wi_i]=0; wi_VJETDCX[wi_i]=0; wi_VJETDCY[wi_i]=0; wi_VBOREOUT[wi_i]=0;
        wi_active_count-=1; wi_active_count<0 ? wi_active_count=0;
      ) : wi_VSTAGE[wi_i]==0 && wi_energy<0.0000008 ? (
        wi_VQUIET[wi_i]+=1;
        wi_VQUIET[wi_i]>1024 ? (
          wi_VACTIVE[wi_i]=0; wi_VQUIET[wi_i]=0;
          wi_active_count-=1; wi_active_count<0 ? wi_active_count=0;
        );
      ) : wi_VQUIET[wi_i]=0;
    );
    wi_i+=1;
  );
);

wi_outL=wi_sumL; wi_outR=wi_sumR;
abs(wi_outL)>32 ? wi_outL=(wi_outL>=0?32:-32);
abs(wi_outR)>32 ? wi_outR=(wi_outR>=0?32:-32);

// ------------------------------------------------------------
// Lo-lo fixed output signature.
// DC 5 Hz -> glue -> x0.4 -> soft limiter -> Master x2.
// ------------------------------------------------------------
wi_dcL=wi_outL-wi_dc_x1L+wi_dc_coeff_5hz*wi_dc_y1L; wi_dc_x1L=wi_outL; wi_dc_y1L=wi_dcL;
wi_dcR=wi_outR-wi_dc_x1R+wi_dc_coeff_5hz*wi_dc_y1R; wi_dc_x1R=wi_outR; wi_dc_y1R=wi_dcR;
wi_peak=max(abs(wi_dcL),abs(wi_dcR));
wi_peak>wi_glue_env ? wi_glue_env+=(wi_peak-wi_glue_env)*wi_glue_att_inv
              : wi_glue_env+=(wi_peak-wi_glue_env)*wi_glue_rel_inv;

wi_glue_gain=1;
wi_glue_env>wi_glue_thresh_k ? (
  wi_glue_target=wi_glue_thresh_k+(wi_glue_env-wi_glue_thresh_k)/wi_glue_ratio_k;
  wi_glue_gain=wi_glue_target/max(0.000000001,wi_glue_env);
);

wi_outL=wi_dcL*wi_glue_gain*wi_post_in_gain; wi_outR=wi_dcR*wi_glue_gain*wi_post_in_gain;
abs(wi_outL)>wi_post_limit ? wi_outL=(wi_outL>=0?1:-1)*(wi_post_limit+(abs(wi_outL)-wi_post_limit)*0.15);
abs(wi_outR)>wi_post_limit ? wi_outR=(wi_outR>=0?1:-1)*(wi_post_limit+(abs(wi_outR)-wi_post_limit)*0.15);

spl0=wi_outL*wi_master_gain*2;
spl1=wi_outR*wi_master_gain*2;

) : (

// ============================================================
// MICRO SYNTH AUDIO — dual oscillator, 24 dB LPF, note-triggered LFO
// ============================================================
ms_lfo_phase+=ms_lfo_rate/srate;
ms_lfo_phase>=1 ? (
  ms_lfo_phase-=1;
  ms_lfo_hold=rand(2)-1;
);
ms_lfo_wave==0 ? ms_lfo=sin(ms_twopi*ms_lfo_phase) :
ms_lfo_wave==1 ? ms_lfo=1-4*abs(ms_lfo_phase-0.5) :
ms_lfo_wave==2 ? ms_lfo=2*ms_lfo_phase-1 :
ms_lfo_wave==3 ? ms_lfo=(ms_lfo_phase<0.5 ? 1 : -1) :
                 ms_lfo=ms_lfo_hold;

// ADSR.
ms_env_stage==1 ? (
  ms_env+=ms_atk_inc;
  ms_env>=1 ? (ms_env=1; ms_env_stage=2;);
) : ms_env_stage==2 ? (
  ms_env=ms_sus+(ms_env-ms_sus)*ms_dec_coef;
  abs(ms_env-ms_sus)<0.00001 ? (ms_env=ms_sus; ms_env_stage=3;);
) : ms_env_stage==3 ? (
  ms_env=ms_sus;
) : ms_env_stage==4 ? (
  ms_env*=ms_rel_coef;
  ms_env<0.000001 ? (
    ms_env=0; ms_env_stage=0; ms_note_active=0;
    max(abs(ms_f4L),abs(ms_f4R))<0.00001 ? (
      ms_f1L=ms_f2L=ms_f3L=ms_f4L=0;
      ms_f1R=ms_f2R=ms_f3R=ms_f4R=0;
    );
  );
);

// Portamento in semitone domain.
(ms_note_active || ms_env_stage!=0) ? (
  ms_porta_s<=0 ? ms_current_note=ms_target_note : (
    ms_current_note=ms_target_note+(ms_current_note-ms_target_note)*ms_porta_coef;
    abs(ms_current_note-ms_target_note)<0.000001 ? ms_current_note=ms_target_note;
  );
);

// Dual oscillator. At zero detune, hard phase lock makes the pair exactly one waveform.
ms_base_hz=ms_note_hz(ms_current_note);
ms_detune_abs_zero=abs(ms_detune_c)<0.0000001;
ms_detune_abs_zero ? (
  ms_freq1=ms_base_hz; ms_freq2=ms_base_hz; ms_phase2=ms_phase1;
) : (
  ms_freq1=ms_base_hz*2^(-ms_detune_c/2400);
  ms_freq2=ms_base_hz*2^( ms_detune_c/2400);
);
ms_freq1=min(ms_freq1,srate*0.45); ms_freq2=min(ms_freq2,srate*0.45);
ms_dt1=max(0.0000001,ms_freq1/srate); ms_dt2=max(0.0000001,ms_freq2/srate);
ms_pw_now=ms_clamp(ms_pw_base+ms_lfo*ms_lfo_pwm_depth*0.45,0.02,0.98);
ms_osc1=ms_osc_wave(ms_phase1,ms_dt1,ms_wave_sel,ms_pw_now);
ms_detune_abs_zero ? ms_osc2=ms_osc1 : ms_osc2=ms_osc_wave(ms_phase2,ms_dt2,ms_wave_sel,ms_pw_now);
ms_srcL=(ms_osc1*ms_pan1L+ms_osc2*ms_pan2L)*ms_osc_stereo_norm;
ms_srcR=(ms_osc1*ms_pan1R+ms_osc2*ms_pan2R)*ms_osc_stereo_norm;
ms_phase1+=ms_dt1; ms_phase1>=1 ? ms_phase1-=1;
ms_detune_abs_zero ? ms_phase2=ms_phase1 : (
  ms_phase2+=ms_dt2; ms_phase2>=1 ? ms_phase2-=1;
);

// 24 dB/oct low-pass. Cutoff slider is 0..1 => 20..6000 Hz internally.
ms_cutoff_env_oct=ms_env*ms_filter_env_amt;
ms_cutoff_now=ms_cutoff_base*2^(ms_cutoff_env_oct+ms_lfo*ms_lfo_cut_depth*4);
ms_cutoff_now=ms_clamp(ms_cutoff_now,ms_cutoff_min,ms_cutoff_max);
ms_fc_work=min(ms_cutoff_now*1.35,srate*0.45);
ms_g=1-exp(-ms_twopi*ms_fc_work/srate);
ms_fb=ms_res_amt*(3.82-0.55*ms_g);
ms_filter_inL=ms_srcL-ms_fb*ms_f4L;
ms_filter_inR=ms_srcR-ms_fb*ms_f4R;
ms_filter_inL=ms_filter_inL/(1+0.22*abs(ms_filter_inL));
ms_filter_inR=ms_filter_inR/(1+0.22*abs(ms_filter_inR));
ms_f1L+=ms_g*(ms_filter_inL-ms_f1L); ms_f2L+=ms_g*(ms_f1L-ms_f2L);
ms_f3L+=ms_g*(ms_f2L-ms_f3L); ms_f4L+=ms_g*(ms_f3L-ms_f4L);
ms_f1R+=ms_g*(ms_filter_inR-ms_f1R); ms_f2R+=ms_g*(ms_f1R-ms_f2R);
ms_f3R+=ms_g*(ms_f2R-ms_f3R); ms_f4R+=ms_g*(ms_f3R-ms_f4R);
ms_filteredL=ms_f4L*(1+0.28*ms_res_amt);
ms_filteredR=ms_f4R*(1+0.28*ms_res_amt);

// Fixed +12 dB internal synth level into Lo-lo Glue + Limiter; Master remains 0 dB in Init.
ms_postL=ms_filteredL*ms_env*3.981071706;
ms_postR=ms_filteredR*ms_env*3.981071706;
ms_glue_in=sqrt((ms_postL*ms_postL+ms_postR*ms_postR)*0.5+0.000000000001);
ms_glue_env<ms_glue_in
  ? ms_glue_env+=(ms_glue_in-ms_glue_env)*ms_glue_att_inv
  : ms_glue_env+=(ms_glue_in-ms_glue_env)*ms_glue_rel_inv;
ms_glue_env>ms_glue_thresh_k ? (
  ms_over=ms_glue_env-ms_glue_thresh_k;
  ms_glue_gain=(ms_glue_thresh_k+ms_over/ms_glue_ratio_k)/ms_glue_env;
) : ms_glue_gain=1;
ms_postL*=ms_glue_gain*ms_post_in_gain;
ms_postR*=ms_glue_gain*ms_post_in_gain;
abs(ms_postL)>ms_post_limit ? (
  ms_excess=abs(ms_postL)-ms_post_limit;
  ms_postL=(ms_postL>=0?1:-1)*(ms_post_limit+ms_excess*0.15);
);
abs(ms_postR)>ms_post_limit ? (
  ms_excess=abs(ms_postR)-ms_post_limit;
  ms_postR=(ms_postR>=0?1:-1)*(ms_post_limit+ms_excess*0.15);
);
spl0=ms_postL*ms_master_gain*2;
spl1=ms_postR*ms_master_gain*2;

);

// ============================================================
// FIXED POST-ENGINE CALIBRATION TRIM
// All engines are reduced by exactly 2 dB here, after their own internal
// signature/master stages and before the shared Delay/Reverb input.
// ============================================================
spl0 *= engine_output_trim_2db;
spl1 *= engine_output_trim_2db;

// ============================================================
// COMPACT DUAL TAPE DELAY — PARALLEL REVERB SEND
// Delay to Reverb controls how much of the delayed repeats excite Reverb.
// ============================================================
dt_inL=spl0;
dt_inR=spl1;
// Separate the audible Delay output from the signal that excites Reverb.
// This lets slider210 control only how much of the echo repeats enter Reverb,
// while the direct component keeps its normal Reverb path.
dt_before_rev_feedL=dt_inL;
dt_before_rev_feedR=dt_inR;

// TEST15 — REAL DELAY AUDIO OWNERSHIP.
// Delay Mix may stay non-zero while the DSP sleeps. A real source wakes it
// instantly; audible repeats refresh the pending hold until the tail is gone.
dt_source_level=max(abs(dt_inL),abs(dt_inR));
dt_source_active=dt_mix_active && dt_source_level>0.0000000001;

dt_source_active ? (
  dt_pending_samples=max(dt_pending_samples,max(64,dt_tail_gap_samples));
);

dt_should_process=dt_mix_active && (dt_source_active || dt_pending_samples>0);

dt_should_process ? (
  // Smooth tempo changes / division edits with the original Tape Glide law.
  dt_t1_time_target=dt_t1_base_delay_samples;
  dt_t2_time_target=dt_t2_base_delay_samples;
  dt_t1_time_cur<=0 ? dt_t1_time_cur=dt_t1_time_target;
  dt_t2_time_cur<=0 ? dt_t2_time_cur=dt_t2_time_target;
  dt_t1_time_cur+=(dt_t1_time_target-dt_t1_time_cur)*dt_glide_coeff;
  dt_t2_time_cur+=(dt_t2_time_target-dt_t2_time_cur)*dt_glide_coeff;

  // Pitch-per-repeat shifters live only in the feedback path, therefore the
  // first echo remains at the original pitch exactly like LDelay2.
  dt_t1_pitch_active ? (
    dt_t1_pitch_window=max(8,min(dt_pitch_window_max,dt_t1_time_cur*0.45));
    dt_t1_pitch_phase+=dt_t1_pitch_speed/dt_t1_pitch_window;
    dt_t1_pitch_phase>=1 ? dt_t1_pitch_phase-=floor(dt_t1_pitch_phase);
  );
  dt_t2_pitch_active ? (
    dt_t2_pitch_window=max(8,min(dt_pitch_window_max,dt_t2_time_cur*0.45));
    dt_t2_pitch_phase+=dt_t2_pitch_speed/dt_t2_pitch_window;
    dt_t2_pitch_phase>=1 ? dt_t2_pitch_phase-=floor(dt_t2_pitch_phase);
  );

  dt_t1_raw_read=dt_t1_write-dt_t1_time_cur;
  dt_t2_raw_read=dt_t2_write-dt_t2_time_cur;
  dt_t1_raw_read<0 ? dt_t1_raw_read+=dt_max_delay_samples;
  dt_t2_raw_read<0 ? dt_t2_raw_read+=dt_max_delay_samples;
  dt_t1_raw=dt_buffer_read_linear(dt_t1_buffer,dt_max_delay_samples,dt_t1_raw_read);
  dt_t2_raw=dt_buffer_read_linear(dt_t2_buffer,dt_max_delay_samples,dt_t2_raw_read);

  // Audible tape low-pass + DC blocker.
  dt_t1_wet_lp+=(dt_t1_raw-dt_t1_wet_lp)*dt_t1_filter_coeff;
  dt_t2_wet_lp+=(dt_t2_raw-dt_t2_wet_lp)*dt_t2_filter_coeff;
  dt_t1_wet_dc=dt_t1_wet_lp-dt_t1_wet_hp_x+dt_dc_block_coeff*dt_t1_wet_hp_y;
  dt_t2_wet_dc=dt_t2_wet_lp-dt_t2_wet_hp_x+dt_dc_block_coeff*dt_t2_wet_hp_y;
  dt_t1_wet_hp_x=dt_t1_wet_lp; dt_t1_wet_hp_y=dt_t1_wet_dc;
  dt_t2_wet_hp_x=dt_t2_wet_lp; dt_t2_wet_hp_y=dt_t2_wet_dc;

  dt_drive_active ? (
    dt_t1_wet=dt_tape_distort(dt_t1_wet_dc,dt_drive_a,dt_drive_gain,dt_drive_bias,dt_drive_zero,dt_drive_soft_mix,dt_drive_hard_mix);
    dt_t2_wet=dt_tape_distort(dt_t2_wet_dc,dt_drive_a,dt_drive_gain,dt_drive_bias,dt_drive_zero,dt_drive_soft_mix,dt_drive_hard_mix);
  ) : (
    dt_t1_wet=dt_t1_wet_dc;
    dt_t2_wet=dt_t2_wet_dc;
  );

  // Dual-head feedback pitch read.
  dt_t1_pitch_active ? (
    dt_t1_pa=dt_t1_pitch_phase;
    dt_t1_pb=dt_t1_pa<0.5 ? dt_t1_pa+0.5 : dt_t1_pa-0.5;
    dt_t1_pitch_ratio>=1 ? (
      dt_t1_off_a=dt_t1_pa*dt_t1_pitch_window;
      dt_t1_off_b=dt_t1_pb*dt_t1_pitch_window;
    ) : (
      dt_t1_off_a=(1-dt_t1_pa)*dt_t1_pitch_window;
      dt_t1_off_b=(1-dt_t1_pb)*dt_t1_pitch_window;
    );
    dt_t1_head_a=dt_buffer_read_linear(dt_t1_buffer,dt_max_delay_samples,dt_t1_raw_read+dt_t1_off_a);
    dt_t1_head_b=dt_buffer_read_linear(dt_t1_buffer,dt_max_delay_samples,dt_t1_raw_read+dt_t1_off_b);
    dt_t1_wa=sin($pi*dt_t1_pa); dt_t1_wa*=dt_t1_wa;
    dt_t1_fb_source=dt_t1_head_a*dt_t1_wa+dt_t1_head_b*(1-dt_t1_wa);
  ) : dt_t1_fb_source=dt_t1_raw;

  dt_t2_pitch_active ? (
    dt_t2_pa=dt_t2_pitch_phase;
    dt_t2_pb=dt_t2_pa<0.5 ? dt_t2_pa+0.5 : dt_t2_pa-0.5;
    dt_t2_pitch_ratio>=1 ? (
      dt_t2_off_a=dt_t2_pa*dt_t2_pitch_window;
      dt_t2_off_b=dt_t2_pb*dt_t2_pitch_window;
    ) : (
      dt_t2_off_a=(1-dt_t2_pa)*dt_t2_pitch_window;
      dt_t2_off_b=(1-dt_t2_pb)*dt_t2_pitch_window;
    );
    dt_t2_head_a=dt_buffer_read_linear(dt_t2_buffer,dt_max_delay_samples,dt_t2_raw_read+dt_t2_off_a);
    dt_t2_head_b=dt_buffer_read_linear(dt_t2_buffer,dt_max_delay_samples,dt_t2_raw_read+dt_t2_off_b);
    dt_t2_wa=sin($pi*dt_t2_pa); dt_t2_wa*=dt_t2_wa;
    dt_t2_fb_source=dt_t2_head_a*dt_t2_wa+dt_t2_head_b*(1-dt_t2_wa);
  ) : dt_t2_fb_source=dt_t2_raw;

  // Feedback is filtered but deliberately never receives the post-delay Drive.
  dt_t1_fb_lp+=(dt_t1_fb_source-dt_t1_fb_lp)*dt_t1_filter_coeff;
  dt_t2_fb_lp+=(dt_t2_fb_source-dt_t2_fb_lp)*dt_t2_filter_coeff;
  dt_t1_fb_dc=dt_t1_fb_lp-dt_t1_fb_hp_x+dt_dc_block_coeff*dt_t1_fb_hp_y;
  dt_t2_fb_dc=dt_t2_fb_lp-dt_t2_fb_hp_x+dt_dc_block_coeff*dt_t2_fb_hp_y;
  dt_t1_fb_hp_x=dt_t1_fb_lp; dt_t1_fb_hp_y=dt_t1_fb_dc;
  dt_t2_fb_hp_x=dt_t2_fb_lp; dt_t2_fb_hp_y=dt_t2_fb_dc;

  dt_decay_shape<=2 ? (
    dt_t1_feedback=dt_t1_feedback_static;
    dt_t2_feedback=dt_t2_feedback_static;
  ) : (
    dt_t1_feedback=dt_feedback_shape(dt_t1_feedback_base,dt_decay_shape,dt_t1_fb_phase);
    dt_t2_feedback=dt_feedback_shape(dt_t2_feedback_base,dt_decay_shape,dt_t2_fb_phase);
  );

  // Mono tape input, same dual-mono topology as the source delay.
  dt_mono_input=(dt_inL+dt_inR)*0.5;
  dt_t1_write_value=dt_clamp(dt_mono_input+dt_t1_fb_dc*dt_t1_feedback,-4,4);
  dt_t2_write_value=dt_clamp(dt_mono_input+dt_t2_fb_dc*dt_t2_feedback,-4,4);
  dt_t1_buffer[dt_t1_write]=dt_t1_write_value;
  dt_t2_buffer[dt_t2_write]=dt_t2_write_value;
  dt_t1_write+=1; dt_t2_write+=1;
  dt_t1_write>=dt_max_delay_samples ? dt_t1_write=0;
  dt_t2_write>=dt_max_delay_samples ? dt_t2_write=0;

  dt_decay_phase_active ? (
    dt_t1_fb_phase+=1/max(1,dt_t1_time_cur);
    dt_t2_fb_phase+=1/max(1,dt_t2_time_cur);
    dt_t1_fb_phase>=1 ? dt_t1_fb_phase-=1;
    dt_t2_fb_phase>=1 ? dt_t2_fb_phase-=1;
  );

  // Smooth static pan targets directly as gains.
  dt_t1_pan_l_smooth+=(dt_t1_pan_l_target-dt_t1_pan_l_smooth)*dt_pan_coeff;
  dt_t1_pan_r_smooth+=(dt_t1_pan_r_target-dt_t1_pan_r_smooth)*dt_pan_coeff;
  dt_t2_pan_l_smooth+=(dt_t2_pan_l_target-dt_t2_pan_l_smooth)*dt_pan_coeff;
  dt_t2_pan_r_smooth+=(dt_t2_pan_r_target-dt_t2_pan_r_smooth)*dt_pan_coeff;

  // Fixed equal contribution from both tapes; stereo placement is controlled
  // entirely by Delay Stereo Spread.
  dt_wetL=(dt_t1_wet*dt_t1_pan_l_smooth
          +dt_t2_wet*dt_t2_pan_l_smooth)*dt_tape_equal_gain;
  dt_wetR=(dt_t1_wet*dt_t1_pan_r_smooth
          +dt_t2_wet*dt_t2_pan_r_smooth)*dt_tape_equal_gain;

  // Full audible Delay output.
  spl0=dt_inL*dt_dry_mix+dt_wetL*dt_wet_mix;
  spl1=dt_inR*dt_dry_mix+dt_wetR*dt_wet_mix;

  // Reverb excitation: direct component is unchanged, while only the delayed
  // repeats are scaled by Delay to Reverb. 100% is the former standard level;
  // 101..300% intentionally push the echoes harder into the Reverb.
  dt_before_rev_feedL=dt_inL*dt_dry_mix+dt_wetL*dt_wet_mix*dt_reverb_send;
  dt_before_rev_feedR=dt_inR*dt_dry_mix+dt_wetR*dt_wet_mix*dt_reverb_send;

  // If an echo/feedback sample is still meaningful, preserve enough time to
  // reach the next possible repeat. Otherwise count the pending gap down.
  dt_tail_level=max(
    max(abs(dt_t1_raw),abs(dt_t2_raw)),
    max(
      max(abs(dt_t1_wet_dc),abs(dt_t2_wet_dc)),
      max(abs(dt_t1_fb_dc),abs(dt_t2_fb_dc))
    )
  );

  (dt_source_active || dt_tail_level>0.000000001) ? (
    dt_pending_samples=max(dt_pending_samples,max(64,dt_tail_gap_samples));
  ) : (
    dt_pending_samples>0 ? dt_pending_samples-=1;
  );
) : (
  // True low-CPU bypass. If Delay Mix is ON but there is no real audio in
  // flight, do literally nothing. Lazy buffer flushing is needed only when
  // Delay itself is OFF.
  // eventually flushes itself without running filters, pitch shifters or Drive.
  !dt_mix_active && dt_flush_remaining>0 ? (
    dt_t1_buffer[dt_t1_write]=0;
    dt_t2_buffer[dt_t2_write]=0;
    dt_t1_write+=1; dt_t2_write+=1;
    dt_t1_write>=dt_max_delay_samples ? dt_t1_write=0;
    dt_t2_write>=dt_max_delay_samples ? dt_t2_write=0;
    dt_flush_remaining-=1;
  );
);

// ============================================================
// REVERB
// Reverb always receives the direct component plus the user-controlled
// Delay send. There is no separate Before/After routing mode.
// ============================================================
shared_dryL = spl0;
shared_dryR = spl1;

// The active topology always uses the dedicated Delay-to-Reverb feed.
shared_reverb_inL = dt_before_rev_feedL;
shared_reverb_inR = dt_before_rev_feedR;

// REAL AUDIO ACTIVITY, NOT MIDI/VOICE ACTIVITY.
// A held key with a completed zero-sustain envelope must not keep the reverb
// or synth post-processing alive. A tiny hold bridges oscillator zero crossings.
shared_source_level = max(abs(shared_reverb_inL),abs(shared_reverb_inR));
shared_source_level > 0.00000001 ? (
  rev_source_hold = 96;
) : (
  rev_source_hold > 0 ? rev_source_hold -= 1;
);
shared_source_active = rev_source_hold > 0;

// Keep processing while reflections are physically in flight.
rev_mix_on && shared_source_active ? (
  rev_pending_samples = max(rev_pending_samples, rev_tap4 + rev_d8 + 32);
  rev_quiet_count = 0;
) : (
  rev_pending_samples > 0 ? rev_pending_samples -= 1;
);

rev_should_process = (rev_mix_on && shared_source_active)
                  || rev_pending_samples > 0
                  || rev_tail_hold;

// The tail opens as it becomes separated from the direct instrument.
// While notes are active it stays spatially attached; after release it
// progressively occupies a wider, moving field.
shared_source_active ? (
  rev_tail_age = 0;
) : rev_should_process ? (
  rev_tail_age += 1;
) : (
  rev_tail_age = 0;
);

rev_tail_open = min(1, rev_tail_age / max(1, srate*1.35));
rev_tail_open = rev_tail_open*rev_tail_open*(3-2*rev_tail_open);

rev_should_process ? (
  // Warm input LP + fixed 90 Hz HP.
  rev_send_lpL += (shared_reverb_inL-rev_send_lpL)*rev_send_k;
  rev_send_lpR += (shared_reverb_inR-rev_send_lpR)*rev_send_k;
  rev_send_lowL += (rev_send_lpL-rev_send_lowL)*rev_hp_k;
  rev_send_lowR += (rev_send_lpR-rev_send_lowR)*rev_hp_k;
  rev_inL = (rev_send_lpL-rev_send_lowL) * 0.62;
  rev_inR = (rev_send_lpR-rev_send_lowR) * 0.62;

  rev_erL_base[rev_idx] = rev_mix_on ? rev_inL : 0;
  rev_erR_base[rev_idx] = rev_mix_on ? rev_inR : 0;

  rev_e1 = courtyard_read(rev_erL_base,rev_tap1);
  rev_e2 = courtyard_read(rev_erR_base,rev_tap2);
  rev_e3 = courtyard_read(rev_erL_base,rev_tap3);
  rev_e4 = courtyard_read(rev_erR_base,rev_tap4);

  rev_earlyL = rev_e1*0.50 + rev_e2*0.28 + rev_e3*0.22 + rev_e4*0.14;
  rev_earlyR = rev_e1*0.28 + rev_e2*0.50 + rev_e3*0.14 + rev_e4*0.22;

  // ------------------------------------------------------------
  // DIFFUSE LATE-FIELD INPUT
  // Two short allpass stages per channel increase echo density before
  // energy enters the recursive network. They are static: no chorus.
  // ------------------------------------------------------------
  rev_ap_z = courtyard_read(rev_ap1L_base,rev_ap1L_d);
  rev_ap_y = rev_ap_z - rev_ap1_g*rev_inL;
  rev_ap1L_base[rev_idx] = rev_inL + rev_ap1_g*rev_ap_y;
  rev_apL = rev_ap_y;

  rev_ap_z = courtyard_read(rev_ap1R_base,rev_ap1R_d);
  rev_ap_y = rev_ap_z - rev_ap1_g*rev_inR;
  rev_ap1R_base[rev_idx] = rev_inR + rev_ap1_g*rev_ap_y;
  rev_apR = rev_ap_y;

  rev_ap_z = courtyard_read(rev_ap2L_base,rev_ap2L_d);
  rev_ap_y = rev_ap_z - rev_ap2_g*rev_apL;
  rev_ap2L_base[rev_idx] = rev_apL + rev_ap2_g*rev_ap_y;
  rev_diffL = rev_ap_y;

  rev_ap_z = courtyard_read(rev_ap2R_base,rev_ap2R_d);
  rev_ap_y = rev_ap_z - rev_ap2_g*rev_apR;
  rev_ap2R_base[rev_idx] = rev_apR + rev_ap2_g*rev_ap_y;
  rev_diffR = rev_ap_y;

  // Eight irregular delay lines.
  rev_q1 = courtyard_read(rev_d1_base,rev_d1);
  rev_q2 = courtyard_read(rev_d2_base,rev_d2);
  rev_q3 = courtyard_read(rev_d3_base,rev_d3);
  rev_q4 = courtyard_read(rev_d4_base,rev_d4);
  rev_q5 = courtyard_read(rev_d5_base,rev_d5);
  rev_q6 = courtyard_read(rev_d6_base,rev_d6);
  rev_q7 = courtyard_read(rev_d7_base,rev_d7);
  rev_q8 = courtyard_read(rev_d8_base,rev_d8);

  // Frequency-dependent decay, intentionally slightly different per line.
  rev_fb_lp1 += (rev_q1-rev_fb_lp1)*rev_damp_k1;
  rev_fb_lp2 += (rev_q2-rev_fb_lp2)*rev_damp_k2;
  rev_fb_lp3 += (rev_q3-rev_fb_lp3)*rev_damp_k3;
  rev_fb_lp4 += (rev_q4-rev_fb_lp4)*rev_damp_k4;
  rev_fb_lp5 += (rev_q5-rev_fb_lp5)*rev_damp_k5;
  rev_fb_lp6 += (rev_q6-rev_fb_lp6)*rev_damp_k6;
  rev_fb_lp7 += (rev_q7-rev_fb_lp7)*rev_damp_k7;
  rev_fb_lp8 += (rev_q8-rev_fb_lp8)*rev_damp_k8;

  // Normalized 8x8 Walsh-Hadamard scattering.
  // This is lossless before the per-line feedback gains and rapidly mixes
  // every returning echo with all the others.
  rev_a1 = rev_fb_lp1 + rev_fb_lp2;
  rev_a2 = rev_fb_lp1 - rev_fb_lp2;
  rev_a3 = rev_fb_lp3 + rev_fb_lp4;
  rev_a4 = rev_fb_lp3 - rev_fb_lp4;
  rev_a5 = rev_fb_lp5 + rev_fb_lp6;
  rev_a6 = rev_fb_lp5 - rev_fb_lp6;
  rev_a7 = rev_fb_lp7 + rev_fb_lp8;
  rev_a8 = rev_fb_lp7 - rev_fb_lp8;

  rev_b1 = rev_a1 + rev_a3;
  rev_b2 = rev_a2 + rev_a4;
  rev_b3 = rev_a1 - rev_a3;
  rev_b4 = rev_a2 - rev_a4;
  rev_b5 = rev_a5 + rev_a7;
  rev_b6 = rev_a6 + rev_a8;
  rev_b7 = rev_a5 - rev_a7;
  rev_b8 = rev_a6 - rev_a8;

  rev_hnorm = 0.353553390593274;
  rev_h1 = (rev_b1 + rev_b5)*rev_hnorm;
  rev_h2 = (rev_b2 + rev_b6)*rev_hnorm;
  rev_h3 = (rev_b3 + rev_b7)*rev_hnorm;
  rev_h4 = (rev_b4 + rev_b8)*rev_hnorm;
  rev_h5 = (rev_b1 - rev_b5)*rev_hnorm;
  rev_h6 = (rev_b2 - rev_b6)*rev_hnorm;
  rev_h7 = (rev_b3 - rev_b7)*rev_hnorm;
  rev_h8 = (rev_b4 - rev_b8)*rev_hnorm;

  // Pure normalized Hadamard feedback matrix.
  // Do not interpolate it with the identity: that would make the feedback
  // matrix non-unitary and change the decay time/modal damping.
  rev_m1 = rev_h1;
  rev_m2 = rev_h2;
  rev_m3 = rev_h3;
  rev_m4 = rev_h4;
  rev_m5 = rev_h5;
  rev_m6 = rev_h6;
  rev_m7 = rev_h7;
  rev_m8 = rev_h8;

  rev_in_mid = (rev_diffL+rev_diffR)*0.5;
  rev_in_side = (rev_diffL-rev_diffR)*0.5;

  // Spread the diffused source over all lines with different signs/weights.
  rev_i1 = rev_mix_on ? (rev_diffL*0.085 + rev_earlyL*0.13) : 0;
  rev_i2 = rev_mix_on ? (rev_diffR*0.085 + rev_earlyR*0.13) : 0;
  rev_i3 = rev_mix_on ? (rev_in_mid*0.080 + rev_in_side*0.045) : 0;
  rev_i4 = rev_mix_on ? (rev_in_mid*0.080 - rev_in_side*0.045) : 0;
  rev_i5 = rev_mix_on ? (rev_diffL*0.060 - rev_diffR*0.025 + rev_earlyR*0.055) : 0;
  rev_i6 = rev_mix_on ? (rev_diffR*0.060 - rev_diffL*0.025 + rev_earlyL*0.055) : 0;
  rev_i7 = rev_mix_on ? (rev_in_mid*0.055 + rev_in_side*0.060) : 0;
  rev_i8 = rev_mix_on ? (rev_in_mid*0.055 - rev_in_side*0.060) : 0;

  rev_d1_base[rev_idx] = rev_i1 + rev_m1*rev_fb1;
  rev_d2_base[rev_idx] = rev_i2 + rev_m2*rev_fb2;
  rev_d3_base[rev_idx] = rev_i3 + rev_m3*rev_fb3;
  rev_d4_base[rev_idx] = rev_i4 + rev_m4*rev_fb4;
  rev_d5_base[rev_idx] = rev_i5 + rev_m5*rev_fb5;
  rev_d6_base[rev_idx] = rev_i6 + rev_m6*rev_fb6;
  rev_d7_base[rev_idx] = rev_i7 + rev_m7*rev_fb7;
  rev_d8_base[rev_idx] = rev_i8 + rev_m8*rev_fb8;

  // Dense signed output projections. RMS is kept close to the old 4-line output.
  rev_lateL = rev_q1*0.28 - rev_q2*0.18 + rev_q3*0.24 + rev_q4*0.12
            - rev_q5*0.20 + rev_q6*0.18 + rev_q7*0.14 - rev_q8*0.10;
  rev_lateR = rev_q2*0.28 + rev_q1*0.18 - rev_q4*0.24 + rev_q3*0.12
            + rev_q6*0.20 - rev_q5*0.18 - rev_q8*0.14 + rev_q7*0.10;

  // Filtered body support. Two one-pole states form a broad 180 Hz..~3 kHz band:
  // LP(high) minus LP(low). It reinforces the tail without touching dry/early.
  rev_body_lpL += (rev_lateL-rev_body_lpL)*rev_body_hi_k;
  rev_body_lpR += (rev_lateR-rev_body_lpR)*rev_body_hi_k;
  rev_body_lowL += (rev_body_lpL-rev_body_lowL)*rev_body_lo_k;
  rev_body_lowR += (rev_body_lpR-rev_body_lowR)*rev_body_lo_k;
  rev_body_bandL = rev_body_lpL - rev_body_lowL;
  rev_body_bandR = rev_body_lpR - rev_body_lowR;

  rev_late_bodyL = rev_lateL + rev_body_bandL*rev_body_support;
  rev_late_bodyR = rev_lateR + rev_body_bandR*rev_body_support;

  // ------------------------------------------------------------
  // MOVING / OPENING LATE FIELD
  // ------------------------------------------------------------
  // Build an additional decorrelated side projection directly from different
  // FDN lines. This prevents the far tail from mathematically collapsing to
  // mono even when the main L/R projection happens to cancel.
  rev_tail_decor = ( rev_q1 - rev_q5
                   + rev_q3 - rev_q7
                   - rev_q2 + rev_q6
                   - rev_q4 + rev_q8) * 0.16;

  rev_late_mid = (rev_late_bodyL+rev_late_bodyR)*0.5;
  rev_late_side = (rev_late_bodyL-rev_late_bodyR)*0.5;

  // As the dry source disappears, widen progressively. The second random walk
  // breathes the spread asynchronously, while Width remains the master scale.
  rev_tail_spread_mul = 1
                      + rev_tail_open*rev_tail_motion
                      * (1.35 + rev_motion_spread*0.32);
  rev_tail_spread_mul = max(1, rev_tail_spread_mul);

  rev_late_side = rev_late_side*rev_width_gain*rev_tail_spread_mul
                + rev_tail_decor*rev_tail_open*rev_tail_motion
                  *(0.55 + 0.35*rev_width);

  // Slow wandering position. It becomes more apparent only in the exposed tail.
  rev_tail_pan = rev_motion_pan * rev_tail_motion
               * (0.10 + 0.42*rev_tail_open);
  rev_tail_pan = max(-0.55,min(0.55,rev_tail_pan));

  rev_late_moveL = (rev_late_mid + rev_late_side) * (1-rev_tail_pan);
  rev_late_moveR = (rev_late_mid - rev_late_side) * (1+rev_tail_pan);

  // Early reflections stay architectural/stable; only late body wanders.
  rev_wetL = rev_earlyL*rev_early_gain + rev_late_moveL*rev_late_gain;
  rev_wetR = rev_earlyR*rev_early_gain + rev_late_moveR*rev_late_gain;

  // Existing wet Width still opens the complete ambience, while the dedicated
  // late-tail process above guarantees that the far body does not shrink inward.
  rev_mid = (rev_wetL+rev_wetR)*0.5;
  rev_side = (rev_wetL-rev_wetR)*0.5*rev_width_gain;
  rev_wetL = rev_mid + rev_side;
  rev_wetR = rev_mid - rev_side;

  rev_tail_energy = max(
    max(max(abs(rev_q1),abs(rev_q2)),max(abs(rev_q3),abs(rev_q4))),
    max(max(max(abs(rev_q5),abs(rev_q6)),max(abs(rev_q7),abs(rev_q8))),
        max(abs(rev_earlyL),abs(rev_earlyR)))
  );

  // Tail lifetime is determined by the recursive energy, not by a fixed
  // 1024-sample gate. A longer RT60 gets a longer confirmation window so a
  // sparse zero crossing cannot falsely stop a huge tail.
  rev_tail_floor = 0.000000005;
  rev_tail_quiet_needed = min(floor(srate*0.25),
                              max(1024,floor(srate*(0.020 + rev_rt60_sec*0.0015))));

  rev_tail_energy > rev_tail_floor ? (
    rev_quiet_count = 0;
  ) : (
    rev_quiet_count += 1;
  );
  rev_tail_hold = rev_pending_samples > 0 || rev_quiet_count < rev_tail_quiet_needed;

  // Same x2 wet calibration approved in Strings 0.33.
  rev_mix_on ? (
    spl0 = shared_dryL + rev_wetL*rev_mix*2;
    spl1 = shared_dryR + rev_wetR*rev_mix*2;
  ) : (
    spl0 = shared_dryL;
    spl1 = shared_dryR;
  );

  rev_idx += 1;
  rev_idx >= rev_buf_len ? rev_idx = 0;
) : (
  rev_tail_hold = 0;
  rev_tail_energy = 0;
  rev_pending_samples = 0;
  rev_quiet_count = 2048;
  rev_body_lpL = rev_body_lpR = 0;
  rev_body_lowL = rev_body_lowR = 0;
  rev_tail_age = 0;
  rev_source_hold = 0;
  spl0 = shared_dryL;
  spl1 = shared_dryR;
);

// ============================================================
// GLOBAL COLD SLEEP — TRUE-SILENCE QUALIFIER
// ============================================================
// All original DSP keeps running until engine ownership, shared-effect tails and
// the final output have been truly silent for 2048 consecutive samples.
global_engine_active_sample = 0;
engine_now < 0.5 ? (
  global_engine_active_sample = rh_active_count > 0;
) : engine_now < 1.5 ? (
  global_engine_active_sample = wz_active_count > 0;
) : engine_now < 2.5 ? (
  global_engine_active_sample = org_any_active;
) : engine_now < 3.5 ? (
  global_engine_active_sample = mode < 2 ? mono_stage != 0 : poly_active_count > 0;
) : engine_now < 4.5 ? (
  global_engine_active_sample = ml_active_count > 0;
) : engine_now < 5.5 ? (
  global_engine_active_sample = wi_active_count > 0;
) : (
  global_engine_active_sample = ms_note_active || ms_env_stage != 0;
);

global_effects_idle_sample = (!dt_mix_active || dt_pending_samples <= 0)
                          && dt_flush_remaining <= 0
                          && !rev_should_process
                          && rev_pending_samples <= 0
                          && !rev_tail_hold;

!global_engine_active_sample
&& global_effects_idle_sample
&& abs(spl0) <= 0.000000000001
&& abs(spl1) <= 0.000000000001 ? (
  global_idle_quiet_count < global_idle_quiet_needed ? global_idle_quiet_count += 1;
) : (
  global_idle_quiet_count = 0;
);

); // end awake @sample path

// ============================================================
// END SHARED EFFECT CHAIN
// ============================================================

@serialize

// Persist the six hidden Mallet parameter Current Banks. Public sliders are
// serialized automatically by REAPER; realtime DSP RAM is rebuilt in @init.
file_var(0,ml_mal_bank_magic);
file_mem(0,ml_MAL_BANK,ml_MAL_BANK_TOTAL);

// Preserve the legacy Reverb serialization footprint exactly: the first
// sixteen owners (4 standard + 6 Mallet + 6 Wind) stay at 160 values so
// projects made with 0.27 read back without shifting the Wind fields.
file_var(0,rev_bank_magic);
file_mem(0,rev_current_bank,16*rev_current_stride);

// Wind persistence remains at the exact legacy position.
file_var(0,wi_win_bank_magic);
file_mem(0,wi_WIN_BANK,wi_WIN_BANK_TOTAL);

// Micro Synth Reverb owner is append-only after all legacy serialized data.
// Public Micro sliders 241..256 are serialized automatically by REAPER.
file_mem(0,rev_current_bank+16*rev_current_stride,rev_current_stride);

// Contextual Delay banks are new in 0.29 and are appended after every 0.28
// field, so older Mallet/Wind/Reverb serialized data keeps its exact position.
file_var(0,dt_bank_magic);
file_mem(0,dt_current_bank,dt_owner_count*dt_current_stride);

// Append-only compatibility marker for the 2026-08-20 Fine Tune unit change.
file_var(0,fine_tune_units_magic);
