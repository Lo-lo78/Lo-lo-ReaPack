// TEST15: True idle for Strings + Micro Synth; active DSP unchanged (2026-09-15).

// TEST20: Strings direct MIDI; queue/sample-offset/midisend hot path removed (2026-09-15).

// TEST23: Strings Full Oversampling + fused RawLog/Knee Comb kernel (2026-09-15).

@init

// ============================================================
// FINE TUNE UNIT MIGRATION
// Old builds exposed Fine Tune as -100..+100 cents. The new public range is
// -12.00..+12.00 semitones, where 0.01 semitone = 1 cent. REAPER restores
// public slider state normalized to the declared range, so an old non-zero
// Fine Tune arrives 12x too large after the range change. Divide the six
// host-visible Fine Tune controls by 12 exactly once for old project state.
// (Micro Synth has no dedicated Fine Tune slider in the 256-slider core.)
// ============================================================
fine_tune_units_magic_value=81201;
fine_tune_units_magic!=fine_tune_units_magic_value ? (
  slider9   /= 12;
  slider61  /= 12;
  slider102 /= 12;
  slider139 /= 12;
  slider172 /= 12;
  slider216 /= 12;
  fine_tune_units_magic=fine_tune_units_magic_value;
);

// ============================================================
// REALTIME RAM CLEAR FOR SERIALIZED MULTI-ENGINE BUILD
//
// Mallet Current Banks use @serialize so hidden instrument edits survive
// project save/load. A non-empty @serialize suppresses REAPER's usual RAM clear,
// therefore clear only realtime DSP/state regions here and deliberately leave
// the persistent Mallet bank at 2,301,200..2,301,373 and Wind bank at
// 2,310,000..2,310,173 untouched. Micro Synth has no hidden parameter bank.
// ============================================================
memset(0,0,8192); // Strings + low helper/key/event RAM; lookup table is rebuilt below.
me_rev_clear_len=floor(srate*0.35)+32;
memset(30000,0,14*me_rev_clear_len); // shared courtyard delay/allpass RAM.
memset(2000000,0,10000); // Organ + Otari realtime RAM.
memset(2100000,0,2000);  // Rhodes realtime RAM.
memset(2200000,0,2000);  // Wurlitzer realtime RAM.
memset(2300000,0,1200);  // Mallet voice/key realtime RAM only.
memset(2301400,0,64);     // Mallet live-value sentinels; not persistent banks.
memset(2320000,0,80000);    // Wind physical waveguides + realtime voice/key state.

// ============================================================
// COMPACT DUAL TAPE DELAY — realtime RAM + helpers
// ============================================================
// LDelay2's two 16-second mono tape buffers are retained where RAM allows.
// They start above the serialized Mallet/Reverb bank area. At common rates
// through 96 kHz the full 16 seconds per tape are available; at very high
// sample rates the length is capped automatically before JSFX RAM's ceiling.
dt_db2log = 0.1151292546497022842;
dt_ln2 = 0.6931471805599453094;
dt_pi2 = 2*$pi;
dt_filter_exp_scale = dt_pi2/srate;
dt_pitch_window_max = srate*0.060;
dt_filter_hz_limit = min(22000,srate*0.45);
dt_epsilon = 0.0000001;
dt_dc_block_coeff = 0.995;
dt_mem_limit = 8300000;
dt_t1_buffer = 2400000;
dt_max_by_ram = floor((dt_mem_limit-dt_t1_buffer-64)/2)-16;
dt_max_delay_samples = min(floor(srate*16)+8,dt_max_by_ram);
dt_max_delay_samples = max(4096,dt_max_delay_samples);
dt_max_delay_read = dt_max_delay_samples-4;
dt_t2_buffer = dt_t1_buffer+dt_max_delay_samples+16;
memset(dt_t1_buffer,0,dt_max_delay_samples);
memset(dt_t2_buffer,0,dt_max_delay_samples);

function dt_clamp(dt_v,dt_lo,dt_hi) (
  max(dt_lo,min(dt_hi,dt_v));
);

function dt_db_to_gain(dt_db) (
  dt_db <= -119.9 ? 0 : exp(dt_db*dt_db2log);
);

function dt_exp2(dt_x) (
  exp(dt_x*dt_ln2);
);

function dt_wrap01(dt_p) (
  dt_p -= floor(dt_p);
  dt_p < 0 ? dt_p += 1;
  dt_p;
);

// Decay-shape family preserved from LDelay2. Costly branches only execute
// when the corresponding non-Normal mode is selected.
function dt_feedback_shape(dt_base,dt_shape,dt_phase)
local(dt_p,dt_v,dt_n,dt_grain,dt_steps,dt_step,dt_osc,dt_curve,dt_chaos,dt_bits,dt_bounce,dt_saw,dt_warp,dt_tw,dt_q) (
  dt_p=dt_wrap01(dt_phase);
  dt_v=dt_base;
  dt_shape==1 ? (
    dt_v=pow(dt_base,1.8);
  ) : dt_shape==2 ? (
    dt_v=pow(dt_base,0.6);
  ) : dt_shape==3 ? (
    dt_v=dt_base*abs(cos(dt_p*3.1)*exp(-3*dt_p));
  ) : dt_shape==4 ? (
    dt_v=dt_base*(0.5+0.5*sin(dt_p*$pi));
  ) : dt_shape==5 ? (
    dt_v=dt_base*(1-dt_p*dt_p);
  ) : dt_shape==6 ? (
    dt_p<0.35 ? dt_v=dt_base*(1-dt_p*1.2) :
    dt_p<0.65 ? dt_v=dt_base*0.35 :
                dt_v=dt_base*max(0,1-(dt_p-0.65)*3);
  ) : dt_shape==7 ? (
    dt_steps=6; dt_step=floor(dt_p*dt_steps);
    dt_v=dt_base*(1-dt_step/dt_steps);
  ) : dt_shape==8 ? (
    dt_osc=0.5*(1+sin(dt_p*8*$pi));
    dt_v=dt_base*(1-dt_p)*dt_osc;
  ) : dt_shape==9 ? (
    dt_v=dt_base*(dt_p<0.4 ? 1.3*dt_p : 1-(dt_p-0.4)*1.6);
  ) : dt_shape==10 ? (
    dt_n=sin(dt_p*13.7*$pi)*sin(dt_p*29.3*$pi);
    dt_v=dt_base*max(0,(1-dt_p)*(0.6+0.4*dt_n));
  ) : dt_shape==11 ? (
    dt_grain=floor(dt_p*32)%2;
    dt_v=dt_base*(1-dt_p)*(dt_grain ? 1 : 0.3);
  ) : dt_shape==12 ? (
    dt_curve=sin(dt_p*dt_pi2)*0.5+0.5;
    dt_v=dt_base*pow(dt_curve,1.5)*(1-dt_p);
  ) : dt_shape==13 ? (
    dt_chaos=3.9*dt_p*(1-dt_p);
    dt_chaos=3.9*dt_chaos*(1-dt_chaos);
    dt_v=dt_base*(1-dt_p)*dt_chaos;
  ) : dt_shape==14 ? (
    dt_bits=1+floor((1-dt_p)*8);
    dt_v=floor(dt_base*dt_bits)/dt_bits;
  ) : dt_shape==15 ? (
    dt_bounce=abs(cos(dt_p*6*$pi))*exp(-4*dt_p);
    dt_v=dt_base*(dt_p*0.6+dt_bounce*0.4);
  ) : dt_shape==16 ? (
    dt_saw=(dt_p*12)%1;
    dt_warp=sin(dt_p*7*$pi)*0.4+0.6;
    dt_v=dt_base*(1-dt_saw*dt_warp);
  ) : dt_shape==17 ? (
    dt_tw=sin(dt_p*3.7*$pi)*sin(dt_p*8.1*$pi);
    dt_v=dt_base*max(0,(1-dt_p)*(0.5+dt_tw*0.5));
  ) : dt_shape==18 ? (
    dt_v=dt_base*(1-pow(dt_p,0.25));
  ) : dt_shape==19 ? (
    dt_q=(rand(2)-1)*0.15;
    dt_v=dt_base*max(0,(1-dt_p)+dt_q);
  );
  dt_clamp(dt_v,0,0.9995);
);

function dt_buffer_read_linear(dt_base,dt_length,dt_pos)
local(dt_i0,dt_i1,dt_frac,dt_a,dt_b) (
  dt_pos<0 ? dt_pos+=dt_length;
  dt_pos>=dt_length ? dt_pos-=dt_length;
  dt_i0=floor(dt_pos);
  dt_i1=dt_i0+1;
  dt_i1>=dt_length ? dt_i1=0;
  dt_frac=dt_pos-dt_i0;
  dt_a=dt_base[dt_i0];
  dt_b=dt_base[dt_i1];
  dt_a+(dt_b-dt_a)*dt_frac;
);

// Same inexpensive asymmetric post-delay tape shaper as LDelay2.
function dt_tape_distort(dt_x,dt_a,dt_drive,dt_bias,dt_zero,dt_soft_mix,dt_hard_mix)
local(dt_u,dt_au,dt_soft,dt_hard,dt_shaped) (
  dt_u=dt_clamp(dt_x*dt_drive+dt_bias,-16,16);
  dt_au=abs(dt_u);
  dt_u>=0 ? dt_soft=dt_u/(1+dt_au) : dt_soft=0.78*dt_u/(0.78+dt_au);
  dt_hard=dt_clamp(dt_u,-1,1);
  dt_shaped=dt_soft*dt_soft_mix+dt_hard*dt_hard_mix-dt_zero;
  dt_x+(dt_shaped-dt_x)*dt_a;
);

// Delay realtime state.
dt_t1_write=0; dt_t2_write=0;
dt_t1_time_cur=0; dt_t2_time_cur=0;
dt_t1_pitch_phase=0; dt_t2_pitch_phase=0;
dt_t1_fb_phase=0; dt_t2_fb_phase=0;
dt_t1_wet_lp=0; dt_t2_wet_lp=0;
dt_t1_wet_hp_x=0; dt_t2_wet_hp_x=0;
dt_t1_wet_hp_y=0; dt_t2_wet_hp_y=0;
dt_t1_fb_lp=0; dt_t2_fb_lp=0;
dt_t1_fb_hp_x=0; dt_t2_fb_hp_x=0;
dt_t1_fb_hp_y=0; dt_t2_fb_hp_y=0;
dt_t1_pan_l_smooth=0.9807852804; dt_t1_pan_r_smooth=0.1950903220;
dt_t2_pan_l_smooth=0.1950903220; dt_t2_pan_r_smooth=0.9807852804;
dt_mix_active=0;
dt_flush_remaining=0;

// TEST15: Delay control state is separate from real audio-in-flight state.
// A non-zero Delay Mix must not keep an otherwise silent instrument awake.
dt_pending_samples=0;
dt_tail_gap_samples=0;
dt_source_level=0;
dt_source_active=0;
dt_tail_level=0;
dt_should_process=0;

twopi = 2*$pi;
  inv_twopi = 1/twopi;

  // Poly voice memory: 6 slots each.
  v_active = 0;
  v_note   = 8;
  v_phase  = 16;
  v_freq   = 24;
  v_target = 32;
  v_env    = 40;
  v_stage  = 48;
  v_vel    = 56;
  v_age    = 64;
  v_exc    = 1200;
  v_tension = 1208;
  v_finger = 1216;
  v_finger_stage = 1224;
  v_finger_vel = 1232;
  v_pick_env = 1240;
  v_pick_lp  = 1248;
  v_pick_dc  = 1256;

  // Local 2x Strings oversampling decimator state.
  // Slots 0..5 = Poly 6; slot 6 = mono.
  osc2_x1 = 1264;
  osc2_x2 = 1272;
  osc2_y1 = 1280;
  osc2_y2 = 1288;
  v_os    = 1296; // per-voice adaptive oscillator oversampling: 1 / 2 / 4
  v_glide = 1304;
  v_os_dirty = 1312;
  v_life_mod = 1320;
  v_timbre_scale = 1328;
  v_phase_step = 1336;
  v_pick_gain = 1344;

  // Recursive first-warp-sine state, slots 0..5 poly, 6 mono.
  warp_rec_sin   = 1352;
  warp_rec_cos   = 1360;
  warp_rec_dsin  = 1368;
  warp_rec_dcos  = 1376;
  warp_rec_ready = 1384;
  warp_rec_count = 1392;

  // Intelligent stereo state, slots 0..5 poly, 6 mono.
  fan_lp1 = 1400;
  fan_lp2 = 1408;
  v_key_gainL = 1416;
  v_key_gainR = 1424;

  // Velocity-dependent body low-pass, slots 0..5 poly, 6 mono.
  vel_tone_state  = 1432;
  vel_tone_k      = 1440;
  vel_tone_ready  = 1448;
  vel_tone_state2 = 1456;

  // Pitch-ratio LUT: -512..+512 cents in 0.25-cent steps.
  // Replaces per-voice per-sample pow()/2^ pitch conversion.
  pitch_lut = 2000;
  pitch_lut_size = 4097;

  // Monophonic held-note state.
  held_state = 80;
  held_order = 208;

  // Sample-accurate MIDI queue, max 256 events per block.
  evt_ofs   = 400;
  evt_msg1  = 656;
  evt_msg23 = 912;

  i = 0;
  loop(6,
    v_active[i] = 0;
    v_note[i] = -1;
    v_phase[i] = 0;
    v_freq[i] = 0;
    v_target[i] = 0;
    v_env[i] = 0;
    v_stage[i] = 0;
    v_vel[i] = 0;
    v_age[i] = 0;
    v_exc[i] = 0;
    v_tension[i] = 0;
    v_finger[i] = 0;
    v_finger_stage[i] = 0;
    v_finger_vel[i] = 0;
    v_pick_env[i] = 0;
    v_pick_lp[i] = 0;
    v_pick_dc[i] = 0;
    v_os[i] = 1;
    v_glide[i] = 0;
    v_os_dirty[i] = 1;
    v_life_mod[i] = 0;
    v_timbre_scale[i] = 1;
    v_phase_step[i] = 0;
    v_pick_gain[i] = 0;
    i += 1;
  );

  i = 0;
  loop(7,
    osc2_x1[i] = 0;
    osc2_x2[i] = 0;
    osc2_y1[i] = 0;
    osc2_y2[i] = 0;

    warp_rec_sin[i] = 0;
    warp_rec_cos[i] = 1;
    warp_rec_dsin[i] = 0;
    warp_rec_dcos[i] = 1;
    warp_rec_ready[i] = 0;
    warp_rec_count[i] = 0;
    fan_lp1[i] = 0;
    fan_lp2[i] = 0;
    v_key_gainL[i] = 1;
    v_key_gainR[i] = 1;
    vel_tone_state[i] = 0;
    vel_tone_state2[i] = 0;
    vel_tone_k[i] = 1;
    vel_tone_ready[i] = 0;
    i += 1;
  );

  i = 0;
  loop(pitch_lut_size,
    lut_cents = -512 + i*0.25;
    pitch_lut[i] = 2^(lut_cents/1200);
    i += 1;
  );

  i = 0;
  loop(128,
    held_state[i] = 0;
    held_order[i] = 0;
    i += 1;
  );

  mono_phase = 0;
  mono_freq = 0;
  mono_target = 0;
  mono_env = 0;
  mono_stage = 0;
  mono_note = -1;
  mono_vel = 1;
  mono_exc = 0;
  mono_tension = 0;
  mono_finger = 0;
  mono_finger_stage = 0;
  mono_finger_vel = 0;
  mono_pick_env = 0;
  mono_pick_lp = 0;
  mono_pick_dc = 0;
  mono_pick_gain = 0;
  mono_os = 1;
  mono_glide = 0;
  mono_os_dirty = 1;
  mono_life_mod = 0;
  mono_timbre_scale = 1;
  mono_phase_step = 0;
  mono_key_gainL = 1;
  mono_key_gainR = 1;
  stereo_active = 0;
  stereoL = 0;
  stereoR = 0;

  // MIDI expression.
  pitch_bend_norm = 0;
  pitch_bend_cents = 0;
  pitch_bend_ratio = 1;
  mod_wheel = 0;

  // One global free-running sine vibrato. Only its rate wanders.
  vib_phase = 0;
  vib_phase_inc = twopi * 5.5 / srate;
  vib_rate_wander_a = 0;
  vib_rate_wander_b = 0;
  vib_rate_target_a = 0;
  vib_rate_target_b = 0;
  vib_rate_count_a = 1;
  vib_rate_count_b = 1;
  vib_rate_current = 5.5;
  vib_cents_sample = 0;
  vib_active = 0;

  prev_vel_tone_on = 0;

  // ============================================================
  // OPEN COURTYARD REVERB
  // 8-line diffuse FDN + sparse stereo early reflections.
  // Four short allpass diffuser buffers feed the late field.
  // No delay modulation: density comes from scattering, not chorus.
  // ============================================================
  // Dedicated high RAM area: the expanded Distance buffer stays isolated from
  // all six synth engines even at very high project sample rates.
  rev_mem_base = 4000000;
  rev_buf_len = min(floor(srate * 0.50) + 32, 300000);
  rev_erL_base = rev_mem_base;
  rev_erR_base = rev_erL_base + rev_buf_len;
  rev_d1_base  = rev_erR_base + rev_buf_len;
  rev_d2_base  = rev_d1_base  + rev_buf_len;
  rev_d3_base  = rev_d2_base  + rev_buf_len;
  rev_d4_base  = rev_d3_base  + rev_buf_len;
  rev_d5_base  = rev_d4_base  + rev_buf_len;
  rev_d6_base  = rev_d5_base  + rev_buf_len;
  rev_d7_base  = rev_d6_base  + rev_buf_len;
  rev_d8_base  = rev_d7_base  + rev_buf_len;

  rev_ap1L_base = rev_d8_base   + rev_buf_len;
  rev_ap1R_base = rev_ap1L_base + rev_buf_len;
  rev_ap2L_base = rev_ap1R_base + rev_buf_len;
  rev_ap2R_base = rev_ap2L_base + rev_buf_len;

  rev_idx = 0;
  rev_tail_hold = 0;
  rev_tail_energy = 0;
  rev_pending_samples = 0;
  rev_quiet_count = 2048;
  rev_send_lpL = 0;
  rev_send_lpR = 0;
  rev_send_lowL = 0;
  rev_send_lowR = 0;
  rev_fb_lp1 = 0;
  rev_fb_lp2 = 0;
  rev_fb_lp3 = 0;
  rev_fb_lp4 = 0;
  rev_fb_lp5 = 0;
  rev_fb_lp6 = 0;
  rev_fb_lp7 = 0;
  rev_fb_lp8 = 0;

  // Late-field body reinforcement: broad low-mid band only in the reverb tail.
  rev_body_lpL = 0;
  rev_body_lpR = 0;
  rev_body_lowL = 0;
  rev_body_lowR = 0;

  // Slow asynchronous late-tail movement. These modulate only the stereo
  // projection of the late field; delay lengths themselves never move.
  rev_motion_target_a = 0;
  rev_motion_target_b = 0;
  rev_motion_a = 0;
  rev_motion_b = 0;
  rev_motion_count_a = 0;
  rev_motion_count_b = 0;
  rev_motion_pan = 0;
  rev_motion_spread = 0;
  rev_tail_age = 0;

  // Real-audio activity detector for the shared reverb.
  // Held MIDI notes do not keep the room awake if the engine is silent.
  rev_source_hold = 0;

  rev_prev_mix_on = 0;
  post_stereo_active = 0;

  poly_active_count = 0;
  output_tail_count = 0;
  output_sleep = 0;

  // Global engine/effect cold sleep. Once the selected engine and both shared
  // effects are truly silent, the complete @sample path disappears until @block
  // sees new work.
  global_idle_quiet_count = 0;
  global_idle_quiet_needed = 2048;
  global_sleep_block = 0;
  global_engine_active_block = 0;
  note_serial = 0;
  held_count = 0;
  strings_sustain_pedal = 0;
  voice_serial = 0;
  last_mode = -1;

  evt_count = 0;
  evt_index = 0;
  sample_in_block = 0;

  // ------------------------------------------------------------
  // POST-OSCILLATOR ANTIALIAS DOMAIN
  // ------------------------------------------------------------
  // The Strings oscillator itself is intentionally left RAW: its fold/warp
  // aliasing is part of the waveform character.
  // Everything after the oscillator is passed through a very-high 4th-order
  // Butterworth guard filter before output. This only tames the Nyquist edge;
  // it does NOT try to erase alias components already folded into the waveform.
  aa1_x1 = aa1_x2 = aa1_y1 = aa1_y2 = 0;
  aa2_x1 = aa2_x2 = aa2_y1 = aa2_y2 = 0;
  aa1R_x1 = aa1R_x2 = aa1R_y1 = aa1R_y2 = 0;
  aa2R_x1 = aa2R_x2 = aa2R_y1 = aa2R_y2 = 0;

  // ------------------------------------------------------------
  // FREE TEMPORAL DRIFT
  // ------------------------------------------------------------
  // These states are global and NEVER reset by MIDI Note On.
  // New random destinations are chosen only every ~1-3 seconds and approached
  // slowly, so each note samples the instrument at its current "age".
  drift_a = 0;
  drift_b = 0;
  drift_target_a = 0;
  drift_target_b = 0;
  drift_count_a = 1;
  drift_count_b = 1;
  drift_last_block_samples = -1;
  drift_block_k_a = 1;
  drift_block_k_b = 1;
  drift_core_block = 0;
  drift_comb_block = 0;
  drift_pitch_cents_block = 0;

  // ============================================================
  // LO-LO SIGNATURE OUTPUT STAGE — LJuno-116 / LSH-2 / PowerSine
  // Post-AA -> 5 Hz DC blocker -> fixed glue -> x0.4
  // -> soft limiter 0.98 / 15% excess -> Master Output x2.
  // ============================================================
  dc_coeff_5hz = exp(-2 * $pi * 5 / srate);
  dc_x_prev = 0;
  dc_y_prev = 0;
  dc_xR_prev = 0;
  dc_yR_prev = 0;

  glue_env = 0;
  glue_gain = 1;
  glue_att_inv = 1 / max(1, (0.001 * srate)); // 1 ms
  glue_rel_inv = 1 / max(1, (0.004 * srate)); // 4 ms
  glue_ratio_k = 2;
  glue_thresh_k = 0.055;

  post_in_gain = 0.4;
  post_limit = 0.98;

function aa_biquad1(x)
local(y) (
  y = aa1_b0*x + aa1_b1*aa1_x1 + aa1_b2*aa1_x2
      - aa1_a1*aa1_y1 - aa1_a2*aa1_y2;
  aa1_x2 = aa1_x1; aa1_x1 = x;
  aa1_y2 = aa1_y1; aa1_y1 = y;
  y;
);

function aa_biquad2(x)
local(y) (
  y = aa2_b0*x + aa2_b1*aa2_x1 + aa2_b2*aa2_x2
      - aa2_a1*aa2_y1 - aa2_a2*aa2_y2;
  aa2_x2 = aa2_x1; aa2_x1 = x;
  aa2_y2 = aa2_y1; aa2_y1 = y;
  y;
);


function aa_biquad1R(x)
local(y) (
  y = aa1_b0*x + aa1_b1*aa1R_x1 + aa1_b2*aa1R_x2
      - aa1_a1*aa1R_y1 - aa1_a2*aa1R_y2;
  aa1R_x2 = aa1R_x1; aa1R_x1 = x;
  aa1R_y2 = aa1R_y1; aa1R_y1 = y;
  y;
);

function aa_biquad2R(x)
local(y) (
  y = aa2_b0*x + aa2_b1*aa2R_x1 + aa2_b2*aa2R_x2
      - aa2_a1*aa2R_y1 - aa2_a2*aa2R_y2;
  aa2R_x2 = aa2R_x1; aa2R_x1 = x;
  aa2R_y2 = aa2R_y1; aa2R_y1 = y;
  y;
);

function calc_key_gains(n)
local(kp,p) (
  kp = n + stereo_oct_semi + stereo_fine_semi;
  p = max(-1, min(1, (kp-60)*0.0208333333333333));
  p *= step_keyboard_stereo;
  key_tmpL = sqrt(max(0, 1-p));
  key_tmpR = sqrt(max(0, 1+p));
);

function stereo_body(x, idx, keyL, keyR)
local(low,upper,high,side) (
  step_fan_on ? (
    fan_lp1[idx] += (x-fan_lp1[idx])*fan_k1;
    fan_lp2[idx] += (x-fan_lp2[idx])*fan_k2;
    low = fan_lp1[idx];
    upper = fan_lp2[idx];
    high = x-upper;
    side = (high-low) * fan_side_gain;
  ) : (
    side = 0;
  );

  stereo_tmpL = (x-side) * keyL;
  stereo_tmpR = (x+side) * keyR;
);

// Circular delay read used by Open Courtyard.
// All delay values are constrained below rev_buf_len in @slider.
function courtyard_read(base, delay_spl)
local(r) (
  r = rev_idx - delay_spl;
  r < 0 ? r += rev_buf_len;
  base[r];
);

// ------------------------------------------------------------
// ADAPTIVE STEPSINE OVERSAMPLING + HOT-PATH PREPARATION
// ------------------------------------------------------------
// EFFECTIVE OSCILLATOR PITCH determines oscillator-only oversampling.
// The decision uses the actual generated frequency after Octave/Fine,
// portamento, String Tension, Finger Press and free Temporal Drift.
//
// Upward thresholds:
//   pitch < C3  (130.8128 Hz) -> 1x
//   C3..B4                  -> 2x
//   pitch >= C5 (523.2511 Hz) -> 4x
//
// A one-semitone downward hysteresis prevents rapid 1x/2x/4x switching when
// slow drift or bends hover around a boundary:
//   2x -> 1x only below B2 (123.4708 Hz)
//   4x -> 2x only below B4 (493.8833 Hz)
//
// Only the Strings waveform is oversampled. Envelopes, MIDI, drift, pick,
// summing, post-AA and signature output remain at the host sample rate.

function osc2_filter(x, idx)
local(y) (
  y = osc2_b0*x + osc2_b1*osc2_x1[idx] + osc2_b2*osc2_x2[idx]
      - osc2_a1*osc2_y1[idx] - osc2_a2*osc2_y2[idx];
  osc2_x2[idx] = osc2_x1[idx];
  osc2_x1[idx] = x;
  osc2_y2[idx] = osc2_y1[idx];
  osc2_y1[idx] = y;
  y;
);

function osc4_filter(x, idx)
local(y) (
  y = osc4_b0*x + osc4_b1*osc2_x1[idx] + osc4_b2*osc2_x2[idx]
      - osc4_a1*osc2_y1[idx] - osc4_a2*osc2_y2[idx];
  osc2_x2[idx] = osc2_x1[idx];
  osc2_x1[idx] = x;
  osc2_y2[idx] = osc2_y1[idx];
  osc2_y1[idx] = y;
  y;
);

function osc_reset(idx) (
  osc2_x1[idx] = 0;
  osc2_x2[idx] = 0;
  osc2_y1[idx] = 0;
  osc2_y2[idx] = 0;

  // Any oscillator reset also invalidates the recursive first sine.
  warp_rec_ready[idx] = 0;
  warp_rec_count[idx] = 0;
);

function os_for_pitch(hz, current_os)
local(os) (
  // Exact equal-tempered boundaries around C3/C5.
  // Current OS is part of the decision to provide one-semitone hysteresis.
  current_os <= 1 ? (
    os = hz >= 130.8127826502993 ? 2 : 1;
  ) : current_os == 2 ? (
    hz < 123.4708253140310 ? os = 1 :
    hz >= 523.2511306011972 ? os = 4 :
    os = 2;
  ) : (
    os = hz < 493.8833012561241 ? 2 : 4;
  );
  os;
);

function cents_ratio(c)
local(x, ii, ff, a, b) (
  c <= -512 ? pitch_lut[0] :
  c >= 512 ? pitch_lut[4096] : (
    x = (c + 512) * 4;
    ii = floor(x);
    ff = x - ii;
    a = pitch_lut[ii];
    b = pitch_lut[ii+1];
    a + (b-a)*ff;
  );
);

function note_hz(n) (
  440 * (2 ^ (((n - 69) + slider8*12 + slider9) / 12));
);

// Stronger velocity-to-brightness mapping for the STRING BODY.
// Two cascaded one-pole sections give a smooth 12 dB/octave low-pass.
// At maximum Amount:
//   very soft notes can fall near ~900 Hz on low registers,
//   medium velocity sits in the several-kHz region,
//   hard velocity approaches ~18.5 kHz.
// A modest pitch-tracking floor preserves the identity of high notes.
function calc_vel_tone_k(vel, base_hz)
local(dark,fc,track_floor,nyq_guard) (
  dark = step_vel_tone_filter * ((1-vel) ^ 1.10);

  // Exponential mapping gives a clearly audible acoustic-like brightness
  // difference while keeping the upper half of the velocity range gradual.
  fc = 18500 * (2 ^ (-4.35*dark));

  // Much lighter tracking than 0.29: enough to protect high notes without
  // preventing soft low notes from becoming genuinely dark.
  track_floor = base_hz * 2.5;
  fc = max(fc, track_floor);

  nyq_guard = srate * 0.45;
  fc = min(fc, nyq_guard);

  1 - exp(-twopi*fc/srate);
);

function apply_vel_tone(x, idx)
local(y1,y2) (
  !vel_tone_ready[idx] ? (
    // Initialize both poles from the dry sample: no artificial note-on jump.
    vel_tone_state[idx] = x;
    vel_tone_state2[idx] = x;
    vel_tone_ready[idx] = 1;
  );

  y1 = vel_tone_state[idx] + (x-vel_tone_state[idx])*vel_tone_k[idx];
  vel_tone_state[idx] = y1;

  y2 = vel_tone_state2[idx] + (y1-vel_tone_state2[idx])*vel_tone_k[idx];
  vel_tone_state2[idx] = y2;

  y2;
);

// Prepare only genuinely dynamic waveform coefficients ONCE per voice/sample.
// Velocity-only terms are cached at note-on/@slider.
function prepare_wave_cached(exc, life_mod, timbre_scale) (
  cur_warp_mul = step_warp_mul
               * (1 + life_mod*0.015 + drift_core_block*0.005);
  cur_wrap_density = step_wrap_density
                   * (1 + life_mod*0.010 + drift_core_block*0.0035);

  step_attack_dynamic ? (
    cur_fold_cycles = step_fold_cycles + step_attack_fold_cycles*exc*timbre_scale;
    cur_fold_depth = step_fold_depth + step_attack_fold_depth*exc*timbre_scale;
  ) : (
    cur_fold_cycles = step_fold_cycles;
    cur_fold_depth = step_fold_depth;
  );

  step_life_on || step_drift_on ? (
    cur_fold_cycles += step_fold_cycles
                     * (life_mod*0.015 + drift_core_block*0.004);
    cur_fold_depth *= 1 + life_mod*0.025 + drift_core_block*0.008;
  );

  cur_fold_mul = twopi * cur_fold_cycles;

  step_comb_on ? (
    cur_comb_amt = step_string_comb_amount
                 * (1 + life_mod*0.06 + drift_comb_block*0.025);
    cur_comb_amt = min(1, max(0, cur_comb_amt));
    cur_comb_phase = step_string_comb_phase
                   + (life_mod*0.003 + drift_comb_block*0.0015)*twopi;
  ) : (
    cur_comb_amt = 0;
  );
);

// Generic path: exact old algebra for all unusual mode combinations.
// Exact branch-free preparation for the common full Strings topology.
// This keeps the SAME operation order as prepare_wave_cached(), but when
// Attack Timbre + Velocity Life/Temporal Drift + String Comb are all active
// it avoids re-testing three invariant mode flags for every voice/sample.
function prepare_wave_full(exc, life_mod, timbre_scale) (
  cur_warp_mul = step_warp_mul
               * (1 + life_mod*0.015 + drift_core_block*0.005);
  cur_wrap_density = step_wrap_density
                   * (1 + life_mod*0.010 + drift_core_block*0.0035);

  cur_fold_cycles = step_fold_cycles + step_attack_fold_cycles*exc*timbre_scale;
  cur_fold_depth = step_fold_depth + step_attack_fold_depth*exc*timbre_scale;

  cur_fold_cycles += step_fold_cycles
                   * (life_mod*0.015 + drift_core_block*0.004);
  cur_fold_depth *= 1 + life_mod*0.025 + drift_core_block*0.008;

  cur_fold_mul = twopi * cur_fold_cycles;

  cur_comb_amt = step_string_comb_amount
               * (1 + life_mod*0.06 + drift_comb_block*0.025);
  cur_comb_amt = min(1, max(0, cur_comb_amt));
  cur_comb_phase = step_string_comb_phase
                 + (life_mod*0.003 + drift_comb_block*0.0015)*twopi;
);

// Specialized exact kernels for Rectify=0, Log Mix=1, Warp Mix=1.
// These are NOT approximations: they use the same calculations and ordering
// as stepsine_core_generic(), but remove mode branches from the oscillator
// sub-sample hot path. The generic kernel remains the fallback for every
// other parameter combination.
function stepsine_core_rawlog_knee(ph)
local(base, shaped_base, pd, w, logarg, des) (
  base = ph * inv_twopi;
  base -= floor(base);

  base <= step_knee_pos
    ? pd = step_knee_level * base * step_knee_inv_pos
    : pd = step_knee_level
         + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
  shaped_base = base*step_knee_dry + pd*step_knee_mix;

  w = sin(shaped_base*cur_warp_mul + step_warp_phase);

  logarg = 1 + w*step_log_shape;
  logarg < 0.000000001 ? logarg = 0.000000001;
  w = log(logarg);

  w *= cur_wrap_density;
  w -= floor(w);

  des = sin(w*cur_fold_mul + step_fold_phase);
  sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);
);

function stepsine_core_rawlog_plain(ph)
local(base, w, logarg, des) (
  base = ph * inv_twopi;
  base -= floor(base);

  w = sin(base*cur_warp_mul + step_warp_phase);

  logarg = 1 + w*step_log_shape;
  logarg < 0.000000001 ? logarg = 0.000000001;
  w = log(logarg);

  w *= cur_wrap_density;
  w -= floor(w);

  des = sin(w*cur_fold_mul + step_fold_phase);
  sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);
);

function wave_rawlog_knee_comb(ph)
local(a,b) (
  a = stepsine_core_rawlog_knee(ph);
  b = stepsine_core_rawlog_knee(ph + cur_comb_phase);
  a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
);

function wave_rawlog_plain_comb(ph)
local(a,b) (
  a = stepsine_core_rawlog_plain(ph);
  b = stepsine_core_rawlog_plain(ph + cur_comb_phase);
  a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
);

function stepsine_core_generic(ph)
local(base, shaped_base, pd, ws, wr, w, logarg, logged, des) (
  base = ph * inv_twopi;
  base -= floor(base);

  step_knee_on ? (
    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;
  ) : (
    shaped_base = base;
  );

  ws = sin(shaped_base*cur_warp_mul + step_warp_phase);

  step_rect_mode == 1 ? (
    w = abs(ws);
  ) : step_rect_mode == 0 ? (
    w = ws;
  ) : (
    wr = abs(ws);
    w = ws*step_rect_dry + wr*step_rectify;
  );

  step_log_mode != 0 ? (
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    logged = log(logarg);
    step_log_mode == 1 ? w = logged
                       : w = w*step_log_dry + logged*step_log_mix;
  );

  w *= cur_wrap_density;
  w -= floor(w);

  step_warpmix_mode == 0 ? (
    w = shaped_base;
  ) : step_warpmix_mode == 2 ? (
    w = shaped_base*step_warp_dry + w*step_warp_mix;
    w -= floor(w);
  );

  des = sin(w*cur_fold_mul + step_fold_phase);
  sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);
);

// Exact fast path for the common/current topology:
// Knee Off, Rectify=1, Log Mix=1, Warp Mix=1.
//
// COMPILED PHASE KERNEL:
// The old hot path converted radians -> cycles and then multiplied by
// twopi*WarpRate. Algebraically those operations cancel. The generated kernel
// receives a wrapped radian phase and executes the identical waveform equation
// directly as ph*cur_warp_rate_eff. This removes one hot multiply/conversion
// layer and one nested function call per oscillator evaluation.
function core_fast_phase(ph)
local(w, des) (
  w = abs(sin(ph*cur_warp_rate_eff + step_warp_phase));
  w = log(1 + w*step_log_shape);
  w *= cur_wrap_density;
  w -= floor(w);
  des = sin(w*cur_fold_mul + step_fold_phase);
  sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);
);

// Same exact fast Strings core, except the FIRST warp sine is supplied by
// the per-voice recurrence instead of calling sin() for every oscillator sample.
function core_fast_from_warp_sine(ws)
local(w, des) (
  w = abs(ws);
  w = log(1 + w*step_log_shape);
  w *= cur_wrap_density;
  w -= floor(w);
  des = sin(w*cur_fold_mul + step_fold_phase);
  sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);
);

// Initialize the recursive sine/cosine pair at the CURRENT wrapped macro phase.
// This is called only when a previously dynamic pitch becomes static.
function warp_rec_setup(ph, phase_step, idx, os)
local(a, d) (
  a = ph*step_warp_rate + step_warp_phase;
  warp_rec_sin[idx] = sin(a);
  warp_rec_cos[idx] = cos(a);

  d = phase_step*step_warp_rate/os;
  warp_rec_dsin[idx] = sin(d);
  warp_rec_dcos[idx] = cos(d);

  warp_rec_ready[idx] = 1;
  warp_rec_count[idx] = 0;
);

// Advance one virtual oscillator sub-step.
// If the wrapped Strings macrocycle crosses 2*pi, apply the precomputed
// -2*pi*WarpRate correction so non-integer Warp Rate keeps the SAME intentional
// macrocycle discontinuity as the original direct sin(ph*WarpRate+phase).
function warp_rec_advance(idx, wrapped)
local(s,c,ns,nc,t) (
  s = warp_rec_sin[idx];
  c = warp_rec_cos[idx];

  ns = s*warp_rec_dcos[idx] + c*warp_rec_dsin[idx];
  nc = c*warp_rec_dcos[idx] - s*warp_rec_dsin[idx];

  wrapped ? (
    t = ns;
    ns = t*warp_wrap_cos + nc*warp_wrap_sin;
    nc = nc*warp_wrap_cos - t*warp_wrap_sin;
  );

  warp_rec_sin[idx] = ns;
  warp_rec_cos[idx] = nc;
);

// Very occasional length correction. It changes no phase and prevents floating
// point magnitude drift after many recursive rotations.
function warp_rec_renorm(idx, os)
local(s,c,r2,k) (
  warp_rec_count[idx] += os;
  warp_rec_count[idx] >= 16384 ? (
    s = warp_rec_sin[idx];
    c = warp_rec_cos[idx];
    r2 = s*s + c*c;
    k = 1.5 - 0.5*r2;
    warp_rec_sin[idx] = s*k;
    warp_rec_cos[idx] = c*k;
    warp_rec_count[idx] = 0;
  );
);

// Recursive no-comb renderers. They preserve the exact Strings macro wrap.
function render_rec_1x(ph, phase_step, idx)
local(y,p,wrapped) (
  y = core_fast_from_warp_sine(warp_rec_sin[idx]);

  p = ph + phase_step;
  wrapped = p >= twopi;
  warp_rec_advance(idx, wrapped);
  warp_rec_renorm(idx, 1);
  y;
);

function render_rec_2x(ph, phase_step, idx)
local(y,p,h,wrapped) (
  h = phase_step*0.5;
  p = ph;

  osc2_filter(core_fast_from_warp_sine(warp_rec_sin[idx]), idx);
  p += h;
  wrapped = p >= twopi;
  wrapped ? p -= twopi;
  warp_rec_advance(idx, wrapped);

  y = osc2_filter(core_fast_from_warp_sine(warp_rec_sin[idx]), idx);
  p += h;
  wrapped = p >= twopi;
  wrapped ? p -= twopi;
  warp_rec_advance(idx, wrapped);

  warp_rec_renorm(idx, 2);
  y;
);

function render_rec_4x(ph, phase_step, idx)
local(y,p,q,wrapped) (
  q = phase_step*0.25;
  p = ph;

  osc4_filter(core_fast_from_warp_sine(warp_rec_sin[idx]), idx);
  p += q;
  wrapped = p >= twopi;
  wrapped ? p -= twopi;
  warp_rec_advance(idx, wrapped);

  osc4_filter(core_fast_from_warp_sine(warp_rec_sin[idx]), idx);
  p += q;
  wrapped = p >= twopi;
  wrapped ? p -= twopi;
  warp_rec_advance(idx, wrapped);

  osc4_filter(core_fast_from_warp_sine(warp_rec_sin[idx]), idx);
  p += q;
  wrapped = p >= twopi;
  wrapped ? p -= twopi;
  warp_rec_advance(idx, wrapped);

  y = osc4_filter(core_fast_from_warp_sine(warp_rec_sin[idx]), idx);
  p += q;
  wrapped = p >= twopi;
  wrapped ? p -= twopi;
  warp_rec_advance(idx, wrapped);

  warp_rec_renorm(idx, 4);
  y;
);

function render_rec_auto(ph, phase_step, idx, os)
local(y) (
  !warp_rec_ready[idx] ? warp_rec_setup(ph, phase_step, idx, os);

  os <= 1 ? y = render_rec_1x(ph,phase_step,idx)
          : os == 2 ? y = render_rec_2x(ph,phase_step,idx)
                    : y = render_rec_4x(ph,phase_step,idx);
  y;
);

// Generic/comb fast core still requires explicit wrapping because a comb phase
// offset can cross the macrocycle boundary before a non-integer warp ratio.
function stepsine_core_fast(ph)
local(base, w, des) (
  base = ph * inv_twopi;
  base -= floor(base);
  w = abs(sin(base*cur_warp_mul + step_warp_phase));
  w = log(1 + w*step_log_shape);
  w *= cur_wrap_density;
  w -= floor(w);
  des = sin(w*cur_fold_mul + step_fold_phase);
  sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);
);

function wave_fast_comb(ph)
local(a,b) (
  a = stepsine_core_fast(ph);
  b = stepsine_core_fast(ph + cur_comb_phase);
  a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
);

function wave_generic_comb(ph)
local(a,b) (
  a = stepsine_core_generic(ph);
  b = stepsine_core_generic(ph + cur_comb_phase);
  a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
);

// Three precompiled no-comb kernels. There is no generic OS loop and no OS
// decision inside these functions. Sub-phases use the common one-cycle fast
// wrap; the floor fallback exists only for pathological >1-cycle increments.
function render_fast_1x(ph)
local(y) (
  core_fast_phase(ph);
);

function wrap_phase_fast(p)
(
  p >= twopi ? (
    p < twopi+twopi ? p -= twopi : p -= twopi*floor(p*inv_twopi);
  );
  p < 0 ? p += twopi*(1+floor((-p)*inv_twopi));
  p;
);

function render_fast_2x(ph, phase_step, idx)
local(p1,y) (
  osc2_filter(core_fast_phase(ph), idx);
  p1 = wrap_phase_fast(ph + phase_step*0.5);
  y = osc2_filter(core_fast_phase(p1), idx);
  y;
);

function render_fast_4x(ph, phase_step, idx)
local(q,p1,p2,p3,y) (
  q = phase_step*0.25;
  p1 = wrap_phase_fast(ph + q);
  p2 = wrap_phase_fast(p1 + q);
  p3 = wrap_phase_fast(p2 + q);
  osc4_filter(core_fast_phase(ph), idx);
  osc4_filter(core_fast_phase(p1), idx);
  osc4_filter(core_fast_phase(p2), idx);
  y = osc4_filter(core_fast_phase(p3), idx);
  y;
);

function render_fast_nocomb(ph, phase_step, idx, os)
local(y) (
  os <= 1 ? y = render_fast_1x(ph)
          : os == 2 ? y = render_fast_2x(ph,phase_step,idx)
                    : y = render_fast_4x(ph,phase_step,idx);
  y;
);

function render_fast_comb(ph, phase_step, idx, os)
local(y,q,h) (
  os <= 1 ? (
    y = wave_fast_comb(ph);
  ) : os == 2 ? (
    osc2_filter(wave_fast_comb(ph), idx);
    y = osc2_filter(wave_fast_comb(ph + phase_step*0.5), idx);
  ) : (
    q = phase_step*0.25;
    h = q+q;
    osc4_filter(wave_fast_comb(ph), idx);
    osc4_filter(wave_fast_comb(ph + q), idx);
    osc4_filter(wave_fast_comb(ph + h), idx);
    y = osc4_filter(wave_fast_comb(ph + h + q), idx);
  );
  y;
);

function render_generic_nocomb(ph, phase_step, idx, os)
local(y,q,h) (
  os <= 1 ? (
    y = stepsine_core_generic(ph);
  ) : os == 2 ? (
    osc2_filter(stepsine_core_generic(ph), idx);
    y = osc2_filter(stepsine_core_generic(ph + phase_step*0.5), idx);
  ) : (
    q = phase_step*0.25;
    h = q+q;
    osc4_filter(stepsine_core_generic(ph), idx);
    osc4_filter(stepsine_core_generic(ph + q), idx);
    osc4_filter(stepsine_core_generic(ph + h), idx);
    y = osc4_filter(stepsine_core_generic(ph + h + q), idx);
  );
  y;
);

function render_generic_comb(ph, phase_step, idx, os)
local(y,q,h) (
  os <= 1 ? (
    y = wave_generic_comb(ph);
  ) : os == 2 ? (
    osc2_filter(wave_generic_comb(ph), idx);
    y = osc2_filter(wave_generic_comb(ph + phase_step*0.5), idx);
  ) : (
    q = phase_step*0.25;
    h = q+q;
    osc4_filter(wave_generic_comb(ph), idx);
    osc4_filter(wave_generic_comb(ph + q), idx);
    osc4_filter(wave_generic_comb(ph + h), idx);
    y = osc4_filter(wave_generic_comb(ph + h + q), idx);
  );
  y;
);

// TEST23 — FULL-OVERSAMPLING FUSED RAWLOG+KNEE COMB
// Same 1x/2x/4x sub-sample positions and same osc2/osc4 decimation filters.
// Only removes nested wave/core function calls from the default Strings topology.
function render_rawlog_knee_comb_fused(ph, phase_step, idx, os)
local(y,q,h,p,base,shaped_base,pd,w,logarg,des,a,b,mix) (
  os <= 1 ? (
    // Main branch — exact stepsine_core_rawlog_knee() algebra.
    base = (ph) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    a = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Phase-shifted Comb branch — same exact kernel, same oversampling point.
    base = ((ph) + cur_comb_phase) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    b = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Preserve the original Comb mix operation order exactly.
    y = a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
  ) : os == 2 ? (
    h = phase_step*0.5;
    // Main branch — exact stepsine_core_rawlog_knee() algebra.
    base = (ph) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    a = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Phase-shifted Comb branch — same exact kernel, same oversampling point.
    base = ((ph) + cur_comb_phase) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    b = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Preserve the original Comb mix operation order exactly.
    mix = a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
    osc2_filter(mix, idx);
    p = ph + h;
    // Main branch — exact stepsine_core_rawlog_knee() algebra.
    base = (p) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    a = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Phase-shifted Comb branch — same exact kernel, same oversampling point.
    base = ((p) + cur_comb_phase) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    b = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Preserve the original Comb mix operation order exactly.
    mix = a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
    y = osc2_filter(mix, idx);
  ) : (
    q = phase_step*0.25;
    h = q+q;
    // Main branch — exact stepsine_core_rawlog_knee() algebra.
    base = (ph) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    a = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Phase-shifted Comb branch — same exact kernel, same oversampling point.
    base = ((ph) + cur_comb_phase) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    b = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Preserve the original Comb mix operation order exactly.
    mix = a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
    osc4_filter(mix, idx);

    p = ph + q;
    // Main branch — exact stepsine_core_rawlog_knee() algebra.
    base = (p) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    a = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Phase-shifted Comb branch — same exact kernel, same oversampling point.
    base = ((p) + cur_comb_phase) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    b = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Preserve the original Comb mix operation order exactly.
    mix = a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
    osc4_filter(mix, idx);

    p = ph + h;
    // Main branch — exact stepsine_core_rawlog_knee() algebra.
    base = (p) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    a = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Phase-shifted Comb branch — same exact kernel, same oversampling point.
    base = ((p) + cur_comb_phase) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    b = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Preserve the original Comb mix operation order exactly.
    mix = a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
    osc4_filter(mix, idx);

    p = ph + h + q;
    // Main branch — exact stepsine_core_rawlog_knee() algebra.
    base = (p) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
    logarg = 1 + w*step_log_shape;
    logarg < 0.000000001 ? logarg = 0.000000001;
    w = log(logarg);
    w *= cur_wrap_density;
    w -= floor(w);
    des = sin(w*cur_fold_mul + step_fold_phase);
    a = sin(w*step_carrier_mul + step_carrier_phase + des*cur_fold_depth);

    // Phase-shifted Comb branch — same exact kernel, same oversampling point.
    base = ((p) + cur_comb_phase) * inv_twopi;
    base -= floor(base);

    base <= step_knee_pos
      ? pd = step_knee_level * base * step_knee_inv_pos
      : pd = step_knee_level
           + (1-step_knee_level)*(base-step_knee_pos)*step_knee_inv_tail;
    shaped_base = base*step_knee_dry + pd*step_knee_mix;

    w = sin(shaped_base*cur_warp_mul + step_warp_phase);
