);

function wi_win_notify_live()
(
  sliderchange(slider213);   sliderchange(slider215);   sliderchange(slider216);   sliderchange(slider217);
  sliderchange(slider218);   sliderchange(slider219);   sliderchange(slider220);   sliderchange(slider221);
  sliderchange(slider222);   sliderchange(slider223);   sliderchange(slider224);   sliderchange(slider225);
  sliderchange(slider226);   sliderchange(slider227);   sliderchange(slider228);   sliderchange(slider229);
  sliderchange(slider230);   sliderchange(slider231);   sliderchange(slider232);   sliderchange(slider233);
  sliderchange(slider234);   sliderchange(slider235);   sliderchange(slider236);   sliderchange(slider237);
  sliderchange(slider238);   sliderchange(slider239); 
);

function wi_win_bank_capture(wi_inst)
local(wi_base,wi_p)
(
  wi_inst=max(0,min(5,floor(wi_inst+0.5)));
  wi_base=wi_WIN_BANK+wi_inst*wi_WIN_BANK_STRIDE;
  wi_p=0;
  loop(wi_WIN_BANK_STRIDE,
    wi_base[wi_p]=wi_win_live_value(wi_p);
    wi_p+=1;
  );
);

function wi_win_bank_load(wi_inst)
local(wi_base,wi_p)
(
  wi_inst=max(0,min(5,floor(wi_inst+0.5)));
  wi_base=wi_WIN_BANK+wi_inst*wi_WIN_BANK_STRIDE;
  wi_p=0;
  loop(wi_WIN_BANK_STRIDE,
    wi_win_set_live(wi_p,wi_base[wi_p]);
    wi_p+=1;
  );
);

function wi_win_snapshot_live()
local(wi_p)
(
  wi_p=0;
  loop(wi_WIN_BANK_STRIDE,
    wi_WIN_LIVE_SNAPSHOT[wi_p]=wi_win_live_value(wi_p);
    wi_p+=1;
  );
);

function wi_win_live_changed()
local(wi_p,wi_changed)
(
  wi_p=0; wi_changed=0;
  loop(wi_WIN_BANK_STRIDE,
    abs(wi_win_live_value(wi_p)-wi_WIN_LIVE_SNAPSHOT[wi_p])>0.0000000001 ? wi_changed=1;
    wi_p+=1;
  );
  wi_changed;
);

