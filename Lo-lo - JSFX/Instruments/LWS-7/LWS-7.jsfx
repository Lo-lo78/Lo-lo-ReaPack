  wi_b[25]=1;
  wi_b[26]=0; wi_b[27]=0; wi_b[28]=0; // legacy/reserved
);

wi_win_bank_magic!=wi_WIN_BANK_MAGIC_VALUE ? (
  // Wind bank migration through the complete six-instrument snapshot set:
  // - install a revised factory only when the former factory is untouched;
  // - preserve every user-edited Wind bank;
  // - keep all six banks explicit and deterministic.
  wi_win_old_magic=wi_win_bank_magic;

  wi_win_old_magic==72010 ? (
    // Previous build already has the Lo-lo/OpenAI Recorder voicing, but its
    // factory Octave is still 0. Upgrade only an untouched Recorder bank to +1.
    wi_win_mig_b=wi_WIN_BANK+3*wi_WIN_BANK_STRIDE;
    wi_win_recorder_72010_factory =
      abs(wi_win_mig_b[0]-0)<0.000001 &&
      abs(wi_win_mig_b[1]-0)<0.000001 &&
      abs(wi_win_mig_b[2]-0)<0.000001 &&
      abs(wi_win_mig_b[3]-2)<0.000001 &&
      abs(wi_win_mig_b[4]-0.90)<0.000001 &&
      abs(wi_win_mig_b[5]-1.10)<0.000001 &&
      abs(wi_win_mig_b[6]-0.84)<0.000001 &&
      abs(wi_win_mig_b[7]-0.18)<0.000001 &&
      abs(wi_win_mig_b[8]-7200)<0.000001 &&
      abs(wi_win_mig_b[9]-12)<0.000001 &&
      abs(wi_win_mig_b[10]-65)<0.000001 &&
      abs(wi_win_mig_b[11]-0.190)<0.000001 &&
      abs(wi_win_mig_b[12]-0.96)<0.000001 &&
      abs(wi_win_mig_b[13]-0.82)<0.000001 &&
      abs(wi_win_mig_b[14]-0.02)<0.000001 &&
      abs(wi_win_mig_b[15]-0.62)<0.000001 &&
      abs(wi_win_mig_b[16]-0.82)<0.000001 &&
      abs(wi_win_mig_b[17]-0.58)<0.000001 &&
      abs(wi_win_mig_b[18]-0.10)<0.000001 &&
      abs(wi_win_mig_b[19]-0.30)<0.000001 &&
      abs(wi_win_mig_b[20]-0.06)<0.000001 &&
      abs(wi_win_mig_b[21]-5000)<0.000001 &&
      abs(wi_win_mig_b[22]-5.0)<0.000001 &&
      abs(wi_win_mig_b[23]-1.8)<0.000001 &&
      abs(wi_win_mig_b[24]-350)<0.000001 &&
      abs(wi_win_mig_b[25]-0.04)<0.000001;
    wi_win_recorder_72010_factory ? wi_win_factory_recorder();
  ) : wi_win_old_magic==72009 ? (
    // Previous LWS-7 state: revised Concert Flute is already present; only
    // the Recorder/Flauto Dolce factory may need the 72010 migration below.
    0;
  ) : wi_win_old_magic==72008 ? (
    // Previous LWS-7 state: all Wind banks approved, but Concert Flute still
    // uses the former factory voicing. Exact untouched matching below decides
    // whether it may be upgraded.
    0;
  ) : wi_win_old_magic==72007 ? (
    // 0.11 already contains all approved banks except the provisional Ocarina.
    // Preserve user edits; the exact Ocarina signature is upgraded below.
    0;
  ) : wi_win_old_magic==72006 ? (
    // 0.10 already contains Concert/Piccolo/Alto/Recorder plus the old
    // provisional Pan Flute. Leave all user-edited banks untouched here.
    0;
  ) : wi_win_old_magic==72005 ? (
    wi_win_mig_b=wi_WIN_BANK+0*wi_WIN_BANK_STRIDE;
    abs(wi_win_mig_b[0]-(-16.75))<0.000001 ? wi_win_mig_b[0]=0;
    wi_win_mig_b=wi_WIN_BANK+1*wi_WIN_BANK_STRIDE;
    abs(wi_win_mig_b[0]-(-15.0))<0.000001 ? wi_win_mig_b[0]=0;
    wi_win_mig_b=wi_WIN_BANK+2*wi_WIN_BANK_STRIDE;
    abs(wi_win_mig_b[0]-(-15.0))<0.000001 ? wi_win_mig_b[0]=0;
    wi_win_factory_recorder();
  ) : wi_win_old_magic==72004 ? (
    // 0.08 state: add Alto + Recorder, preserving existing user-edited banks.
    wi_win_factory_alto();
    wi_win_factory_recorder();
    wi_win_mig_b=wi_WIN_BANK+0*wi_WIN_BANK_STRIDE;
    abs(wi_win_mig_b[0]-(-16.75))<0.000001 ? wi_win_mig_b[0]=0;
    wi_win_mig_b=wi_WIN_BANK+1*wi_WIN_BANK_STRIDE;
    abs(wi_win_mig_b[0]-(-15.0))<0.000001 ? wi_win_mig_b[0]=0;
  ) : wi_win_old_magic==72003 ? (
    // 0.07 state: bring in Piccolo + Alto + Recorder.
    wi_win_factory_piccolo();
    wi_win_factory_alto();
    wi_win_factory_recorder();
    wi_win_mig_b=wi_WIN_BANK+0*wi_WIN_BANK_STRIDE;
    abs(wi_win_mig_b[0]-(-16.75))<0.000001 ? wi_win_mig_b[0]=0;
  ) : (
    // Fresh/older state: initialize all six Current Banks.
    wi_win_factory_concert();
    wi_win_factory_piccolo();
    wi_win_factory_alto();
    wi_win_factory_recorder();
    wi_win_factory_panflute();
    wi_win_factory_ocarina();
  );

  // Upgrade only an untouched former Concert Flute factory bank. Matching the
  // complete old voicing prevents a user-edited Concert Flute from being replaced.
  wi_win_old_magic>=72003 && wi_win_old_magic<=72008 ? (
    wi_win_mig_b=wi_WIN_BANK+0*wi_WIN_BANK_STRIDE;
    wi_win_concert_old_factory =
      abs(wi_win_mig_b[0]-0)<0.000001 &&
      abs(wi_win_mig_b[1]-0)<0.000001 &&
      abs(wi_win_mig_b[2]-0)<0.000001 &&
      abs(wi_win_mig_b[3]-2)<0.000001 &&
      abs(wi_win_mig_b[4]-0.8)<0.000001 &&
      abs(wi_win_mig_b[5]-0.7)<0.000001 &&
      abs(wi_win_mig_b[6]-1.0)<0.000001 &&
      abs(wi_win_mig_b[7]-1.0)<0.000001 &&
      abs(wi_win_mig_b[8]-5340)<0.000001 &&
      abs(wi_win_mig_b[9]-11)<0.000001 &&
      abs(wi_win_mig_b[10]-180)<0.000001 &&
      abs(wi_win_mig_b[11]-0.35)<0.000001 &&
      abs(wi_win_mig_b[12]-1.10)<0.000001 &&
      abs(wi_win_mig_b[13]-0.0)<0.000001 &&
      abs(wi_win_mig_b[14]-(-0.20))<0.000001 &&
      abs(wi_win_mig_b[15]-0.76)<0.000001 &&
      abs(wi_win_mig_b[16]-0.84)<0.000001 &&
      abs(wi_win_mig_b[17]-0.56)<0.000001 &&
      abs(wi_win_mig_b[18]-0.0)<0.000001 &&
      abs(wi_win_mig_b[19]-0.92)<0.000001 &&
      abs(wi_win_mig_b[20]-1.0)<0.000001 &&
      abs(wi_win_mig_b[21]-2740)<0.000001 &&
      abs(wi_win_mig_b[22]-5.35)<0.000001 &&
      abs(wi_win_mig_b[23]-14)<0.000001 &&
      abs(wi_win_mig_b[24]-160)<0.000001 &&
      abs(wi_win_mig_b[25]-0.15)<0.000001;
    wi_win_concert_old_factory ? wi_win_factory_concert();
  );

  // Upgrade only an untouched former Recorder factory bank. This is the
  // approved pre-72010 voicing; exact matching protects every user edit.
  wi_win_old_magic>=72006 && wi_win_old_magic<=72009 ? (
    wi_win_mig_b=wi_WIN_BANK+3*wi_WIN_BANK_STRIDE;
    wi_win_recorder_old_factory =
      abs(wi_win_mig_b[0]-0)<0.000001 &&
      abs(wi_win_mig_b[1]-0)<0.000001 &&
      abs(wi_win_mig_b[2]-0)<0.000001 &&
      abs(wi_win_mig_b[3]-2)<0.000001 &&
      abs(wi_win_mig_b[4]-1.0)<0.000001 &&
      abs(wi_win_mig_b[5]-1.15)<0.000001 &&
      abs(wi_win_mig_b[6]-0.95)<0.000001 &&
      abs(wi_win_mig_b[7]-0.12)<0.000001 &&
      abs(wi_win_mig_b[8]-7000)<0.000001 &&
      abs(wi_win_mig_b[9]-1)<0.000001 &&
      abs(wi_win_mig_b[10]-100)<0.000001 &&
      abs(wi_win_mig_b[11]-0.192)<0.000001 &&
      abs(wi_win_mig_b[12]-1.24)<0.000001 &&
      abs(wi_win_mig_b[13]-1.00)<0.000001 &&
      abs(wi_win_mig_b[14]-0.08)<0.000001 &&
      abs(wi_win_mig_b[15]-0.72)<0.000001 &&
      abs(wi_win_mig_b[16]-0.68)<0.000001 &&
      abs(wi_win_mig_b[17]-0.70)<0.000001 &&
      abs(wi_win_mig_b[18]-0.25)<0.000001 &&
      abs(wi_win_mig_b[19]-0.42)<0.000001 &&
      abs(wi_win_mig_b[20]-0.12)<0.000001 &&
      abs(wi_win_mig_b[21]-4800)<0.000001 &&
      abs(wi_win_mig_b[22]-5.0)<0.000001 &&
      abs(wi_win_mig_b[23]-2)<0.000001 &&
      abs(wi_win_mig_b[24]-300)<0.000001 &&
      abs(wi_win_mig_b[25]-0.04)<0.000001;
    wi_win_recorder_old_factory ? wi_win_factory_recorder();
  );

  // Upgrade only an untouched provisional Pan Flute bank. The exact signature
  // prevents an edited Pan Flute from being replaced by the new factory table.
  wi_win_old_magic>=72003 && wi_win_old_magic<=72008 ? (
    wi_win_mig_b=wi_WIN_BANK+4*wi_WIN_BANK_STRIDE;
    wi_win_pan_old_factory =
      abs(wi_win_mig_b[0]-0)<0.000001 &&
      abs(wi_win_mig_b[1]-0)<0.000001 &&
      abs(wi_win_mig_b[5]-1.35)<0.000001 &&
      abs(wi_win_mig_b[6]-1.05)<0.000001 &&
      abs(wi_win_mig_b[7]-0.35)<0.000001 &&
      abs(wi_win_mig_b[8]-4500)<0.000001 &&
      abs(wi_win_mig_b[10]-280)<0.000001 &&
      abs(wi_win_mig_b[11]-0.42)<0.000001 &&
      abs(wi_win_mig_b[12]-0.90)<0.000001 &&
      abs(wi_win_mig_b[13]-0.42)<0.000001 &&
      abs(wi_win_mig_b[14]-(-0.12))<0.000001 &&
      abs(wi_win_mig_b[15]-0.48)<0.000001 &&
      abs(wi_win_mig_b[19]-0.70)<0.000001 &&
      abs(wi_win_mig_b[20]-0.00)<0.000001 &&
      abs(wi_win_mig_b[23]-9)<0.000001 &&
      abs(wi_win_mig_b[24]-250)<0.000001;
    wi_win_pan_old_factory ? wi_win_factory_panflute();
  );

  // Upgrade only an untouched provisional Ocarina bank. The exact signature
  // protects any Ocarina already edited by the user.
  wi_win_old_magic>=72003 && wi_win_old_magic<=72008 ? (
    wi_win_mig_b=wi_WIN_BANK+5*wi_WIN_BANK_STRIDE;
    wi_win_ocarina_old_factory =
      abs(wi_win_mig_b[0]-0)<0.000001 &&
      abs(wi_win_mig_b[1]-0)<0.000001 &&
      abs(wi_win_mig_b[5]-1.25)<0.000001 &&
      abs(wi_win_mig_b[6]-0.90)<0.000001 &&
      abs(wi_win_mig_b[7]-0.08)<0.000001 &&
      abs(wi_win_mig_b[8]-5000)<0.000001 &&
      abs(wi_win_mig_b[9]-30)<0.000001 &&
      abs(wi_win_mig_b[10]-180)<0.000001 &&
      abs(wi_win_mig_b[11]-0.18)<0.000001 &&
      abs(wi_win_mig_b[12]-1.15)<0.000001 &&
      abs(wi_win_mig_b[13]-0.75)<0.000001 &&
      abs(wi_win_mig_b[14]-0.15)<0.000001 &&
      abs(wi_win_mig_b[16]-0.85)<0.000001 &&
      abs(wi_win_mig_b[18]-0.05)<0.000001 &&
      abs(wi_win_mig_b[19]-0.95)<0.000001 &&
      abs(wi_win_mig_b[20]-0.04)<0.000001 &&
      abs(wi_win_mig_b[24]-180)<0.000001 &&
      abs(wi_win_mig_b[25]-0.10)<0.000001;
    wi_win_ocarina_old_factory ? wi_win_factory_ocarina();
  );

  // 72011 tuning-unit migration: hidden Wind bank slot 2 used to store cents.
  // Convert known old Current Banks to semitones, preserving every edit.
  wi_win_old_magic>=72003 && wi_win_old_magic<=72010 ? (
    wi_win_conv_i=0;
    loop(wi_WIN_BANK_COUNT,
      wi_win_conv_b=wi_WIN_BANK+wi_win_conv_i*wi_WIN_BANK_STRIDE;
      wi_win_conv_b[2] *= 0.01;
      wi_win_conv_i += 1;
    );
  );


  // 72012 full Wind snapshot refresh.
  // Only banks that are still exactly the 72011 factory are replaced;
  // every user-edited Current Bank remains untouched.
