// ============================================================
// CURRENT REVERB BANKS — ONE OWNER AT A TIME ON THE SAME 10 SLIDERS
//
// Plain engine/internal-instrument switch:
//   capture old owner -> load Current bank of new owner.
// Normal edit:
//   capture visible values into current owner.
// Bulk project/preset restore:
//   if owner + visible reverb changed together, visible values belong to new owner.
//
// Banks are serialized so user edits survive project close/reopen, not just
// movement between engines/instruments during the current REAPER session.
// ============================================================
rev_current_bank = 2020200;   // 17 owners x 10 values.
rev_live_snapshot = 2020400;  // 10 visible-value sentinels.
rev_current_stride = 10;
rev_bank_magic_value = 72005;

function rev_owner_index(engine,mallet_inst,wind_inst)
local(e,m,w)
(
  e=max(0,min(6,floor(engine+0.5)));
  m=max(0,min(5,floor(mallet_inst+0.5)));
  w=max(0,min(5,floor(wind_inst+0.5)));
  e < 4 ? e :
  e < 5 ? 4+m :
  e < 6 ? 10+w :
          16;
);

function rev_live_value(p)
(
  p == 0 ? slider48 :
  p == 1 ? slider49 :
  p == 2 ? slider50 :
  p == 3 ? slider51 :
  p == 4 ? slider52 :
  p == 5 ? slider53 :
  p == 6 ? slider54 :
  p == 7 ? slider55 :
  p == 8 ? slider56 :
           slider57;
);

function rev_set_live(p,value)
(
  p == 0 ? slider48=value :
  p == 1 ? slider49=value :
  p == 2 ? slider50=value :
  p == 3 ? slider51=value :
  p == 4 ? slider52=value :
  p == 5 ? slider53=value :
  p == 6 ? slider54=value :
  p == 7 ? slider55=value :
  p == 8 ? slider56=value :
           slider57=value;
);

function rev_bank_fill_factory(owner)
local(base,src,p)
(
  owner=max(0,min(rev_owner_count-1,floor(owner+0.5)));
  base=rev_current_bank+owner*rev_current_stride;
  src=rev_engine_table+owner*rev_engine_stride;
  p=0;
  loop(10,
    base[p]=src[p];
    p+=1;
  );
);

// Previous LWS-7 Wind provisional factory used one dry row for all six Winds.
// Used only during migration so an untouched old Wind bank can receive its
// approved per-instrument Reverb init without overwriting user edits.
function rev_old_wind_dry_untouched(owner)
local(base,ok)
(
  owner=max(10,min(15,floor(owner+0.5)));
  base=rev_current_bank+owner*rev_current_stride;
  ok =
    abs(base[0]-0.00)<0.0000001 &&
    abs(base[1]-1800)<0.0000001 &&
    abs(base[2]-1.00)<0.0000001 &&
    abs(base[3]-0.90)<0.0000001 &&
    abs(base[4]-1.00)<0.0000001 &&
    abs(base[5]-1.00)<0.0000001 &&
    abs(base[6]-0.80)<0.0000001 &&
    abs(base[7]-2.00)<0.0000001 &&
    abs(base[8]-0.90)<0.0000001 &&
    abs(base[9]-1.00)<0.0000001;
  ok;
);

function rev_migrate_wind_factory()
local(owner)
(
  owner=10;
  loop(6,
    rev_old_wind_dry_untouched(owner) ? rev_bank_fill_factory(owner);
    owner+=1;
  );
);

function rev_bank_capture(owner)
local(base,p)
(
  owner=max(0,min(rev_owner_count-1,floor(owner+0.5)));
  base=rev_current_bank+owner*rev_current_stride;
  p=0;
  loop(10,
    base[p]=rev_live_value(p);
    p+=1;
  );
);

function rev_bank_load(owner)
local(base,p)
(
  owner=max(0,min(rev_owner_count-1,floor(owner+0.5)));
  base=rev_current_bank+owner*rev_current_stride;
  p=0;
  loop(10,
    rev_set_live(p,base[p]);
    p+=1;
  );
);

function rev_snapshot_live()
local(p)
(
  p=0;
  loop(10,
    rev_live_snapshot[p]=rev_live_value(p);
    p+=1;
  );
);

function rev_live_changed()
local(p,changed)
(
  p=0;
  changed=0;
  loop(10,
    abs(rev_live_value(p)-rev_live_snapshot[p])>0.0000000001 ? changed=1;
    p+=1;
  );
  changed;
);

function rev_notify_live()
(
  sliderchange(slider48);
  sliderchange(slider49);
  sliderchange(slider50);
  sliderchange(slider51);
  sliderchange(slider52);
  sliderchange(slider53);
  sliderchange(slider54);
  sliderchange(slider55);
  sliderchange(slider56);
  sliderchange(slider57);
);

// A new project starts from Factory. Migration is append-only:
// 72001 = ten legacy owners,
// 72002 = sixteen owners through Wind,
// 72003 = Micro owner added with its old dry provisional factory,
// 72004 = Micro approved, but Wind rows still used the common dry provisional factory,
// 72005 = six approved Wind Reverb factory rows.
//
// Preserve user Current banks. For older Wind-capable states, only an untouched
// old dry Wind bank is replaced by the corresponding approved factory row.
rev_bank_magic != rev_bank_magic_value ? (
  rev_bank_magic == 72004 ? (
    rev_migrate_wind_factory();
  ) : rev_bank_magic == 72003 ? (
    rev_old_micro=rev_current_bank+16*rev_current_stride;
    rev_old_micro_untouched =
      abs(rev_old_micro[0]-0.00)<0.0000001 &&
      abs(rev_old_micro[1]-1800)<0.0000001 &&
      abs(rev_old_micro[2]-1.00)<0.0000001 &&
      abs(rev_old_micro[3]-0.90)<0.0000001 &&
      abs(rev_old_micro[4]-1.00)<0.0000001 &&
      abs(rev_old_micro[5]-1.00)<0.0000001 &&
      abs(rev_old_micro[6]-0.80)<0.0000001 &&
      abs(rev_old_micro[7]-2.00)<0.0000001 &&
      abs(rev_old_micro[8]-0.90)<0.0000001 &&
      abs(rev_old_micro[9]-1.00)<0.0000001;
    rev_old_micro_untouched ? rev_bank_fill_factory(16);
    rev_migrate_wind_factory();
  ) : rev_bank_magic == 72002 ? (
    rev_bank_fill_factory(16);
    rev_migrate_wind_factory();
  ) : rev_bank_magic == 72001 ? (
    rev_i=10;
    loop(7,
      rev_bank_fill_factory(rev_i);
      rev_i+=1;
    );
  ) : (
    rev_i=0;
    loop(rev_owner_count,
      rev_bank_fill_factory(rev_i);
      rev_i+=1;
    );
  );
  rev_bank_magic=rev_bank_magic_value;
);

// The currently visible host/project state wins for the selected owner.
reverb_owner_prev=rev_owner_index(slider58,slider170,slider214);
rev_bank_capture(reverb_owner_prev);
rev_snapshot_live();


// ============================================================
// CONTEXTUAL DUAL TAPE DELAY BANKS — SAME 17 OWNERS AS REVERB
// 14 values per owner, sliders 199..212 only.
//
// Owners 0..9 retain the former global/dry Delay factory.
// Owners 10..15 use the six approved Wind Delay snapshots (currently identical
// and intentionally dry, but stored as six independent logical owners).
// Owner 16 (Micro Synth) uses its approved dedicated Delay snapshot.
//
// This is Current-bank memory, not a forced preset recall: user edits are
// captured continuously and are restored when returning to that owner.
// ============================================================
dt_factory_table=2020500;
dt_current_bank=2020800;
dt_live_snapshot=2021100;
dt_current_stride=14;
dt_owner_count=17;
dt_bank_magic_value=73002;

// Former global Delay factory retained for the four standard engines and six Mallets.
dt_factory_i=0;
loop(10,
  dt_factory_base=dt_factory_table+dt_factory_i*dt_current_stride;
  dt_factory_base[0]=0.00;    // Mix
  dt_factory_base[1]=180;     // Glide ms
  dt_factory_base[2]=1.00;    // Division Tape 1
  dt_factory_base[3]=1.50;    // Division Tape 2
  dt_factory_base[4]=0.00;    // Pitch Tape 1
  dt_factory_base[5]=0.00;    // Pitch Tape 2
  dt_factory_base[6]=-9.00;   // Feedback Tape 1 dB
  dt_factory_base[7]=-9.00;   // Feedback Tape 2 dB
  dt_factory_base[8]=9000;    // Filter Tape 1 Hz
  dt_factory_base[9]=7500;    // Filter Tape 2 Hz
  dt_factory_base[10]=0.75;   // Stereo Spread
  dt_factory_base[11]=100;    // Delay to Reverb %
  dt_factory_base[12]=20;     // Tape Drive %
  dt_factory_base[13]=0;      // Decay Shape
  dt_factory_i+=1;
);

// Wind Delay factory — six explicit user-approved instrument snapshots.
// Values are written per owner even when identical, so each Init is self-contained.

// Concert Flute Delay Init — Wind owner 10.
dt_factory_base=dt_factory_table+10*dt_current_stride;
dt_factory_base[0]=0;      // Mix
dt_factory_base[1]=180;      // Glide ms
dt_factory_base[2]=1;      // Division Tape 1
dt_factory_base[3]=1.5;      // Division Tape 2
dt_factory_base[4]=0;      // Pitch Tape 1
dt_factory_base[5]=0;      // Pitch Tape 2
dt_factory_base[6]=-9;      // Feedback Tape 1 dB
dt_factory_base[7]=-9;      // Feedback Tape 2 dB
dt_factory_base[8]=9000;      // Filter Tape 1 Hz
dt_factory_base[9]=7500;      // Filter Tape 2 Hz
dt_factory_base[10]=0.75;      // Stereo Spread
dt_factory_base[11]=100;      // Delay to Reverb %
dt_factory_base[12]=20;      // Tape Drive %
dt_factory_base[13]=0;      // Decay Shape

// Piccolo Delay Init — Wind owner 11.
dt_factory_base=dt_factory_table+11*dt_current_stride;
dt_factory_base[0]=0;      // Mix
dt_factory_base[1]=180;      // Glide ms
dt_factory_base[2]=1;      // Division Tape 1
dt_factory_base[3]=1.5;      // Division Tape 2
dt_factory_base[4]=0;      // Pitch Tape 1
dt_factory_base[5]=0;      // Pitch Tape 2
dt_factory_base[6]=-9;      // Feedback Tape 1 dB
dt_factory_base[7]=-9;      // Feedback Tape 2 dB
dt_factory_base[8]=9000;      // Filter Tape 1 Hz
dt_factory_base[9]=7500;      // Filter Tape 2 Hz
dt_factory_base[10]=0.75;      // Stereo Spread
dt_factory_base[11]=100;      // Delay to Reverb %
dt_factory_base[12]=20;      // Tape Drive %
dt_factory_base[13]=0;      // Decay Shape

// Alto Flute Delay Init — Wind owner 12.
dt_factory_base=dt_factory_table+12*dt_current_stride;
dt_factory_base[0]=0;      // Mix
dt_factory_base[1]=180;      // Glide ms
dt_factory_base[2]=1;      // Division Tape 1
dt_factory_base[3]=1.5;      // Division Tape 2
dt_factory_base[4]=0;      // Pitch Tape 1
dt_factory_base[5]=0;      // Pitch Tape 2
dt_factory_base[6]=-9;      // Feedback Tape 1 dB
dt_factory_base[7]=-9;      // Feedback Tape 2 dB
dt_factory_base[8]=9000;      // Filter Tape 1 Hz
dt_factory_base[9]=7500;      // Filter Tape 2 Hz
dt_factory_base[10]=0.75;      // Stereo Spread
dt_factory_base[11]=100;      // Delay to Reverb %
dt_factory_base[12]=20;      // Tape Drive %
dt_factory_base[13]=0;      // Decay Shape

// Recorder Delay Init — Wind owner 13.
dt_factory_base=dt_factory_table+13*dt_current_stride;
dt_factory_base[0]=0;      // Mix
dt_factory_base[1]=180;      // Glide ms
dt_factory_base[2]=1;      // Division Tape 1
dt_factory_base[3]=1.5;      // Division Tape 2
dt_factory_base[4]=0;      // Pitch Tape 1
dt_factory_base[5]=0;      // Pitch Tape 2
dt_factory_base[6]=-9;      // Feedback Tape 1 dB
dt_factory_base[7]=-9;      // Feedback Tape 2 dB
dt_factory_base[8]=9000;      // Filter Tape 1 Hz
dt_factory_base[9]=7500;      // Filter Tape 2 Hz
dt_factory_base[10]=0.75;      // Stereo Spread
dt_factory_base[11]=100;      // Delay to Reverb %
dt_factory_base[12]=20;      // Tape Drive %
dt_factory_base[13]=0;      // Decay Shape

// Pan Flute Delay Init — Wind owner 14.
dt_factory_base=dt_factory_table+14*dt_current_stride;
dt_factory_base[0]=0.32;      // Mix
dt_factory_base[1]=180;      // Glide ms
dt_factory_base[2]=1;      // Division Tape 1
dt_factory_base[3]=1.5;      // Division Tape 2
dt_factory_base[4]=0;      // Pitch Tape 1
dt_factory_base[5]=0;      // Pitch Tape 2
dt_factory_base[6]=-9;      // Feedback Tape 1 dB
dt_factory_base[7]=-9;      // Feedback Tape 2 dB
dt_factory_base[8]=9000;      // Filter Tape 1 Hz
dt_factory_base[9]=7500;      // Filter Tape 2 Hz
dt_factory_base[10]=0.75;      // Stereo Spread
dt_factory_base[11]=300;      // Delay to Reverb %
dt_factory_base[12]=20;      // Tape Drive %
dt_factory_base[13]=0;      // Decay Shape

// Ocarina Delay Init — Wind owner 15.
dt_factory_base=dt_factory_table+15*dt_current_stride;
dt_factory_base[0]=0;      // Mix
dt_factory_base[1]=180;      // Glide ms
dt_factory_base[2]=1;      // Division Tape 1
dt_factory_base[3]=1.5;      // Division Tape 2
dt_factory_base[4]=0;      // Pitch Tape 1
dt_factory_base[5]=0;      // Pitch Tape 2
dt_factory_base[6]=-9;      // Feedback Tape 1 dB
dt_factory_base[7]=-9;      // Feedback Tape 2 dB
dt_factory_base[8]=9000;      // Filter Tape 1 Hz
dt_factory_base[9]=7500;      // Filter Tape 2 Hz
dt_factory_base[10]=0.75;      // Stereo Spread
dt_factory_base[11]=100;      // Delay to Reverb %
dt_factory_base[12]=20;      // Tape Drive %
dt_factory_base[13]=0;      // Decay Shape
// Micro Synth Delay — approved factory snapshot.
dt_factory_base=dt_factory_table+16*dt_current_stride;
dt_factory_base[0]=0.40;
dt_factory_base[1]=180;
dt_factory_base[2]=2.00;
dt_factory_base[3]=1.50;
dt_factory_base[4]=0.00;
dt_factory_base[5]=0.00;
dt_factory_base[6]=-11.40;
dt_factory_base[7]=-11.40;
dt_factory_base[8]=10000;
dt_factory_base[9]=10000;
dt_factory_base[10]=0.75;
dt_factory_base[11]=300;
dt_factory_base[12]=20;
dt_factory_base[13]=0;

function dt_live_value(p)
(
  p == 0 ? slider199 :
  p == 1 ? slider200 :
  p == 2 ? slider201 :
  p == 3 ? slider202 :
  p == 4 ? slider203 :
  p == 5 ? slider204 :
  p == 6 ? slider205 :
  p == 7 ? slider206 :
  p == 8 ? slider207 :
  p == 9 ? slider208 :
  p == 10 ? slider209 :
  p == 11 ? slider210 :
  p == 12 ? slider211 :
            slider212;
);

function dt_set_live(p,value)
(
  p == 0 ? slider199=value :
  p == 1 ? slider200=value :
  p == 2 ? slider201=value :
  p == 3 ? slider202=value :
  p == 4 ? slider203=value :
  p == 5 ? slider204=value :
  p == 6 ? slider205=value :
  p == 7 ? slider206=value :
  p == 8 ? slider207=value :
  p == 9 ? slider208=value :
  p == 10 ? slider209=value :
  p == 11 ? slider210=value :
  p == 12 ? slider211=value :
            slider212=value;
);

function dt_bank_fill_factory(owner)
local(base,src,p)
(
  owner=max(0,min(dt_owner_count-1,floor(owner+0.5)));
  base=dt_current_bank+owner*dt_current_stride;
  src=dt_factory_table+owner*dt_current_stride;
  p=0;
  loop(dt_current_stride,
    base[p]=src[p];
    p+=1;
  );
);

function dt_bank_capture(owner)
local(base,p)
(
  owner=max(0,min(dt_owner_count-1,floor(owner+0.5)));
  base=dt_current_bank+owner*dt_current_stride;
  p=0;
  loop(dt_current_stride,
    base[p]=dt_live_value(p);
    p+=1;
  );
);

function dt_bank_load(owner)
local(base,p)
(
  owner=max(0,min(dt_owner_count-1,floor(owner+0.5)));
  base=dt_current_bank+owner*dt_current_stride;
  p=0;
  loop(dt_current_stride,
    dt_set_live(p,base[p]);
    p+=1;
  );
);

function dt_snapshot_live()
local(p)
(
  p=0;
  loop(dt_current_stride,
    dt_live_snapshot[p]=dt_live_value(p);
    p+=1;
  );
);

function dt_live_changed()
local(p,changed)
(
  p=0;
  changed=0;
  loop(dt_current_stride,
    abs(dt_live_value(p)-dt_live_snapshot[p])>0.0000000001 ? changed=1;
    p+=1;
  );
  changed;
);

function dt_notify_live()
(
  sliderchange(slider199);
  sliderchange(slider200);
  sliderchange(slider201);
  sliderchange(slider202);
  sliderchange(slider203);
  sliderchange(slider204);
  sliderchange(slider205);
  sliderchange(slider206);
  sliderchange(slider207);
  sliderchange(slider208);
  sliderchange(slider209);
  sliderchange(slider210);
  sliderchange(slider211);
  sliderchange(slider212);
);

// Contextual Delay migration.
// 73001 = first contextual Delay version: all six Winds used the dry factory.
// 73002 = Pan Flute receives its approved active Delay Init.
// Preserve any user-edited Current bank; upgrade only the exact untouched
// previous Pan Flute factory signature.
dt_old_magic=dt_bank_magic;
dt_bank_magic != dt_bank_magic_value ? (
  dt_old_magic==73001 ? (
    dt_mig_b=dt_current_bank+14*dt_current_stride;
    dt_pan_old_factory =
      abs(dt_mig_b[0]-0.00)<0.000001 &&
      abs(dt_mig_b[1]-180)<0.000001 &&
      abs(dt_mig_b[2]-1.00)<0.000001 &&
      abs(dt_mig_b[3]-1.50)<0.000001 &&
      abs(dt_mig_b[4]-0.00)<0.000001 &&
      abs(dt_mig_b[5]-0.00)<0.000001 &&
      abs(dt_mig_b[6]-(-9.00))<0.000001 &&
      abs(dt_mig_b[7]-(-9.00))<0.000001 &&
      abs(dt_mig_b[8]-9000)<0.000001 &&
      abs(dt_mig_b[9]-7500)<0.000001 &&
      abs(dt_mig_b[10]-0.75)<0.000001 &&
      abs(dt_mig_b[11]-100)<0.000001 &&
      abs(dt_mig_b[12]-20)<0.000001 &&
      abs(dt_mig_b[13]-0)<0.000001;
    dt_pan_old_factory ? dt_bank_fill_factory(14);
  ) : (
    // Fresh/older state: initialize every owner from the current factory table.
    dt_factory_i=0;
    loop(dt_owner_count,
      dt_bank_fill_factory(dt_factory_i);
      dt_factory_i+=1;
    );
  );
  dt_bank_magic=dt_bank_magic_value;
);

delay_owner_prev=rev_owner_index(slider58,slider170,slider214);

// If a 73001 project was saved while Pan Flute was active and its visible Delay
// is still the exact old dry factory, expose the new Pan Flute Init before the
// normal live-state capture. Any visible user edit prevents this replacement.
dt_old_magic==73001 && delay_owner_prev==14 ? (
  dt_pan_live_old_factory =
    abs(slider199-0.00)<0.000001 &&
    abs(slider200-180)<0.000001 &&
    abs(slider201-1.00)<0.000001 &&
    abs(slider202-1.50)<0.000001 &&
    abs(slider203-0.00)<0.000001 &&
    abs(slider204-0.00)<0.000001 &&
    abs(slider205-(-9.00))<0.000001 &&
    abs(slider206-(-9.00))<0.000001 &&
    abs(slider207-9000)<0.000001 &&
    abs(slider208-7500)<0.000001 &&
    abs(slider209-0.75)<0.000001 &&
    abs(slider210-100)<0.000001 &&
    abs(slider211-20)<0.000001 &&
    abs(slider212-0)<0.000001;
  dt_pan_live_old_factory ? dt_bank_load(14);
);

dt_bank_capture(delay_owner_prev);
dt_snapshot_live();
dt_bank_ready=1;
rev_bank_ready=1;

// Separate audio-switch state. Keep -1 so first sample pass initializes/clears
// voice ownership exactly as before.
engine_now=slider58;
engine_prev=-1;

// Fixed calibration trim shared by all seven engines.
// Applied after each engine's own signature/master stage and before shared Delay/Reverb.
// This preserves every engine's internal voicing and leaves the final/shared output topology untouched.
engine_output_trim_2db=0.7943282347242815;

// ============================================================
// ORGAN ENGINE — ISOLATED RAM / ISOLATED STATE
// ============================================================
org_TWO_PI = 2*$pi;
org_LN2_OVER_1200 = log(2)/1200;
org_AA_MARGIN = 0.45*srate;

// Voice memory blocks, 8 values each.
org_VNOTE = 2000000;
org_VSTAGE = 2000016; // 0 off, 1 attack, 2 held, 3 release
org_VENV = 2000032;
org_VFREQ = 2000048; // org_base MIDI frequency before master tuning/vibrato
org_VVEL = 2000064; // normalized MIDI velocity 0..1
org_VPHASE = 2000080;  // tonewheel group A phase, based on 16' frequency
org_VCLICK = 2000096;
org_VPERC = 2000112;
org_VAGE = 2000128;
org_VPHASEB = 2000144; // tonewheel group B, same nominal pitch but independent drift
org_VPHASEC = 2000160; // tonewheel group C, same nominal pitch but independent drift
org_KEYHELD = 2000200; // 128 physical MIDI key states for sustain-pedal ownership.
memset(org_KEYHELD,0,128);
org_sustain_pedal = 0;

org_age_counter = 0;
org_wheel_phase = 0;
org_vib_phase = 0;
org_autopan_phase = 0;
org_drift_value = 0;
org_drift_target = 0;
org_drift_countdown = 1;
org_drift_smooth = 1 - exp(-1/(0.65*srate));

// Slow independent pitch wander for the drawbar tonewheel families.
// Tonewheel Drift remains the ONLY depth parameter.
org_rank_drift_a = 0;
org_rank_drift_b = 0;
org_rank_drift_c = 0;
org_rank_target_a = 0;
org_rank_target_b = 0;
org_rank_target_c = 0;
org_rank_count_a = 1;
org_rank_count_b = 1;
org_rank_count_c = 1;
org_rank_drift_smooth = 1 - exp(-1/(1.10*srate));

// ============================================================
// LO-LO SIGNATURE OUTPUT STAGE — FROM LJuno-116 / LSH-2
// Mandatory final topology:
// stereo signal -> 5 Hz DC blocker -> fixed stereo glue -> x0.4
// -> soft limiter at 0.98 (15% org_excess slope) -> Master Output x2.
// These constants intentionally match LJuno-116 and LSH-2.
// ============================================================
org_dc_coeff_5hz = exp(-2 * $pi * 5 / srate);
org_dc_xL_prev = 0;
org_dc_yL_prev = 0;
org_dc_xR_prev = 0;
org_dc_yR_prev = 0;

org_glue_env = 0;
org_glue_gain = 1;
org_glue_att_inv = 1 / max(1, (0.001 * srate)); // 1 ms
org_glue_rel_inv = 1 / max(1, (0.004 * srate)); // 4 ms
org_glue_ratio_k = 2;
org_glue_thresh_k = 0.055;

org_post_in_gain = 0.4;
org_post_limit = 0.98;

// ============================================================
// OTARI-INSPIRED MAGNETIC TAPE / TRANSPORT
// This is intentionally NOT claimed as an exact MX-5050 circuit model.
// Architecture follows magnetic-tape behavior:
// record pre-emphasis -> stateful magnetic nonlinearity -> playback roll-off
// -> transport delay fluctuation -> low-frequency head contour.
// The transport trajectory is deliberately coupled to the existing AutoPan.
// ============================================================
org_tape_prev_on = -1;
org_tape_prev_inL = 0;
org_tape_prev_inR = 0;
org_tape_preL = 0;
org_tape_preR = 0;
org_tape_magL = 0;
org_tape_magR = 0;
org_tape_playL = 0;
org_tape_playR = 0;

org_tape_bump_lpL = 0;
org_tape_bump_bpL = 0;
org_tape_bump_lpR = 0;
org_tape_bump_bpR = 0;

// State-variable HP used only on the Otari COLOR RESIDUAL.
// The dry organ body bypasses this filter completely.
org_grain_hp_lpL = 0;
org_grain_hp_bpL = 0;
org_grain_hp_lpR = 0;
org_grain_hp_bpR = 0;

org_TAPE_BUF_SIZE = 4096;
org_TAPE_BUF_L = 2001024;
org_TAPE_BUF_R = org_TAPE_BUF_L + org_TAPE_BUF_SIZE;
org_tape_w = 0;

org_i=0;
loop(org_TAPE_BUF_SIZE,
  org_TAPE_BUF_L[org_i] = 0;
  org_TAPE_BUF_R[org_i] = 0;
  org_i += 1;
);

org_i=0;
loop(8,
  org_VNOTE[org_i] = -1;
  org_VSTAGE[org_i] = 0;
  org_VENV[org_i] = 0;
  org_VFREQ[org_i] = 0;
  org_VVEL[org_i] = 0;
  // Deterministic free-running tonewheel phases; org_note-ons do not reset them.
  // All three families start aligned so Drift=0 preserves the old oscillator.
  org_VPHASE[org_i]  = (org_i+1) * 0.713;
  org_VPHASEB[org_i] = org_VPHASE[org_i];
  org_VPHASEC[org_i] = org_VPHASE[org_i];
  org_VCLICK[org_i] = 0;
  org_VPERC[org_i] = 0;
  org_VAGE[org_i] = 0;
  org_i += 1;
);

function org_shape_rank(org_s, org_f) local(org_s2,org_s3,org_s5,org_s7,org_h3,org_h5,org_h7,org_o) (
  org_o = org_wave1 * org_s;

  // Internal odd harmonics are generated algebraically from the rank sine.
  // Each one is omitted before it can cross the anti-alias margin.
  (org_shape_need3 && org_f*3 < org_AA_MARGIN) ? (
    org_s2 = org_s*org_s;
    org_s3 = org_s2*org_s;
    org_h3 = 3*org_s - 4*org_s3;
    org_o += org_wave3 * org_h3;

    (org_shape_need5 && org_f*5 < org_AA_MARGIN) ? (
      org_s5 = org_s3*org_s2;
      org_h5 = 16*org_s5 - 20*org_s3 + 5*org_s;
      org_o += org_wave5 * org_h5;

      (org_shape_need7 && org_f*7 < org_AA_MARGIN) ? (
        org_s7 = org_s5*org_s2;
        org_h7 = 7*org_s - 56*org_s3 + 112*org_s5 - 64*org_s7;
        org_o += org_wave7 * org_h7;
      );
    );
  );

  org_o * org_wave_norm;
);

// Rational soft saturation used inside the magnetic state.
// The important part is not the static curve alone: org_tape_mag_sample feeds a
// controlled amount of the previous magnetization back into the next sample.
function org_tape_soft(org_u) local(org_u2) (
  org_u = max(-3, min(3, org_u));
  org_u2 = org_u*org_u;
  org_u * (27 + org_u2) / (27 + 9*org_u2);
);

// Two-channel stateful magnetic record/play path.
// Coefficients are calculated for 2x local processing.
function org_tape_mag_sample(org_x, org_ch, org_drive_ch)
local(org_hi, org_rec, org_u, org_sat, org_out)
(
  org_ch < 0.5 ? (
    org_tape_preL += (org_x - org_tape_preL) * org_tape_pre_alpha;
    org_hi = org_x - org_tape_preL;
    org_rec = org_x + org_hi * org_tape_pre_emph;

    org_u = org_rec * org_drive_ch + org_tape_magL * org_tape_mem_fb;
    org_sat = org_tape_soft(org_u);
    org_tape_magL += (org_sat - org_tape_magL) * org_tape_mag_follow;
    org_out = (org_sat * (1-org_tape_mem_mix) + org_tape_magL * org_tape_mem_mix) * org_tape_drive_comp;

    // At Drive = 0 dB this leaves the signal ~98.5% clean.
    org_out = org_x + (org_out - org_x) * org_tape_sat_mix;

    org_tape_playL += (org_out - org_tape_playL) * org_tape_play_alpha;
    org_tape_playL;
  ) : (
    org_tape_preR += (org_x - org_tape_preR) * org_tape_pre_alpha;
    org_hi = org_x - org_tape_preR;
    org_rec = org_x + org_hi * org_tape_pre_emph;

    org_u = org_rec * org_drive_ch + org_tape_magR * org_tape_mem_fb;
    org_sat = org_tape_soft(org_u);
    org_tape_magR += (org_sat - org_tape_magR) * org_tape_mag_follow;
    org_out = (org_sat * (1-org_tape_mem_mix) + org_tape_magR * org_tape_mem_mix) * org_tape_drive_comp;

    // Same low-drive calibration on the right channel.
    org_out = org_x + (org_out - org_x) * org_tape_sat_mix;

    org_tape_playR += (org_out - org_tape_playR) * org_tape_play_alpha;
    org_tape_playR;
  );
);

// Linear fractional delay.  The pitch shift is created by MOVING this delay,
// not by applying a pitch LFO directly.
function org_tape_delay_read(org_base, org_delay_samples)
local(org_rp, org_i0, org_i1, org_frac)
(
  org_rp = org_tape_w - org_delay_samples;
  org_rp < 0 ? org_rp += org_TAPE_BUF_SIZE;
  org_i0 = floor(org_rp);
  org_frac = org_rp - org_i0;
  org_i1 = org_i0 + 1;
  org_i1 >= org_TAPE_BUF_SIZE ? org_i1 = 0;
  org_base[org_i0] * (1-org_frac) + org_base[org_i1] * org_frac;
);

function org_midi_note_on(org_n, org_v) local(org_i,org_slot,org_old_age) (
  org_slot = -1;

  // Repeated key retriggers its existing org_voice instead of stacking duplicates.
  org_i=0;
  loop(8,
    (org_slot < 0 && org_VSTAGE[org_i] > 0 && org_VNOTE[org_i] == org_n) ? org_slot = org_i;
    org_i += 1;
  );

  // Prefer a free org_voice.
  (org_slot < 0) ? (
    org_i=0;
    loop(8,
      (org_slot < 0 && org_VSTAGE[org_i] == 0) ? org_slot = org_i;
      org_i += 1;
    );
  );

  // Otherwise steal the oldest org_voice.
  (org_slot < 0) ? (
    org_slot = 0;
    org_old_age = org_VAGE[0];
    org_i=1;
    loop(7,
      (org_VAGE[org_i] < org_old_age) ? (
        org_old_age = org_VAGE[org_i];
        org_slot = org_i;
      );
      org_i += 1;
    );
  );

  org_age_counter += 1;
  org_VAGE[org_slot] = org_age_counter;
  org_VNOTE[org_slot] = org_n;
  org_VFREQ[org_slot] = 440 * 2^((org_n-69)/12);
  org_VVEL[org_slot] = org_v/127;
  org_VENV[org_slot] = 0;
  org_VSTAGE[org_slot] = 1;
  // Intentionally do not reset org_VPHASE: organ/tonewheel-style free phase onset.
  org_VCLICK[org_slot] = 1;
  org_VPERC[org_slot] = slider81 > 0 ? 1 : 0;
);

function org_midi_note_off(org_n) local(org_i) (
  org_i=0;
  loop(8,
    (org_VSTAGE[org_i] > 0 && org_VNOTE[org_i] == org_n && !org_sustain_pedal) ? org_VSTAGE[org_i] = 3;
    org_i += 1;
  );
);

function org_midi_release_pedal() local(org_i,org_n) (
  org_i=0;
  loop(8,
    org_VSTAGE[org_i] > 0 ? (
      org_n=org_VNOTE[org_i];
      org_n >= 0 && !org_KEYHELD[org_n] ? org_VSTAGE[org_i]=3;
    );
    org_i += 1;
  );
);



// ============================================================
// RHODES ENGINE — FULLY ISOLATED STATE / RAM / FUNCTIONS
// Source: user-supplied Rhodes Lab (internally 0.12 User Init).
// RAM bank starts at 2,100,000.
// ============================================================

rh_twopi = 2*$pi;
rh_ln_001 = log(0.001);
rh_voice_count = 12;

// ------------------------------------------------------------
// Voice memory.
// ------------------------------------------------------------
rh_VACTIVE = 2100000;
rh_VNOTE = 2100016;
rh_VGATE = 2100032;
rh_VVEL = 2100048;
rh_VSTAMP = 2100064;
rh_VQUIET = 2100080;
rh_VDAMPED = 2100096;
rh_VFREQ = 2100112;
rh_VDECAY = 2100128;

rh_F_Y1 = 2100144;   rh_F_Y2 = 160;   rh_F_C1 = 176;   rh_F_C2 = 192;
rh_M1_Y1 = 2100208;  rh_M1_Y2 = 224;  rh_M1_C1 = 240;  rh_M1_C2 = 256;
rh_M2_Y1 = 2100272;  rh_M2_Y2 = 288;  rh_M2_C1 = 304;  rh_M2_C2 = 320;
rh_M3_Y1 = 2100336;  rh_M3_Y2 = 352;  rh_M3_C1 = 368;  rh_M3_C2 = 384;
rh_B_Y1 = 2100400;   rh_B_Y2 = 416;   rh_B_C1 = 432;   rh_B_C2 = 448;

rh_VPREVFLUX = 2100464;
rh_VNOISEENV = 2100480;
rh_VNOISELP = 2100496;
rh_VNOISEDEC = 512;
rh_VNOISELOW = 2100528;
rh_VOTGAIN = 2100544;
rh_VBODYATT = 2100560;

// Physical-key memory is deliberately separate from audio voice ownership.
rh_KEYHELD = 600; // 128 values.

// Sample-accurate MIDI queue.
rh_EV_OFF = 800;
rh_EV_MSG1 = 928;
rh_EV_MSG23 = 1056;
rh_EV_MAX = 128;

// Mechanical action modal bank (3 short resonators per voice).
// Deliberately separate from tine/tone-bar states.
rh_ME1_Y1 = 2101200; rh_ME1_Y2 = 1216; rh_ME1_C1 = 1232; rh_ME1_C2 = 1248;
rh_ME2_Y1 = 2101264; rh_ME2_Y2 = 1280; rh_ME2_C1 = 1296; rh_ME2_C2 = 1312;
rh_ME3_Y1 = 2101328; rh_ME3_Y2 = 1344; rh_ME3_C1 = 1360; rh_ME3_C2 = 1376;

// Per-voice pickup tone states.
// Needed so notes of different velocity can have different brightness inside one chord.
rh_VPKLP1 = 2101400;
rh_VPKLP2 = 2101416;
rh_VPKK = 2101432;

// TEST2 Rhodes runtime caches. These values change only on Note On / retune / slider edit,
// never at audio rate. Keeping them per voice removes repeated velocity/frequency work
// from the 12-voice hot loop without changing the pickup equation.
rh_VMOTION_SCALE = 2101448;
rh_VINDUCED_SCALE = 2101464;

// TEST4 compact active-voice list. Only currently sounding Rhodes slots are
// visited by @sample; inactive slots do not exist in the hot renderer path.
rh_ACTIVE_LIST = 2101480; // 12 entries max.

rh_ev_count = 0;
rh_ev_index = 0;
rh_sample_in_block = 0;

rh_voice_stamp_counter = 1;
rh_active_count = 0;
rh_sustain_pedal = 0;
rh_pitch_bend_norm = 0;

// Fixed 3 ms anti-click attack for the direct body only.
// Pickup, hammer/noise, damper and all other transients remain unchanged.
rh_body_attack_step = 1/max(1,0.003*srate);

// Pickup/output states.
rh_sat_low = 0;

// AutoPan recurrence.
rh_ap_sin = 0;
rh_ap_cos = 1;

// Fixed Lo-lo output signature.
rh_dc_coeff_5hz = exp(-rh_twopi*5/srate);
rh_dc_x1L = rh_dc_y1L = 0;
rh_dc_x1R = rh_dc_y1R = 0;
rh_glue_env = 0;
rh_glue_att_inv = 1/(0.001*srate);
rh_glue_rel_inv = 1/(0.004*srate);
rh_glue_ratio_k = 2;
rh_glue_thresh_k = 0.055;
rh_post_in_gain = 0.4;
rh_post_limit = 0.98;

// ------------------------------------------------------------
// Helpers.
// ------------------------------------------------------------
function rh_rh_clamp01(rh_x) (
  max(0,min(1,rh_x));
);

function rh_rh_softclip(rh_x)
local(rh_x2) (
  rh_x2 = rh_x*rh_x;
  rh_x*(27+rh_x2)/(27+9*rh_x2);
);

function rh_rh_mode_coeff(rh_freq, rh_decay_s)
local(rh_w,rh_r) (
  rh_freq > 5 && rh_freq < srate*0.475 ? (
    rh_w = rh_twopi*rh_freq/srate;
    rh_r = exp(rh_ln_001/max(1,rh_decay_s*srate));
    rh_rh_tmp_c1 = 2*rh_r*cos(rh_w);
    rh_rh_tmp_c2 = -rh_r*rh_r;
  ) : (
    rh_rh_tmp_c1 = 0;
    rh_rh_tmp_c2 = 0;
  );
);

function rh_rh_voice_recalc(rh_i)
local(rh_note,rh_f,rh_decay_scale,rh_dec,rh_damper_s,rh_r1,rh_r2,rh_r3,rh_barf,
      rh_vel_dark,rh_vel_curve,rh_voicing_oct,rh_pick_fc,rh_pick_floor) (
  rh_note = rh_VNOTE[rh_i];

  rh_f = 440 * (2^(((rh_note-69) + rh_octave_semi + rh_fine_semi + rh_pitch_bend_semi)/12));
  rh_VFREQ[rh_i] = rh_f;

  // Bass notes naturally keep energy longer; high notes shorten progressively.
  rh_decay_scale = 2^(-((rh_note-60)/48)*rh_decay_keytrack);
  rh_dec = max(0.08,rh_tine_decay*rh_decay_scale);
  rh_VDECAY[rh_i] = rh_dec;

  rh_VDAMPED[rh_i] ? (
    rh_damper_s = max(0.010,rh_damper_ms*0.001);
    rh_dec = rh_damper_s;
  );

  rh_rh_mode_coeff(rh_f,rh_dec);
  rh_F_C1[rh_i]=rh_rh_tmp_c1; rh_F_C2[rh_i]=rh_rh_tmp_c2;

  rh_r1 = 1 + (6.267-1)*rh_overtone_stretch;
  rh_r2 = 1 + (17.55-1)*rh_overtone_stretch;
  rh_r3 = 1 + (34.39-1)*rh_overtone_stretch;

  // Overtone decay is independent of keyboard position.
  // Tine Overtone Decay = 0.12 therefore keeps the same time behavior
  // in bass and treble. Keyboard compensation is now LEVEL-only.
  rh_rh_mode_coeff(rh_f*rh_r1, max(0.015,rh_dec*rh_overtone_decay));
  rh_M1_C1[rh_i]=rh_rh_tmp_c1; rh_M1_C2[rh_i]=rh_rh_tmp_c2;

  rh_rh_mode_coeff(rh_f*rh_r2, max(0.012,rh_dec*rh_overtone_decay*0.62));
  rh_M2_C1[rh_i]=rh_rh_tmp_c1; rh_M2_C2[rh_i]=rh_rh_tmp_c2;

  rh_rh_mode_coeff(rh_f*rh_r3, max(0.010,rh_dec*rh_overtone_decay*0.42));
  rh_M3_C1[rh_i]=rh_rh_tmp_c1; rh_M3_C2[rh_i]=rh_rh_tmp_c2;

  // LEVEL key follow only.
  // C4 (MIDI 60) and above are exactly 0 dB / unchanged.
  // Toward A0 the curve reaches -30 dB at Key Follow = 1.0.
  // Default 0.18 therefore reaches about -5.4 dB at the bottom,
  // with a smooth musical curve rather than a linear keyboard ramp.
  rh_bass_pos = max(0,min(1,(60-rh_note)/39));
  rh_bass_curve = rh_bass_pos^1.35;
  rh_ot_kf_db = -30 * rh_overtone_level_keyfollow * rh_bass_curve;
  rh_VOTGAIN[rh_i] = 2^(rh_ot_kf_db/6.020599913);

  rh_barf = rh_f * (2^(rh_tonebar_detune/1200));
  rh_rh_mode_coeff(rh_barf, rh_VDAMPED[rh_i] ? max(0.012,rh_damper_s*1.20) : rh_tonebar_decay*rh_decay_scale);
  rh_B_C1[rh_i]=rh_rh_tmp_c1; rh_B_C2[rh_i]=rh_rh_tmp_c2;

  // --------------------------------------------------------
  // PICKUP BARK VELOCITY VOICING
  // Same parameter, now controlling both nonlinear excursion and brightness.
  // Velocity 127 -> Pickup Tone exactly as set.
  // Lower velocities -> progressively darker pickup.
  // --------------------------------------------------------
  rh_vel_dark = 1 - max(0,min(1,rh_VVEL[rh_i]));
  rh_vel_curve = rh_vel_dark^1.18;

  // Max darkening = 3 octaves at Bark Velocity = 1.
  rh_voicing_oct = rh_pickup_bark_velocity * rh_vel_curve * 3.0;
  rh_pick_fc = rh_pickup_tone_hz * (2^(-rh_voicing_oct));

  // Never darken below a musically safe floor related to the played note.
  // This keeps the fundamental/body intact even on very soft low notes.
  rh_pick_floor = max(700, rh_f*3.2);
  rh_pick_fc = max(rh_pick_floor, min(srate*0.45, rh_pick_fc));

  rh_VPKK[rh_i] = 1-exp(-rh_twopi*rh_pick_fc/srate);

  // Audio-rate pickup constants owned by this voice. Velocity and frequency only
  // change when this recalc function is called, so do not rebuild them per sample.
  rh_VMOTION_SCALE[rh_i] = rh_pickup_motion_base
                         * (1 + rh_pickup_bark_velocity*rh_VVEL[rh_i]*1.35);
  rh_VINDUCED_SCALE[rh_i] = srate/max(35,rh_f);
);

function rh_rh_voice_damp(rh_i) (
  rh_VACTIVE[rh_i] ? (
    rh_VDAMPED[rh_i] = 1;
    rh_rh_voice_recalc(rh_i);
  );
);

function rh_rh_active_remove(rh_voice)
local(rh_p,rh_last) (
  rh_p = 0;
  while(rh_p < rh_active_count && rh_ACTIVE_LIST[rh_p] != rh_voice) (
    rh_p += 1;
  );
  rh_p < rh_active_count ? (
    rh_last = rh_active_count-1;
    rh_ACTIVE_LIST[rh_p] = rh_ACTIVE_LIST[rh_last];
    rh_active_count = rh_last;
  );
);

function rh_rh_alloc_voice()
local(rh_i,rh_best,rh_beststamp) (
  rh_best = -1;
  rh_i = 0;
  loop(rh_voice_count,
    rh_best < 0 && !rh_VACTIVE[rh_i] ? rh_best = rh_i;
    rh_i += 1;
  );

  rh_best < 0 ? (
    // Oldest voice stealing.
    rh_best = 0;
    rh_beststamp = rh_VSTAMP[0];
    rh_i = 1;
    loop(rh_voice_count-1,
      rh_VSTAMP[rh_i] < rh_beststamp ? (
        rh_best = rh_i;
        rh_beststamp = rh_VSTAMP[rh_i];
      );
      rh_i += 1;
    );
  ) : (
    // New DSP owner: append exactly once to the compact active list.
    rh_ACTIVE_LIST[rh_active_count] = rh_best;
    rh_active_count += 1;
  );

  rh_best;
);

function rh_rh_mech_strike(rh_i,rh_note,rh_amp,rh_hard)
local(rh_tone_t,rh_key_irreg,rh_ma,rh_f1,rh_f2,rh_f3,rh_d1,rh_d2,rh_d3,rh_w1,rh_w2,rh_w3,rh_l1,rh_l2,rh_l3) (
  rh_mech_action_gain > 0 ? (
    // Tone maps the action from a dull pedestal/hammer "thunk"
    // to a harder plastic/metallic "clack".
    rh_tone_t = max(0,min(1,(rh_mech_noise_tone-500)/(12000-500)));

    // Each physical key gets a tiny deterministic irregularity.
    // No random/noise process is used.
    rh_key_irreg = 1 + 0.018*sin(rh_note*1.731 + 0.37);

    rh_f1 = (230 + 520*(rh_tone_t^1.20))*rh_key_irreg;
    rh_f2 = (780 + 2050*(rh_tone_t^1.05))*(2-rh_key_irreg);
    rh_f3 = (2100 + 5900*(rh_tone_t^0.92))*rh_key_irreg;

    // Softer tips/pedestal interaction ring a little longer and darker;
    // hard hits transfer relatively more energy into the upper action modes.
    rh_d1 = 0.030 - 0.010*rh_hard;
    rh_d2 = 0.017 - 0.006*rh_hard;
    rh_d3 = 0.009 - 0.003*rh_hard;

    rh_rh_mode_coeff(rh_f1,rh_d1);
    rh_ME1_C1[rh_i]=rh_rh_tmp_c1; rh_ME1_C2[rh_i]=rh_rh_tmp_c2;
    rh_rh_mode_coeff(rh_f2,rh_d2);
    rh_ME2_C1[rh_i]=rh_rh_tmp_c1; rh_ME2_C2[rh_i]=rh_rh_tmp_c2;
    rh_rh_mode_coeff(rh_f3,rh_d3);
    rh_ME3_C1[rh_i]=rh_rh_tmp_c1; rh_ME3_C2[rh_i]=rh_rh_tmp_c2;

    // Perceptual level + velocity. High modes rise strongly with hammer hardness.
    rh_ma = rh_mech_action_gain * rh_amp * (0.30 + 0.70*rh_VVEL[rh_i]);

    rh_l1 = rh_ma*(0.88 - 0.35*rh_hard);
    rh_l2 = rh_ma*(0.28 + 0.50*rh_hard);
    rh_l3 = rh_ma*(0.05 + 0.46*(rh_hard^1.7));

    rh_w1 = rh_twopi*rh_f1/srate;
    rh_w2 = rh_twopi*rh_f2/srate;
    rh_w3 = rh_twopi*rh_f3/srate;

    rh_ME1_Y2[rh_i]=0; rh_ME1_Y1[rh_i]=rh_l1*sin(rh_w1);
    rh_ME2_Y2[rh_i]=0; rh_ME2_Y1[rh_i]=rh_l2*sin(rh_w2);
    rh_ME3_Y2[rh_i]=0; rh_ME3_Y1[rh_i]=rh_l3*sin(rh_w3);
  ) : (
    rh_ME1_Y1[rh_i]=rh_ME1_Y2[rh_i]=0;
    rh_ME2_Y1[rh_i]=rh_ME2_Y2[rh_i]=0;
    rh_ME3_Y1[rh_i]=rh_ME3_Y2[rh_i]=0;
  );
);

function rh_rh_note_on(rh_note,rh_vel)
local(rh_i,rh_scan,rh_v,rh_vcurve,rh_amp,rh_keynorm,rh_hard,rh_sf1,rh_sf2,rh_sf3,
      rh_f,rh_r1,rh_r2,rh_r3,rh_barf,rh_w,rh_a1,rh_a2,rh_a3,rh_ab) (
  // Musical sustain policy: one sounding voice per MIDI pitch.
  // Re-striking a key while CC64 is down retriggers that pitch instead of
  // stacking another identical tine/tone-bar voice and consuming polyphony.
  rh_i = -1;
  rh_scan = 0;
  loop(rh_voice_count,
    rh_i < 0 && rh_VACTIVE[rh_scan] && rh_VNOTE[rh_scan] == rh_note ? rh_i = rh_scan;
    rh_scan += 1;
  );
  rh_i < 0 ? rh_i = rh_rh_alloc_voice();

  rh_VACTIVE[rh_i] = 1;
  rh_VNOTE[rh_i] = rh_note;
  rh_VGATE[rh_i] = 1;
  rh_VBODYATT[rh_i] = 0;
  rh_VPKLP1[rh_i] = 0;
  rh_VPKLP2[rh_i] = 0;
  rh_VDAMPED[rh_i] = 0;
  rh_VQUIET[rh_i] = 0;
  rh_VSTAMP[rh_i] = rh_voice_stamp_counter;
  rh_voice_stamp_counter += 1;

  rh_v = rh_vel/127;
  rh_vcurve = rh_v^rh_velocity_curve;
  rh_VVEL[rh_i] = rh_vcurve;

  rh_amp = rh_hammer_level * ((1-rh_velocity_amount) + rh_velocity_amount*rh_vcurve);

  // Rhodes hammer tips become harder toward the treble.
  rh_keynorm = rh_rh_clamp01((rh_note-28)/72);
  rh_hard = rh_rh_clamp01(rh_hammer_hardness
                   + (rh_keynorm-0.5)*0.55*rh_hammer_keytrack
                   + (rh_vcurve-0.5)*0.22*rh_pickup_bark_velocity);

  rh_rh_voice_recalc(rh_i);
  rh_f = rh_VFREQ[rh_i];

  // Strike position changes how strongly the high cantilever modes are excited.
  rh_sf1 = 0.28 + 0.72*abs(sin($pi*rh_hammer_strike*2.31));
  rh_sf2 = 0.22 + 0.78*abs(sin($pi*rh_hammer_strike*3.87));
  rh_sf3 = 0.18 + 0.82*abs(sin($pi*rh_hammer_strike*5.43));

  rh_r1 = 1 + (6.267-1)*rh_overtone_stretch;
  rh_r2 = 1 + (17.55-1)*rh_overtone_stretch;
  rh_r3 = 1 + (34.39-1)*rh_overtone_stretch;

  // Initialize each modal resonator directly. This is a reduced hammer contact
  // model: harder/faster blows deposit proportionally more energy in high modes.
  rh_w = rh_twopi*rh_f/srate;
  rh_F_Y2[rh_i] = 0;
  rh_F_Y1[rh_i] = rh_amp*rh_tine_fund_level*sin(rh_w);

  rh_f*rh_r1 < srate*0.475 ? (
    rh_a1 = rh_amp*rh_tine_mode1_level*(rh_hard^1.10)*rh_sf1;
    rh_M1_Y2[rh_i]=0; rh_M1_Y1[rh_i]=rh_a1*sin(rh_twopi*rh_f*rh_r1/srate);
  ) : ( rh_M1_Y1[rh_i]=rh_M1_Y2[rh_i]=0; );

  rh_f*rh_r2 < srate*0.475 ? (
    rh_a2 = rh_amp*rh_tine_mode2_level*(rh_hard^1.45)*rh_sf2;
    rh_M2_Y2[rh_i]=0; rh_M2_Y1[rh_i]=rh_a2*sin(rh_twopi*rh_f*rh_r2/srate);
  ) : ( rh_M2_Y1[rh_i]=rh_M2_Y2[rh_i]=0; );

  rh_f*rh_r3 < srate*0.475 ? (
    rh_a3 = rh_amp*rh_tine_mode3_level*(rh_hard^1.80)*rh_sf3;
    rh_M3_Y2[rh_i]=0; rh_M3_Y1[rh_i]=rh_a3*sin(rh_twopi*rh_f*rh_r3/srate);
  ) : ( rh_M3_Y1[rh_i]=rh_M3_Y2[rh_i]=0; );

  rh_barf = rh_f*(2^(rh_tonebar_detune/1200));

  // Tone Bar owns its internal resonant energy.
  // Level and Coupling are applied later as two separate musical dimensions,
  // instead of multiplying the excitation and then suppressing it a second time.
  rh_ab = rh_amp*0.70;
  rh_B_Y2[rh_i]=0;
  rh_B_Y1[rh_i]=rh_ab*sin(rh_twopi*rh_barf/srate);

  // Normalized pickup displacement-state at rest is exactly zero. Geometry is
  // already cached at slider rate, so Note On does not rebuild the same constants.
  rh_VPREVFLUX[rh_i] = 0;

  // Deterministic modal action impact.
  // No white/band-limited noise: hammer/pedestal/action are represented
  // by three short damped mechanical resonances.
  rh_VNOISEENV[rh_i] = 0;
  rh_VNOISELP[rh_i] = 0;
  rh_VNOISELOW[rh_i] = 0;
  rh_rh_mech_strike(rh_i,rh_note,rh_amp,rh_hard);
);

function rh_rh_note_off(rh_note)
local(rh_i) (
  rh_i = 0;
  loop(rh_voice_count,
    rh_VACTIVE[rh_i] && rh_VNOTE[rh_i] == rh_note && rh_VGATE[rh_i] ? (
      rh_VGATE[rh_i] = 0;
      !rh_sustain_pedal ? rh_rh_voice_damp(rh_i);
    );
    rh_i += 1;
  );
);

function rh_rh_release_pedal()
local(rh_i) (
  rh_i=0;
  loop(rh_voice_count,
    rh_VACTIVE[rh_i] && !rh_VGATE[rh_i] ? rh_rh_voice_damp(rh_i);
    rh_i+=1;
  );
);

function rh_rh_recalc_all()
local(rh_i) (
  rh_i=0;
  loop(rh_voice_count,
    rh_VACTIVE[rh_i] ? rh_rh_voice_recalc(rh_i);
    rh_i+=1;
  );
);



// ============================================================
// WURLITZER ENGINE — FULLY ISOLATED STATE / RAM / FUNCTIONS
// Source: user-supplied Wurlitzer Lab (internally 0.04 Rebuilt Physical Core).
// RAM bank starts at 2,200,000.
// ============================================================

wz_twopi = 2*$pi;
wz_ln_001 = log(0.001);
wz_voice_count = 12;

// ------------------------------------------------------------
// Voice memory.
// ------------------------------------------------------------
wz_VACTIVE = 2200000;
wz_VNOTE = 2200016;
wz_VGATE = 2200032;
wz_VVEL = 2200048;
wz_VSTAMP = 2200064;
wz_VQUIET = 2200080;
wz_VDAMPED = 2200096;
wz_VFREQ = 2200112;

wz_R_Y1 = 2200128;
wz_R_Y2 = 2200144;
wz_R_C1 = 2200160;
wz_R_C2 = 2200176;

wz_VPREVCAP = 2200192;
wz_VBODYATT = 2200208;

// Per-voice pickup tone. Soft/hard notes can have different brightness.
wz_VPKLP1 = 2200224;
wz_VPKLP2 = 2200240;
wz_VPKK = 2200256;

// Per-voice Wurlitzer runtime caches.
// These remove velocity/pitch-only math from the per-sample pickup hot path.
wz_VMOTION_SCALE = 2200272;   // reed displacement -> pickup motion mm
wz_VINDUCED_SCALE = 2200288;  // srate / max(30, voice frequency)

// TEST4 compact active-voice list. @sample walks only sounding Wurlitzer slots.
wz_ACTIVE_LIST = 2200304; // 12 entries max.

// Held MIDI keys are not audio voice ownership.
wz_KEYHELD = 320; // 128 cells.

// Sample-accurate MIDI queue.
wz_EV_OFF = 512;
wz_EV_MSG1 = 640;
wz_EV_MSG23 = 768;
wz_EV_MAX = 128;

// Three short deterministic mechanical-action modes per voice.
wz_ME1_Y1 = 2200900;  wz_ME1_Y2 = 916;  wz_ME1_C1 = 932;  wz_ME1_C2 = 948;
wz_ME2_Y1 = 2200964;  wz_ME2_Y2 = 980;  wz_ME2_C1 = 996;  wz_ME2_C2 = 1012;
wz_ME3_Y1 = 2201028; wz_ME3_Y2 = 1044; wz_ME3_C1 = 1060; wz_ME3_C2 = 1076;

wz_sample_in_block = 0;

wz_voice_stamp_counter = 1;
wz_active_count = 0;
wz_sustain_pedal = 0;
wz_pitch_bend_norm = 0;

// Output states.
wz_sat_low = 0;

// Fixed 3 ms anti-click fade for the linear/direct reed component only.
wz_body_attack_step = 1/max(1,0.003*srate);

// Tremolo recurrence.
wz_tr_sin = 0;
wz_tr_cos = 1;

// AutoPan recurrence.
wz_ap_sin = 0;
wz_ap_cos = 1;

// Fixed Lo-lo output signature.
wz_dc_coeff_5hz = exp(-wz_twopi*5/srate);
wz_dc_x1L = wz_dc_y1L = 0;
wz_dc_x1R = wz_dc_y1R = 0;
wz_glue_env = 0;
wz_glue_att_inv = 1/(0.001*srate);
wz_glue_rel_inv = 1/(0.004*srate);
wz_glue_ratio_k = 2;
wz_glue_thresh_k = 0.055;
wz_post_in_gain = 0.4;
wz_post_limit = 0.98;

// ------------------------------------------------------------
// Helpers.
// ------------------------------------------------------------
function wz_wz_clamp01(wz_x) (
  max(0,min(1,wz_x));
);

function wz_wz_softclip(wz_x)
local(wz_x2) (
  wz_x2 = wz_x*wz_x;
  wz_x*(27+wz_x2)/(27+9*wz_x2);
);

function wz_wz_reed_coeff(wz_freq, wz_decay_s)
local(wz_w,wz_r) (
  wz_freq > 5 && wz_freq < srate*0.475 ? (
    wz_w = wz_twopi*wz_freq/srate;
    wz_r = exp(wz_ln_001/max(1,wz_decay_s*srate));
    wz_wz_tmp_c1 = 2*wz_r*cos(wz_w);
    wz_wz_tmp_c2 = -wz_r*wz_r;
  ) : (
    wz_wz_tmp_c1 = 0;
    wz_wz_tmp_c2 = 0;
  );
);

function wz_wz_voice_recalc(wz_i)
local(wz_note,wz_f,wz_keyscale,wz_dec,wz_damper_s,wz_stiff_cents,
      wz_vel_dark,wz_vel_curve,wz_voicing_oct,wz_pick_fc,wz_pick_floor) (
  wz_note = wz_VNOTE[wz_i];

  // A very small velocity-dependent stiffness term gives a natural hard-hit
  // pitch firmness without creating an audible pitch envelope.
  wz_stiff_cents = wz_reed_dynamic_stiffness * wz_VVEL[wz_i] * 4;
  wz_f = 440 * (2^(((wz_note-69) + wz_octave_semi + wz_fine_semi
                 + wz_pitch_bend_semi + wz_stiff_cents/100)/12));
  wz_VFREQ[wz_i] = wz_f;

  wz_keyscale = 2^(-((wz_note-60)/48)*wz_reed_decay_keytrack);
  wz_dec = max(0.05,wz_reed_decay*wz_keyscale);

  wz_VDAMPED[wz_i] ? (
    wz_damper_s = max(0.008,wz_damper_ms*0.001);
    wz_dec = wz_damper_s;
  );

  wz_wz_reed_coeff(wz_f,wz_dec);
  wz_R_C1[wz_i] = wz_wz_tmp_c1;
  wz_R_C2[wz_i] = wz_wz_tmp_c2;

  // Pickup Bite Velocity is also the dynamic voicing macro.
  // Hard notes reach the full Pickup Tone value; soft notes close progressively.
  wz_vel_dark = 1-max(0,min(1,wz_VVEL[wz_i]));
  wz_vel_curve = wz_vel_dark^1.16;
  wz_voicing_oct = wz_pickup_bite_velocity*wz_vel_curve*3.0;
  wz_pick_fc = wz_pickup_tone_hz*(2^(-wz_voicing_oct));

  // Keep the fundamental/body safe on very soft notes.
  wz_pick_floor = max(650,wz_f*3.0);
  wz_pick_fc = max(wz_pick_floor,min(srate*0.45,wz_pick_fc));
  wz_VPKK[wz_i] = 1-exp(-wz_twopi*wz_pick_fc/srate);

  // Runtime cache: these terms change only when velocity, pitch or the related
  // Wurlitzer controls change. @slider already calls wz_wz_recalc_all(), so
  // live edits and pitch bend keep the cached values exact.
  wz_VMOTION_SCALE[wz_i] = wz_reed_excursion_mm*0.10
                         * (1 + wz_pickup_bite_velocity*wz_VVEL[wz_i]*1.65);
  wz_VINDUCED_SCALE[wz_i] = srate/max(30,wz_f);
);

function wz_wz_voice_damp(wz_i) (
  wz_VACTIVE[wz_i] ? (
    wz_VDAMPED[wz_i] = 1;
    wz_wz_voice_recalc(wz_i);
  );
);

function wz_wz_active_remove(wz_voice)
local(wz_p,wz_last) (
  wz_p = 0;
  while(wz_p < wz_active_count && wz_ACTIVE_LIST[wz_p] != wz_voice) (
    wz_p += 1;
  );
  wz_p < wz_active_count ? (
    wz_last = wz_active_count-1;
    wz_ACTIVE_LIST[wz_p] = wz_ACTIVE_LIST[wz_last];
    wz_active_count = wz_last;
  );
);

function wz_wz_alloc_voice()
local(wz_i,wz_best,wz_beststamp) (
  wz_best = -1;
  wz_i=0;
  loop(wz_voice_count,
    wz_best < 0 && !wz_VACTIVE[wz_i] ? wz_best=wz_i;
    wz_i+=1;
  );

  wz_best < 0 ? (
    wz_best = 0;
    wz_beststamp = wz_VSTAMP[0];
    wz_i=1;
    loop(wz_voice_count-1,
      wz_VSTAMP[wz_i] < wz_beststamp ? (
        wz_best=wz_i;
        wz_beststamp=wz_VSTAMP[wz_i];
      );
      wz_i+=1;
    );
  ) : (
    // New DSP owner: append exactly once to the compact active list.
    wz_ACTIVE_LIST[wz_active_count] = wz_best;
    wz_active_count += 1;
  );

  wz_best;
);

function wz_wz_pickup_cap(wz_motion_mm)
local(wz_d1,wz_d2,wz_raw,wz_cap_delta,wz_lin) (
  // Only the moving plate distances remain sample-dynamic. Gap, position, the
  // rest capacitance and normalization are cached in @slider.
  wz_d1 = max(0.10,wz_pickup_g-wz_pickup_pos-wz_motion_mm);
  wz_d2 = max(0.10,wz_pickup_g+wz_pickup_pos+wz_motion_mm);

  wz_raw = 1/wz_d1 + wz_pickup_symmetry/wz_d2;
  wz_cap_delta = (wz_raw-wz_pickup_rest)*wz_pickup_geom_scale;

  // Stable linear reference + nonlinear capacitive geometry.
  wz_lin = wz_motion_mm*wz_pickup_lin_scale;
  wz_wz_cap_out = wz_lin + (wz_cap_delta-wz_lin)*wz_pickup_nonlin;

  // Numerical airbag, far above normal operation.
  wz_wz_cap_out > 4 ? wz_wz_cap_out = 4;
  wz_wz_cap_out < -4 ? wz_wz_cap_out = -4;
);

function wz_wz_mech_strike(wz_i,wz_note,wz_amp,wz_hard)
local(wz_tone_t,wz_key_irreg,wz_ma,wz_f1,wz_f2,wz_f3,wz_d1,wz_d2,wz_d3,wz_l1,wz_l2,wz_l3,wz_w1,wz_w2,wz_w3) (
  wz_mech_action_gain > 0 ? (
    wz_tone_t = max(0,min(1,(wz_mech_noise_tone-500)/(12000-500)));
    wz_key_irreg = 1 + 0.015*sin(wz_note*1.619 + 0.21);

    // Reduced Wurlitzer action model:
    // low felt/key thunk, mid hammer knock, high action clack.
    wz_f1 = (180 + 430*(wz_tone_t^1.15))*wz_key_irreg;
    wz_f2 = (620 + 1900*(wz_tone_t^1.02))*(2-wz_key_irreg);
    wz_f3 = (1850 + 5200*(wz_tone_t^0.90))*wz_key_irreg;

    wz_d1 = 0.032 - 0.010*wz_hard;
    wz_d2 = 0.018 - 0.006*wz_hard;
    wz_d3 = 0.010 - 0.003*wz_hard;

    wz_wz_reed_coeff(wz_f1,wz_d1);
    wz_ME1_C1[wz_i]=wz_wz_tmp_c1; wz_ME1_C2[wz_i]=wz_wz_tmp_c2;
    wz_wz_reed_coeff(wz_f2,wz_d2);
    wz_ME2_C1[wz_i]=wz_wz_tmp_c1; wz_ME2_C2[wz_i]=wz_wz_tmp_c2;
    wz_wz_reed_coeff(wz_f3,wz_d3);
    wz_ME3_C1[wz_i]=wz_wz_tmp_c1; wz_ME3_C2[wz_i]=wz_wz_tmp_c2;

    wz_ma = wz_mech_action_gain*wz_amp*(0.30+0.70*wz_VVEL[wz_i]);
    wz_l1 = wz_ma*(0.90-0.34*wz_hard);
    wz_l2 = wz_ma*(0.26+0.48*wz_hard);
    wz_l3 = wz_ma*(0.04+0.42*(wz_hard^1.7));

    wz_w1=wz_twopi*wz_f1/srate;
    wz_w2=wz_twopi*wz_f2/srate;
    wz_w3=wz_twopi*wz_f3/srate;

    wz_ME1_Y2[wz_i]=0; wz_ME1_Y1[wz_i]=wz_l1*sin(wz_w1);
    wz_ME2_Y2[wz_i]=0; wz_ME2_Y1[wz_i]=wz_l2*sin(wz_w2);
    wz_ME3_Y2[wz_i]=0; wz_ME3_Y1[wz_i]=wz_l3*sin(wz_w3);
  ) : (
    wz_ME1_Y1[wz_i]=wz_ME1_Y2[wz_i]=0;
    wz_ME2_Y1[wz_i]=wz_ME2_Y2[wz_i]=0;
    wz_ME3_Y1[wz_i]=wz_ME3_Y2[wz_i]=0;
  );
);

function wz_wz_note_on(wz_note,wz_vel)
local(wz_i,wz_scan,wz_v,wz_vcurve,wz_amp,wz_keynorm,wz_hard,wz_f,wz_w,wz_exc,wz_restcap) (
  // Musical sustain policy: one sounding voice per MIDI pitch.
  // Re-striking a key while CC64 is down retriggers that pitch instead of
  // stacking another identical reed voice and consuming polyphony.
  wz_i = -1;
  wz_scan = 0;
  loop(wz_voice_count,
    wz_i < 0 && wz_VACTIVE[wz_scan] && wz_VNOTE[wz_scan] == wz_note ? wz_i = wz_scan;
    wz_scan += 1;
  );
  wz_i < 0 ? wz_i = wz_wz_alloc_voice();

  wz_VACTIVE[wz_i]=1;
  wz_VNOTE[wz_i]=wz_note;
  wz_VGATE[wz_i]=1;
  wz_VDAMPED[wz_i]=0;
  wz_VBODYATT[wz_i]=0;
  wz_VPKLP1[wz_i]=0;
  wz_VPKLP2[wz_i]=0;
  wz_VQUIET[wz_i]=0;
  wz_VSTAMP[wz_i]=wz_voice_stamp_counter;
  wz_voice_stamp_counter += 1;

  wz_v = wz_vel/127;
  wz_vcurve = wz_v^wz_velocity_curve;
  wz_VVEL[wz_i]=wz_vcurve;

  wz_amp = wz_hammer_level*((1-wz_velocity_amount)+wz_velocity_amount*wz_vcurve);

  wz_keynorm = wz_wz_clamp01((wz_note-28)/72);
  wz_hard = wz_wz_clamp01(wz_hammer_hardness
                  + (wz_keynorm-0.5)*0.45*wz_hammer_keytrack
                  + (wz_vcurve-0.5)*0.18);

  wz_wz_voice_recalc(wz_i);
  wz_f = wz_VFREQ[wz_i];
  wz_w = wz_twopi*wz_f/srate;

  // The real Wurlitzer reed is mechanically dominated by its fundamental.
  // Hardness changes initial velocity/excursion, not a bank of fake overtones.
  wz_exc = wz_amp*wz_reed_level*(0.72 + wz_hard*0.28);
  wz_R_Y2[wz_i]=0;
  wz_R_Y1[wz_i]=wz_exc*sin(wz_w);

  // Pickup starts from the current physical displacement, avoiding a fake DC impulse.
  wz_wz_pickup_cap(wz_R_Y1[wz_i]*wz_reed_excursion_mm*0.10);
  wz_VPREVCAP[wz_i]=wz_wz_cap_out;

  // Deterministic mechanical action impact; no random noise.
  wz_wz_mech_strike(wz_i,wz_note,wz_amp,wz_hard);

  wz_tremolo_trigger == 1 ? (
    wz_tr_sin=0;
    wz_tr_cos=1;
  );
);

function wz_wz_note_off(wz_note)
local(wz_i) (
  wz_i=0;
  loop(wz_voice_count,
    wz_VACTIVE[wz_i] && wz_VNOTE[wz_i]==wz_note && wz_VGATE[wz_i] ? (
      wz_VGATE[wz_i]=0;
      !wz_sustain_pedal ? wz_wz_voice_damp(wz_i);
    );
    wz_i+=1;
  );
);

function wz_wz_release_pedal()
local(wz_i) (
  wz_i=0;
  loop(wz_voice_count,
    wz_VACTIVE[wz_i] && !wz_VGATE[wz_i] ? wz_wz_voice_damp(wz_i);
    wz_i+=1;
  );
);

function wz_wz_recalc_all()
local(wz_i) (
  wz_i=0;
  loop(wz_voice_count,
    wz_VACTIVE[wz_i] ? wz_wz_voice_recalc(wz_i);
    wz_i+=1;
  );
);



// ============================================================
// MALLET FAMILY ENGINE — EMBEDDED 0.12 CORE
// Fifth top-level engine; six internal instruments with independent Current Banks.
// RAM and symbols are namespaced/relocated so no existing engine state is shared.
// ============================================================

ml_twopi=2*$pi;
ml_ln_001=log(0.001);
ml_voice_count=12;

// ------------------------------------------------------------
// Per-voice banks, stride 16.
// ------------------------------------------------------------
ml_VACTIVE=2300000;
ml_VNOTE=2300016;
ml_VGATE=2300032;
ml_VDAMPED=2300048;
ml_VVEL=2300064;
ml_VSTAMP=2300080;
ml_VQUIET=2300096;
ml_VFREQ=2300112;
ml_VATT=2300128;
ml_VATTSTEP=2300144;
ml_VPANL=2300160;
ml_VPANR=2300176;

// Six bar modes.
ml_M1Y1=2300192; ml_M1Y2=208; ml_M1C1=224; ml_M1C2=240;
ml_M2Y1=2300256; ml_M2Y2=272; ml_M2C1=288; ml_M2C2=304;
ml_M3Y1=2300320; ml_M3Y2=336; ml_M3C1=352; ml_M3C2=368;
ml_M4Y1=2300384; ml_M4Y2=400; ml_M4C1=416; ml_M4C2=432;
ml_M5Y1=2300448; ml_M5Y2=464; ml_M5C1=480; ml_M5C2=496;
ml_M6Y1=2300512; ml_M6Y2=528; ml_M6C1=544; ml_M6C2=560;

// One acoustic resonator/tube mode.
ml_RY1=2300576; ml_RY2=592; ml_RC1=608; ml_RC2=624;

// Two deterministic mallet/action modes.
ml_A1Y1=2300640; ml_A1Y2=656; ml_A1C1=672; ml_A1C2=688;
ml_A2Y1=2300704; ml_A2Y2=720; ml_A2C1=736; ml_A2C2=752;

ml_KEYHELD=2300800; // 128 cells.

ml_voice_stamp_counter=1;
ml_active_count=0;
ml_sustain_pedal=0;
ml_pitch_bend_norm=0;

// ============================================================
// PER-INSTRUMENT CURRENT BANKS
// 6 instruments x 29 shared controls.
// slider170 (Instrument) is the selector and is not banked.
// AutoPan Rate/Depth are banked exactly like the other instrument controls.
// ============================================================
ml_MAL_BANK=2301200;
ml_MAL_OLD_BANK_STRIDE=27;
ml_MAL_BANK_STRIDE=29;
ml_MAL_BANK_COUNT=6;
ml_MAL_BANK_TOTAL=174;
ml_MAL_LIVE_SNAPSHOT=2301400;
ml_MAL_BANK_MAGIC_VALUE=61013;

// Integrated build: realtime RAM is cleared centrally by Multi Engine Lab.

function ml_mal_live_value(ml_p)
(
  ml_p==0  ? slider169  :
  ml_p==1  ? slider171  :
  ml_p==2  ? slider172  :
  ml_p==3  ? slider173  :
  ml_p==4  ? slider174  :
  ml_p==5  ? slider175  :
  ml_p==6  ? slider176  :
  ml_p==7  ? slider177  :
  ml_p==8  ? slider178 :
  ml_p==9  ? slider179 :
  ml_p==10 ? slider180 :
  ml_p==11 ? slider181 :
  ml_p==12 ? slider182 :
  ml_p==13 ? slider183 :
  ml_p==14 ? slider184 :
  ml_p==15 ? slider185 :
  ml_p==16 ? slider186 :
  ml_p==17 ? slider187 :
  ml_p==18 ? slider188 :
  ml_p==19 ? slider189 :
  ml_p==20 ? slider190 :
  ml_p==21 ? slider191 :
  ml_p==22 ? slider192 :
  ml_p==23 ? slider193 :
  ml_p==24 ? slider194 :
  ml_p==25 ? slider195 :
  ml_p==26 ? slider196 :
  ml_p==27 ? slider197 :
          slider198;
);

function ml_mal_set_live(ml_p,ml_v)
(
  ml_p==0  ? slider169=ml_v  :
  ml_p==1  ? slider171=ml_v  :
  ml_p==2  ? slider172=ml_v  :
  ml_p==3  ? slider173=ml_v  :
  ml_p==4  ? slider174=ml_v  :
  ml_p==5  ? slider175=ml_v  :
  ml_p==6  ? slider176=ml_v  :
  ml_p==7  ? slider177=ml_v  :
  ml_p==8  ? slider178=ml_v :
  ml_p==9  ? slider179=ml_v :
  ml_p==10 ? slider180=ml_v :
  ml_p==11 ? slider181=ml_v :
  ml_p==12 ? slider182=ml_v :
  ml_p==13 ? slider183=ml_v :
  ml_p==14 ? slider184=ml_v :
  ml_p==15 ? slider185=ml_v :
  ml_p==16 ? slider186=ml_v :
  ml_p==17 ? slider187=ml_v :
  ml_p==18 ? slider188=ml_v :
  ml_p==19 ? slider189=ml_v :
  ml_p==20 ? slider190=ml_v :
  ml_p==21 ? slider191=ml_v :
  ml_p==22 ? slider192=ml_v :
  ml_p==23 ? slider193=ml_v :
  ml_p==24 ? slider194=ml_v :
  ml_p==25 ? slider195=ml_v :
  ml_p==26 ? slider196=ml_v :
  ml_p==27 ? slider197=ml_v :
          slider198=ml_v;
);

function ml_mal_notify_live()
(
  sliderchange(slider169);
  sliderchange(slider171);  sliderchange(slider172);  sliderchange(slider173);
  sliderchange(slider174);  sliderchange(slider175);  sliderchange(slider176);
  sliderchange(slider177);  sliderchange(slider178); sliderchange(slider179);
  sliderchange(slider180); sliderchange(slider181); sliderchange(slider182);
  sliderchange(slider183); sliderchange(slider184); sliderchange(slider185);
  sliderchange(slider186); sliderchange(slider187); sliderchange(slider188);
  sliderchange(slider189); sliderchange(slider190); sliderchange(slider191);
  sliderchange(slider192); sliderchange(slider193); sliderchange(slider194);
  sliderchange(slider195); sliderchange(slider196); sliderchange(slider197);
  sliderchange(slider198);
);

function ml_mal_bank_capture(ml_inst)
local(ml_base,ml_p)
(
  ml_inst=max(0,min(5,floor(ml_inst+0.5)));
  ml_base=ml_MAL_BANK+ml_inst*ml_MAL_BANK_STRIDE;
  ml_p=0;
  loop(ml_MAL_BANK_STRIDE,
    ml_base[ml_p]=ml_mal_live_value(ml_p);
    ml_p+=1;
  );
);

function ml_mal_bank_load(ml_inst)
local(ml_base,ml_p)
(
  ml_inst=max(0,min(5,floor(ml_inst+0.5)));
  ml_base=ml_MAL_BANK+ml_inst*ml_MAL_BANK_STRIDE;
  ml_p=0;
  loop(ml_MAL_BANK_STRIDE,
    ml_mal_set_live(ml_p,ml_base[ml_p]);
    ml_p+=1;
  );
);

function ml_mal_snapshot_live()
local(ml_p)
(
  ml_p=0;
  loop(ml_MAL_BANK_STRIDE,
    ml_MAL_LIVE_SNAPSHOT[ml_p]=ml_mal_live_value(ml_p);
    ml_p+=1;
  );
);

function ml_mal_live_changed()
local(ml_p,ml_changed)
(
  ml_p=0;
  ml_changed=0;
  loop(ml_MAL_BANK_STRIDE,
    abs(ml_mal_live_value(ml_p)-ml_MAL_LIVE_SNAPSHOT[ml_p])>0.0000000001 ? ml_changed=1;
    ml_p+=1;
  );
  ml_changed;
);

// Expand the saved 0.09-and-earlier 6 x 27 banks in place to 6 x 29.
// Copy from the last Instrument backwards so source data is never overwritten.
// The two new cells start with AutoPan disabled. Rate is retained as a useful
// default, but Depth=0 means no instrument receives AutoPan in its Init.
function ml_mal_expand_banks_27_to_29()
local(ml_inst,ml_oldbase,ml_newbase,ml_p)
(
  ml_inst=5;
  loop(ml_MAL_BANK_COUNT,
    ml_oldbase=ml_MAL_BANK+ml_inst*ml_MAL_OLD_BANK_STRIDE;
    ml_newbase=ml_MAL_BANK+ml_inst*ml_MAL_BANK_STRIDE;
    ml_p=ml_MAL_OLD_BANK_STRIDE-1;
    loop(ml_MAL_OLD_BANK_STRIDE,
      ml_newbase[ml_p]=ml_oldbase[ml_p];
      ml_p-=1;
    );
    ml_newbase[27]=3.2;
    ml_newbase[28]=0;
    ml_inst-=1;
  );
);

// Original 0.01 public defaults for instruments not yet user-voiced.
function ml_mal_factory_generic(ml_inst)
local(ml_base)
(
  ml_base=ml_MAL_BANK+ml_inst*ml_MAL_BANK_STRIDE;
  ml_base[0]=0;    ml_base[1]=0;    ml_base[2]=0;    ml_base[3]=2;
  ml_base[4]=1;    ml_base[5]=1;    ml_base[6]=1;    ml_base[7]=0.55;
  ml_base[8]=0.55; ml_base[9]=0.38; ml_base[10]=0.55;ml_base[11]=0.60;
  ml_base[12]=0.50;ml_base[13]=4.0; ml_base[14]=0.48;ml_base[15]=0.70;
  ml_base[16]=0.55;ml_base[17]=0.65;ml_base[18]=120; ml_base[19]=0.85;
  ml_base[20]=0.55;ml_base[21]=5.5; ml_base[22]=0.35;ml_base[23]=0.55;
  ml_base[24]=4;   ml_base[25]=180; ml_base[26]=0.18;
  ml_base[27]=3.2; ml_base[28]=0;
);

// User-created Vibraphone factory sound.
