      drift_count_b -= samplesblock;
      drift_count_b <= 0 ? (
        drift_target_b = rand(2) - 1;
        drift_count_b += floor(srate * (1.30 + rand(2.10)));
      );
  
      drift_a += (drift_target_a - drift_a) * drift_block_k_a;
      drift_b += (drift_target_b - drift_b) * drift_block_k_b;
  
      drift_core_block = drift_a * step_temporal_drift3;
      drift_comb_block = drift_b * step_temporal_drift3;
      drift_pitch_cents_block = drift_b * step_temporal_drift * 2.1;

      // Pitch drift is block-rate already. Mark pitch once at the block edge
