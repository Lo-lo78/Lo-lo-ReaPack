function wi_win_factory_concert()
local(wi_b)
(
  // Concert Flute — complete user-approved FX Params snapshot.
  // All 26 banked Wind controls are written explicitly.
  wi_b=wi_WIN_BANK;
  wi_b[0]=0; wi_b[1]=0; wi_b[2]=0; wi_b[3]=2; wi_b[4]=0.8;
  wi_b[5]=0.7; wi_b[6]=1; wi_b[7]=1; wi_b[8]=5340; wi_b[9]=11;
  wi_b[10]=180; wi_b[11]=0.35; wi_b[12]=1.1; wi_b[13]=0; wi_b[14]=-0.2;
  wi_b[15]=0.76; wi_b[16]=0.84; wi_b[17]=0.56; wi_b[18]=0; wi_b[19]=0.92;
