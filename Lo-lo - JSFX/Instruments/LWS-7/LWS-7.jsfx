    wi_pitch_bend_semi=wi_pitch_bend_norm*wi_bend_range;
    wi_win_recalc_all();
  );
);

) : (

// Micro Synth MIDI path — mono Trigger / Legato, last-note priority.
while(midirecv(ms_midi_ofs,ms_midi_msg1,ms_midi_msg23)) (
  ms_midi_status=ms_midi_msg1 & $xF0;
  ms_midi_d1=ms_midi_msg23 & $x7F;
  ms_midi_d2=(ms_midi_msg23>>8) & $x7F;

  ms_midi_status==$xE0 ? (
    ms_pb14=ms_midi_d1+(ms_midi_d2<<7);
    ms_bend_semi=((ms_pb14-8192)/8192)*2;
  );

  ms_midi_status==$xB0 && ms_midi_d1==64 ? (
    ms_new_sus=ms_midi_d2>=64;
    ms_sustain_pedal && !ms_new_sus ? (
      ms_sustain_pedal=0;
      ms_mono_note>=0 && !ms_HELD_STATE[ms_mono_note] ? (
        ms_best_note=-1; ms_best_order=-1; ms_i=0;
        loop(128,
          ms_HELD_STATE[ms_i] && ms_HELD_ORDER[ms_i]>ms_best_order ? (
            ms_best_order=ms_HELD_ORDER[ms_i];
            ms_best_note=ms_i;
          );
          ms_i+=1;
        );
        ms_best_note>=0 ? (
          ms_mono_note=ms_best_note;
          ms_target_note=ms_best_note;
        ) : (
          ms_mono_note=-1;
          ms_env_stage!=0 ? ms_env_stage=4;
        );
      );
    ) : (
      ms_sustain_pedal=ms_new_sus;
    );
  );

  ms_is_on=ms_midi_status==$x90 && ms_midi_d2>0;
  ms_is_off=ms_midi_status==$x80 || (ms_midi_status==$x90 && ms_midi_d2==0);

  ms_is_on ? (
    ms_note=ms_midi_d1;
    ms_had_held=ms_held_count>0;
    !ms_HELD_STATE[ms_note] ? ms_held_count+=1;
    ms_note_serial+=1;
    ms_HELD_STATE[ms_note]=1;
    ms_HELD_ORDER[ms_note]=ms_note_serial;
    ms_mono_note=ms_note;
    ms_target_note=ms_note;
    !ms_note_active ? ms_current_note=ms_target_note;

    ms_voice_mode==0 ? (
      ms_phase1=0; ms_phase2=0;
      ms_lfo_phase=0; ms_lfo_hold=rand(2)-1;
      ms_env=0; ms_env_stage=1; ms_note_active=1;
    ) : (
      !ms_had_held ? (
        ms_phase1=0; ms_phase2=0;
        ms_lfo_phase=0; ms_lfo_hold=rand(2)-1;
        ms_env=0; ms_env_stage=1; ms_note_active=1;
      );
    );
  );

  ms_is_off ? (
    ms_note=ms_midi_d1;
    ms_HELD_STATE[ms_note] ? (
      ms_HELD_STATE[ms_note]=0;
      ms_HELD_ORDER[ms_note]=0;
      ms_held_count-=1; ms_held_count<0 ? ms_held_count=0;
    );

    ms_note==ms_mono_note ? (
      ms_best_note=-1; ms_best_order=-1; ms_i=0;
      loop(128,
        ms_HELD_STATE[ms_i] && ms_HELD_ORDER[ms_i]>ms_best_order ? (
          ms_best_order=ms_HELD_ORDER[ms_i];
          ms_best_note=ms_i;
        );
        ms_i+=1;
      );
      ms_best_note>=0 ? (
        ms_mono_note=ms_best_note;
        ms_target_note=ms_best_note;
      ) : !ms_sustain_pedal ? (
        ms_mono_note=-1;
        ms_env_stage!=0 ? ms_env_stage=4;
      );
      // With CC64 down and no physical fallback, the current note remains
      // active until the pedal is released.
    );
  );
);

);

// Compact Dual Tape tempo cache. No LFOs: only tempo-synced base times.
dt_mix_active ? (
  dt_block_bpm=max(1,tempo);
  dt_block_bpm_inv=1/dt_block_bpm;
  dt_t1_base_delay_samples=dt_clamp(dt_t1_delay_numer*dt_block_bpm_inv,16,dt_max_delay_read);
  dt_t2_base_delay_samples=dt_clamp(dt_t2_delay_numer*dt_block_bpm_inv,16,dt_max_delay_read);

  // Long enough to bridge silence between two possible repeats.
  // Every audible repeat refreshes this hold, so feedback tails remain intact.
  dt_tail_gap_samples=min(
    dt_max_delay_read,
    max(dt_t1_base_delay_samples,dt_t2_base_delay_samples)+dt_pitch_window_max+64
  );
) : (
  dt_tail_gap_samples=0;
);

// ============================================================
// GLOBAL COLD SLEEP — BLOCK DECISION
// ============================================================
// MIDI has already been consumed above. A Note On has therefore already created
// engine activity before this test. Strings MIDI is handled directly in @block.
global_engine_active_block = 0;
engine_now < 0.5 ? (
  global_engine_active_block = rh_active_count > 0;
) : engine_now < 1.5 ? (
  global_engine_active_block = wz_active_count > 0;
) : engine_now < 2.5 ? (
  global_idle_i = 0;
  loop(8,
    org_VSTAGE[global_idle_i] > 0 ? global_engine_active_block = 1;
    global_idle_i += 1;
  );
) : engine_now < 3.5 ? (
  global_engine_active_block = mode < 2 ? mono_stage != 0 : poly_active_count > 0;
) : engine_now < 4.5 ? (
  global_engine_active_block = ml_active_count > 0;
) : engine_now < 5.5 ? (
  global_engine_active_block = wi_active_count > 0;
) : (
  global_engine_active_block = ms_note_active || ms_env_stage != 0;
);

global_effects_idle_block = (!dt_mix_active || dt_pending_samples <= 0)
                         && dt_flush_remaining <= 0
                         && rev_pending_samples <= 0
                         && !rev_tail_hold
                         && rev_source_hold <= 0;

(global_engine_active_block || !global_effects_idle_block) ? global_idle_quiet_count = 0;

global_sleep_block = !global_engine_active_block
                  && global_effects_idle_block
                  && global_idle_quiet_count >= global_idle_quiet_needed;

// TEST15: a silent/sleeping engine does not spend block CPU on courtyard motion.
!global_sleep_block ? (
// ============================================================
// SHARED COURTYARD TAIL MOTION — block-rate, asynchronous
// ============================================================
// Two unrelated slow random walks. One biases left/right position,
// the other changes how strongly the late field opens sideways.
// No delay-time modulation, so there is no intentional pitch chorus.
rev_tail_motion > 0.0000001 ? (
  rev_motion_count_a -= samplesblock;
  rev_motion_count_a <= 0 ? (
    rev_motion_target_a = rand(2)-1;
    rev_motion_count_a += floor(srate * (0.85 + rand(1.90)));
  );

  rev_motion_count_b -= samplesblock;
  rev_motion_count_b <= 0 ? (
    rev_motion_target_b = rand(2)-1;
    rev_motion_count_b += floor(srate * (2.10 + rand(3.80)));
  );

  rev_motion_k_a = 1-exp(-samplesblock/(0.72*srate));
  rev_motion_k_b = 1-exp(-samplesblock/(1.65*srate));
  rev_motion_a += (rev_motion_target_a-rev_motion_a)*rev_motion_k_a;
  rev_motion_b += (rev_motion_target_b-rev_motion_b)*rev_motion_k_b;

  // Different combinations keep lateral position and width asynchronous.
  rev_motion_pan = rev_motion_a*0.68 + rev_motion_b*0.32;
  rev_motion_spread = rev_motion_b*0.72 - rev_motion_a*0.28;
) : (
  // Smoothly return to neutral if the control is disabled.
  rev_motion_k_off = 1-exp(-samplesblock/(0.35*srate));
  rev_motion_a += (0-rev_motion_a)*rev_motion_k_off;
  rev_motion_b += (0-rev_motion_b)*rev_motion_k_off;
  rev_motion_pan = rev_motion_a*0.68 + rev_motion_b*0.32;
  rev_motion_spread = rev_motion_b*0.72 - rev_motion_a*0.28;
);


);

// Preserve only free-running musical phases while asleep, at block rate.
global_sleep_block ? (
  engine_now < 0.5 ? (
    rh_autopan_depth > 0.0000001 ? (
      global_phase_a = rh_ap_w*samplesblock;
      global_phase_s = sin(global_phase_a); global_phase_c = cos(global_phase_a);
      global_phase_old = rh_ap_sin;
      rh_ap_sin = rh_ap_sin*global_phase_c + rh_ap_cos*global_phase_s;
      rh_ap_cos = rh_ap_cos*global_phase_c - global_phase_old*global_phase_s;
    );
  ) : engine_now < 1.5 ? (
    wz_tremolo_depth > 0.0000001 ? (
      global_phase_a = wz_tr_w*samplesblock;
      global_phase_s = sin(global_phase_a); global_phase_c = cos(global_phase_a);
      global_phase_old = wz_tr_sin;
      wz_tr_sin = wz_tr_sin*global_phase_c + wz_tr_cos*global_phase_s;
      wz_tr_cos = wz_tr_cos*global_phase_c - global_phase_old*global_phase_s;
    );
    wz_autopan_depth > 0.0000001 ? (
      global_phase_a = wz_ap_w*samplesblock;
      global_phase_s = sin(global_phase_a); global_phase_c = cos(global_phase_a);
      global_phase_old = wz_ap_sin;
      wz_ap_sin = wz_ap_sin*global_phase_c + wz_ap_cos*global_phase_s;
      wz_ap_cos = wz_ap_cos*global_phase_c - global_phase_old*global_phase_s;
    );
  ) : engine_now < 3.5 && engine_now >= 2.5 ? (
    vib_phase += vib_phase_inc*samplesblock;
    vib_phase >= twopi ? vib_phase -= twopi*floor(vib_phase*inv_twopi);
  ) : engine_now < 4.5 ? (
    ml_motor_phase += (ml_motor_rate/srate)*samplesblock;
    ml_motor_phase >= 1 ? ml_motor_phase -= floor(ml_motor_phase);
    ml_autopan_depth > 0.0000001 ? (
      global_phase_a = ml_ap_w*samplesblock;
      global_phase_s = sin(global_phase_a); global_phase_c = cos(global_phase_a);
      global_phase_old = ml_ap_sin;
      ml_ap_sin = ml_ap_sin*global_phase_c + ml_ap_cos*global_phase_s;
      ml_ap_cos = ml_ap_cos*global_phase_c - global_phase_old*global_phase_s;
    );
  ) : engine_now < 5.5 ? (
    wi_vib_phase += (wi_vibrato_rate/srate)*samplesblock;
    wi_vib_phase >= 1 ? wi_vib_phase -= floor(wi_vib_phase);
  );
);

@sample

// Deep idle: the entire selected engine + shared effects path does not execute.
global_sleep_block ? (
  spl0 = 0;
  spl1 = 0;
) : (

engine_now < 0.5 ? (

rh_sample_in_block += 1;

// ------------------------------------------------------------
// Voice render. No held-key test here: only VACTIVE owns CPU.
// ------------------------------------------------------------
rh_voice_sum = 0;
rh_mech_sum = 0;

rh_active_count > 0 ? (
  // TEST4: compact renderer. Five sounding notes = five voice visits, not twelve.
  rh_ai = 0;
  while(rh_ai < rh_active_count) (
    rh_i = rh_ACTIVE_LIST[rh_ai];
    rh_VACTIVE[rh_i] ? (
      rh_fy = rh_F_C1[rh_i]*rh_F_Y1[rh_i] + rh_F_C2[rh_i]*rh_F_Y2[rh_i];
      rh_F_Y2[rh_i] = rh_F_Y1[rh_i];
      rh_F_Y1[rh_i] = rh_fy;

      rh_m1y = rh_M1_C1[rh_i]*rh_M1_Y1[rh_i] + rh_M1_C2[rh_i]*rh_M1_Y2[rh_i];
      rh_M1_Y2[rh_i]=rh_M1_Y1[rh_i]; rh_M1_Y1[rh_i]=rh_m1y;

      rh_m2y = rh_M2_C1[rh_i]*rh_M2_Y1[rh_i] + rh_M2_C2[rh_i]*rh_M2_Y2[rh_i];
      rh_M2_Y2[rh_i]=rh_M2_Y1[rh_i]; rh_M2_Y1[rh_i]=rh_m2y;

      rh_m3y = rh_M3_C1[rh_i]*rh_M3_Y1[rh_i] + rh_M3_C2[rh_i]*rh_M3_Y2[rh_i];
      rh_M3_Y2[rh_i]=rh_M3_Y1[rh_i]; rh_M3_Y1[rh_i]=rh_m3y;

      rh_by = rh_B_C1[rh_i]*rh_B_Y1[rh_i] + rh_B_C2[rh_i]*rh_B_Y2[rh_i];
      rh_B_Y2[rh_i]=rh_B_Y1[rh_i]; rh_B_Y1[rh_i]=rh_by;

      // --------------------------------------------------------
      // FUNCTIONAL TONE BAR
      // Level = direct audible contribution of the Tone Bar.
      // Coupling = how much the tine fundamental is pulled toward the Tone Bar.
      // This makes Level, Coupling, Detune and Decay four distinct controls.
      // --------------------------------------------------------
      rh_overtone_body = (rh_m1y + rh_m2y + rh_m3y) * rh_VOTGAIN[rh_i];

      // TEST2: coupling and direct Tone Bar gain are slider-rate constants.
      // Stable reduced coupling: blend part of the fundamental displacement
      // toward the bar rather than multiplying the bar twice.
      rh_coupled_fund = rh_fy + (rh_by-rh_fy)*rh_tonebar_blend_cached;

      // Direct bar contribution remains independently controllable.
      rh_tonebar_direct = rh_by*rh_tonebar_direct_gain_cached;

      rh_body = rh_coupled_fund + rh_overtone_body + rh_tonebar_direct;

      // --------------------------------------------------------
      // Nonlinear electromagnetic pickup.
      // Only body displacement is audio-rate. Velocity, resting geometry and
      // frequency normalization are cached outside the sample loop.
      // --------------------------------------------------------
      rh_motion_mm = rh_body * rh_VMOTION_SCALE[rh_i];

      // --------------------------------------------------------
      // PICKUP SAFETY NORMALIZATION
      // --------------------------------------------------------
      rh_pole_d = max(0.10, rh_pickup_pole_base_cached-rh_motion_mm);
      rh_raw_flux = 1/(rh_pole_d*rh_pole_d);

      // Same exact normalized 1/d^2 law, with the static rest terms cached.
      rh_flux_norm = (rh_raw_flux-rh_pickup_rest_flux_cached) * rh_pickup_flux_scale_cached;

      rh_induced = (rh_flux_norm-rh_VPREVFLUX[rh_i]) * rh_VINDUCED_SCALE[rh_i];
      rh_VPREVFLUX[rh_i] = rh_flux_norm;

      // 3 ms micro attack ONLY on the direct body path.
      // Magnetic pickup, mechanical noise and other attack components stay unchanged.
      rh_VBODYATT[rh_i] < 1 ? (
        rh_VBODYATT[rh_i] = min(1, rh_VBODYATT[rh_i] + rh_body_attack_step);
      );

      rh_direct_core = rh_body * 0.34 * rh_VBODYATT[rh_i];
      rh_magnetic_core = rh_induced * rh_pickup_dist_gain_cached * 0.32;

      // Numerical airbag only. Threshold is deliberately far above the normal
      // magnetic branch, so normal tone/dynamics are bit-for-bit untouched
      // until a pathological pickup geometry produces an extreme transient.
      rh_magnetic_core > 8 ? rh_magnetic_core = 8;
      rh_magnetic_core < -8 ? rh_magnetic_core = -8;

      rh_voice_electric = (rh_direct_core + rh_magnetic_core) * rh_pickup_level;

      // Per-voice 12 dB/oct pickup voicing.
      // Strong notes use the full Pickup Tone setting; soft notes are darker
      // according to Pickup Bark Velocity.
      rh_pk = rh_VPKK[rh_i];
      rh_VPKLP1[rh_i] += (rh_voice_electric - rh_VPKLP1[rh_i]) * rh_pk;
      rh_VPKLP2[rh_i] += (rh_VPKLP1[rh_i] - rh_VPKLP2[rh_i]) * rh_pk;
      rh_voice_sum += rh_VPKLP2[rh_i];

      // --------------------------------------------------------
      // MODAL MECHANICAL ACTION
      // Three deterministic short resonances: low thunk / mid knock / high clack.
      // They are excited once by rh_mech_strike() and then freely decay.
      // --------------------------------------------------------
      rh_me1 = rh_ME1_C1[rh_i]*rh_ME1_Y1[rh_i] + rh_ME1_C2[rh_i]*rh_ME1_Y2[rh_i];
      rh_ME1_Y2[rh_i]=rh_ME1_Y1[rh_i]; rh_ME1_Y1[rh_i]=rh_me1;

      rh_me2 = rh_ME2_C1[rh_i]*rh_ME2_Y1[rh_i] + rh_ME2_C2[rh_i]*rh_ME2_Y2[rh_i];
      rh_ME2_Y2[rh_i]=rh_ME2_Y1[rh_i]; rh_ME2_Y1[rh_i]=rh_me2;

      rh_me3 = rh_ME3_C1[rh_i]*rh_ME3_Y1[rh_i] + rh_ME3_C2[rh_i]*rh_ME3_Y2[rh_i];
      rh_ME3_Y2[rh_i]=rh_ME3_Y1[rh_i]; rh_ME3_Y1[rh_i]=rh_me3;

      rh_mech_voice = rh_me1 + rh_me2 + rh_me3;
      rh_mech_sum += rh_mech_voice;

      // TRUE AUDIBLE-OUTPUT SLEEP.
      // Physical key state (rh_KEYHELD) is deliberately separate from DSP ownership.
      // A held key may therefore remain down after its struck tine has naturally
      // decayed: once the voice's ACTUAL audible contribution is below the floor
      // for a short confirmation window, this DSP voice ceases to exist.
      //
      // Do not use raw tine/tone-bar/modal states here: those can retain tiny
      // internal energy long after the pickup/mechanical output is inaudible.
      rh_audible = max(abs(rh_VPKLP2[rh_i]), abs(rh_mech_voice));

      rh_audible < 0.00001 ? (
        rh_VQUIET[rh_i] += 1;
        rh_VQUIET[rh_i] > 1024 ? (
          rh_VACTIVE[rh_i] = 0;
          rh_VGATE[rh_i] = 0;
          rh_VDAMPED[rh_i] = 0;
          rh_F_Y1[rh_i]=rh_F_Y2[rh_i]=0;
          rh_M1_Y1[rh_i]=rh_M1_Y2[rh_i]=0;
          rh_M2_Y1[rh_i]=rh_M2_Y2[rh_i]=0;
          rh_M3_Y1[rh_i]=rh_M3_Y2[rh_i]=0;
          rh_B_Y1[rh_i]=rh_B_Y2[rh_i]=0;
          rh_VNOISEENV[rh_i]=0;
          rh_VNOISELP[rh_i]=0;
          rh_VNOISELOW[rh_i]=0;
          rh_ME1_Y1[rh_i]=rh_ME1_Y2[rh_i]=0;
          rh_ME2_Y1[rh_i]=rh_ME2_Y2[rh_i]=0;
          rh_ME3_Y1[rh_i]=rh_ME3_Y2[rh_i]=0;
          rh_VPKLP1[rh_i]=0;
          rh_VPKLP2[rh_i]=0;
          rh_VBODYATT[rh_i]=0;
          rh_VQUIET[rh_i]=0;
          // KEYHELD is intentionally NOT cleared here. A later physical Note Off
          // only updates keyboard ownership; it does not need a dead DSP voice.
          rh_rh_active_remove(rh_i);
        );
      ) : (
        rh_VQUIET[rh_i] = 0;
      );
      // If the current voice died, active_remove() swapped another voice into
      // this list position: keep the same index so it is rendered next.
      rh_VACTIVE[rh_i] ? rh_ai += 1;
    ) : (
      // Defensive stale-entry repair; should only matter after unusual state restore.
      rh_rh_active_remove(rh_i);
    );
  );
);

// ------------------------------------------------------------
// Pickup rail/output coloration.
// ------------------------------------------------------------
// Pickup Tone is now handled per voice so velocity can control brightness
// independently for every played note.
rh_pickup_x = rh_voice_sum;

// Last-resort numerical guard. This is not an audible limiter: it only catches
// impossible runaway values before they poison downstream filters with Inf/NaN.
abs(rh_pickup_x) > 64 ? rh_pickup_x = sign(rh_pickup_x)*64;

rh_x = rh_pickup_x;

// ------------------------------------------------------------
// Parallel saturation with protected bass.
// LP = untouched low band; only HP branch is driven/saturated.
// ------------------------------------------------------------
rh_sat_low += (rh_x-rh_sat_low)*rh_sat_hp_k;
rh_sat_high = rh_x-rh_sat_low;
rh_sat_mix > 0.0000001 && slider134 > 0.00001 ? (
  rh_sat_driven = rh_sat_high*rh_sat_drive;
  rh_sat_wet = rh_rh_softclip(rh_sat_driven)/max(1,rh_sat_drive);
  rh_sat_processed = rh_sat_low + rh_sat_wet;
  rh_x = rh_x + (rh_sat_processed-rh_x)*rh_sat_mix;
);

// Mechanical/action modes are acoustic/direct, so they bypass the magnetic
// Pickup Tone and amp-style saturation. This keeps the action physically separate.
rh_x += rh_mech_sum;

// ------------------------------------------------------------
// AutoPan. Static center when depth=0.
// Recurrence avoids a per-sample sin() call.
// ------------------------------------------------------------
rh_autopan_depth > 0.0000001 ? (
  rh_ap_old_s = rh_ap_sin;
  rh_ap_sin = rh_ap_sin*rh_ap_rot_c + rh_ap_cos*rh_ap_rot_s;
  rh_ap_cos = rh_ap_cos*rh_ap_rot_c - rh_ap_old_s*rh_ap_rot_s;

  // Rare normalization prevents long-term recurrence drift.
  (rh_sample_in_block & 16383) == 0 ? (
    rh_ap_norm = max(0.000001,sqrt(rh_ap_sin*rh_ap_sin + rh_ap_cos*rh_ap_cos));
    rh_ap_sin /= rh_ap_norm;
    rh_ap_cos /= rh_ap_norm;
  );

  rh_ap_pan = rh_ap_sin*rh_autopan_depth;
  rh_outL = rh_x*(1-rh_ap_pan*0.72);
  rh_outR = rh_x*(1+rh_ap_pan*0.72);
) : (
  rh_outL = rh_x;
  rh_outR = rh_x;
);

// ------------------------------------------------------------
// Lo-lo fixed output signature.
// DC 5 Hz -> fixed glue -> x0.4 -> soft limiter -> Master x2.
// ------------------------------------------------------------
rh_dcL = rh_outL - rh_dc_x1L + rh_dc_coeff_5hz*rh_dc_y1L;
rh_dc_x1L = rh_outL; rh_dc_y1L = rh_dcL;
rh_dcR = rh_outR - rh_dc_x1R + rh_dc_coeff_5hz*rh_dc_y1R;
rh_dc_x1R = rh_outR; rh_dc_y1R = rh_dcR;

rh_peak = max(abs(rh_dcL),abs(rh_dcR));
rh_peak > rh_glue_env ? (
  rh_glue_env += (rh_peak-rh_glue_env)*rh_glue_att_inv;
) : (
  rh_glue_env += (rh_peak-rh_glue_env)*rh_glue_rel_inv;
);

rh_glue_gain = 1;
rh_glue_env > rh_glue_thresh_k ? (
  rh_glue_target = rh_glue_thresh_k + (rh_glue_env-rh_glue_thresh_k)/rh_glue_ratio_k;
  rh_glue_gain = rh_glue_target/max(0.000000001,rh_glue_env);
);

rh_outL = rh_dcL*rh_glue_gain*rh_post_in_gain;
rh_outR = rh_dcR*rh_glue_gain*rh_post_in_gain;

abs(rh_outL) > rh_post_limit ? (
  rh_outL = sign(rh_outL)*(rh_post_limit + (abs(rh_outL)-rh_post_limit)*0.15);
);
abs(rh_outR) > rh_post_limit ? (
  rh_outR = sign(rh_outR)*(rh_post_limit + (abs(rh_outR)-rh_post_limit)*0.15);
);

spl0 = rh_outL*rh_master_gain*2;
spl1 = rh_outR*rh_master_gain*2;

) : engine_now < 1.5 ? (

wz_sample_in_block+=1;

// ------------------------------------------------------------
// Voice rendering.
// ------------------------------------------------------------
wz_voice_sum=0;
wz_mech_sum=0;

wz_active_count > 0 ? (
  // TEST4: compact renderer. Visit only the Wurlitzer voices that own DSP.
  wz_ai=0;
  while(wz_ai < wz_active_count) (
    wz_i=wz_ACTIVE_LIST[wz_ai];
    wz_VACTIVE[wz_i] ? (
      wz_ry = wz_R_C1[wz_i]*wz_R_Y1[wz_i] + wz_R_C2[wz_i]*wz_R_Y2[wz_i];
      wz_R_Y2[wz_i]=wz_R_Y1[wz_i];
      wz_R_Y1[wz_i]=wz_ry;

      // Velocity/pitch-only pickup terms are cached by wz_wz_voice_recalc().
      wz_motion_mm = wz_ry*wz_VMOTION_SCALE[wz_i];

      wz_wz_pickup_cap(wz_motion_mm);
      wz_cap_now=wz_wz_cap_out;

      // Capacitive pickup voltage is proportional to changing capacitance.
      wz_induced=(wz_cap_now-wz_VPREVCAP[wz_i])*wz_VINDUCED_SCALE[wz_i];
      wz_VPREVCAP[wz_i]=wz_cap_now;

      // 3 ms micro attack ONLY on the stable linear reed component.
      wz_VBODYATT[wz_i] < 1 ? (
        wz_VBODYATT[wz_i]=min(1,wz_VBODYATT[wz_i]+wz_body_attack_step);
      );

      wz_direct_reed=wz_ry*0.42*wz_VBODYATT[wz_i];
      wz_capacitive_core=wz_induced*0.34;

      // Numerical airbag on the nonlinear branch only.
      wz_capacitive_core > 8 ? wz_capacitive_core=8;
      wz_capacitive_core < -8 ? wz_capacitive_core=-8;

      wz_voice_electric=(wz_direct_reed+wz_capacitive_core)*wz_pickup_level;

      // Per-voice 12 dB/oct pickup voicing.
      // Pickup Bite Velocity: soft = darker, hard = full Pickup Tone.
      wz_pk=wz_VPKK[wz_i];
      wz_VPKLP1[wz_i]+=(wz_voice_electric-wz_VPKLP1[wz_i])*wz_pk;
      wz_VPKLP2[wz_i]+=(wz_VPKLP1[wz_i]-wz_VPKLP2[wz_i])*wz_pk;
      wz_voice_sum+=wz_VPKLP2[wz_i];

      // Deterministic modal mechanical action: thunk / knock / clack.
      wz_me1=wz_ME1_C1[wz_i]*wz_ME1_Y1[wz_i]+wz_ME1_C2[wz_i]*wz_ME1_Y2[wz_i];
      wz_ME1_Y2[wz_i]=wz_ME1_Y1[wz_i]; wz_ME1_Y1[wz_i]=wz_me1;

      wz_me2=wz_ME2_C1[wz_i]*wz_ME2_Y1[wz_i]+wz_ME2_C2[wz_i]*wz_ME2_Y2[wz_i];
      wz_ME2_Y2[wz_i]=wz_ME2_Y1[wz_i]; wz_ME2_Y1[wz_i]=wz_me2;

      wz_me3=wz_ME3_C1[wz_i]*wz_ME3_Y1[wz_i]+wz_ME3_C2[wz_i]*wz_ME3_Y2[wz_i];
      wz_ME3_Y2[wz_i]=wz_ME3_Y1[wz_i]; wz_ME3_Y1[wz_i]=wz_me3;

      wz_mech_voice=wz_me1+wz_me2+wz_me3;
      wz_mech_sum+=wz_mech_voice;

      // TRUE AUDIBLE-OUTPUT SLEEP.
      // Follow sound, not Note On ownership. The physical key may stay held while
      // a naturally decayed Wurlitzer reed releases its DSP slot.
      //
      // Use the filtered pickup plus the actually summed mechanical contribution,
      // not the three hidden mechanical modes independently.
      wz_audible=max(abs(wz_VPKLP2[wz_i]),abs(wz_mech_voice));
      wz_audible < 0.00001 ? (
        wz_VQUIET[wz_i]+=1;
        wz_VQUIET[wz_i] > 1024 ? (
          wz_VACTIVE[wz_i]=0;
          wz_VGATE[wz_i]=0;
          wz_VDAMPED[wz_i]=0;
          wz_R_Y1[wz_i]=wz_R_Y2[wz_i]=0;
          wz_VPKLP1[wz_i]=wz_VPKLP2[wz_i]=0;
          wz_ME1_Y1[wz_i]=wz_ME1_Y2[wz_i]=0;
          wz_ME2_Y1[wz_i]=wz_ME2_Y2[wz_i]=0;
          wz_ME3_Y1[wz_i]=wz_ME3_Y2[wz_i]=0;
          wz_VBODYATT[wz_i]=0;
          wz_VQUIET[wz_i]=0;
          // wz_KEYHELD is intentionally preserved until the physical Note Off.
          wz_wz_active_remove(wz_i);
        );
      ) : (
        wz_VQUIET[wz_i]=0;
      );
      wz_VACTIVE[wz_i] ? wz_ai+=1;
    ) : (
      wz_wz_active_remove(wz_i);
    );
  );
);

// ------------------------------------------------------------
// Pickup rail.
// ------------------------------------------------------------
// Electrical pickup tone is already filtered per voice.
// Mechanical action remains a direct/acoustic contribution.
wz_pickup_x=wz_voice_sum;
abs(wz_pickup_x)>64 ? wz_pickup_x=sign(wz_pickup_x)*64;
wz_x=wz_pickup_x;

// ------------------------------------------------------------
// Parallel saturation with protected bass.
// ------------------------------------------------------------
wz_sat_low += (wz_x-wz_sat_low)*wz_sat_hp_k;
wz_sat_high = wz_x-wz_sat_low;
wz_sat_mix > 0.0000001 && slider166 > 0.00001 ? (
  wz_sat_driven = wz_sat_high*wz_sat_drive;
  wz_sat_wet = wz_wz_softclip(wz_sat_driven)/max(1,wz_sat_drive);
  wz_sat_processed = wz_sat_low + wz_sat_wet;
  wz_x = wz_x + (wz_sat_processed-wz_x)*wz_sat_mix;
);

// Mechanical action is direct/acoustic and bypasses pickup amp saturation.
wz_x += wz_mech_sum;

// ------------------------------------------------------------
// Wurlitzer-style amplitude Tremolo.
// ------------------------------------------------------------
wz_tremolo_depth > 0.0000001 ? (
  wz_tr_old_s=wz_tr_sin;
  wz_tr_sin=wz_tr_sin*wz_tr_rot_c + wz_tr_cos*wz_tr_rot_s;
  wz_tr_cos=wz_tr_cos*wz_tr_rot_c - wz_tr_old_s*wz_tr_rot_s;

  (wz_sample_in_block & 16383)==0 ? (
    wz_tr_norm=max(0.000001,sqrt(wz_tr_sin*wz_tr_sin+wz_tr_cos*wz_tr_cos));
    wz_tr_sin/=wz_tr_norm;
    wz_tr_cos/=wz_tr_norm;
  );

  // Unipolar gain modulation: depth=1 reaches nearly silence at trough.
  wz_tr_gain = 1 - wz_tremolo_depth*0.5 + wz_tr_sin*wz_tremolo_depth*0.5;
  wz_x *= wz_tr_gain;
);

// ------------------------------------------------------------
// Optional AutoPan after Tremolo.
// ------------------------------------------------------------
wz_autopan_depth > 0.0000001 ? (
  wz_ap_old_s=wz_ap_sin;
  wz_ap_sin=wz_ap_sin*wz_ap_rot_c + wz_ap_cos*wz_ap_rot_s;
  wz_ap_cos=wz_ap_cos*wz_ap_rot_c - wz_ap_old_s*wz_ap_rot_s;

  (wz_sample_in_block & 16383)==0 ? (
    wz_ap_norm=max(0.000001,sqrt(wz_ap_sin*wz_ap_sin+wz_ap_cos*wz_ap_cos));
    wz_ap_sin/=wz_ap_norm;
    wz_ap_cos/=wz_ap_norm;
  );

  wz_ap_pan=wz_ap_sin*wz_autopan_depth;
  wz_outL=wz_x*(1-wz_ap_pan*0.72);
  wz_outR=wz_x*(1+wz_ap_pan*0.72);
) : (
  wz_outL=wz_x;
  wz_outR=wz_x;
);

// ------------------------------------------------------------
// Lo-lo fixed output signature.
// DC 5 Hz -> fixed glue -> x0.4 -> soft limiter -> Master x2.
// ------------------------------------------------------------
wz_dcL=wz_outL-wz_dc_x1L+wz_dc_coeff_5hz*wz_dc_y1L;
wz_dc_x1L=wz_outL; wz_dc_y1L=wz_dcL;
wz_dcR=wz_outR-wz_dc_x1R+wz_dc_coeff_5hz*wz_dc_y1R;
wz_dc_x1R=wz_outR; wz_dc_y1R=wz_dcR;

wz_peak=max(abs(wz_dcL),abs(wz_dcR));
wz_peak > wz_glue_env ? (
  wz_glue_env += (wz_peak-wz_glue_env)*wz_glue_att_inv;
) : (
  wz_glue_env += (wz_peak-wz_glue_env)*wz_glue_rel_inv;
);

wz_glue_gain=1;
wz_glue_env > wz_glue_thresh_k ? (
  wz_glue_target=wz_glue_thresh_k+(wz_glue_env-wz_glue_thresh_k)/wz_glue_ratio_k;
  wz_glue_gain=wz_glue_target/max(0.000000001,wz_glue_env);
);

wz_outL=wz_dcL*wz_glue_gain*wz_post_in_gain;
wz_outR=wz_dcR*wz_glue_gain*wz_post_in_gain;

abs(wz_outL)>wz_post_limit ? (
  wz_outL=sign(wz_outL)*(wz_post_limit+(abs(wz_outL)-wz_post_limit)*0.15);
);
abs(wz_outR)>wz_post_limit ? (
  wz_outR=sign(wz_outR)*(wz_post_limit+(abs(wz_outR)-wz_post_limit)*0.15);
);

spl0=wz_outL*wz_master_gain*2;
spl1=wz_outR*wz_master_gain*2;

) : engine_now < 2.5 ? (
  org_any_active = 0;
  org_i=0;
  loop(8,
    org_VSTAGE[org_i] > 0 ? org_any_active = 1;
    org_i += 1;
  );
  
  !org_any_active ? (
    org_pre_outL = 0;
    org_pre_outR = 0;
  ) : (
    // Tonewheel AM / tremolo.
    // v0.10 only allowed +/-3%, which was intentionally subtle but practically inaudible.
    // v0.11 maps Depth 0..100% to a real unipolar amplitude modulation:
    // 0% = unity, 100% = 0..1. This keeps the peak at unity instead of boosting it.
    slider86 > 0.000001 ? (
      org_wheel_phase += org_wheel_inc;
      org_wheel_phase >= org_TWO_PI ? org_wheel_phase -= org_TWO_PI;
      org_wheel_depth = slider86 * 0.01;
      org_wheel_amp = 1 - 0.5*org_wheel_depth + 0.5*org_wheel_depth*sin(org_wheel_phase);
    ) : (
      org_wheel_amp = 1;
    );
  
    // Organic slow drift. The original global wander is preserved.
    // A small fraction of the same Tonewheel Drift amount now also moves three
    // tonewheel families independently in PITCH, never in volume.
    slider89 > 0.000001 ? (
      org_drift_countdown -= 1;
      org_drift_countdown <= 0 ? (
        org_drift_target = rand(2) - 1;
        org_drift_countdown = floor(srate * (0.7 + rand(1.3)));
      );
      org_drift_value += (org_drift_target - org_drift_value) * org_drift_smooth;
      org_drift_mult = exp(org_drift_value * slider89 * org_LN2_OVER_1200);
  
      org_rank_count_a -= 1;
      org_rank_count_a <= 0 ? (
        org_rank_target_a = rand(2) - 1;
        org_rank_count_a = floor(srate * (1.05 + rand(1.75)));
      );
  
      org_rank_count_b -= 1;
      org_rank_count_b <= 0 ? (
        org_rank_target_b = rand(2) - 1;
        org_rank_count_b = floor(srate * (0.85 + rand(1.55)));
      );
  
      org_rank_count_c -= 1;
      org_rank_count_c <= 0 ? (
        org_rank_target_c = rand(2) - 1;
        org_rank_count_c = floor(srate * (1.25 + rand(1.85)));
      );
  
      org_rank_drift_a += (org_rank_target_a - org_rank_drift_a) * org_rank_drift_smooth;
      org_rank_drift_b += (org_rank_target_b - org_rank_drift_b) * org_rank_drift_smooth;
      org_rank_drift_c += (org_rank_target_c - org_rank_drift_c) * org_rank_drift_smooth;
  
      // Relative pitch motion is deliberately much smaller than the main Drift.
      // With the current Init (4.8 cents), these peak below roughly +/-1 cent.
      org_rank_cents_a = org_rank_drift_a * slider89 * 0.12;
      org_rank_cents_b = org_rank_drift_b * slider89 * 0.16;
      org_rank_cents_c = org_rank_drift_c * slider89 * 0.20;
  
      // Small-cents linearized 2^(cents/1200): cheaper than three exp() calls
      // and extremely accurate org_over this deliberately narrow relative range.
      org_rank_mult_a = 1 + org_rank_cents_a * org_LN2_OVER_1200;
      org_rank_mult_b = 1 + org_rank_cents_b * org_LN2_OVER_1200;
      org_rank_mult_c = 1 + org_rank_cents_c * org_LN2_OVER_1200;
    ) : (
      org_drift_value = 0;
      org_drift_target = 0;
      org_drift_countdown = 1;
      org_drift_mult = 1;
  
      org_rank_drift_a = 0; org_rank_target_a = 0; org_rank_count_a = 1;
      org_rank_drift_b = 0; org_rank_target_b = 0; org_rank_count_b = 1;
      org_rank_drift_c = 0; org_rank_target_c = 0; org_rank_count_c = 1;
      org_rank_mult_a = 1;
      org_rank_mult_b = 1;
      org_rank_mult_c = 1;
    );
  
    // Shared scanner-style pitch vibrato. One exponential per sample, not per org_voice.
    slider88 > 0.000001 ? (
      org_vib_phase += org_vib_inc;
      org_vib_phase >= org_TWO_PI ? org_vib_phase -= org_TWO_PI;
      org_vib_mult = exp(sin(org_vib_phase) * slider88 * org_LN2_OVER_1200);
    ) : (
      org_vib_mult = 1;
    );
  
    // Classic stereo auto-pan, computed once per sample for the whole organ.
    slider91 > 0.000001 ? (
      org_autopan_phase += org_autopan_inc;
      org_autopan_phase >= org_TWO_PI ? org_autopan_phase -= org_TWO_PI;
      org_autopan_wave = sin(org_autopan_phase);
      org_autopan_pos = org_autopan_wave * slider91 * 0.01;
      org_pan_l = sqrt(0.5 * (1 - org_autopan_pos));
      org_pan_r = sqrt(0.5 * (1 + org_autopan_pos));
    ) : (
      org_autopan_wave = 0;
      org_autopan_pos = 0;
      org_pan_l = 1;
      org_pan_r = 1;
    );
  
    org_mix = 0;
    org_i=0;
    loop(8,
      org_VSTAGE[org_i] > 0 ? (
        // Key envelope.
        org_VSTAGE[org_i] == 1 ? (
          org_VENV[org_i] += org_attack_inc;
          org_VENV[org_i] >= 1 ? (
            org_VENV[org_i] = 1;
            org_VSTAGE[org_i] = 2;
          );
        ) : org_VSTAGE[org_i] == 3 ? (
          slider63 <= 0 ? org_VENV[org_i] = 0 : org_VENV[org_i] *= org_release_coef;
          org_VENV[org_i] < 0.000001 ? (
            org_VENV[org_i] = 0;
            org_VSTAGE[org_i] = 0;
            org_VNOTE[org_i] = -1;
          );
        );
  
        org_VSTAGE[org_i] > 0 ? (
          org_freq_base = org_VFREQ[org_i] * org_tune_mult * org_drift_mult * org_vib_mult;
          org_freq_a = org_freq_base * org_rank_mult_a;
          org_freq_b = org_freq_base * org_rank_mult_b;
          org_freq_c = org_freq_base * org_rank_mult_c;
  
          org_theta_a = org_VPHASE[org_i];
          org_theta_b = org_VPHASEB[org_i];
          org_theta_c = org_VPHASEC[org_i];
  
          // Three efficient harmonic-recurrence families.  This costs only three
          // sine/cosine pairs per active org_voice, rather than nine independent
          // oscillators, but gives the drawbar groups genuine relative pitch motion.
  
          // ---------------- GROUP A ----------------
          org_max_a > 0 ? (
            org_a1 = sin(org_theta_a);
            org_ac = cos(org_theta_a);
            org_max_a >= 2  ? org_a2  = 2*org_ac*org_a1;
            org_max_a >= 3  ? org_a3  = 2*org_ac*org_a2  - org_a1;
            org_max_a >= 4  ? org_a4  = 2*org_ac*org_a3  - org_a2;
            org_max_a >= 5  ? org_a5  = 2*org_ac*org_a4  - org_a3;
            org_max_a >= 6  ? org_a6  = 2*org_ac*org_a5  - org_a4;
            org_max_a >= 7  ? org_a7  = 2*org_ac*org_a6  - org_a5;
            org_max_a >= 8  ? org_a8  = 2*org_ac*org_a7  - org_a6;
            org_max_a >= 9  ? org_a9  = 2*org_ac*org_a8  - org_a7;
            org_max_a >= 10 ? org_a10 = 2*org_ac*org_a9  - org_a8;
          );
  
          // ---------------- GROUP B ----------------
          org_max_b > 0 ? (
            org_b1 = sin(org_theta_b);
            org_bc = cos(org_theta_b);
            org_max_b >= 2  ? org_b2  = 2*org_bc*org_b1;
            org_max_b >= 3  ? org_b3  = 2*org_bc*org_b2  - org_b1;
            org_max_b >= 4  ? org_b4  = 2*org_bc*org_b3  - org_b2;
            org_max_b >= 5  ? org_b5  = 2*org_bc*org_b4  - org_b3;
            org_max_b >= 6  ? org_b6  = 2*org_bc*org_b5  - org_b4;
            org_max_b >= 7  ? org_b7  = 2*org_bc*org_b6  - org_b5;
            org_max_b >= 8  ? org_b8  = 2*org_bc*org_b7  - org_b6;
            org_max_b >= 9  ? org_b9  = 2*org_bc*org_b8  - org_b7;
            org_max_b >= 10 ? org_b10 = 2*org_bc*org_b9  - org_b8;
            org_max_b >= 11 ? org_b11 = 2*org_bc*org_b10 - org_b9;
            org_max_b >= 12 ? org_b12 = 2*org_bc*org_b11 - org_b10;
          );
  
          // ---------------- GROUP C ----------------
          org_max_c > 0 ? (
            org_c1 = sin(org_theta_c);
            org_cc = cos(org_theta_c);
            org_max_c >= 2  ? org_c2  = 2*org_cc*org_c1;
            org_max_c >= 3  ? org_c3  = 2*org_cc*org_c2  - org_c1;
            org_max_c >= 4  ? org_c4  = 2*org_cc*org_c3  - org_c2;
            org_max_c >= 5  ? org_c5  = 2*org_cc*org_c4  - org_c3;
            org_max_c >= 6  ? org_c6  = 2*org_cc*org_c5  - org_c4;
            org_max_c >= 7  ? org_c7  = 2*org_cc*org_c6  - org_c5;
            org_max_c >= 8  ? org_c8  = 2*org_cc*org_c7  - org_c6;
            org_max_c >= 9  ? org_c9  = 2*org_cc*org_c8  - org_c7;
            org_max_c >= 10 ? org_c10 = 2*org_cc*org_c9  - org_c8;
            org_max_c >= 11 ? org_c11 = 2*org_cc*org_c10 - org_c9;
            org_max_c >= 12 ? org_c12 = 2*org_cc*org_c11 - org_c10;
            org_max_c >= 13 ? org_c13 = 2*org_cc*org_c12 - org_c11;
            org_max_c >= 14 ? org_c14 = 2*org_cc*org_c13 - org_c12;
            org_max_c >= 15 ? org_c15 = 2*org_cc*org_c14 - org_c13;
            org_max_c >= 16 ? org_c16 = 2*org_cc*org_c15 - org_c14;
          );
  
          org_voice = 0;
  
          // Group A
          (org_d16  > 0.000001 && org_freq_a*0.5 < org_AA_MARGIN) ? org_voice += org_d16  * org_shape_rank(org_a1,  org_freq_a*0.5);
          (org_d4   > 0.000001 && org_freq_a*2   < org_AA_MARGIN) ? org_voice += org_d4   * org_shape_rank(org_a4,  org_freq_a*2);
          (org_d135 > 0.000001 && org_freq_a*5   < org_AA_MARGIN) ? org_voice += org_d135 * org_shape_rank(org_a10, org_freq_a*5);
  
          // Group B
          (org_d513 > 0.000001 && org_freq_b*1.5 < org_AA_MARGIN) ? org_voice += org_d513 * org_shape_rank(org_b3,  org_freq_b*1.5);
          (org_d223 > 0.000001 && org_freq_b*3   < org_AA_MARGIN) ? org_voice += org_d223 * org_shape_rank(org_b6,  org_freq_b*3);
          (org_d113 > 0.000001 && org_freq_b*6   < org_AA_MARGIN) ? org_voice += org_d113 * org_shape_rank(org_b12, org_freq_b*6);
  
          // Group C
          (org_d8   > 0.000001 && org_freq_c     < org_AA_MARGIN) ? org_voice += org_d8   * org_shape_rank(org_c2,  org_freq_c);
          (org_d2   > 0.000001 && org_freq_c*4   < org_AA_MARGIN) ? org_voice += org_d2   * org_shape_rank(org_c8,  org_freq_c*4);
          (org_d1   > 0.000001 && org_freq_c*8   < org_AA_MARGIN) ? org_voice += org_d1   * org_shape_rank(org_c16, org_freq_c*8);
  
          org_voice *= org_draw_norm;
  
          // Efficient Hammond-inspired key click: short sixth-harmonic transient.
          slider79 > 0.000001 && org_VCLICK[org_i] > 0.00001 ? (
            org_freq_c*6 < org_AA_MARGIN ? org_voice += org_c12 * slider79 * org_VCLICK[org_i] * 4.0; // +12.04 dB key-click gain
            org_VCLICK[org_i] *= org_click_coef;
          ) : org_VCLICK[org_i] = 0;
  
          // Touch percussion: second or third harmonic, independent exponential decay.
          slider81 > 0 && org_VPERC[org_i] > 0.00001 ? (
            org_perc_vel = (1-slider84) + slider84*org_VVEL[org_i];
            slider81 == 1 ? (
              org_freq_c*2 < org_AA_MARGIN ? org_voice += org_c4 * slider82 * org_VPERC[org_i] * org_perc_vel;
            ) : (
              org_freq_c*3 < org_AA_MARGIN ? org_voice += org_c6 * slider82 * org_VPERC[org_i] * org_perc_vel;
            );
            org_VPERC[org_i] *= org_perc_coef;
          ) : org_VPERC[org_i] = 0;
  
          org_vel_gain = (1-org_velocity_amount) + org_velocity_amount*org_VVEL[org_i];
          org_mix += org_voice * org_VENV[org_i] * org_vel_gain * org_wheel_amp;
  
          // Each family advances from the same nominal 16' org_base, with only its
          // tiny relative pitch wander differing.
          org_VPHASE[org_i]  += $pi * org_freq_a / srate;
          org_VPHASEB[org_i] += $pi * org_freq_b / srate;
          org_VPHASEC[org_i] += $pi * org_freq_c / srate;
  
          org_VPHASE[org_i]  >= org_TWO_PI ? org_VPHASE[org_i]  -= org_TWO_PI;
          org_VPHASEB[org_i] >= org_TWO_PI ? org_VPHASEB[org_i] -= org_TWO_PI;
          org_VPHASEC[org_i] >= org_TWO_PI ? org_VPHASEC[org_i] -= org_TWO_PI;
        );
      );
      org_i += 1;
    );
  
    // AutoPan creates the stereo signal before tape and the signature stage.
    org_pre_outL = org_mix * org_pan_l;
    org_pre_outR = org_mix * org_pan_r;
  );
  
  // ============================================================
  // OTARI-INSPIRED RECORD / TRANSPORT / REPRO STAGE
  // ============================================================
  org_tape_on ? (
    // Preserve the clean organ body.  The new HP will act only on the difference
    // introduced by tape saturation / transport / head contour.
    org_tape_cleanL = org_pre_outL;
    org_tape_cleanR = org_pre_outR;
  
    // The side currently favored by AutoPan is driven a little harder into the
    // magnetic state.  This makes the coloration travel WITH the panorama.
    org_tape_drive_motion = 0.10 * org_tape_motion_amt;
    org_tape_driveL = org_tape_drive * (1 + org_tape_drive_motion * (-org_autopan_pos));
    org_tape_driveR = org_tape_drive * (1 + org_tape_drive_motion * ( org_autopan_pos));
  
    // Local 2x magnetic processing: midpoint + current sample.
    // Averaging the two substeps also softens nonlinear alias products.
    org_tape_midL = 0.5*(org_tape_prev_inL + org_pre_outL);
    org_tape_midR = 0.5*(org_tape_prev_inR + org_pre_outR);
  
    org_tape_aL = org_tape_mag_sample(org_tape_midL, 0, org_tape_driveL);
    org_tape_aR = org_tape_mag_sample(org_tape_midR, 1, org_tape_driveR);
    org_tape_bL = org_tape_mag_sample(org_pre_outL, 0, org_tape_driveL);
    org_tape_bR = org_tape_mag_sample(org_pre_outR, 1, org_tape_driveR);
  
    org_tape_prev_inL = org_pre_outL;
    org_tape_prev_inR = org_pre_outR;
  
    org_tape_recL = 0.5*(org_tape_aL + org_tape_bL);
    org_tape_recR = 0.5*(org_tape_aR + org_tape_bR);
  
    // Transport motion is a true moving fractional delay.
    // Because delay position follows the same sinusoid as AutoPan, its derivative
    // is largest while the sound crosses the centre: that is where the pitch
    // Doppler/wow is strongest. At the pan extremes it naturally slows down.
    org_tape_motion_link = org_tape_motion_amt * slider91 * 0.01 * org_tape_speed_motion;
  
    org_tape_motion_link > 0.0000001 ? (
      org_TAPE_BUF_L[org_tape_w] = org_tape_recL;
      org_TAPE_BUF_R[org_tape_w] = org_tape_recR;
  
      // 0.35 ms at full creative Motion; with the current Init (32% pan, 35%
      // Motion) the modulation is around real-machine scale.
      org_tape_common_ms = 0.35 * org_tape_motion_link * org_autopan_wave;
      org_tape_skew_ms = 0.08 * org_tape_motion_link * org_autopan_pos;
      org_tape_base_ms = 0.60;
  
      org_tape_delayL = (org_tape_base_ms + org_tape_common_ms + org_tape_skew_ms) * 0.001*srate;
      org_tape_delayR = (org_tape_base_ms + org_tape_common_ms - org_tape_skew_ms) * 0.001*srate;
      org_tape_delayL = max(1, min(org_TAPE_BUF_SIZE-2, org_tape_delayL));
      org_tape_delayR = max(1, min(org_TAPE_BUF_SIZE-2, org_tape_delayR));
  
      org_tape_outL = org_tape_delay_read(org_TAPE_BUF_L, org_tape_delayL);
      org_tape_outR = org_tape_delay_read(org_TAPE_BUF_R, org_tape_delayR);
  
      org_tape_w += 1;
      org_tape_w >= org_TAPE_BUF_SIZE ? org_tape_w = 0;
    ) : (
      org_tape_outL = org_tape_recL;
      org_tape_outR = org_tape_recR;
    );
  
    // Low-frequency head contour / "head bump".
    org_tape_hpL = org_tape_outL - org_tape_bump_lpL - org_tape_bump_damp*org_tape_bump_bpL;
    org_tape_bump_bpL += org_tape_bump_f*org_tape_hpL;
    org_tape_bump_lpL += org_tape_bump_f*org_tape_bump_bpL;
  
    org_tape_hpR = org_tape_outR - org_tape_bump_lpR - org_tape_bump_damp*org_tape_bump_bpR;
    org_tape_bump_bpR += org_tape_bump_f*org_tape_hpR;
    org_tape_bump_lpR += org_tape_bump_f*org_tape_bump_bpR;
  
    org_tape_procL = org_tape_outL + org_tape_bump_bpL * org_tape_bump_amt * 0.32;
    org_tape_procR = org_tape_outR + org_tape_bump_bpR * org_tape_bump_amt * 0.32;
  
    // ------------------------------------------------------------
    // GRAIN HP — FILTER ONLY THE OTARI COLORATION RESIDUAL
    // ------------------------------------------------------------
    // Subtract the clean body first.  This means bass fundamentals remain intact;
    // only low-frequency mud generated by saturation / moving-delay / head contour
    // is rejected.  The mild resonance lets the remaining edge/grain speak.
    org_grain_inL = org_tape_procL - org_tape_cleanL;
    org_grain_inR = org_tape_procR - org_tape_cleanR;
  
    org_grain_hpL = org_grain_inL - org_grain_hp_lpL - org_grain_hp_damp*org_grain_hp_bpL;
    org_grain_hp_bpL += org_grain_hp_f*org_grain_hpL;
    org_grain_hp_lpL += org_grain_hp_f*org_grain_hp_bpL;
  
    org_grain_hpR = org_grain_inR - org_grain_hp_lpR - org_grain_hp_damp*org_grain_hp_bpR;
    org_grain_hp_bpR += org_grain_hp_f*org_grain_hpR;
    org_grain_hp_lpR += org_grain_hp_f*org_grain_hp_bpR;
  
    org_pre_outL = org_tape_cleanL + org_grain_hpL;
    org_pre_outR = org_tape_cleanR + org_grain_hpR;
  );
  
  // ============================================================
  // LO-LO SIGNATURE OUTPUT STAGE
  // Exact mandatory topology shared by LJuno-116 and LSH-2.
  // It is deliberately outside the active-org_voice branch so the DC blocker
  // and glue detector can return smoothly to zero after the final release.
  // ============================================================
  
  // 5 Hz stereo DC blocker.
  org_dc_xL = org_pre_outL;
  org_dc_yL = org_dc_xL - org_dc_xL_prev + org_dc_coeff_5hz * org_dc_yL_prev;
  org_dc_xL_prev = org_dc_xL;
  org_dc_yL_prev = org_dc_yL;
  
  org_dc_xR = org_pre_outR;
  org_dc_yR = org_dc_xR - org_dc_xR_prev + org_dc_coeff_5hz * org_dc_yR_prev;
  org_dc_xR_prev = org_dc_xR;
  org_dc_yR_prev = org_dc_yR;
  
  // Fixed linked stereo glue.
  // Detector follows the louder channel, as in the optimized LSH-2 path.
  org_glue_in = max(abs(org_dc_yL), abs(org_dc_yR));
  
  org_glue_env < org_glue_in
    ? org_glue_env += (org_glue_in - org_glue_env) * org_glue_att_inv
    : org_glue_env += (org_glue_in - org_glue_env) * org_glue_rel_inv;
  
  org_glue_env > org_glue_thresh_k ? (
    org_over = org_glue_env - org_glue_thresh_k;
    org_glue_gain = (org_glue_thresh_k + org_over / org_glue_ratio_k) / org_glue_env;
  ) : (
    org_glue_gain = 1;
  );
  
  spl0 = org_dc_yL * org_glue_gain * org_post_in_gain;
  spl1 = org_dc_yR * org_glue_gain * org_post_in_gain;
  
  // Soft limiter: threshold 0.98; only 15% of org_excess survives.
  org_abs0 = abs(spl0);
  org_abs0 > org_post_limit ? (
    org_excess = org_abs0 - org_post_limit;
    spl0 = sign(spl0) * (org_post_limit + org_excess * 0.15);
  );
  
  org_abs1 = abs(spl1);
  org_abs1 > org_post_limit ? (
    org_excess = org_abs1 - org_post_limit;
    spl1 = sign(spl1) * (org_post_limit + org_excess * 0.15);
  );
  
  // Master Output is last, with the characteristic x2 used by LJuno / LSH-2.
  spl0 *= org_master_gain_lin * 2;
  spl1 *= org_master_gain_lin * 2;
) : engine_now < 3.5 ? (

    // ------------------------------------------------------------
    // GLOBAL MOD-WHEEL VIBRATO SAMPLE
    // ------------------------------------------------------------
    vib_phase += vib_phase_inc;
    vib_phase >= twopi ? vib_phase -= twopi;
  
    vib_active = mod_wheel > 0.0000001 && step_vib_depth_cents > 0.0000001;
    vib_active ? (
      vib_cents_sample = sin(vib_phase) * step_vib_depth_cents * mod_wheel;
      global_pitch_ratio = pitch_bend_ratio * cents_ratio(vib_cents_sample);
    ) : (
      vib_cents_sample = 0;
      global_pitch_ratio = pitch_bend_ratio;
    );
  
    out = 0;
    stereoL = 0;
    stereoR = 0;
  
    mode < 2 ? (
      mono_stage != 0 ? (
        // Very common sustained-note path: after portamento/finger/transients settle,
        // and with all time-varying waveform modules disabled, execute oscillator +
        // gain + phase only. This preserves the exact sustained sample stream.
        mono_steady = mono_stage == 3
                   && !mono_glide
                   && !mono_os_dirty
                   && !vib_active
                   && step_steady_kernel
                   && (!step_finger_on || mono_finger_stage == 0)
                   && mono_pick_env == 0
                   // Never render oscillator * 0 forever just because the key is held.
                   && !(sustain_level <= 0.00001 && mono_env <= 0.00001);
  
        mono_steady ? (
          phase_step = mono_phase_step;
          osc_out = render_rec_auto(mono_phase, phase_step, 6, mono_os);
          body_out = osc_out * mono_env * mono_vel;
          step_vel_tone_on ? body_out = apply_vel_tone(body_out, 6);
          out = body_out;
          stereo_active ? (
            stereo_body(body_out, 6, mono_key_gainL, mono_key_gainR);
            stereoL += stereo_tmpL;
            stereoR += stereo_tmpR;
          );
          mono_phase += phase_step;
          mono_phase >= twopi ? mono_phase -= twopi*floor(mono_phase*inv_twopi);
        ) : (
        mono_glide ? (
          mono_freq += (mono_target - mono_freq) * porta_k;
          abs(mono_target-mono_freq) <= max(0.000000000001, abs(mono_target)*0.000000000001) ? (
            mono_freq = mono_target;
            mono_glide = 0;
            mono_os_dirty = 1;
          );
        );
  
        // These state machines disappear completely from the hot path when their
        // corresponding audible module is disabled.
        step_attack_dynamic ? mono_exc += (0-mono_exc)*attack_timbre_k;
        step_tension_on ? mono_tension += (0-mono_tension)*tension_k;
  
        step_finger_on ? (
          mono_finger_stage == 1 ? (
            mono_finger += (1-mono_finger)*finger_rise_k;
            mono_finger >= 0.999 ? (mono_finger = 1; mono_finger_stage = 2;);
          ) : mono_finger_stage == 2 ? (
            mono_finger += (0-mono_finger)*finger_return_k;
            mono_finger <= 0.00001 ? (
              mono_finger = 0;
              mono_finger_stage = 0;
              mono_os_dirty = 1;
            );
          );
        );
  
        mono_stage == 1 ? (
          mono_env += (1-mono_env)*atk_k;
          mono_env >= 0.9995 ? (
            mono_env = 1;
            mono_stage = 2;
          );
        ) : mono_stage == 2 ? (
          mono_env += (sustain_level-mono_env)*dec_k;
          abs(mono_env-sustain_level) <= 0.00001 ? (
            mono_env = sustain_level;
            mono_stage = 3;
          );
        ) : mono_stage == 3 ? (
          // A plucked Strings patch with Sustain=0 must sleep even while the
          // physical MIDI key remains held. MIDI held-state is stored separately,
          // so killing AUDIO state here does not lose legato/key ownership.
          sustain_level <= 0.00001 && mono_env <= 0.00001 && mono_pick_env <= 0.00001 ? (
            mono_env = 0;
            mono_stage = 0;
            mono_exc = 0;
            mono_tension = 0;
            mono_finger = 0;
            mono_finger_stage = 0;
            mono_finger_vel = 0;
            mono_glide = 0;
            mono_phase_step = 0;
          );
        ) : (
          mono_env += (0-mono_env)*rel_k;
          mono_env <= 0.00001 ? (
            mono_env = 0;
            mono_stage = 0;
            mono_exc = 0;
            mono_tension = 0;
            mono_finger = 0;
            mono_finger_stage = 0;
            mono_finger_vel = 0;
          );
        );
  
        mono_stage != 0 ? (
          pitch_work = mono_os_dirty || mono_glide || vib_active
                    || (step_tension_on && abs(mono_tension) > 0.000000001)
                    || (step_finger_on && mono_finger_stage != 0);
  
          pitch_work ? (
            local_pitch_cents = drift_pitch_cents_block;
            step_tension_on ? local_pitch_cents += step_tension_cents*mono_tension*mono_vel;
            step_finger_on && mono_finger_stage != 0
              ? local_pitch_cents += step_finger_cents*mono_finger*mono_finger_vel;
  
            abs(local_pitch_cents) > 0.000000000001
              ? effective_hz = mono_freq * global_pitch_ratio * cents_ratio(local_pitch_cents)
              : effective_hz = mono_freq * global_pitch_ratio;
  
            new_os = os_for_pitch(effective_hz, mono_os);
            new_os != mono_os ? (
              osc_reset(6);
              mono_os = new_os;
            );
            mono_phase_step = effective_hz * phase_per_hz;
            mono_os_dirty = 0;
          );
  
          // Drift is block-rate and dirties pitch only on the first sample of a block.
          // Once glide/finger/tension settle, LUT/OS/Hz->phase work disappears otherwise.
          phase_step = mono_phase_step;
          step_direct_fast ? (
            warp_static_now = !mono_glide
                           && !step_drift_on
                           && !vib_active
                           && (!step_tension_on || abs(mono_tension) <= 0.000000001)
                           && (!step_finger_on || mono_finger_stage == 0);
            warp_static_now ? (
              osc_out = render_rec_auto(mono_phase,phase_step,6,mono_os);
            ) : (
              warp_rec_ready[6] = 0;
              mono_os <= 1 ? osc_out = render_fast_1x(mono_phase)
                           : mono_os == 2 ? osc_out = render_fast_2x(mono_phase,phase_step,6)
                                          : osc_out = render_fast_4x(mono_phase,phase_step,6);
            );
          ) : osc_out = render_stepsine_os(
                mono_phase, phase_step, mono_exc,
                mono_life_mod, mono_timbre_scale, 6, mono_os
              );
          body_out = osc_out * mono_env * mono_vel;
          step_vel_tone_on ? body_out = apply_vel_tone(body_out, 6);
          out = body_out;
          stereo_active ? (
            stereo_body(body_out, 6, mono_key_gainL, mono_key_gainR);
            stereoL += stereo_tmpL;
            stereoR += stereo_tmpR;
          );
  
          mono_phase += phase_step;
          mono_phase >= twopi ? mono_phase -= twopi*floor(mono_phase*inv_twopi);
        );
  
        // Plectrum transient is separate from the main ADSR, so even a slow
        // Key Attack keeps a sharp physical pick articulation.
        mono_pick_env > 0.00001 && step_pick_level > 0.000001 ? (
          pick_n = rand(2) - 1;
  
          // Dark component: band-limited scrape.
          mono_pick_lp += (pick_n - mono_pick_lp) * pick_lp_k;
          mono_pick_dc += (mono_pick_lp - mono_pick_dc) * pick_dc_k;
          pick_dark = mono_pick_lp - mono_pick_dc;
  
          // Bright component: the edge removed by the low-pass. This gives the
          // characteristic small hard contact of a pick without adding a new slider.
          pick_edge = pick_n - mono_pick_lp;
  
          pick_sig = pick_dark*pick_dark_mix + pick_edge*pick_edge_mix;
  
          // Very short mechanical snap at the front of the stroke.
          // It is derived from the same noise texture, so it does not sound like
          // an unrelated digital click.
          pick_snap = max(0, (mono_pick_env - 0.72) / 0.28);
          pick_sig += pick_edge * pick_snap * pick_snap_mix;
  
          // Previous version used 0.42 and was effectively masked by the oscillator.
          // 5.2 doubles the previous plectrum level; low slider values remain usable.
          // Velocity still influences the gesture but never makes it disappear.
          // Independent velocity sensitivity for the plectrum.
          // 0.00 = fixed pick level, 1.00 = full linear MIDI velocity response.
          pick_out = pick_sig * mono_pick_env * mono_pick_gain;
          out += pick_out;
          stereo_active ? (
            // Pick ignores Stereo Fan, but follows Keyboard Stereo exactly.
            stereoL += pick_out * mono_key_gainL;
            stereoR += pick_out * mono_key_gainR;
          );
  
          mono_pick_env *= pick_decay_k;
        ) : mono_pick_env = 0;
        ); // full mono path
      );
    ) : (
      // Six voices are compile-time/unrolled below. REAPER receives six fixed code
      // paths instead of loop(6)+dynamic i memory addressing. When inactive, each
      // path exits at its first v_active[constant] test.
      poly_active_count > 0 ? (
      // ---- precompiled voice 0 ----
        v_active[0] ? (
          v_steady = v_stage[0] == 3
                  && !v_glide[0]
                  && !v_os_dirty[0]
                  && !vib_active
                  && step_steady_kernel
                  && (!step_finger_on || v_finger_stage[0] == 0)
                  && v_pick_env[0] == 0
                  // Silent held Strings voices must fall through once and self-release.
                  && !(sustain_level <= 0.00001 && v_env[0] <= 0.00001);
  
          v_steady ? (
            phase_step = v_phase_step[0];
            osc_out = render_rec_auto(v_phase[0], phase_step, 0, v_os[0]);
            body_out = osc_out * v_env[0] * v_vel[0];
            step_vel_tone_on ? body_out = apply_vel_tone(body_out, 0);
            out += body_out;
            stereo_active ? (
              stereo_body(body_out, 0, v_key_gainL[0], v_key_gainR[0]);
              stereoL += stereo_tmpL;
              stereoR += stereo_tmpR;
            );
            v_phase[0] += phase_step;
            v_phase[0] >= twopi ? v_phase[0] -= twopi*floor(v_phase[0]*inv_twopi);
          ) : (
          v_glide[0] ? (
            v_freq[0] += (v_target[0]-v_freq[0])*porta_k;
            abs(v_target[0]-v_freq[0]) <= max(0.000000000001, abs(v_target[0])*0.000000000001) ? (
              v_freq[0] = v_target[0];
              v_glide[0] = 0;
              v_os_dirty[0] = 1;
            );
          );
  
          step_attack_dynamic ? v_exc[0] += (0-v_exc[0])*attack_timbre_k;
          step_tension_on ? v_tension[0] += (0-v_tension[0])*tension_k;
  
          step_finger_on ? (
            v_finger_stage[0] == 1 ? (
              v_finger[0] += (1-v_finger[0])*finger_rise_k;
              v_finger[0] >= 0.999 ? (v_finger[0] = 1; v_finger_stage[0] = 2;);
            ) : v_finger_stage[0] == 2 ? (
              v_finger[0] += (0-v_finger[0])*finger_return_k;
              v_finger[0] <= 0.00001 ? (
                v_finger[0] = 0;
                v_finger_stage[0] = 0;
                v_os_dirty[0] = 1;
              );
            );
          );
  
          v_stage[0] == 1 ? (
            v_env[0] += (1-v_env[0])*atk_k;
            v_env[0] >= 0.9995 ? (
              v_env[0] = 1;
              v_stage[0] = 2;
            );
          ) : v_stage[0] == 2 ? (
            v_env[0] += (sustain_level-v_env[0])*dec_k;
            abs(v_env[0]-sustain_level) <= 0.00001 ? (
              v_env[0] = sustain_level;
              v_stage[0] = 3;
            );
          ) : v_stage[0] == 3 ? (
            // Sustain=0: release DSP ownership as soon as this held voice is
            // truly silent. A later MIDI Note Off may arrive, but no audio work
            // is needed in the meantime.
            sustain_level <= 0.00001 && v_env[0] <= 0.00001 && v_pick_env[0] <= 0.00001 ? (
              v_env[0] = 0;
              v_stage[0] = 0;
              v_active[0] = 0;
              poly_active_count -= 1;
              poly_active_count < 0 ? poly_active_count = 0;
              v_exc[0] = 0;
              v_tension[0] = 0;
              v_finger[0] = 0;
              v_finger_stage[0] = 0;
              v_finger_vel[0] = 0;
              v_glide[0] = 0;
              v_phase_step[0] = 0;
            );
          ) : (
            v_env[0] += (0-v_env[0])*rel_k;
            v_env[0] <= 0.00001 ? (
              v_env[0] = 0;
              v_stage[0] = 0;
              v_active[0] = 0;
              poly_active_count -= 1;
              poly_active_count < 0 ? poly_active_count = 0;
              v_exc[0] = 0;
              v_tension[0] = 0;
              v_finger[0] = 0;
              v_finger_stage[0] = 0;
              v_finger_vel[0] = 0;
              v_pick_env[0] = 0;
              v_pick_lp[0] = 0;
              v_pick_dc[0] = 0;
              v_glide[0] = 0;
              v_os_dirty[0] = 1;
              v_phase_step[0] = 0;
            );
          );
  
          v_active[0] ? (
            pitch_work = v_os_dirty[0] || v_glide[0] || vib_active
                      || (step_tension_on && abs(v_tension[0]) > 0.000000001)
                      || (step_finger_on && v_finger_stage[0] != 0);
  
            pitch_work ? (
              local_pitch_cents = drift_pitch_cents_block;
              step_tension_on ? local_pitch_cents += step_tension_cents*v_tension[0]*v_vel[0];
              step_finger_on && v_finger_stage[0] != 0
                ? local_pitch_cents += step_finger_cents*v_finger[0]*v_finger_vel[0];
  
              abs(local_pitch_cents) > 0.000000000001
                ? effective_hz = v_freq[0] * global_pitch_ratio * cents_ratio(local_pitch_cents)
                : effective_hz = v_freq[0] * global_pitch_ratio;
  
              new_os = os_for_pitch(effective_hz, v_os[0]);
              new_os != v_os[0] ? (
                osc_reset(0);
                v_os[0] = new_os;
              );
              v_phase_step[0] = effective_hz * phase_per_hz;
              v_os_dirty[0] = 0;
            );
  
            phase_step = v_phase_step[0];
            step_direct_fast ? (
              warp_static_now = !v_glide[0]
                             && !step_drift_on
                             && !vib_active
                             && (!step_tension_on || abs(v_tension[0]) <= 0.000000001)
                             && (!step_finger_on || v_finger_stage[0] == 0);
              warp_static_now ? (
                osc_out = render_rec_auto(v_phase[0],phase_step,0,v_os[0]);
              ) : (
                warp_rec_ready[0] = 0;
                v_os[0] <= 1 ? osc_out = render_fast_1x(v_phase[0])
                               : v_os[0] == 2 ? osc_out = render_fast_2x(v_phase[0],phase_step,0)
                                                : osc_out = render_fast_4x(v_phase[0],phase_step,0);
              );
            ) : osc_out = render_stepsine_os(
                  v_phase[0], phase_step, v_exc[0],
                  v_life_mod[0], v_timbre_scale[0], 0, v_os[0]
                );
            body_out = osc_out * v_env[0] * v_vel[0];
            step_vel_tone_on ? body_out = apply_vel_tone(body_out, 0);
            out += body_out;
            stereo_active ? (
              stereo_body(body_out, 0, v_key_gainL[0], v_key_gainR[0]);
              stereoL += stereo_tmpL;
              stereoR += stereo_tmpR;
            );
  
            v_phase[0] += phase_step;
            v_phase[0] >= twopi ? v_phase[0] -= twopi*floor(v_phase[0]*inv_twopi);
          );
  
          v_pick_env[0] > 0.00001 && step_pick_level > 0.000001 ? (
            pick_n = rand(2) - 1;
  
            v_pick_lp[0] += (pick_n - v_pick_lp[0]) * pick_lp_k;
            v_pick_dc[0] += (v_pick_lp[0] - v_pick_dc[0]) * pick_dc_k;
            pick_dark = v_pick_lp[0] - v_pick_dc[0];
            pick_edge = pick_n - v_pick_lp[0];
  
            pick_sig = pick_dark*pick_dark_mix + pick_edge*pick_edge_mix;
  
            pick_snap = max(0, (v_pick_env[0] - 0.72) / 0.28);
            pick_sig += pick_edge * pick_snap * pick_snap_mix;
  
            pick_out = pick_sig * v_pick_env[0] * v_pick_gain[0];
            out += pick_out;
