    // Preserve the original Comb mix operation order exactly.
    mix = a*(1-cur_comb_amt) + (a-b)*0.5*cur_comb_amt;
    y = osc4_filter(mix, idx);
  );
  y;
);

function render_rawlog_knee_nocomb(ph, phase_step, idx, os)
local(y,q,h) (
  os <= 1 ? (
    y = stepsine_core_rawlog_knee(ph);
  ) : os == 2 ? (
    osc2_filter(stepsine_core_rawlog_knee(ph), idx);
    y = osc2_filter(stepsine_core_rawlog_knee(ph + phase_step*0.5), idx);
  ) : (
    q = phase_step*0.25;
    h = q+q;
    osc4_filter(stepsine_core_rawlog_knee(ph), idx);
    osc4_filter(stepsine_core_rawlog_knee(ph + q), idx);
    osc4_filter(stepsine_core_rawlog_knee(ph + h), idx);
    y = osc4_filter(stepsine_core_rawlog_knee(ph + h + q), idx);
  );
  y;
);

function render_rawlog_knee_comb(ph, phase_step, idx, os)
local(y,q,h) (
  os <= 1 ? (
    y = wave_rawlog_knee_comb(ph);
  ) : os == 2 ? (
    osc2_filter(wave_rawlog_knee_comb(ph), idx);
    y = osc2_filter(wave_rawlog_knee_comb(ph + phase_step*0.5), idx);
  ) : (
    q = phase_step*0.25;
    h = q+q;
    osc4_filter(wave_rawlog_knee_comb(ph), idx);
    osc4_filter(wave_rawlog_knee_comb(ph + q), idx);
    osc4_filter(wave_rawlog_knee_comb(ph + h), idx);
    y = osc4_filter(wave_rawlog_knee_comb(ph + h + q), idx);
  );
  y;
);

function render_rawlog_plain_nocomb(ph, phase_step, idx, os)
local(y,q,h) (
  os <= 1 ? (
    y = stepsine_core_rawlog_plain(ph);
  ) : os == 2 ? (
    osc2_filter(stepsine_core_rawlog_plain(ph), idx);
    y = osc2_filter(stepsine_core_rawlog_plain(ph + phase_step*0.5), idx);
  ) : (
    q = phase_step*0.25;
    h = q+q;
    osc4_filter(stepsine_core_rawlog_plain(ph), idx);
    osc4_filter(stepsine_core_rawlog_plain(ph + q), idx);
    osc4_filter(stepsine_core_rawlog_plain(ph + h), idx);
    y = osc4_filter(stepsine_core_rawlog_plain(ph + h + q), idx);
  );
  y;
);

function render_rawlog_plain_comb(ph, phase_step, idx, os)
local(y,q,h) (
  os <= 1 ? (
    y = wave_rawlog_plain_comb(ph);
  ) : os == 2 ? (
    osc2_filter(wave_rawlog_plain_comb(ph), idx);
    y = osc2_filter(wave_rawlog_plain_comb(ph + phase_step*0.5), idx);
  ) : (
    q = phase_step*0.25;
    h = q+q;
    osc4_filter(wave_rawlog_plain_comb(ph), idx);
    osc4_filter(wave_rawlog_plain_comb(ph + q), idx);
    osc4_filter(wave_rawlog_plain_comb(ph + h), idx);
    y = osc4_filter(wave_rawlog_plain_comb(ph + h + q), idx);
  );
  y;
);

function render_stepsine_os(ph, phase_step, exc, life_mod, timbre_scale, idx, os)
local(y) (
  step_core_dynamic ? (
    step_prepare_full ? prepare_wave_full(exc, life_mod, timbre_scale)
                      : prepare_wave_cached(exc, life_mod, timbre_scale);
  );

  step_rawlog_kernel == 2 ? (
    // Default Strings topology: full oversampling retained, Comb fused in one kernel.
    step_comb_on ? y = render_rawlog_knee_comb_fused(ph,phase_step,idx,os)
                 : y = render_rawlog_knee_nocomb(ph,phase_step,idx,os);
  ) : step_rawlog_kernel == 1 ? (
    step_comb_on ? y = render_rawlog_plain_comb(ph,phase_step,idx,os)
                 : y = render_rawlog_plain_nocomb(ph,phase_step,idx,os);
  ) : step_core_fast ? (
    step_comb_on ? y = render_fast_comb(ph,phase_step,idx,os)
                 : y = render_fast_nocomb(ph,phase_step,idx,os);
  ) : (
    step_comb_on ? y = render_generic_comb(ph,phase_step,idx,os)
                 : y = render_generic_nocomb(ph,phase_step,idx,os);
  );
  y;
);

