  wi_p==25 ? slider239 :
  0; // legacy bank slots 26..28 are intentionally unused
);

function wi_win_set_live(wi_p,wi_v)
(
  wi_p==0  ? slider213=wi_v :
  wi_p==1  ? slider215=wi_v :
  wi_p==2  ? slider216=wi_v :
  wi_p==3  ? slider217=wi_v :
  wi_p==4  ? slider218=wi_v :
  wi_p==5  ? slider219=wi_v :
  wi_p==6  ? slider220=wi_v :
