// ------------------------------------------------------------
// Helpers.
// ------------------------------------------------------------
function wi_win_clip01(wi_x) ( max(0,min(1,wi_x)); );

function wi_win_delay_read(wi_base,wi_len,wi_w,wi_delay)
local(wi_pos,wi_i0,wi_i1,wi_frac)
(
  wi_delay=max(1,min(wi_len-2,wi_delay));
  wi_pos=wi_w-wi_delay;
  wi_pos-=floor(wi_pos/wi_len)*wi_len;
  wi_i0=floor(wi_pos);
  wi_frac=wi_pos-wi_i0;
  wi_i1=wi_i0+1;
  wi_i1>=wi_len ? wi_i1=0;
  wi_base[wi_i0]+(wi_base[wi_i1]-wi_base[wi_i0])*wi_frac;
);

function wi_win_clear_voice(wi_i)
local(wi_bb,wi_jb,wi_k)
(
  wi_bb=wi_BORE_BUF+wi_i*wi_BORE_LEN;
  wi_jb=wi_JET_BUF+wi_i*wi_JET_LEN;
  wi_k=0;
  loop(wi_BORE_LEN, wi_bb[wi_k]=0; wi_k+=1;);
  wi_k=0;
  loop(wi_JET_LEN, wi_jb[wi_k]=0; wi_k+=1;);
  wi_VBOREW[wi_i]=0; wi_VJETW[wi_i]=0; wi_VBOREOUT[wi_i]=0; wi_VREFLP[wi_i]=0;
  wi_VJETDCX[wi_i]=0; wi_VJETDCY[wi_i]=0; wi_VBREATHLP[wi_i]=0;
  wi_VKEYLP[wi_i]=0; wi_VBODYLP[wi_i]=0; wi_VQUIET[wi_i]=0; wi_VTAIL[wi_i]=0; wi_VCURDELAY[wi_i]=0; wi_VIGNITE[wi_i]=0;
);

function wi_win_reset_voices()
local(wi_i)
(
  wi_i=0;
  loop(wi_voice_count,
    wi_VACTIVE[wi_i]=0; wi_VGATE[wi_i]=0; wi_VENV[wi_i]=0; wi_VSTAGE[wi_i]=0;
    wi_VKEYENV[wi_i]=0; wi_VIGNITE[wi_i]=0;
    wi_win_clear_voice(wi_i);
    wi_i+=1;
  );
  wi_i=0;
  loop(128,
    wi_KEYHELD[wi_i]=0; wi_KEYORDER[wi_i]=0; wi_KEYVEL[wi_i]=0;
    wi_i+=1;
  );
  wi_held_count=0;
  wi_note_serial=0;
  wi_active_count=0;
);

function wi_win_alloc_voice()
local(wi_i,wi_best,wi_beststamp)
(
  wi_i=0; wi_best=-1;
  loop(wi_poly_voice_count,
    wi_best<0 && !wi_VACTIVE[wi_i] ? wi_best=wi_i;
    wi_i+=1;
  );
  wi_best<0 ? (
    wi_best=0; wi_beststamp=wi_VSTAMP[0]; wi_i=1;
    loop(wi_poly_voice_count-1,
      wi_VSTAMP[wi_i]<wi_beststamp ? (wi_best=wi_i; wi_beststamp=wi_VSTAMP[wi_i];);
      wi_i+=1;
    );
  );
  wi_best;
);

function wi_win_inst_config()
(
  // Hidden acoustic compensation only. Audible voicing remains in sliders/banks.
  wi_inst_gain=1;
  wi_inst_body_fc=1400;
  wi_inst_reflect_bias=0;
  wi_inst_air_gain=1;
  wi_instrument==0 ? (wi_inst_gain=1.00; wi_inst_body_fc=1700; wi_inst_reflect_bias=0.00; wi_inst_air_gain=1.00;) :
  wi_instrument==1 ? (wi_inst_gain=0.92; wi_inst_body_fc=2600; wi_inst_reflect_bias=-0.03; wi_inst_air_gain=0.85;) :
  wi_instrument==2 ? (wi_inst_gain=1.08; wi_inst_body_fc=1050; wi_inst_reflect_bias=0.04; wi_inst_air_gain=1.05;) :
  wi_instrument==3 ? (wi_inst_gain=0.96; wi_inst_body_fc=1450; wi_inst_reflect_bias=-0.02; wi_inst_air_gain=0.78;) :
  wi_instrument==4 ? (wi_inst_gain=1.03; wi_inst_body_fc=900; wi_inst_reflect_bias=0.05; wi_inst_air_gain=1.25;) :
                  (wi_inst_gain=0.98; wi_inst_body_fc=720; wi_inst_reflect_bias=0.08; wi_inst_air_gain=0.70;);
);

function wi_win_voice_recalc(wi_i)
local(wi_note,wi_f)
(
  wi_note=wi_VNOTE[wi_i];
  wi_f=440*(2^(((wi_note-69)+wi_octave_semi+wi_fine_semi+wi_pitch_bend_semi)/12));
  wi_f=max(20,min(srate*0.22,wi_f));
  wi_VFREQ[wi_i]=wi_f;

  // Target acoustic tube length. In Mono Legato this target is not applied
  // instantaneously: @sample slews the effective tube length over a few ms,
  // like opening/closing a finger hole instead of teleporting the bore tap.
  wi_VBASEDELAY[wi_i]=max(4,min(wi_BORE_LEN-3,srate/(wi_f*0.6666666667)+0.5*min(1,440/wi_f)));
);

function wi_win_recalc_all()
local(wi_i)
(
  wi_i=0;
  loop(wi_voice_count, wi_VACTIVE[wi_i] ? wi_win_voice_recalc(wi_i); wi_i+=1;);
);

function wi_win_note_on(wi_note,wi_vel)
local(wi_i,wi_v,wi_vc,wi_had_held,wi_retrigger)
(
  wi_voice_mode<2 ? (
    // Mono: last-note priority. Trigger retriggers every Note On; Legato
    // retriggers only the first note of a connected held-note phrase.
    wi_had_held=wi_held_count>0;
    !wi_KEYHELD[wi_note] ? wi_held_count+=1;
    wi_note_serial+=1;
    wi_KEYHELD[wi_note]=1;
    wi_KEYORDER[wi_note]=wi_note_serial;
    wi_KEYVEL[wi_note]=wi_vel;

    wi_i=wi_mono_voice;
    wi_retrigger=(wi_voice_mode==0)||!wi_had_held||!wi_VACTIVE[wi_i];
    !wi_VACTIVE[wi_i] ? wi_active_count+=1;
    wi_retrigger ? wi_win_clear_voice(wi_i);

    wi_VACTIVE[wi_i]=1; wi_VNOTE[wi_i]=wi_note; wi_VGATE[wi_i]=1;
    wi_VSTAMP[wi_i]=wi_voice_stamp_counter; wi_voice_stamp_counter+=1;
    wi_v=wi_vel/127; wi_vc=wi_v^wi_velocity_curve; wi_VVEL[wi_i]=wi_vc;

    wi_retrigger ? (
      wi_VENV[wi_i]=0; wi_VSTAGE[wi_i]=1; wi_VRELSTEP[wi_i]=0; wi_VTAIL[wi_i]=1;
      wi_VKEYENV[wi_i]=1; wi_VIGNITE[wi_i]=1; wi_VVIBPHASE[wi_i]=0; wi_VVIBCOUNT[wi_i]=0;
    ) : (
      // True legato: preserve breath envelope and waveguide energy.
      // No new chiff/key transient or ignition pulse on overlapping notes.
      // The existing air column is already oscillating, just as in a real
      // fingered legato phrase.
      wi_VSTAGE[wi_i]==3 ? wi_VSTAGE[wi_i]=2;
      wi_VKEYENV[wi_i]=0; wi_VIGNITE[wi_i]=0;
    );
    wi_win_voice_recalc(wi_i);
    wi_retrigger ? wi_VCURDELAY[wi_i]=wi_VBASEDELAY[wi_i];
  ) : (
    // Poly 6: six independent physical wind voices.
    wi_i=wi_win_alloc_voice();
    !wi_VACTIVE[wi_i] ? wi_active_count+=1;
    wi_win_clear_voice(wi_i);

    wi_VACTIVE[wi_i]=1; wi_VNOTE[wi_i]=wi_note; wi_VGATE[wi_i]=1;
    wi_VSTAMP[wi_i]=wi_voice_stamp_counter; wi_voice_stamp_counter+=1;
    wi_v=wi_vel/127; wi_vc=wi_v^wi_velocity_curve; wi_VVEL[wi_i]=wi_vc;
    wi_VENV[wi_i]=0; wi_VSTAGE[wi_i]=1; wi_VRELSTEP[wi_i]=0; wi_VTAIL[wi_i]=1;
    wi_VKEYENV[wi_i]=1; wi_VIGNITE[wi_i]=1; wi_VVIBPHASE[wi_i]=0; wi_VVIBCOUNT[wi_i]=0;
    wi_win_voice_recalc(wi_i);
    wi_VCURDELAY[wi_i]=wi_VBASEDELAY[wi_i];
  );
);

function wi_win_release_voice(wi_i)
(
  wi_VACTIVE[wi_i] ? (
    // The ignition pulse belongs only to the attack. Never let it continue
    // feeding the jet after a real note release.
    wi_VIGNITE[wi_i]=0;
    wi_VSTAGE[wi_i]=3;
    wi_VRELSTEP[wi_i]=wi_VENV[wi_i]/max(1,wi_breath_release_ms*0.001*srate);
  );
);

function wi_win_note_off(wi_note)
local(wi_i,wi_i2,wi_best,wi_best_order,wi_v)
(
  wi_voice_mode<2 ? (
    wi_KEYHELD[wi_note] ? (
      wi_KEYHELD[wi_note]=0; wi_KEYORDER[wi_note]=0;
      wi_held_count-=1; wi_held_count<0 ? wi_held_count=0;
    );

    wi_i=wi_mono_voice;
    wi_VACTIVE[wi_i] && wi_VNOTE[wi_i]==wi_note ? (
      // If another key is still physically held, return to the most
      // recently pressed one without retriggering, like the Strings mono logic.
      wi_best=-1; wi_best_order=-1;
      wi_i2=0;
      loop(128,
        wi_KEYHELD[wi_i2] && wi_KEYORDER[wi_i2]>wi_best_order ? (
          wi_best_order=wi_KEYORDER[wi_i2]; wi_best=wi_i2;
        );
        wi_i2+=1;
      );
      wi_best>=0 ? (
        wi_i=wi_mono_voice;
        wi_VNOTE[wi_i]=wi_best; wi_VGATE[wi_i]=1;
        wi_v=wi_KEYVEL[wi_best]/127; wi_VVEL[wi_i]=wi_v^wi_velocity_curve;
        wi_win_voice_recalc(wi_i);
      ) : (
        wi_i=wi_mono_voice;
        wi_VGATE[wi_i]=0;
        !wi_sustain_pedal ? wi_win_release_voice(wi_i);
      );
    );
  ) : (
    // Poly 6 note-off affects only the six poly slots.
    wi_i=0;
    loop(wi_poly_voice_count,
      wi_VACTIVE[wi_i] && wi_VNOTE[wi_i]==wi_note && wi_VGATE[wi_i] ? (
        wi_VGATE[wi_i]=0;
        !wi_sustain_pedal ? wi_win_release_voice(wi_i);
      );
      wi_i+=1;
    );
  );
);

function wi_win_release_pedal()
local(wi_i)
(
  wi_i=0;
  loop(wi_voice_count, wi_VACTIVE[wi_i] && !wi_VGATE[wi_i] ? wi_win_release_voice(wi_i); wi_i+=1;);
);

// Output states.
wi_vib_phase=0;
wi_dc_coeff_5hz=exp(-wi_twopi*5/srate);
wi_dc_x1L=wi_dc_y1L=0; wi_dc_x1R=wi_dc_y1R=0;
wi_glue_env=0;
wi_glue_att_inv=1/(0.001*srate);
wi_glue_rel_inv=1/(0.004*srate);
wi_glue_ratio_k=2;
wi_glue_thresh_k=0.055;
wi_post_in_gain=0.4;
wi_post_limit=0.98;

// ============================================================
// MICRO SYNTH ENGINE — isolated state / helpers
// ============================================================
ms_twopi=2*$pi;
ms_HELD_STATE=2390000;
ms_HELD_ORDER=2390200;
memset(ms_HELD_STATE,0,128);
memset(ms_HELD_ORDER,0,128);
ms_held_count=0;
ms_note_serial=0;
ms_mono_note=-1;
ms_target_note=60;
ms_current_note=60;
ms_note_active=0;
ms_sustain_pedal=0;
ms_phase1=0;
ms_phase2=0;
ms_env=0;
ms_env_stage=0;
ms_lfo_phase=0;
ms_lfo_hold=0;
ms_f1L=ms_f2L=ms_f3L=ms_f4L=0;
ms_f1R=ms_f2R=ms_f3R=ms_f4R=0;

// Fixed dual-oscillator stereo positions: Osc 1 = -0.5, Osc 2 = +0.5.
ms_osc1_pan=-0.5;
ms_osc2_pan=0.5;
ms_pan1_ang=(ms_osc1_pan+1)*$pi*0.25;
ms_pan2_ang=(ms_osc2_pan+1)*$pi*0.25;
ms_pan1L=cos(ms_pan1_ang); ms_pan1R=sin(ms_pan1_ang);
ms_pan2L=cos(ms_pan2_ang); ms_pan2R=sin(ms_pan2_ang);
ms_osc_stereo_norm=1/max(0.000001,ms_pan1L+ms_pan2L);

// Lo-lo signature final stage from the standalone Micro Synth / LJuno lineage.
ms_glue_env=0;
ms_glue_gain=1;
ms_glue_att_inv=1/max(1,0.001*srate);
ms_glue_rel_inv=1/max(1,0.004*srate);
ms_glue_ratio_k=2;
ms_glue_thresh_k=0.055;
ms_post_in_gain=0.4;
ms_post_limit=0.98;
ms_bend_semi=0;

function ms_clamp(x lo hi) (
  x < lo ? lo : x > hi ? hi : x;
);

function ms_poly_blep(t dt) local(x) (
  t < dt ? (
    x=t/dt;
    x+x-x*x-1;
  ) : t > 1-dt ? (
    x=(t-1)/dt;
    x*x+x+x+1;
  ) : 0;
);

function ms_osc_wave(ph dt wave pw) local(v,e2) (
  wave==0 ? (
    v=sin(ms_twopi*ph);
  ) : wave==1 ? (
    v=1-4*abs(ph-0.5);
  ) : wave==2 ? (
    v=2*ph-1;
    v-=ms_poly_blep(ph,dt);
  ) : (
    v=ph<pw ? 1 : -1;
    v+=ms_poly_blep(ph,dt);
    e2=ph-pw; e2<0 ? e2+=1;
    v-=ms_poly_blep(e2,dt);
  );
  v;
);

function ms_note_hz(n) (
  440*2^((n-69+ms_bend_semi)/12);
);

function ms_reset_voice()
local(i)
(
  i=0;
  loop(128,
    ms_HELD_STATE[i]=0;
    ms_HELD_ORDER[i]=0;
    i+=1;
  );
  ms_held_count=0;
  ms_note_serial=0;
  ms_mono_note=-1;
  ms_note_active=0;
  ms_sustain_pedal=0;
  ms_env=0;
  ms_env_stage=0;
  ms_phase1=0;
  ms_phase2=0;
  ms_lfo_phase=0;
  ms_lfo_hold=0;
  ms_f1L=ms_f2L=ms_f3L=ms_f4L=0;
  ms_f1R=ms_f2R=ms_f3R=ms_f4R=0;
  ms_glue_env=0;
  ms_glue_gain=1;
  ms_bend_semi=0;
);

@slider

// ============================================================
// CURRENT REVERB OWNERSHIP
// Rhodes/Wurlitzer/Organ/Strings/Micro own one bank each; Mallet and Wind own six.
// The same visible sliders 48..57 follow Engine and, inside Mallet/Wind,
// the internal Instrument. User edits are captured continuously into that owner.
// ============================================================
engine_now=max(0,min(6,floor(slider58+0.5)));
reverb_owner_now=rev_owner_index(engine_now,slider170,slider214);
engine_reverb_changed=0;

rev_bank_ready ? (
  rev_now_changed=rev_live_changed();

  reverb_owner_now != reverb_owner_prev ? (
    rev_now_changed ? (
      // Bulk/preset/state restore: visible values belong to the new owner.
      rev_bank_capture(reverb_owner_now);
    ) : (
      // Plain Engine/Mallet/Wind Instrument move: save old, recall new Current.
      rev_bank_capture(reverb_owner_prev);
      rev_bank_load(reverb_owner_now);
      engine_reverb_changed=1;
    );

    reverb_owner_prev=reverb_owner_now;
  ) : rev_now_changed ? (
    // Ordinary reverb edit while staying on the same owner.
    rev_bank_capture(reverb_owner_now);
  );

  rev_snapshot_live();
);

// ============================================================
// CURRENT DELAY OWNERSHIP
// Same owner map as Reverb. Plain engine/instrument moves save old Current
// settings and recall the new owner. Bulk host/preset restores let the visible
// values win for the newly restored owner.
// ============================================================
delay_owner_now=rev_owner_index(engine_now,slider170,slider214);
engine_delay_changed=0;
delay_owner_switched=0;

dt_bank_ready ? (
  dt_now_changed=dt_live_changed();

  delay_owner_now != delay_owner_prev ? (
    dt_now_changed ? (
      // Bulk/preset/state restore: visible Delay belongs to the new owner.
      dt_bank_capture(delay_owner_now);
    ) : (
      // Plain Engine/Mallet/Wind move: preserve old Current and recall new.
      dt_bank_capture(delay_owner_prev);
      dt_bank_load(delay_owner_now);
      engine_delay_changed=1;
    );

    delay_owner_prev=delay_owner_now;
    delay_owner_switched=1;
  ) : dt_now_changed ? (
    dt_bank_capture(delay_owner_now);
  );

  dt_snapshot_live();
);

// Do not carry tape contents from one logical instrument into another.
// If the new owner is active, the cache below clears both buffers immediately;
// if it is dry, they are flushed lazily and will still be clean when enabled.
delay_owner_switched ? (
  dt_mix_active=0;
  dt_pending_samples=0;
  dt_should_process=0;
  dt_flush_remaining=dt_max_delay_samples;
);

// ============================================================
// COMPACT DUAL TAPE DELAY CACHE
// ============================================================
dt_new_mix=dt_clamp(slider199,0,1);
dt_new_active=dt_new_mix>dt_epsilon;

// Mix=0 is the on/off state. While off, @sample lazily overwrites the ring
// buffers with zero at almost no cost. If the user re-enables before that
// flush is complete, clear once here so no old echo can reappear.
dt_new_active && !dt_mix_active ? (
  dt_flush_remaining>0 ? (
    memset(dt_t1_buffer,0,dt_max_delay_samples);
    memset(dt_t2_buffer,0,dt_max_delay_samples);
    dt_flush_remaining=0;
  );
  dt_pending_samples=0;
  dt_should_process=0;
  dt_t1_time_cur=0; dt_t2_time_cur=0;
  dt_t1_pitch_phase=0; dt_t2_pitch_phase=0;
  dt_t1_fb_phase=0; dt_t2_fb_phase=0;
  dt_t1_wet_lp=0; dt_t2_wet_lp=0;
  dt_t1_wet_hp_x=0; dt_t2_wet_hp_x=0;
  dt_t1_wet_hp_y=0; dt_t2_wet_hp_y=0;
  dt_t1_fb_lp=0; dt_t2_fb_lp=0;
  dt_t1_fb_hp_x=0; dt_t2_fb_hp_x=0;
  dt_t1_fb_hp_y=0; dt_t2_fb_hp_y=0;
);
!dt_new_active && dt_mix_active ? (
  dt_pending_samples=0;
  dt_should_process=0;
  dt_flush_remaining=dt_max_delay_samples;
);
dt_mix_active=dt_new_active;
dt_mix=dt_new_mix;
// Single routing topology: Delay remains audible in the main path while this
// send controls how strongly its repeats excite the Reverb. 100% preserves
// the previous standard level; values up to 300% deliberately drive the
// Reverb harder. The old Before/After routing slider has been removed.
dt_reverb_send=dt_clamp(slider210*0.01,0,3);

// Equal-power dry/wet law. Trig is slider-rate only.
dt_mix_angle=dt_mix*$pi*0.5;
dt_dry_mix=cos(dt_mix_angle);
dt_wet_mix=sin(dt_mix_angle);

dt_glide_seconds=max(0.001,slider200*0.001);
dt_glide_coeff=1-exp(-1/(dt_glide_seconds*srate));
dt_pan_coeff=1-exp(-1/(0.005*srate));
dt_t1_delay_numer=30*srate*slider201;
dt_t2_delay_numer=30*srate*slider202;

dt_t1_pitch_semis=slider203;
dt_t2_pitch_semis=slider204;
dt_t1_pitch_ratio=dt_exp2(dt_t1_pitch_semis/12);
dt_t2_pitch_ratio=dt_exp2(dt_t2_pitch_semis/12);
dt_t1_pitch_speed=abs(dt_t1_pitch_ratio-1);
dt_t2_pitch_speed=abs(dt_t2_pitch_ratio-1);
dt_t1_pitch_active=dt_t1_pitch_speed>dt_epsilon;
dt_t2_pitch_active=dt_t2_pitch_speed>dt_epsilon;

dt_t1_feedback_base=dt_clamp(dt_db_to_gain(slider205),0,0.9995);
dt_t2_feedback_base=dt_clamp(dt_db_to_gain(slider206),0,0.9995);
dt_decay_shape=slider212|0;
dt_decay_phase_active=dt_decay_shape>=3;
dt_t1_feedback_static=dt_decay_shape==1 ? pow(dt_t1_feedback_base,1.8) :
                      dt_decay_shape==2 ? pow(dt_t1_feedback_base,0.6) : dt_t1_feedback_base;
dt_t2_feedback_static=dt_decay_shape==1 ? pow(dt_t2_feedback_base,1.8) :
                      dt_decay_shape==2 ? pow(dt_t2_feedback_base,0.6) : dt_t2_feedback_base;

dt_t1_filter_hz=dt_clamp(slider207,40,dt_filter_hz_limit);
dt_t2_filter_hz=dt_clamp(slider208,40,dt_filter_hz_limit);
dt_t1_filter_coeff=1-exp(-dt_filter_exp_scale*dt_t1_filter_hz);
dt_t2_filter_coeff=1-exp(-dt_filter_exp_scale*dt_t2_filter_hz);

// One bipolar stereo-spread control replaces both tape pan sliders.
// +1: Tape 1 hard left / Tape 2 hard right.
//  0: both tapes centered.
// -1: Tape 1 hard right / Tape 2 hard left (crossed stereo).
// Equal-power pan targets are calculated only at slider rate.
dt_stereo_spread=dt_clamp(slider209,-1,1);
dt_t1_pan=-dt_stereo_spread;
dt_t2_pan= dt_stereo_spread;
dt_t1_pan_angle=(dt_t1_pan+1)*$pi*0.25;
dt_t2_pan_angle=(dt_t2_pan+1)*$pi*0.25;
dt_t1_pan_l_target=cos(dt_t1_pan_angle);
dt_t1_pan_r_target=sin(dt_t1_pan_angle);
dt_t2_pan_l_target=cos(dt_t2_pan_angle);
dt_t2_pan_r_target=sin(dt_t2_pan_angle);

// Tape Balance was removed. Both tapes now have a fixed equal contribution.
// 0.353553... preserves the old Balance=0 output calibration exactly.
dt_tape_equal_gain=0.353553390593274;

// One shared Drive replaces the two original tape-drive sliders.
dt_drive_a=dt_clamp(slider211*0.01,0,1);
dt_drive_a2=dt_drive_a*dt_drive_a;
dt_drive_gain=1+79*dt_drive_a2;
dt_drive_bias=0.185*dt_drive_a2;
dt_drive_soft_mix=1-dt_drive_a2;
dt_drive_hard_mix=dt_drive_a2;
dt_drive_zero_soft=dt_drive_bias/(1+abs(dt_drive_bias));
dt_drive_zero_hard=dt_clamp(dt_drive_bias,-1,1);
dt_drive_zero=dt_drive_zero_soft*dt_drive_soft_mix+dt_drive_zero_hard*dt_drive_hard_mix;
dt_drive_active=dt_drive_a>dt_epsilon;

mode = slider2|0;
  sustain_level = slider6;
  porta_enabled = slider3 > 0.0000001;
  phase_per_hz = twopi / srate;

  // Exact dB conversion used by the LJuno / LSH-2 signature stage.
  master_gain_lin = 2^(slider1/6.020599913);

  // Sample-rate dependent signature coefficients.
  dc_coeff_5hz = exp(-2 * $pi * 5 / srate);
  glue_att_inv = 1 / max(1, (0.001 * srate));
  glue_rel_inv = 1 / max(1, (0.004 * srate));

  // Envelope coefficients are calculated only when sliders change.
  slider4 <= 0 ? atk_k = 1 : atk_k = 1-exp(-6.907755278982137/(slider4*srate));
  slider5 <= 0 ? dec_k = 1 : dec_k = 1-exp(-6.907755278982137/(slider5*srate));
  slider7 <= 0 ? rel_k = 1 : rel_k = 1-exp(-6.907755278982137/(slider7*srate));
  slider3 <= 0 ? porta_k = 1 : porta_k = 1-exp(-6.907755278982137/(slider3*srate));
  attack_timbre_k = 1-exp(-6.907755278982137/(max(0.001,slider27)*srate));
  tension_k = 1-exp(-6.907755278982137/(max(0.001,slider30)*srate));
  finger_rise_k = 1-exp(-6.907755278982137/(max(0.001,slider34)*srate));
  finger_return_k = 1-exp(-6.907755278982137/(max(0.005,slider35)*srate));

  // Cache waveform controls so @sample performs no slider mapping work.
  step_warp_rate = slider10;
  step_warp_mul = twopi*step_warp_rate;

  // Recursive warp-sine macrocycle correction. The Strings phase itself wraps,
  // therefore a non-integer Warp Rate intentionally jumps by -2*pi*WarpRate.
  warp_wrap_angle = -twopi*step_warp_rate;
  warp_wrap_sin = sin(warp_wrap_angle);
  warp_wrap_cos = cos(warp_wrap_angle);
  step_rectify = slider11;
  step_rect_dry = 1-step_rectify;
  step_rect_mode = step_rectify <= 0.0000001 ? 0 : step_rectify >= 0.9999999 ? 1 : 2;

  step_log_shape = slider12;
  step_log_mix = slider13;
  step_log_dry = 1-step_log_mix;
  step_log_mode = step_log_mix <= 0.0000001 ? 0 : step_log_mix >= 0.9999999 ? 1 : 2;

  step_warp_mix = slider14;
  step_warp_dry = 1-step_warp_mix;
  step_warpmix_mode = step_warp_mix <= 0.0000001 ? 0 : step_warp_mix >= 0.9999999 ? 1 : 2;

  step_wrap_density = slider15;
  step_fold_cycles = slider16;
  step_fold_depth = slider17;
  step_fold_phase = slider18*twopi;
  step_carrier_ratio = slider19;
  step_carrier_mul = twopi*step_carrier_ratio;
  step_warp_phase = slider20*twopi;
  step_carrier_phase = slider21*twopi;

  step_knee_pos = slider22;
  step_knee_level = slider23;
  step_knee_mix = slider24;
  step_knee_dry = 1-step_knee_mix;
  step_knee_on = step_knee_mix > 0.0000001;
  step_knee_inv_pos = 1/max(0.000001, step_knee_pos);
  step_knee_inv_tail = 1/max(0.000001, 1-step_knee_pos);

  step_attack_fold_depth = slider25;
  step_attack_fold_cycles = slider26;
  step_attack_dynamic = abs(step_attack_fold_depth) > 0.0000001
                     || abs(step_attack_fold_cycles) > 0.0000001;
  step_velocity_timbre = slider28;
  step_velocity_timbre_base = 1-step_velocity_timbre;
  step_tension_cents = slider29;
  step_tension_on = abs(step_tension_cents) > 0.0000001;

  step_string_comb_amount = slider31;
  step_string_comb_phase = slider32*twopi;
  step_comb_on = step_string_comb_amount > 0.0000001;

  step_finger_cents = slider33;
  step_finger_on = abs(step_finger_cents) > 0.0000001;
  step_finger_vel_curve = slider36;
  step_velocity_life = slider37;
  step_velocity_life3 = step_velocity_life*3;
  step_life_on = step_velocity_life > 0.0000001;
  step_temporal_drift = slider38;
  step_temporal_drift3 = step_temporal_drift*3;
  step_drift_on = step_temporal_drift > 0.0000001;

  // Dispatch is decided once here, never inside each oversampled core sample.
  step_core_dynamic = step_attack_dynamic || step_life_on || step_drift_on;

  // Compile the common raw-sine/log/warp topology once per slider change.
  // 0 = generic/other topology, 1 = no Knee, 2 = Knee active.
  step_rawlog_kernel = (step_rect_mode == 0 && step_log_mode == 1 && step_warpmix_mode == 1)
                     ? (step_knee_on ? 2 : 1)
                     : 0;

  // Full dynamic preparer is algebraically identical to prepare_wave_cached
  // for this exact set of enabled modules, but removes invariant hot branches.
  step_prepare_full = step_attack_dynamic
                   && (step_life_on || step_drift_on)
                   && step_comb_on;

  step_core_fast = !step_knee_on
                && step_rect_mode == 1
                && step_log_mode == 1
                && step_warpmix_mode == 1;
  step_direct_fast = !step_core_dynamic && step_core_fast && !step_comb_on;
  // Compiler-style global kernel eligibility. This is invariant until a slider changes.
  step_steady_kernel = step_direct_fast
                    && !step_tension_on
                    && !step_drift_on;

  // Static values used directly when no waveform-life module is active.
  cur_warp_mul = step_warp_mul;
  cur_warp_rate_eff = step_warp_rate;
  cur_wrap_density = step_wrap_density;
  cur_fold_cycles = step_fold_cycles;
  cur_fold_depth = step_fold_depth;
  cur_fold_mul = twopi*step_fold_cycles;
  cur_comb_amt = step_string_comb_amount;
  cur_comb_phase = step_string_comb_phase;

  step_pick_level = slider39;
  step_pick_tone = slider40;
  step_pick_velocity = slider41;
  pick_vel_base = 1-step_pick_velocity;

  // INTELLIGENT STEREO
  step_stereo_fan = slider42;
  step_keyboard_stereo = slider43;

  // MIDI Pitch Bend / Mod Wheel vibrato.
  step_bend_range_cents = slider44 * 100;
  step_vib_rate_hz = slider45;
  step_vib_depth_cents = slider46;
  pitch_bend_cents = pitch_bend_norm * step_bend_range_cents;
  // +/-12 semitones is calculated only at MIDI/slider event rate.
  pitch_bend_ratio = 2 ^ (pitch_bend_cents/1200);

  // Velocity-controlled body brightness.
  step_vel_tone_filter = slider47;
  step_vel_tone_on = step_vel_tone_filter > 0.0000001;

  // ------------------------------------------------------------
  // OPEN COURTYARD REVERB
  // ------------------------------------------------------------
  rev_mix = slider48;
  rev_mix_on = rev_mix > 0.0000001;

  // TRUE RT60 CONTROL IN MILLISECONDS.
  // The slider directly expresses RT60 in ms:
  // 1000 = 1 second, 6000 = 6 seconds, 10000 = 10 seconds.
  rev_rt60_ms = max(1, slider49);
  rev_rt60_sec = rev_rt60_ms * 0.001;

  rev_distance = slider50;
  rev_sky = slider51;
  rev_warmth = slider52;
  rev_width = slider53;
  rev_early_amount = slider54;
  rev_body_volume = slider55;
  rev_tail_tone = slider56;
  rev_tail_motion = slider57;

  // Distance 0..1 preserves the established sound exactly. The new 1..3
  // extension keeps stretching the physical reflection spacing, up to roughly
  // twice the old maximum early-reflection distance at value 3.
  rev_er_scale = 0.75 + 0.75*rev_distance;
  rev_tap1 = max(1, min(rev_buf_len-2, floor(srate * 0.022 * rev_er_scale)));
  rev_tap2 = max(1, min(rev_buf_len-2, floor(srate * 0.041 * rev_er_scale)));
  rev_tap3 = max(1, min(rev_buf_len-2, floor(srate * 0.077 * rev_er_scale)));
  rev_tap4 = max(1, min(rev_buf_len-2, floor(srate * 0.132 * rev_er_scale)));

  rev_late_scale = 0.85 + 0.45*rev_distance;

  // Eight deliberately irregular/incommensurate late delays.
  // The wider modal distribution prevents the long tail from revealing
  // one short repeating loop even when RT60 becomes extremely long.
  rev_d1_sec = 0.0437 * rev_late_scale;
  rev_d2_sec = 0.0509 * rev_late_scale;
  rev_d3_sec = 0.0593 * rev_late_scale;
  rev_d4_sec = 0.0689 * rev_late_scale;
  rev_d5_sec = 0.0797 * rev_late_scale;
  rev_d6_sec = 0.0923 * rev_late_scale;
  rev_d7_sec = 0.1061 * rev_late_scale;
  rev_d8_sec = 0.1217 * rev_late_scale;

  rev_d1 = max(1, min(rev_buf_len-2, floor(srate*rev_d1_sec)));
  rev_d2 = max(1, min(rev_buf_len-2, floor(srate*rev_d2_sec)));
  rev_d3 = max(1, min(rev_buf_len-2, floor(srate*rev_d3_sec)));
  rev_d4 = max(1, min(rev_buf_len-2, floor(srate*rev_d4_sec)));
  rev_d5 = max(1, min(rev_buf_len-2, floor(srate*rev_d5_sec)));
  rev_d6 = max(1, min(rev_buf_len-2, floor(srate*rev_d6_sec)));
  rev_d7 = max(1, min(rev_buf_len-2, floor(srate*rev_d7_sec)));
  rev_d8 = max(1, min(rev_buf_len-2, floor(srate*rev_d8_sec)));

  // Two short allpass diffusion stages per channel.
  rev_ap_scale = 0.85 + 0.30*rev_distance;
  rev_ap1L_d = max(1, min(rev_buf_len-2, floor(srate*0.0049*rev_ap_scale)));
  rev_ap1R_d = max(1, min(rev_buf_len-2, floor(srate*0.0067*rev_ap_scale)));
  rev_ap2L_d = max(1, min(rev_buf_len-2, floor(srate*0.0109*rev_ap_scale)));
  rev_ap2R_d = max(1, min(rev_buf_len-2, floor(srate*0.0137*rev_ap_scale)));

  // Open Sky changes echo-density formation through lossless allpasses only.
  // Closed courtyard = stronger diffusion; open sky = more discrete/airy.
  // Because these stages are allpass, they do NOT secretly shorten RT60.
  rev_ap1_g = 0.66 - 0.18*rev_sky;
  rev_ap2_g = 0.54 - 0.14*rev_sky;

  // ------------------------------------------------------------
  // TRUE RT60 PER DELAY LINE
  // ------------------------------------------------------------
  // Definition: at t = RT60 the low-frequency feedback amplitude is -60 dB,
  // i.e. 0.001 of the starting amplitude.
  //
  // Using milliseconds explicitly:
  //   g_i = exp( ln(0.001) * delay_ms_i / RT60_ms )
  //
  // This is the same as 10^(-3 * delay_seconds / RT60_seconds).
  // No extra Open-Sky multiplier is permitted here.
  rev_d1_ms = rev_d1_sec * 1000;
  rev_d2_ms = rev_d2_sec * 1000;
  rev_d3_ms = rev_d3_sec * 1000;
  rev_d4_ms = rev_d4_sec * 1000;
  rev_d5_ms = rev_d5_sec * 1000;
  rev_d6_ms = rev_d6_sec * 1000;
  rev_d7_ms = rev_d7_sec * 1000;
  rev_d8_ms = rev_d8_sec * 1000;

  rev_rt60_log = log(0.001) / rev_rt60_ms;
  rev_fb1 = exp(rev_rt60_log * rev_d1_ms);
  rev_fb2 = exp(rev_rt60_log * rev_d2_ms);
  rev_fb3 = exp(rev_rt60_log * rev_d3_ms);
  rev_fb4 = exp(rev_rt60_log * rev_d4_ms);
  rev_fb5 = exp(rev_rt60_log * rev_d5_ms);
  rev_fb6 = exp(rev_rt60_log * rev_d6_ms);
  rev_fb7 = exp(rev_rt60_log * rev_d7_ms);
  rev_fb8 = exp(rev_rt60_log * rev_d8_ms);

  // Wooden/stone air loss + centered Tail Tone.
  // Warmth remains the material character. Tail Tone controls how quickly
  // successive reflections move toward darkness.
  rev_send_fc_base = 16000 * (2 ^ (-1.40*rev_warmth));
  rev_damp_fc_base = 12000 * (2 ^ (-2.10*rev_warmth));

  rev_tail_tone < 0.5 ? (
    // DARK SIDE: much steeper. At 0.0 the late field closes dramatically.
    rev_tone_dark = (0.5-rev_tail_tone)*2;
    rev_tone_dark = rev_tone_dark*rev_tone_dark*(3-2*rev_tone_dark);
    rev_send_fc = rev_send_fc_base * (2 ^ (-2.10*rev_tone_dark));
    rev_damp_fc = rev_damp_fc_base * (2 ^ (-3.20*rev_tone_dark));
  ) : (
    // BRIGHT SIDE: open gradually toward air, but retain a real low-pass.
    // Therefore the tail still becomes darker over time, just more slowly.
    rev_tone_bright = (rev_tail_tone-0.5)*2;
    rev_tone_bright = rev_tone_bright*rev_tone_bright*(3-2*rev_tone_bright);

    rev_send_target = min(srate*0.43, 19500);
    rev_damp_target = min(srate*0.40, 17500);

    rev_send_fc = rev_send_fc_base
                + (rev_send_target-rev_send_fc_base)*rev_tone_bright;
    rev_damp_fc = rev_damp_fc_base
                + (rev_damp_target-rev_damp_fc_base)*rev_tone_bright;
  );

  rev_send_fc = max(250, rev_send_fc);
  rev_damp_fc = max(180, rev_damp_fc);
  rev_send_k = 1-exp(-twopi*min(srate*0.45,rev_send_fc)/srate);

  // Slightly different damping in each feedback line spreads modal decay
  // instead of letting all eight lines ring with the same spectral fingerprint.
  rev_damp_k1 = 1-exp(-twopi*min(srate*0.45,rev_damp_fc*0.88)/srate);
  rev_damp_k2 = 1-exp(-twopi*min(srate*0.45,rev_damp_fc*0.93)/srate);
  rev_damp_k3 = 1-exp(-twopi*min(srate*0.45,rev_damp_fc*0.97)/srate);
  rev_damp_k4 = 1-exp(-twopi*min(srate*0.45,rev_damp_fc*1.01)/srate);
  rev_damp_k5 = 1-exp(-twopi*min(srate*0.45,rev_damp_fc*1.04)/srate);
  rev_damp_k6 = 1-exp(-twopi*min(srate*0.45,rev_damp_fc*1.07)/srate);
  rev_damp_k7 = 1-exp(-twopi*min(srate*0.45,rev_damp_fc*1.10)/srate);
  rev_damp_k8 = 1-exp(-twopi*min(srate*0.45,rev_damp_fc*1.13)/srate);

  // Keep a center coefficient for the body-support filter calculations.
  rev_damp_k = 1-exp(-twopi*min(srate*0.45,rev_damp_fc)/srate);

  // Fixed low-frequency escape keeps the open courtyard from becoming boomy.
  rev_hp_k = 1-exp(-twopi*90/srate);

  // Rebalanced courtyard:
  // - Early Reflections are deliberately HALF the old 0.02 strength.
  // - The true FDN body is THREE TIMES the old late level at Body Volume = 1.
  // This makes Early=0 leave a strong, living reverberant body.
  rev_early_gain = rev_early_amount * (0.21 + 0.14*rev_sky);
  rev_late_gain = 0.62 * (1 - 0.55*rev_sky) * 3 * rev_body_volume;

  // Broad body-support band (~180 Hz .. 3 kHz), late field only.
  // Warmth gently lowers the upper edge so the tail stays wooden rather than harsh.
  rev_body_hi_fc = 3200 * (2 ^ (-0.45*rev_warmth));
  rev_body_lo_fc = 180;
  rev_body_hi_k = 1-exp(-twopi*min(srate*0.45,rev_body_hi_fc)/srate);
  rev_body_lo_k = 1-exp(-twopi*rev_body_lo_fc/srate);
  rev_body_support = 0.55 * rev_body_volume;

  // Width acts only on the wet side component. 0 = mono ambience.
  rev_width_gain = rev_width * 1.25;

  step_fan_on = abs(step_stereo_fan) > 0.0000001;
  step_keyboard_on = abs(step_keyboard_stereo) > 0.0000001;
  new_stereo_active = step_fan_on || step_keyboard_on;

  fan_low_hz = 180
             + 40*abs(step_fold_cycles)
             + 120*step_warp_rate
             + 60*step_wrap_density;
  fan_low_hz = max(180, min(1600, fan_low_hz));

  fan_high_hz = 1800
              + 90*abs(step_fold_depth)
              + 220*step_wrap_density
              + 250*step_carrier_ratio
              + 900*step_string_comb_amount;
  fan_high_hz = max(fan_low_hz+500, min(12000, fan_high_hz));

  fan_k1 = 1-exp(-2*$pi*fan_low_hz/srate);
  fan_k2 = 1-exp(-2*$pi*fan_high_hz/srate);
  fan_side_gain = step_stereo_fan * 0.72;

  stereo_oct_semi = slider8*12;
  stereo_fine_semi = slider9;

  mono_note >= 0 ? (
    calc_key_gains(mono_note);
    mono_key_gainL = key_tmpL;
    mono_key_gainR = key_tmpR;
  ) : (
    mono_key_gainL = 1;
    mono_key_gainR = 1;
  );

  i = 0;
  loop(6,
    v_note[i] >= 0 ? (
      calc_key_gains(v_note[i]);
      v_key_gainL[i] = key_tmpL;
      v_key_gainR[i] = key_tmpR;
    ) : (
      v_key_gainL[i] = 1;
      v_key_gainR[i] = 1;
    );
    i += 1;
  );

  new_stereo_active != stereo_active ? (
    i = 0;
    loop(7,
      fan_lp1[i] = 0;
      fan_lp2[i] = 0;
      i += 1;
    );
    aa1_x1 = aa1_x2 = aa1_y1 = aa1_y2 = 0;
    aa2_x1 = aa2_x2 = aa2_y1 = aa2_y2 = 0;
    aa1R_x1 = aa1R_x2 = aa1R_y1 = aa1R_y2 = 0;
    aa2R_x1 = aa2R_x2 = aa2R_y1 = aa2R_y2 = 0;
    dc_x_prev = dc_y_prev = 0;
    dc_xR_prev = dc_yR_prev = 0;
    glue_env = 0;
    glue_gain = 1;
  );
  stereo_active = new_stereo_active;
  pick_dark_mix = 1 - 0.35*step_pick_tone;
  pick_edge_mix = 0.18 + 0.82*step_pick_tone;
  pick_snap_mix = 0.55 + 0.85*step_pick_tone;

  // Audible plectrum transient.
  // The main scrape decays in ~7 ms; the earliest part is emphasized below
  // as a short mechanical "snap".
  // Tone maps exponentially: 0 = dark (~1.2 kHz), 1 = bright (~14 kHz).
  // A fixed 350 Hz subtraction prevents a low-frequency thump.
  pick_decay_k = exp(-1/(0.007*srate));
  pick_lp_hz = 1200 * ((14000/1200) ^ step_pick_tone);
  pick_lp_hz = min(pick_lp_hz, 0.44*srate);
  pick_lp_k = 1 - exp(-2*$pi*pick_lp_hz/srate);
  pick_dc_k = 1 - exp(-2*$pi*350/srate);

  // Any slider change can alter Warp Rate/Phase or routing assumptions.
  i = 0;
  loop(7,
    warp_rec_ready[i] = 0;
    warp_rec_count[i] = 0;
    i += 1;
  );

  // ------------------------------------------------------------
  // ADAPTIVE WAVEFORM DECIMATION FILTERS
  // ------------------------------------------------------------
  // Both filters cut at 0.45*srate (90% of host Nyquist), but are designed
  // at the actual virtual oscillator rate (2*srate or 4*srate).
  osc2_fc = 0.45*srate;
  osc2_k = tan($pi * osc2_fc / (2*srate));
  osc2_q = 0.707106781186548;
  osc2_n = 1 / (1 + osc2_k/osc2_q + osc2_k*osc2_k);
  osc2_b0 = osc2_k*osc2_k*osc2_n;
  osc2_b1 = 2*osc2_b0;
  osc2_b2 = osc2_b0;
  osc2_a1 = 2*(osc2_k*osc2_k - 1)*osc2_n;
  osc2_a2 = (1 - osc2_k/osc2_q + osc2_k*osc2_k)*osc2_n;

  osc4_fc = 0.45*srate;
  osc4_k = tan($pi * osc4_fc / (4*srate));
  osc4_q = 0.707106781186548;
  osc4_n = 1 / (1 + osc4_k/osc4_q + osc4_k*osc4_k);
  osc4_b0 = osc4_k*osc4_k*osc4_n;
  osc4_b1 = 2*osc4_b0;
  osc4_b2 = osc4_b0;
  osc4_a1 = 2*(osc4_k*osc4_k - 1)*osc4_n;
  osc4_a2 = (1 - osc4_k/osc4_q + osc4_k*osc4_k)*osc4_n;

  // ------------------------------------------------------------
  // POST-OSCILLATOR AA GUARD
  // ------------------------------------------------------------
  // Cutoff = 0.455*srate = 91% of Nyquist.
  // This is deliberately very high so the intentional Strings alias character
  // survives, while the post-oscillator domain does not carry unnecessary
  // near-Nyquist energy into the output.
  aa_fc = 0.455 * srate;
  aa_k = tan($pi * aa_fc / srate);

  aa_q1 = 0.541196100146197;
  aa_n1 = 1 / (1 + aa_k/aa_q1 + aa_k*aa_k);
  aa1_b0 = aa_k*aa_k*aa_n1;
  aa1_b1 = 2*aa1_b0;
  aa1_b2 = aa1_b0;
  aa1_a1 = 2*(aa_k*aa_k - 1)*aa_n1;
  aa1_a2 = (1 - aa_k/aa_q1 + aa_k*aa_k)*aa_n1;

  aa_q2 = 1.306562964876377;
  aa_n2 = 1 / (1 + aa_k/aa_q2 + aa_k*aa_k);
  aa2_b0 = aa_k*aa_k*aa_n2;
  aa2_b1 = 2*aa2_b0;
  aa2_b2 = aa2_b0;
  aa2_a1 = 2*(aa_k*aa_k - 1)*aa_n2;
  aa2_a2 = (1 - aa_k/aa_q2 + aa_k*aa_k)*aa_n2;

  // Velocity-only waveform/pick terms are cached outside @sample.
  mono_life_mod = step_life_on ? ((mono_vel-0.5)*2)*step_velocity_life3 : 0;
  mono_timbre_scale = step_attack_dynamic
                    ? step_velocity_timbre_base + step_velocity_timbre*mono_vel
                    : 1;
  mono_pick_gain = step_pick_level
                 * (pick_vel_base + step_pick_velocity*mono_vel) * 5.2;

  i = 0;
  loop(6,
    v_life_mod[i] = step_life_on ? ((v_vel[i]-0.5)*2)*step_velocity_life3 : 0;
    v_timbre_scale[i] = step_attack_dynamic
                      ? step_velocity_timbre_base + step_velocity_timbre*v_vel[i]
                      : 1;
    v_pick_gain[i] = step_pick_level
                   * (pick_vel_base + step_pick_velocity*v_vel[i]) * 5.2;
    i += 1;
  );

  // Retune currently held voices. Pitch-dependent OS is marked dirty once;
  // portamento work is enabled only if there is an actual frequency move.
  mono_note >= 0 ? (
    mono_target = note_hz(mono_note);
    !porta_enabled ? (
      mono_freq = mono_target;
      mono_glide = 0;
    ) : (
      mono_glide = abs(mono_target-mono_freq) > 0.000000000001;
    );
    mono_os_dirty = 1;
  );

  i = 0;
  loop(6,
    v_active[i] ? (
      v_target[i] = note_hz(v_note[i]);
      !porta_enabled ? (
        v_freq[i] = v_target[i];
        v_glide[i] = 0;
      ) : (
        v_glide[i] = abs(v_target[i]-v_freq[i]) > 0.000000000001;
      );
      v_os_dirty[i] = 1;
    );
    i += 1;
  );

  // Velocity Tone Filter coefficients are calculated only here / Note On.
  mono_note >= 0 && step_vel_tone_on
    ? vel_tone_k[6] = calc_vel_tone_k(mono_vel, mono_target)
    : vel_tone_k[6] = 1;

  i = 0;
  loop(6,
    v_active[i] && step_vel_tone_on
      ? vel_tone_k[i] = calc_vel_tone_k(v_vel[i], v_target[i])
      : vel_tone_k[i] = 1;
    i += 1;
  );

  // Opening the filter on a held note initializes from its next dry sample.
  step_vel_tone_on && !prev_vel_tone_on ? (
    i = 0;
    loop(7,
      vel_tone_ready[i] = 0;
      i += 1;
    );
  );
  !step_vel_tone_on ? (
    i = 0;
    loop(7,
      vel_tone_ready[i] = 0;
      i += 1;
    );
  );
  prev_vel_tone_on = step_vel_tone_on;

  // A bend-range edit changes the real pitch of every held voice.
  mono_os_dirty = 1;
  i = 0;
  loop(6,
    v_active[i] ? v_os_dirty[i] = 1;
    i += 1;
  );

  // Changing voice architecture is intentionally a clean reset.
  mode != last_mode ? (
    i = 0;
    loop(6,
      v_active[i] = 0;
      v_stage[i] = 0;
      v_env[i] = 0;
      v_exc[i] = 0;
      v_tension[i] = 0;
      v_finger[i] = 0;
      v_finger_stage[i] = 0;
      v_finger_vel[i] = 0;
      v_pick_env[i] = 0;
      v_pick_lp[i] = 0;
      v_pick_dc[i] = 0;
      v_os[i] = 1;
      v_glide[i] = 0;
      v_os_dirty[i] = 1;
      v_life_mod[i] = 0;
      v_timbre_scale[i] = 1;
      v_phase_step[i] = 0;
      v_pick_gain[i] = 0;
      osc_reset(i);
      i += 1;
    );
    i = 0;
    loop(128,
      held_state[i] = 0;
      held_order[i] = 0;
      i += 1;
    );
    mono_stage = 0;
    mono_env = 0;
    mono_exc = 0;
    mono_tension = 0;
    mono_finger = 0;
    mono_finger_stage = 0;
    mono_finger_vel = 0;
    mono_pick_env = 0;
    mono_pick_lp = 0;
    mono_pick_dc = 0;
    mono_pick_gain = 0;
    mono_os = 1;
    mono_glide = 0;
    mono_os_dirty = 1;
    mono_life_mod = 0;
    mono_timbre_scale = 1;
    mono_phase_step = 0;
    mono_key_gainL = 1;
    mono_key_gainR = 1;
    i = 0;
    loop(7,
      fan_lp1[i] = 0;
      fan_lp2[i] = 0;
      i += 1;
    );
    osc_reset(6);
    mono_note = -1;
    held_count = 0;
    strings_sustain_pedal = 0;
    poly_active_count = 0;
    output_tail_count = 0;
    output_sleep = 0;
    last_mode = mode;
  );

// ============================================================
// ORGAN ENGINE PARAMETER CACHE — ORGAN ONLY
// ============================================================
org_master_gain_lin = 2^(slider59/6.020599913);

// Recalculate sample-rate-dependent signature constants here as well.
// This keeps the output stage correct if REAPER changes project sample rate.
org_dc_coeff_5hz = exp(-2 * $pi * 5 / srate);
org_glue_att_inv = 1 / max(1, (0.001 * srate));
org_glue_rel_inv = 1 / max(1, (0.004 * srate));
org_tune_mult = 2^(slider60 + slider61/12);
org_velocity_amount = slider64;

org_attack_inc = slider62 <= 0 ? 1 : min(1, 1/(slider62*0.001*srate));
org_release_coef = slider63 <= 0 ? 0 : exp(log(0.000001)/(slider63*0.001*srate));
org_click_coef = exp(log(0.00001)/(max(1,slider80)*0.001*srate));
org_perc_coef = exp(log(0.00001)/(max(1,slider83)*0.001*srate));

org_wave1 = slider65;
org_wave3 = slider66;
org_wave5 = slider67;
org_wave7 = slider68;
org_shape_need3 = abs(org_wave3) + abs(org_wave5) + abs(org_wave7) > 0.0000001;
org_shape_need5 = abs(org_wave5) + abs(org_wave7) > 0.0000001;
org_shape_need7 = abs(org_wave7) > 0.0000001;
org_wave_abs_sum = abs(org_wave1)+abs(org_wave3)+abs(org_wave5)+abs(org_wave7);
org_wave_norm = slider69 ? 1/max(1,org_wave_abs_sum) : 1;

// Drawbar ratios relative to the played 8' fundamental:
// 16'=0.5, 5 1/3'=1.5, 8'=1, 4'=2, 2 2/3'=3,
// 2'=4, 1 3/5'=5, 1 1/3'=6, 1'=8.
org_d16  = slider70/8;
org_d513 = slider71/8;
org_d8   = slider72/8;
org_d4   = slider73/8;
org_d223 = slider74/8;
org_d2   = slider75/8;
org_d135 = slider76/8;
org_d113 = slider77/8;
org_d1   = slider78/8;

org_draw_energy = org_d16*org_d16+org_d513*org_d513+org_d8*org_d8+org_d4*org_d4+org_d223*org_d223+org_d2*org_d2+org_d135*org_d135+org_d113*org_d113+org_d1*org_d1;
org_draw_norm = 1/sqrt(max(1,org_draw_energy));

// Three tonewheel families let the drawbar pitches move very slightly relative
// to one another while keeping the efficient harmonic recurrence architecture.
//
// Group A: 16', 4', 1 3/5'
// Group B: 5 1/3', 2 2/3', 1 1/3'
// Group C: 8', 2', 1' + key click / percussion
org_max_a = 0;
org_d16  > 0.000001 ? org_max_a = max(org_max_a,1);
org_d4   > 0.000001 ? org_max_a = max(org_max_a,4);
org_d135 > 0.000001 ? org_max_a = max(org_max_a,10);

org_max_b = 0;
org_d513 > 0.000001 ? org_max_b = max(org_max_b,3);
org_d223 > 0.000001 ? org_max_b = max(org_max_b,6);
org_d113 > 0.000001 ? org_max_b = max(org_max_b,12);

org_max_c = 0;
org_d8   > 0.000001 ? org_max_c = max(org_max_c,2);
org_d2   > 0.000001 ? org_max_c = max(org_max_c,8);
org_d1   > 0.000001 ? org_max_c = max(org_max_c,16);
slider79 > 0.000001 ? org_max_c = max(org_max_c,12); // 6th harmonic click
slider81 == 1 ? org_max_c = max(org_max_c,4);        // 2nd harmonic percussion
slider81 == 2 ? org_max_c = max(org_max_c,6);        // 3rd harmonic percussion

org_wheel_inc = org_TWO_PI*slider85/srate;
org_vib_inc = org_TWO_PI*slider87/srate;
org_autopan_inc = org_TWO_PI*slider90/srate;

// OTARI-inspired tape controls.
// Local 2x processing is used only inside the nonlinear magnetic block.
org_tape_on = slider92 >= 0.5;
org_tape_drive = 2^(slider93/6.020599913);
org_tape_drive_comp = 1/sqrt(max(1, org_tape_drive));

// Calibrated wetness for the magnetic nonlinearity.
// Drive 0 dB is intentionally almost clean: only 1.5% magnetic coloration.
// The curve opens progressively so higher Drive values still reach the full
// stateful saturation/hysteresis model.
org_tape_drive_norm = min(1, max(0, slider93/18));
org_tape_sat_mix = 0.015 + 0.985 * pow(org_tape_drive_norm, 1.6);

org_tape_hyst = slider94*0.01;
org_tape_bump_amt = slider95*0.01;
org_tape_speed15 = slider96 >= 0.5;
org_tape_motion_amt = slider97*0.01;

org_tape_pre_hz = 3200;
org_tape_pre_alpha = 1 - exp(-2*$pi*org_tape_pre_hz/(2*srate));
org_tape_pre_emph = 0.18 + 0.32*org_tape_hyst;

// Higher tape speed keeps more top end.  The source Otari specifications are
// 30 Hz–20 kHz at 15 ips and 30 Hz–18 kHz at 7.5 ips.
org_tape_play_hz = org_tape_speed15 ? 20000 : 18000;
org_tape_play_hz = min(org_tape_play_hz, 0.45*srate);
org_tape_play_alpha = 1 - exp(-2*$pi*org_tape_play_hz/(2*srate));

// Compact hysteretic memory.  More Hysteresis means stronger minor-loop memory
// and a slower magnetization state, but remains fast enough for audio.
org_tape_mem_fb = 0.035 + 0.30*org_tape_hyst;
org_tape_mem_mix = 0.04 + 0.32*org_tape_hyst;
org_tape_mag_follow = 0.92 - 0.42*org_tape_hyst;

// Head-contour resonance.  This is a musical head-bump model, not a measured
// MX-5050 transfer curve.
org_tape_bump_hz = org_tape_speed15 ? 90 : 55;
org_tape_bump_f = 2*sin($pi*org_tape_bump_hz/srate);
org_tape_bump_damp = 1.15;

// The official MX-5050 wow/flutter limits are lower at 15 ips than 7.5 ips.
// Use that ratio only as a transport scaling reference; the top of our Motion
// control intentionally extends far beyond the real machine for synthesis.
org_tape_speed_motion = org_tape_speed15 ? 1 : (0.08/0.06);

// Gentle high-pass for the *Otari residual only*.
// Resonance is intentionally constrained to a mild musical range:
// Q ~= 0.707 at 0%, rising only to about 1.05 at 100%.
org_grain_hp_hz = min(800, max(20, slider98));
org_grain_hp_res = min(1, max(0, slider99*0.01));
org_grain_hp_Q = 0.70710678 + 0.34289322*org_grain_hp_res;
org_grain_hp_damp = 1/max(0.001, org_grain_hp_Q);
org_grain_hp_f = 2*sin($pi*org_grain_hp_hz/srate);

org_tape_on != org_tape_prev_on ? (
  org_tape_prev_on = org_tape_on;
  org_tape_prev_inL = 0;
  org_tape_prev_inR = 0;
  org_tape_preL = org_tape_preR = 0;
  org_tape_magL = org_tape_magR = 0;
  org_tape_playL = org_tape_playR = 0;
  org_tape_bump_lpL = org_tape_bump_bpL = 0;
  org_tape_bump_lpR = org_tape_bump_bpR = 0;
  org_grain_hp_lpL = org_grain_hp_bpL = 0;
  org_grain_hp_lpR = org_grain_hp_bpR = 0;
  org_tape_w = 0;
  org_i=0;
  loop(org_TAPE_BUF_SIZE,
    org_TAPE_BUF_L[org_i] = 0;
    org_TAPE_BUF_R[org_i] = 0;
    org_i += 1;
  );
);



// ============================================================
// RHODES PARAMETER MAP — slider100..136
// ============================================================

rh_master_gain = 2^(slider100/6.020599913);

rh_octave_semi = slider101*12;
rh_fine_semi = slider102;
rh_bend_range = slider103;
rh_pitch_bend_semi = rh_pitch_bend_norm*rh_bend_range;

rh_velocity_amount = slider104;
rh_velocity_curve = slider105;
rh_hammer_level = slider106;
rh_hammer_hardness = slider107;
rh_hammer_keytrack = slider108;
rh_hammer_strike = slider109;

rh_tine_decay = slider110;
rh_decay_keytrack = slider111;
rh_tine_fund_level = slider112;
rh_tine_mode1_level = slider113;
rh_tine_mode2_level = slider114;
rh_tine_mode3_level = slider115;
// Tine Overtone Level Key Follow:
// 0 = no keyboard compensation.
// 1 = up to -30 dB at A0, with C4 and above exactly unchanged.
// User-listening Init: 0.18.
rh_overtone_level_keyfollow = slider116;

// Tine Overtone Decay:
// 0.12 is the musical pivot found in testing.
// Above 0.12 the old response is preserved exactly.
// Below 0.12 the control becomes logarithmic/compressed instead of collapsing
// the high modes too abruptly. Slider minimum 0.03 maps internally to 0.055.
rh_ot_slider = slider117;
rh_ot_slider >= 0.12 ? (
  rh_overtone_decay = rh_ot_slider;
) : (
  rh_ot_t = max(0,min(1,(rh_ot_slider-0.03)/(0.12-0.03)));
  rh_overtone_decay = 0.055 * exp(log(0.12/0.055)*rh_ot_t);
);

rh_overtone_stretch = slider118;

rh_tonebar_level = slider119;
rh_tonebar_coupling = slider120;
rh_tonebar_detune = slider121;
rh_tonebar_decay = slider122;

rh_pickup_distance_mm = slider123;
rh_pickup_offset_mm = slider124;
rh_pickup_nonlin = slider125;
rh_pickup_bark_velocity = slider126;
rh_pickup_tone_hz = slider127;
rh_pickup_level = slider128;

// TEST2: exact Rhodes hot-loop constants. None of these depend on the current sample.
// Recompute only when their sliders change; rh_rh_recalc_all() below refreshes the
// per-voice velocity/frequency caches for notes that are already sounding.
rh_tonebar_blend_cached = 0.28*(rh_tonebar_coupling*rh_tonebar_coupling);
rh_tonebar_direct_gain_cached = rh_tonebar_level*0.85;
rh_bar_audibility_cached = max(rh_tonebar_direct_gain_cached,rh_tonebar_blend_cached);

rh_pickup_gap_cached = max(0.20,rh_pickup_distance_mm);
rh_pickup_pole_base_cached = rh_pickup_gap_cached-rh_pickup_offset_mm;
rh_pickup_rest_d_cached = max(0.12,rh_pickup_pole_base_cached);
rh_pickup_rest_flux_cached = 1/(rh_pickup_rest_d_cached*rh_pickup_rest_d_cached);
rh_pickup_flux_scale_cached = rh_pickup_rest_d_cached*rh_pickup_rest_d_cached
                            * rh_pickup_rest_d_cached*0.5;
rh_pickup_dist_gain_cached = 1/(0.80 + rh_pickup_gap_cached*0.20);
rh_pickup_motion_base = 0.020 + 0.115*rh_pickup_nonlin;

rh_damper_ms = slider129;

// Mechanical Noise controls are retained by name for parameter compatibility,
// but the DSP is now a deterministic modal ACTION model, not filtered noise.
// Level uses a smooth perceptual curve: subtle at the default, strong at 1.0.
rh_mech_noise_level = slider130;
rh_mech_action_gain = 1.56 * (rh_mech_noise_level^1.35); // x3 vs 0.08

rh_mech_noise_tone = slider131;

rh_autopan_rate = slider132;
rh_autopan_depth = slider133;
rh_ap_w = rh_twopi*rh_autopan_rate/srate;
rh_ap_rot_c = cos(rh_ap_w);
rh_ap_rot_s = sin(rh_ap_w);

rh_sat_drive = 2^(slider134/6.020599913);
rh_sat_hp_hz = slider135;
rh_sat_mix = slider136;

// Pickup tone coefficient is now per voice, calculated in rh_voice_recalc().
// Mechanical Tone is used at Note On to tune the three action resonators.
// No realtime noise filter is required anymore.

rh_sat_hp_k = 1-exp(-rh_twopi*min(srate*0.45,rh_sat_hp_hz)/srate);

// Retune active voices without retriggering them.
rh_rh_recalc_all();




// ============================================================
// WURLITZER PARAMETER MAP — slider137..168
// ============================================================

wz_master_gain = 2^(slider137/6.020599913);

wz_octave_semi = slider138*12;
wz_fine_semi = slider139;
wz_bend_range = slider140;
wz_pitch_bend_semi = wz_pitch_bend_norm*wz_bend_range;

wz_velocity_amount = slider141;
wz_velocity_curve = slider142;
wz_hammer_level = slider143;
wz_hammer_hardness = slider144;
wz_hammer_keytrack = slider145;

wz_reed_decay = slider146;
wz_reed_decay_keytrack = slider147;
wz_reed_level = slider148;
wz_reed_excursion_mm = slider149;
wz_reed_dynamic_stiffness = slider150;

wz_pickup_gap_mm = slider151;
wz_pickup_position_mm = slider152;
wz_pickup_symmetry = slider153;
wz_pickup_nonlin = slider154;
wz_pickup_bite_velocity = slider155;
wz_pickup_tone_hz = slider156;
wz_pickup_level = slider157;

// Static Wurlitzer pickup geometry cache. The old pickup function rebuilt these
// exact terms once per voice/sample even though they only change with sliders.
wz_pickup_g = max(0.20,wz_pickup_gap_mm);
wz_pickup_pos = wz_pickup_position_mm;
wz_pickup_rest1 = max(0.10,wz_pickup_g-wz_pickup_pos);
wz_pickup_rest2 = max(0.10,wz_pickup_g+wz_pickup_pos);
wz_pickup_rest = 1/wz_pickup_rest1 + wz_pickup_symmetry/wz_pickup_rest2;
wz_pickup_geom_scale = 0.5*wz_pickup_g*wz_pickup_g;
wz_pickup_lin_scale = 1/max(0.04,wz_pickup_g*wz_pickup_g);

wz_damper_ms = slider158;

// Parameter names remain for compatibility, but this is now modal action,
// not filtered random noise.
wz_mech_noise_level = slider159;
wz_mech_action_gain = 1.10*(wz_mech_noise_level^1.30);
wz_mech_noise_tone = slider160;

wz_tremolo_rate = slider161;
wz_tremolo_depth = slider162;
wz_tremolo_trigger = slider163|0;
wz_tr_w = wz_twopi*wz_tremolo_rate/srate;
wz_tr_rot_c = cos(wz_tr_w);
wz_tr_rot_s = sin(wz_tr_w);

wz_autopan_rate = slider164;
wz_autopan_depth = slider165;
wz_ap_w = wz_twopi*wz_autopan_rate/srate;
wz_ap_rot_c = cos(wz_ap_w);
wz_ap_rot_s = sin(wz_ap_w);

wz_sat_drive = 2^(slider166/6.020599913);
wz_sat_hp_hz = slider167;
wz_sat_mix = slider168;

// Pickup Tone is calculated per voice in wz_voice_recalc().
// Mechanical Tone tunes the action modes at Note On.
wz_sat_hp_k = 1-exp(-wz_twopi*min(srate*0.45,wz_sat_hp_hz)/srate);

wz_wz_recalc_all();




// ============================================================
// MALLET FAMILY PARAMETER MAP + PER-INSTRUMENT MEMORY
// ============================================================
// ============================================================
// PER-INSTRUMENT MEMORY
// ============================================================
ml_mal_new_inst=max(0,min(5,floor(slider170+0.5)));

ml_mal_bank_ready ? (
  ml_mal_now_changed=ml_mal_live_changed();

  ml_mal_new_inst!=ml_mal_bank_prev ? (
    ml_mal_now_changed ? (
      // Project/preset restore: visible values belong to the newly restored Instrument.
      ml_mal_bank_capture(ml_mal_new_inst);
    ) : (
      // Normal Instrument switch: save old Current Bank, recall new Current Bank.
      ml_mal_bank_capture(ml_mal_bank_prev);
      ml_mal_bank_load(ml_mal_new_inst);
      ml_mal_notify_live();
    );
    ml_mal_bank_prev=ml_mal_new_inst;
  ) : ml_mal_now_changed ? (
    // Ordinary edit: keep current Instrument bank continuously updated.
    ml_mal_bank_capture(ml_mal_new_inst);
  );

  ml_mal_snapshot_live();
);

// An Engine switch already refreshes these controls in the switch block below.
// A Mallet-Instrument-only switch does not enter that block, so notify REAPER
// here after recalling its independent reverb Current bank.
engine_reverb_changed && engine_now == engine_prev ? rev_notify_live();
engine_delay_changed && engine_now == engine_prev ? dt_notify_live();

ml_master_gain=2^(slider169/6.020599913);
ml_instrument=floor(slider170+0.5);

ml_octave_semi=slider171*12;
ml_fine_semi=slider172;
ml_bend_range=slider173;
ml_pitch_bend_semi=ml_pitch_bend_norm*ml_bend_range;

ml_velocity_amount=slider174;
ml_velocity_curve=slider175;

ml_strike_level=slider176;
ml_mallet_hardness=slider177;
ml_mallet_weight=slider178;
ml_mallet_position=slider179;

ml_bar_tone=slider180;
ml_bar_brightness=slider181;
ml_bar_complexity=slider182;
ml_bar_decay=slider183;
ml_high_decay=slider184;

ml_resonator_level=slider185;
ml_resonator_depth=slider186;
ml_resonator_coupling=slider187;
ml_damper_ms=slider188;

ml_velocity_tone=slider189;
ml_velocity_attack=slider190;

ml_motor_rate=slider191;
ml_motor_depth=slider192;

ml_keyboard_stereo=slider193;

ml_sat_drive=2^(slider194/6.020599913);
ml_sat_hp_hz=slider195;
ml_sat_mix=slider196;
ml_sat_hp_k=1-exp(-ml_twopi*min(srate*0.45,ml_sat_hp_hz)/srate);

ml_autopan_rate=slider197;
ml_autopan_depth=slider198;
ml_ap_w=ml_twopi*ml_autopan_rate/srate;
ml_ap_rot_c=cos(ml_ap_w);
ml_ap_rot_s=sin(ml_ap_w);

ml_mal_inst_config();
ml_mal_recalc_all();

// ============================================================
// WIND FAMILY PARAMETER CACHE + PER-INSTRUMENT MEMORY
// ============================================================
// ============================================================
// PER-INSTRUMENT MEMORY
// ============================================================
wi_win_new_inst=max(0,min(5,floor(slider214+0.5)));
wi_win_inst_switched=0;

wi_win_bank_ready ? (
  wi_win_now_changed=wi_win_live_changed();
  wi_win_new_inst!=wi_win_bank_prev ? (
    wi_win_now_changed ? (
      // Project/preset restore: visible values belong to restored Instrument.
      wi_win_bank_capture(wi_win_new_inst);
    ) : (
      // Normal switch: preserve old Current Bank and recall new one.
      wi_win_bank_capture(wi_win_bank_prev);
      wi_win_bank_load(wi_win_new_inst);
      wi_win_notify_live();
    );
    wi_win_bank_prev=wi_win_new_inst;
    wi_win_inst_switched=1;
  ) : wi_win_now_changed ? wi_win_bank_capture(wi_win_new_inst);
  wi_win_snapshot_live();
);

wi_master_gain=2^(slider213/6.020599913);
wi_instrument=floor(slider214+0.5);
wi_voice_mode=max(0,min(2,floor(slider240+0.5)));
wi_win_mode_switched=wi_voice_mode!=wi_win_prev_voice_mode;
wi_win_prev_voice_mode=wi_voice_mode;

wi_octave_semi=slider215*12;
wi_fine_semi=slider216;
wi_bend_range=slider217;
wi_pitch_bend_semi=wi_pitch_bend_norm*wi_bend_range;

wi_velocity_amount=slider218;
wi_velocity_curve=slider219;
wi_breath_pressure=slider220;
wi_breath_noise=slider221;
wi_breath_color_hz=slider222;
wi_breath_attack_ms=slider223;
wi_breath_release_ms=slider224;
wi_jet_ratio=slider225;
wi_jet_drive=slider226;
wi_embouchure=slider227;
wi_edge_bias=slider228;
wi_bore_tone=slider229;
wi_bore_resonance=slider230;
wi_bore_harmonics=slider231;
wi_overblow=slider232;
wi_air_body=slider233;
wi_key_noise=slider234;
wi_key_noise_tone_hz=slider235;
wi_vibrato_rate=slider236;
wi_vibrato_depth_cents=slider237;
wi_vibrato_delay_ms=slider238;
wi_vibrato_pressure=slider239;

wi_win_inst_config();

wi_breath_lp_k=1-exp(-wi_twopi*min(srate*0.45,wi_breath_color_hz)/srate);
wi_key_lp_k=1-exp(-wi_twopi*min(srate*0.45,wi_key_noise_tone_hz)/srate);
wi_ref_fc=350+15000*(wi_bore_tone^1.7);
wi_ref_lp_k=1-exp(-wi_twopi*min(srate*0.45,wi_ref_fc)/srate);
wi_body_lp_k=1-exp(-wi_twopi*min(srate*0.45,wi_inst_body_fc)/srate);
wi_key_env_decay=exp(-1/max(1,0.018*srate));
// Hidden attack ignition assist. A short air pulse makes the nonlinear
// waveguide lock reliably even at medium/low velocity, without raising the
// sustained breath level. Tau 28 ms: enough to bridge normal flute attacks,
// then it disappears completely.
wi_ignite_decay=exp(-1/max(1,0.028*srate));
// Once breath reaches zero, residual waveguide feedback is forced to decay.
// The breath-release slider still controls the musical release; this only
// prevents the physical loop from settling into a self-sustaining limit cycle.
wi_release_tail_decay=exp(-1/max(1,0.050*srate));
// Fingering transition: ~4 ms acoustic tube-length slew. Fast enough to avoid
// audible portamento, slow enough to remove the metallic discontinuity caused
// by jumping the fractional delay tap in one sample.
wi_legato_tube_k=1-exp(-1/max(1,0.004*srate));

wi_jet_reflection=max(0.08,min(0.92,0.22+0.62*wi_embouchure+wi_inst_reflect_bias));
wi_end_reflection=max(0.10,min(0.94,0.30+0.60*wi_bore_resonance));

(wi_win_inst_switched || wi_win_mode_switched) ? wi_win_reset_voices();
wi_win_recalc_all();

// ------------------------------------------------------------
// MICRO SYNTH CACHE — sliders 241..256
// ------------------------------------------------------------
ms_master_gain=2^(slider241/6.020599913);
ms_wave_sel=floor(slider242+0.5);
ms_atk_s=max(0.001,slider243);
ms_dec_s=max(0.001,slider244);
ms_sus=ms_clamp(slider245,0,1);
ms_rel_s=max(0.001,slider246);
ms_filter_env_amt=slider247;
ms_pw_base=0.5;
ms_porta_s=max(0,slider248);
ms_voice_mode=floor(slider249+0.5);
ms_detune_c=slider250;
ms_cutoff_min=20;
ms_cutoff_max=min(6000,srate*0.45);
ms_cutoff_pos=ms_clamp(slider251,0,1);
ms_cutoff_base=ms_cutoff_min*(ms_cutoff_max/ms_cutoff_min)^ms_cutoff_pos;
ms_res_amt=ms_clamp(slider252,0,1);
ms_lfo_rate=slider253;
ms_lfo_wave=floor(slider254+0.5);
ms_lfo_cut_depth=slider255;
ms_lfo_pwm_depth=slider256;
ms_atk_inc=1/(ms_atk_s*srate);
ms_dec_coef=exp(-1/(ms_dec_s*srate));
ms_rel_coef=exp(-1/(ms_rel_s*srate));
ms_porta_s<=0 ? ms_porta_coef=0 : ms_porta_coef=exp(-1/(max(0.001,ms_porta_s)*srate));

// ------------------------------------------------------------
// ENGINE SWITCH — engines never touch one another's DSP state.
// Shared reverb is intentionally NOT cleared; its acoustic tail may continue.
// ------------------------------------------------------------
engine_now = slider58;
engine_now != engine_prev ? (
  // Kill Strings notes/voices only.
  mono_stage = 0;
  mono_env = 0;
  mono_note = -1;
  mono_pick_env = 0;
  mono_finger_stage = 0;
  held_count = 0;
  strings_sustain_pedal = 0;
  evt_count = 0;

  i = 0;
  loop(128,
    held_state[i] = 0;
    held_order[i] = 0;
    i += 1;
  );

  i = 0;
  loop(6,
    v_active[i] = 0;
    v_stage[i] = 0;
    v_env[i] = 0;
    v_note[i] = -1;
    v_pick_env[i] = 0;
    v_finger_stage[i] = 0;
    i += 1;
  );

  // Kill Organ notes/voices only.
  org_sustain_pedal = 0;
  memset(org_KEYHELD,0,128);
  org_i = 0;
  loop(8,
    org_VNOTE[org_i] = -1;
    org_VSTAGE[org_i] = 0;
    org_VENV[org_i] = 0;
    org_VCLICK[org_i] = 0;
    org_VPERC[org_i] = 0;
    org_i += 1;
  );

  // Kill Rhodes voices/state only.
  rh_active_count = 0;
  rh_sustain_pedal = 0;
  rh_i = 0;
  loop(12,
    rh_VACTIVE[rh_i] = 0;
    rh_VGATE[rh_i] = 0;
    rh_VDAMPED[rh_i] = 0;
    rh_VQUIET[rh_i] = 0;
    rh_VPKLP1[rh_i] = 0;
    rh_VPKLP2[rh_i] = 0;
    rh_KEYHELD[rh_i] = 0;
    rh_i += 1;
  );
  rh_i = 12;
  loop(116,
    rh_KEYHELD[rh_i] = 0;
    rh_i += 1;
  );
  rh_sat_low = 0;
  rh_dc_x1L = rh_dc_y1L = rh_dc_x1R = rh_dc_y1R = 0;
  rh_glue_env = 0;

  // Kill Wurlitzer voices/state only.
  wz_active_count = 0;
  wz_sustain_pedal = 0;
  wz_i = 0;
  loop(12,
    wz_VACTIVE[wz_i] = 0;
    wz_VGATE[wz_i] = 0;
    wz_VDAMPED[wz_i] = 0;
    wz_VQUIET[wz_i] = 0;
    wz_VPKLP1[wz_i] = 0;
    wz_VPKLP2[wz_i] = 0;
    wz_KEYHELD[wz_i] = 0;
    wz_i += 1;
  );
  wz_i = 12;
  loop(116,
    wz_KEYHELD[wz_i] = 0;
    wz_i += 1;
  );
  wz_sat_low = 0;
  wz_dc_x1L = wz_dc_y1L = wz_dc_x1R = wz_dc_y1R = 0;
  wz_glue_env = 0;

  // Kill Mallet voices/state only. Per-instrument parameter banks are NOT touched.
  ml_active_count = 0;
  ml_sustain_pedal = 0;
  ml_i = 0;
  loop(12,
    ml_VACTIVE[ml_i] = 0;
    ml_VGATE[ml_i] = 0;
    ml_VDAMPED[ml_i] = 0;
    ml_VQUIET[ml_i] = 0;
    ml_i += 1;
  );
  ml_i = 0;
  loop(128,
    ml_KEYHELD[ml_i] = 0;
    ml_i += 1;
  );
  ml_sat_lowL = ml_sat_lowR = 0;
  ml_dc_x1L = ml_dc_y1L = ml_dc_x1R = ml_dc_y1R = 0;
  ml_glue_env = 0;
  ml_motor_phase = 0;
  ml_ap_sin = 0;
  ml_ap_cos = 1;

  // Kill Wind voices/waveguide state only. Six parameter Current Banks persist.
  wi_win_reset_voices();
  wi_sustain_pedal=0;
  wi_modwheel=0;
  wi_aftertouch=0;
  wi_pitch_bend_norm=0;
  wi_pitch_bend_semi=0;
  wi_vib_phase=0;
  wi_dc_x1L=wi_dc_y1L=wi_dc_x1R=wi_dc_y1R=0;
  wi_glue_env=0;

  // Kill Micro Synth mono state only.
  ms_reset_voice();

  spl0 = 0;
  spl1 = 0;
  engine_prev = engine_now;

  // Refresh shared-effect controls after CURRENT-bank recall.
  // No Master or engine-specific synth slider is touched.
  engine_reverb_changed ? rev_notify_live();
  engine_delay_changed ? dt_notify_live();
);

@block

engine_now = slider58;
// Engine isolation rule:
// 0 Rhodes, 1 Wurlitzer, 2 Organ, 3 Strings, 4 Mallet, 5 Wind, 6 Micro Synth.
// Only the selected engine consumes MIDI/runs block-rate synth work.
// Mallet and Wind each select one of six internal instruments; Micro Synth is one compact mono engine.
// Shared Compact Dual Tape Delay and Reverb run after the selected-engine output; both effects recall the Current bank of the active engine/internal instrument, and slider210 controls how strongly delayed repeats excite Reverb.
engine_now < 0.5 ? (

// Laboratory MIDI path: direct official midirecv() handling.
// Event offsets are intentionally ignored in this validation build.
while(midirecv(rh_midi_ofs,rh_midi_msg1,rh_midi_msg23)) (
  rh_midi_status = rh_midi_msg1 & $xF0;
  rh_midi_d1 = rh_midi_msg23 & $x7F;
  rh_midi_d2 = (rh_midi_msg23 >> 8) & $x7F;

  rh_midi_status == $x90 ? (
    rh_midi_d2 > 0 ? (
      rh_KEYHELD[rh_midi_d1] = 1;
      rh_rh_note_on(rh_midi_d1,rh_midi_d2);
    ) : (
      rh_KEYHELD[rh_midi_d1] = 0;
      rh_rh_note_off(rh_midi_d1);
    );
  ) :
  rh_midi_status == $x80 ? (
    rh_KEYHELD[rh_midi_d1] = 0;
    rh_rh_note_off(rh_midi_d1);
  ) :
  rh_midi_status == $xB0 && rh_midi_d1 == 64 ? (
    rh_new_sus = rh_midi_d2 >= 64;
    rh_sustain_pedal && !rh_new_sus ? (
      rh_sustain_pedal = 0;
      rh_rh_release_pedal();
    ) : (
      rh_sustain_pedal = rh_new_sus;
    );
  ) :
  rh_midi_status == $xE0 ? (
    rh_bend14 = rh_midi_d1 + (rh_midi_d2<<7);
    rh_pitch_bend_norm = (rh_bend14-8192)/8192;
    rh_pitch_bend_semi = rh_pitch_bend_norm*rh_bend_range;
    rh_rh_recalc_all();
  );
);

rh_sample_in_block = 0;


) : engine_now < 1.5 ? (

// Robust laboratory MIDI path.
// Direct midirecv() handling avoids the fragile custom event queue while
// the physical engine is being voiced.
while(midirecv(wz_midi_ofs,wz_midi_msg1,wz_midi_msg23)) (
  wz_midi_status=wz_midi_msg1 & $xF0;
  wz_midi_d1=wz_midi_msg23 & $x7F;
  wz_midi_d2=(wz_midi_msg23>>8) & $x7F;

  wz_midi_status==$x90 ? (
    wz_midi_d2>0 ? (
      wz_KEYHELD[wz_midi_d1]=1;
      wz_wz_note_on(wz_midi_d1,wz_midi_d2);
    ) : (
      wz_KEYHELD[wz_midi_d1]=0;
      wz_wz_note_off(wz_midi_d1);
    );
  ) :
  wz_midi_status==$x80 ? (
    wz_KEYHELD[wz_midi_d1]=0;
    wz_wz_note_off(wz_midi_d1);
  ) :
  wz_midi_status==$xB0 && wz_midi_d1==64 ? (
    wz_new_sus=wz_midi_d2>=64;
    wz_sustain_pedal && !wz_new_sus ? (
      wz_sustain_pedal=0;
      wz_wz_release_pedal();
    ) : (
      wz_sustain_pedal=wz_new_sus;
    );
  ) :
  wz_midi_status==$xE0 ? (
    wz_bend14=wz_midi_d1+(wz_midi_d2<<7);
    wz_pitch_bend_norm=(wz_bend14-8192)/8192;
    wz_pitch_bend_semi=wz_pitch_bend_norm*wz_bend_range;
    wz_wz_recalc_all();
  );
);

wz_sample_in_block=0;


) : engine_now < 2.5 ? (
  while(midirecv(org_offset,org_msg1,org_msg23)) (
    org_status = org_msg1 & 240;
    org_note = org_msg23 & 127;
    org_vel = (org_msg23/256)|0;
  
    (org_status == 144 && org_vel > 0) ? (
      org_KEYHELD[org_note]=1;
      org_midi_note_on(org_note,org_vel);
    ) : ((org_status == 128) || (org_status == 144 && org_vel == 0)) ? (
      org_KEYHELD[org_note]=0;
      org_midi_note_off(org_note);
    ) : (org_status == 176) ? (
      org_cc = org_note;
      org_val = org_vel;
      org_cc == 64 ? (
        org_new_sus = org_val >= 64;
        org_sustain_pedal && !org_new_sus ? (
          org_sustain_pedal=0;
          org_midi_release_pedal();
        ) : (
          org_sustain_pedal=org_new_sus;
        );
      ) : (org_cc == 120 || org_cc == 123) ? (
        org_sustain_pedal=0;
        memset(org_KEYHELD,0,128);
        org_i=0;
        loop(8,
          org_VSTAGE[org_i] > 0 ? org_VSTAGE[org_i] = 3;
          org_i += 1;
        );
      );
    );
  );
) : engine_now < 3.5 ? (

    // TEST20 — direct Strings MIDI handling.
    // Sample offsets are intentionally ignored; changes apply at block edge.
    while(midirecv(mofs, m1, m23)) (
    status = m1 & 240;
    note = m23 & 127;
    vel = (m23/256)|0;
    vel > 127 ? vel = 127;
  
    is_on = status == 144 && vel > 0;
    is_off = status == 128 || (status == 144 && vel == 0);
    is_pitch_bend = status == 224;
    is_cc = status == 176;
  
    is_pitch_bend ? (
      pb_lsb = m23 & 127;
      pb_msb = ((m23/256)|0) & 127;
      pb14 = pb_lsb + pb_msb*128;
  
      pb14 >= 8192
        ? pitch_bend_norm = (pb14-8192)/8191
        : pitch_bend_norm = (pb14-8192)/8192;
  
      pitch_bend_cents = pitch_bend_norm * step_bend_range_cents;
      pitch_bend_ratio = 2 ^ (pitch_bend_cents/1200);
  
      mono_os_dirty = 1;
      warp_rec_ready[6] = 0;
      i = 0;
      loop(6,
        v_active[i] ? (
          v_os_dirty[i] = 1;
          warp_rec_ready[i] = 0;
        );
        i += 1;
      );
    );
  
    // Standard MIDI CC1 Mod Wheel.
    is_cc && note == 1 ? (
      mod_wheel = vel/127;
      mono_os_dirty = 1;
      warp_rec_ready[6] = 0;
      i = 0;
      loop(6,
        v_active[i] ? (
          v_os_dirty[i] = 1;
          warp_rec_ready[i] = 0;
        );
        i += 1;
      );
    );

    // Standard sustain pedal (CC64). Physical key state remains separate
    // from audio release state so pedal-up can release only keys no longer held.
    is_cc && note == 64 ? (
      strings_new_sus = vel >= 64;
      strings_sustain_pedal && !strings_new_sus ? (
        strings_sustain_pedal = 0;
        mode < 2 ? (
          mono_note >= 0 && !held_state[mono_note] ? (
            mono_stage != 0 ? mono_stage = 4;
            mono_note = -1;
          );
        ) : (
          i = 0;
          loop(6,
            v_active[i] && !held_state[v_note[i]] ? v_stage[i] = 4;
            i += 1;
          );
        );
      ) : (
        strings_sustain_pedal = strings_new_sus;
      );
    );
  
    is_on ? (
      mode < 2 ? (
        // Last-note priority for both mono modes. No per-note scan is needed on note-on.
        had_held = held_count > 0;
        !held_state[note] ? held_count += 1;
        note_serial += 1;
        held_state[note] = 1;
        held_order[note] = note_serial;
  
        mono_note = note;
        mono_target = note_hz(note);
        mono_vel = vel/127;
        vel_tone_k[6] = step_vel_tone_on ? calc_vel_tone_k(mono_vel, mono_target) : 1;
        vel_tone_ready[6] = 0;
        calc_key_gains(note);
        mono_key_gainL = key_tmpL;
        mono_key_gainR = key_tmpR;
  
        mono_freq <= 0 || !porta_enabled ? (
          mono_freq = mono_target;
          mono_glide = 0;
        ) : (
          mono_glide = abs(mono_target-mono_freq) > 0.000000000001;
        );
  
        mono_life_mod = step_life_on ? ((mono_vel-0.5)*2)*step_velocity_life3 : 0;
        mono_timbre_scale = step_attack_dynamic
                          ? step_velocity_timbre_base + step_velocity_timbre*mono_vel
                          : 1;
        mono_pick_gain = step_pick_level
                       * (pick_vel_base + step_pick_velocity*mono_vel) * 5.2;
        mono_os_dirty = 1;
  
        mode == 0 ? (
          // Mono Trigger: every Note On restarts BOTH oscillator phase and ADSR.
          mono_phase = 0;
          mono_env = 0;
          mono_stage = 1;
          mono_exc = 1;
          mono_tension = 1;
          mono_finger = 0;
          mono_finger_stage = step_finger_on ? 1 : 0;
          mono_finger_vel = step_finger_on ? (mono_vel ^ step_finger_vel_curve) : 0;
          osc_reset(6);
          step_pick_level > 0.000001 ? (
            mono_pick_env = 1;
            mono_pick_lp = 0;
            mono_pick_dc = 0;
          ) : mono_pick_env = 0;
        ) : (
          // Mono Legato: only the first note of a connected phrase triggers ADSR.
          !had_held ? (
            mono_env = 0;
            mono_stage = 1;
            mono_exc = 1;
            mono_tension = 1;
            mono_finger = 0;
            mono_finger_stage = step_finger_on ? 1 : 0;
            mono_finger_vel = step_finger_on ? (mono_vel ^ step_finger_vel_curve) : 0;
            osc_reset(6);
            step_pick_level > 0.000001 ? (
              mono_pick_env = 1;
              mono_pick_lp = 0;
              mono_pick_dc = 0;
            ) : mono_pick_env = 0;
          );
        );
      ) : (
        // Poly 6: track physical key state separately for CC64 sustain.
        held_state[note] = 1;

        // Poly 6: one physical voice per MIDI pitch.
        // If the same note is played again while its previous voice is still
        // sounding (including Release), retrigger THAT voice instead of
        // allocating a duplicate. This prevents release tails of repeated
        // notes from stacking CPU and stealing unrelated pitches.
        pick = -1;
        i = 0;
        loop(6,
          pick < 0 && v_active[i] && v_note[i] == note ? pick = i;
          i += 1;
        );

        // New pitch: first free voice, otherwise steal the oldest voice.
        pick < 0 ? (
          i = 0;
          loop(6,
            pick < 0 && !v_active[i] ? pick = i;
            i += 1;
          );
        );
        pick < 0 ? (
          pick = 0;
          oldest = v_age[0];
          i = 1;
          loop(5,
            v_age[i] < oldest ? (
              oldest = v_age[i];
              pick = i;
            );
            i += 1;
          );
        );
  
        was_active = v_active[pick];
        target_hz = note_hz(note);
        v_target[pick] = target_hz;
        v_note[pick] = note;
        calc_key_gains(note);
        v_key_gainL[pick] = key_tmpL;
        v_key_gainR[pick] = key_tmpR;
        v_vel[pick] = vel/127;
        vel_tone_k[pick] = step_vel_tone_on ? calc_vel_tone_k(v_vel[pick], target_hz) : 1;
        vel_tone_ready[pick] = 0;
  
        v_freq[pick] <= 0 || !porta_enabled ? (
          v_freq[pick] = target_hz;
          v_glide[pick] = 0;
        ) : (
          v_glide[pick] = abs(target_hz-v_freq[pick]) > 0.000000000001;
        );
  
        v_life_mod[pick] = step_life_on
                         ? ((v_vel[pick]-0.5)*2)*step_velocity_life3 : 0;
        v_timbre_scale[pick] = step_attack_dynamic
                             ? step_velocity_timbre_base + step_velocity_timbre*v_vel[pick]
                             : 1;
        v_pick_gain[pick] = step_pick_level
                          * (pick_vel_base + step_pick_velocity*v_vel[pick]) * 5.2;
        v_os_dirty[pick] = 1;
  
        v_phase[pick] = 0;
        osc_reset(pick);
        v_env[pick] = 0;
        v_stage[pick] = 1;
        v_exc[pick] = 1;
        v_tension[pick] = 1;
        v_finger[pick] = 0;
        v_finger_stage[pick] = step_finger_on ? 1 : 0;
        v_finger_vel[pick] = step_finger_on ? (v_vel[pick] ^ step_finger_vel_curve) : 0;
        step_pick_level > 0.000001 ? (
          v_pick_env[pick] = 1;
          v_pick_lp[pick] = 0;
          v_pick_dc[pick] = 0;
        ) : v_pick_env[pick] = 0;
        v_active[pick] = 1;
        !was_active ? poly_active_count += 1;
        voice_serial += 1;
        v_age[pick] = voice_serial;
      );
    );
  
    is_off ? (
      mode < 2 ? (
        held_state[note] ? (
          held_state[note] = 0;
          held_order[note] = 0;
          held_count -= 1;
          held_count < 0 ? held_count = 0;
        );
        note == mono_note ? (
          // Return to the most recently physically held note, if any.
          best_note = -1;
          best_order = -1;
          i = 0;
          loop(128,
            held_state[i] && held_order[i] > best_order ? (
              best_order = held_order[i];
              best_note = i;
            );
            i += 1;
          );
          best_note >= 0 ? (
            mono_note = best_note;
            mono_target = note_hz(best_note);
            vel_tone_k[6] = step_vel_tone_on ? calc_vel_tone_k(mono_vel, mono_target) : 1;
            calc_key_gains(best_note);
            mono_key_gainL = key_tmpL;
            mono_key_gainR = key_tmpR;
            !porta_enabled ? (
              mono_freq = mono_target;
              mono_glide = 0;
            ) : (
              mono_glide = abs(mono_target-mono_freq) > 0.000000000001;
            );
            mono_os_dirty = 1;
