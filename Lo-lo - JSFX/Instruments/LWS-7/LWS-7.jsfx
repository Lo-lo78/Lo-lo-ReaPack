  ml_base[4]=1;    ml_base[5]=1.60; ml_base[6]=1;    ml_base[7]=0.55;
  ml_base[8]=0.55; ml_base[9]=0.07; ml_base[10]=0.84;ml_base[11]=1.00;
  ml_base[12]=0.16;ml_base[13]=1.80;ml_base[14]=0.05;ml_base[15]=0.22;
  ml_base[16]=0.72;ml_base[17]=0.92;ml_base[18]=483; ml_base[19]=1.00;
  ml_base[20]=1.00;ml_base[21]=2.95;ml_base[22]=0.40;ml_base[23]=1.00;
  ml_base[24]=4;   ml_base[25]=180; ml_base[26]=0.18;
  ml_base[27]=3.2; ml_base[28]=0.84;
);

