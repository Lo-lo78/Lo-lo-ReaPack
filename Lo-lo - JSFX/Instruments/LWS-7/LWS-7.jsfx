// User-created Celesta factory sound.
// Fixed from the REAPER FXPARAM snapshot supplied for Celesta.
function ml_mal_factory_celesta()
local(ml_base)
(
  ml_base=ml_MAL_BANK+4*ml_MAL_BANK_STRIDE;
  ml_base[0]=0;     // Master Output (dB)
  ml_base[1]=0;     // Octave
  ml_base[2]=0;     // Fine Tune (semitones)
  ml_base[3]=2;     // Pitch Bend Range (semitones)
  ml_base[4]=1;     // Velocity Amount
  ml_base[5]=1;     // Velocity Curve
  ml_base[6]=1;     // Strike Level
  ml_base[7]=0.55;  // Hardness
  ml_base[8]=0.55;  // Weight
  ml_base[9]=0.05;  // Strike Position
  ml_base[10]=1;    // Bar Tone
  ml_base[11]=0.60; // Bar Brightness
  ml_base[12]=1;    // Bar Complexity
  ml_base[13]=4.00; // Bar Decay (s)
  ml_base[14]=0.64; // High Decay
  ml_base[15]=0.64; // Resonator Level
  ml_base[16]=0.55; // Resonator Depth
  ml_base[17]=0.65; // Resonator Coupling
  ml_base[18]=1200; // Damper Time (ms)
  ml_base[19]=1;    // Velocity Tone
  ml_base[20]=0.55; // Velocity Attack
  ml_base[21]=5.5;  // Motor Rate (Hz)
  ml_base[22]=0.35; // Motor Depth
  ml_base[23]=0.55; // Keyboard Stereo
  ml_base[24]=4;    // Saturation Drive (dB)
  ml_base[25]=180;  // Saturation HP (Hz)
  ml_base[26]=0.18; // Saturation Mix
  ml_base[27]=6.0;  // AutoPan Rate (Hz)
  ml_base[28]=1.0;  // AutoPan Depth
);

// User-created Metallophone factory sound.
// Fixed from the REAPER FXPARAM snapshot supplied for Metallophone.
function ml_mal_factory_metallophone()
local(ml_base)
(
  ml_base=ml_MAL_BANK+5*ml_MAL_BANK_STRIDE;
  ml_base[0]=0;     // Master Output (dB)
  ml_base[1]=0;     // Octave
  ml_base[2]=0;     // Fine Tune (semitones)
  ml_base[3]=2;     // Pitch Bend Range (semitones)
  ml_base[4]=1;     // Velocity Amount
  ml_base[5]=1;     // Velocity Curve
  ml_base[6]=1;     // Strike Level
  ml_base[7]=0.55;  // Hardness
  ml_base[8]=0.55;  // Weight
  ml_base[9]=0.39;  // Strike Position
  ml_base[10]=1;    // Bar Tone
  ml_base[11]=0.60; // Bar Brightness
  ml_base[12]=1;    // Bar Complexity
  ml_base[13]=4.00; // Bar Decay (s)
  ml_base[14]=0.13; // High Decay
  ml_base[15]=0.54; // Resonator Level
  ml_base[16]=0.55; // Resonator Depth
  ml_base[17]=0.65; // Resonator Coupling
  ml_base[18]=1200; // Damper Time (ms)
  ml_base[19]=1;    // Velocity Tone
  ml_base[20]=0.55; // Velocity Attack
  ml_base[21]=5.5;  // Motor Rate (Hz)
  ml_base[22]=0.35; // Motor Depth
  ml_base[23]=0.55; // Keyboard Stereo
  ml_base[24]=4;    // Saturation Drive (dB)
  ml_base[25]=180;  // Saturation HP (Hz)
  ml_base[26]=0.18; // Saturation Mix
  ml_base[27]=3.2;  // AutoPan Rate (Hz)
  ml_base[28]=0;    // AutoPan Depth: off in factory Init
);

// Correct the mistaken -15 dB factory Master stored in 0.07/0.08
// without touching any other per-instrument setting.
function ml_mal_fix_celesta_metallophone_master()
local(ml_base)
(
  ml_base=ml_MAL_BANK+4*ml_MAL_BANK_STRIDE;
  ml_base[0]=0;
  ml_base=ml_MAL_BANK+5*ml_MAL_BANK_STRIDE;
  ml_base[0]=0;
);

// Apply the three approved factory AutoPan settings.
// Other instruments keep AutoPan disabled in their factory Init.
function ml_mal_set_three_factory_autopan()
local(ml_base)
(
  ml_base=ml_MAL_BANK;
  ml_base[27]=3.2; ml_base[28]=0.84; // Vibraphone

  ml_base=ml_MAL_BANK+3*ml_MAL_BANK_STRIDE;
  ml_base[27]=3.2; ml_base[28]=0.32; // Glockenspiel

  ml_base=ml_MAL_BANK+4*ml_MAL_BANK_STRIDE;
  ml_base[27]=6.0; ml_base[28]=1.0;  // Celesta
);

// Migrate 0.10 without destroying user AutoPan edits.
// Only the untouched 0.10 factory pair (3.2 Hz / 0.35) is replaced.
// The three approved instruments receive their new factory AutoPan;
// the other untouched instruments are changed to Depth 0.
function ml_mal_migrate_010_autopan()
local(ml_inst,ml_base,ml_newrate,ml_newdepth)
(
  ml_inst=0;
  loop(ml_MAL_BANK_COUNT,
    ml_base=ml_MAL_BANK+ml_inst*ml_MAL_BANK_STRIDE;
    abs(ml_base[27]-3.2)<0.0000001 && abs(ml_base[28]-0.35)<0.0000001 ? (
      ml_newrate=3.2;
      ml_newdepth=0;
      ml_inst==0 ? ml_newdepth=0.84;
      ml_inst==3 ? ml_newdepth=0.32;
      ml_inst==4 ? (ml_newrate=6.0; ml_newdepth=1.0;);
      ml_base[27]=ml_newrate;
      ml_base[28]=ml_newdepth;
    );
    ml_inst+=1;
  );
);

// Migrate 0.11 without destroying user AutoPan edits.
// Only an untouched old factory pair (3.2 Hz / 0) is promoted on the
// three instruments that now intentionally have AutoPan in their Init.
function ml_mal_migrate_011_autopan()
local(ml_base)
(
  ml_base=ml_MAL_BANK;
  abs(ml_base[27]-3.2)<0.0000001 && abs(ml_base[28])<0.0000001 ? (
    ml_base[27]=3.2; ml_base[28]=0.84;
  );

  ml_base=ml_MAL_BANK+3*ml_MAL_BANK_STRIDE;
  abs(ml_base[27]-3.2)<0.0000001 && abs(ml_base[28])<0.0000001 ? (
    ml_base[27]=3.2; ml_base[28]=0.32;
  );

  ml_base=ml_MAL_BANK+4*ml_MAL_BANK_STRIDE;
  abs(ml_base[27]-3.2)<0.0000001 && abs(ml_base[28])<0.0000001 ? (
    ml_base[27]=6.0; ml_base[28]=1.0;
  );
);

// Bank migration:
// 0.02..0.09 used 27 cells per Instrument and had no AutoPan bank fields.
// Expand them preserving every old edit, then seed only the three approved
// factory AutoPan settings. The other three remain Depth 0.
ml_mal_pre_migration_magic=ml_mal_bank_magic;
ml_mal_autopan_load_current=0;
ml_mal_bank_magic>=61002 && ml_mal_bank_magic<=61009 ? (
  ml_mal_expand_banks_27_to_29();
  ml_mal_set_three_factory_autopan();
  ml_mal_autopan_load_current=1;
);

// - 0.11 state (magic 61011): promote only untouched AutoPan defaults on
//   Vibraphone, Glockenspiel and Celesta; preserve any user AutoPan edit.
// - 0.10 state (magic 61010): repair untouched 0.10 AutoPan defaults while
//   preserving user-edited Rate/Depth on every instrument.
// - 0.09 and older known states: preserve old controls, expand bank storage,
//   and seed the three approved factory AutoPan settings.
// - fresh/unknown state: seed all six approved Factory banks.
ml_mal_master_fix_current=0;

ml_mal_bank_magic==61012 ? (
  // Previous current build: preserve all six banks; the Fine Tune unit
  // conversion immediately below updates only bank slot 2.
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61011 ? (
  ml_mal_migrate_011_autopan();
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61010 ? (
  ml_mal_migrate_010_autopan();
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61009 ? (
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61008 ? (
  ml_mal_fix_celesta_metallophone_master();
  ml_mal_master_fix_current=1;
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61007 ? (
  ml_mal_factory_metallophone();
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61006 ? (
  ml_mal_factory_celesta();
  ml_mal_factory_metallophone();
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61005 ? (
  ml_mal_factory_glockenspiel();
  ml_mal_factory_celesta();
  ml_mal_factory_metallophone();
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61004 ? (
  ml_mal_factory_xylophone();
  ml_mal_factory_glockenspiel();
  ml_mal_factory_celesta();
  ml_mal_factory_metallophone();
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61003 ? (
  ml_mal_factory_vibraphone();
  ml_mal_factory_xylophone();
  ml_mal_factory_glockenspiel();
  ml_mal_factory_celesta();
  ml_mal_factory_metallophone();
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic==61002 ? (
  ml_mal_factory_vibraphone();
  ml_mal_factory_marimba();
  ml_mal_factory_xylophone();
  ml_mal_factory_glockenspiel();
  ml_mal_factory_celesta();
  ml_mal_factory_metallophone();
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
) :
ml_mal_bank_magic!=ml_MAL_BANK_MAGIC_VALUE ? (
  ml_mal_factory_generic(0);
  ml_mal_factory_generic(1);
  ml_mal_factory_generic(2);
  ml_mal_factory_generic(3);
  ml_mal_factory_generic(4);
  ml_mal_factory_generic(5);
  ml_mal_factory_vibraphone();
  ml_mal_factory_marimba();
  ml_mal_factory_xylophone();
  ml_mal_factory_glockenspiel();
  ml_mal_factory_celesta();
  ml_mal_factory_metallophone();
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
);


// 61013 tuning-unit migration: hidden Mallet bank slot 2 used to store cents.
// Convert every known old Current Bank to semitones without disturbing edits.
ml_mal_pre_migration_magic>=61002 && ml_mal_pre_migration_magic<=61012 ? (
  ml_mal_conv_i=0;
  loop(ml_MAL_BANK_COUNT,
    ml_mal_conv_b=ml_MAL_BANK+ml_mal_conv_i*ml_MAL_BANK_STRIDE;
    ml_mal_conv_b[2] *= 0.01;
    ml_mal_conv_i += 1;
  );
  ml_mal_bank_magic=ml_MAL_BANK_MAGIC_VALUE;
);

// The host-visible state wins for the currently selected Instrument on load.
// Exception for the 0.08 -> 0.09 correction: if Celesta or Metallophone is
// currently selected, correct only its visible Master too, so the old -15 dB
// value cannot immediately overwrite the repaired bank.
ml_mal_bank_prev=max(0,min(5,floor(slider170+0.5)));
ml_mal_master_fix_current && ml_mal_bank_prev>=4 ? (
  slider169=0;
  sliderchange(slider169);
);

// For 0.09 and earlier the AutoPan sliders did not exist, so load the
// migrated bank values for the currently selected instrument before capture.
ml_mal_autopan_load_current ? (
  ml_mal_ap_base=ml_MAL_BANK+ml_mal_bank_prev*ml_MAL_BANK_STRIDE;
  slider197=ml_mal_ap_base[27];
  slider198=ml_mal_ap_base[28];
  sliderchange(slider197);
  sliderchange(slider198);
);

// For 0.10/0.11, change the visible AutoPan only when it still matches the
// untouched old factory pair. A user-edited visible AutoPan is preserved.
ml_mal_pre_migration_magic==61010 &&
abs(slider197-3.2)<0.0000001 && abs(slider198-0.35)<0.0000001 ? (
  ml_mal_ap_base=ml_MAL_BANK+ml_mal_bank_prev*ml_MAL_BANK_STRIDE;
  slider197=ml_mal_ap_base[27];
  slider198=ml_mal_ap_base[28];
  sliderchange(slider197);
  sliderchange(slider198);
);

ml_mal_pre_migration_magic==61011 &&
(ml_mal_bank_prev==0 || ml_mal_bank_prev==3 || ml_mal_bank_prev==4) &&
abs(slider197-3.2)<0.0000001 && abs(slider198)<0.0000001 ? (
  ml_mal_ap_base=ml_MAL_BANK+ml_mal_bank_prev*ml_MAL_BANK_STRIDE;
  slider197=ml_mal_ap_base[27];
  slider198=ml_mal_ap_base[28];
  sliderchange(slider197);
  sliderchange(slider198);
);

ml_mal_bank_capture(ml_mal_bank_prev);
ml_mal_snapshot_live();
ml_mal_bank_ready=1;

// Motor is global: one rotating resonator mechanism, not one LFO per voice.
ml_motor_phase=0;

// AutoPan recurrence, identical in principle to Rhodes Lab.
ml_ap_sin=0;
ml_ap_cos=1;
ml_sample_count=0;

// Saturation/output states.
ml_sat_lowL=0;
ml_sat_lowR=0;

// Lo-lo fixed output signature.
ml_dc_coeff_5hz=exp(-ml_twopi*5/srate);
ml_dc_x1L=ml_dc_y1L=0;
ml_dc_x1R=ml_dc_y1R=0;
ml_glue_env=0;
ml_glue_att_inv=1/(0.001*srate);
ml_glue_rel_inv=1/(0.004*srate);
ml_glue_ratio_k=2;
ml_glue_thresh_k=0.055;
ml_post_in_gain=0.4;
ml_post_limit=0.98;

// ------------------------------------------------------------
// Helpers.
// ------------------------------------------------------------
function ml_mal_clip01(ml_x)
(
  max(0,min(1,ml_x));
);

function ml_mal_softclip(ml_x)
local(ml_x2)
(
  ml_x2=ml_x*ml_x;
  ml_x*(27+ml_x2)/(27+9*ml_x2);
);

function ml_mal_mode_coeff(ml_freq,ml_decay_s)
local(ml_w,ml_r)
(
  ml_freq>5 && ml_freq<srate*0.475 ? (
    ml_w=ml_twopi*ml_freq/srate;
    ml_r=exp(ml_ln_001/max(1,ml_decay_s*srate));
    ml_mal_tmp_c1=2*ml_r*cos(ml_w);
    ml_mal_tmp_c2=-ml_r*ml_r;
  ) : (
    ml_mal_tmp_c1=0;
    ml_mal_tmp_c2=0;
  );
);

function ml_mal_inst_config()
(
  // ----------------------------------------------------------
  // Hidden instrument structure.
  // Ratios / modal weights / decay behavior are intentionally
  // not public parameters.
  // ----------------------------------------------------------
  ml_instrument==0 ? ( // Vibraphone
    ml_ir1=1; ml_ir2=4.00; ml_ir3=10.00; ml_ir4=16.40; ml_ir5=24.20; ml_ir6=33.10;
    ml_iw1=1.00; ml_iw2=0.42; ml_iw3=0.25; ml_iw4=0.13; ml_iw5=0.08; ml_iw6=0.05;
    ml_id1=1.00; ml_id2=0.72; ml_id3=0.52; ml_id4=0.34; ml_id5=0.24; ml_id6=0.17;
    ml_inst_decay=1.35;
    ml_inst_bright=0.64;
    ml_inst_metal=1.00;
    ml_inst_res=1.00;
    ml_inst_motor=1.00;
    ml_inst_action=0.48;
    ml_inst_res_ratio=1.00;
  ) :
  ml_instrument==1 ? ( // Marimba
    ml_ir1=1; ml_ir2=4.00; ml_ir3=10.00; ml_ir4=17.10; ml_ir5=25.80; ml_ir6=35.00;
    ml_iw1=1.00; ml_iw2=0.50; ml_iw3=0.23; ml_iw4=0.085; ml_iw5=0.035; ml_iw6=0.018;
    ml_id1=1.00; ml_id2=0.58; ml_id3=0.34; ml_id4=0.18; ml_id5=0.11; ml_id6=0.07;
    ml_inst_decay=0.72;
    ml_inst_bright=0.34;
    ml_inst_metal=0.08;
    ml_inst_res=1.20;
    ml_inst_motor=0.00;
    ml_inst_action=0.72;
    ml_inst_res_ratio=1.00;
  ) :
  ml_instrument==2 ? ( // Xylophone
    ml_ir1=1; ml_ir2=3.00; ml_ir3=6.20; ml_ir4=10.30; ml_ir5=15.40; ml_ir6=21.50;
    ml_iw1=1.00; ml_iw2=0.62; ml_iw3=0.38; ml_iw4=0.20; ml_iw5=0.11; ml_iw6=0.06;
    ml_id1=1.00; ml_id2=0.34; ml_id3=0.19; ml_id4=0.10; ml_id5=0.065; ml_id6=0.045;
    ml_inst_decay=0.24;
    ml_inst_bright=0.75;
    ml_inst_metal=0.04;
    ml_inst_res=0.58;
    ml_inst_motor=0.00;
    ml_inst_action=1.00;
    ml_inst_res_ratio=1.00;
  ) :
  ml_instrument==3 ? ( // Glockenspiel
    ml_ir1=1; ml_ir2=2.756; ml_ir3=5.404; ml_ir4=8.933; ml_ir5=13.34; ml_ir6=18.64;
    ml_iw1=1.00; ml_iw2=0.56; ml_iw3=0.35; ml_iw4=0.23; ml_iw5=0.16; ml_iw6=0.11;
    ml_id1=1.00; ml_id2=0.86; ml_id3=0.68; ml_id4=0.52; ml_id5=0.40; ml_id6=0.31;
    ml_inst_decay=1.75;
    ml_inst_bright=0.92;
    ml_inst_metal=1.00;
    ml_inst_res=0.26;
    ml_inst_motor=0.00;
    ml_inst_action=0.88;
    ml_inst_res_ratio=1.00;
  ) :
  ml_instrument==4 ? ( // Celesta
    ml_ir1=1; ml_ir2=2.72; ml_ir3=5.32; ml_ir4=8.75; ml_ir5=13.00; ml_ir6=18.10;
    ml_iw1=1.00; ml_iw2=0.40; ml_iw3=0.20; ml_iw4=0.10; ml_iw5=0.055; ml_iw6=0.028;
    ml_id1=1.00; ml_id2=0.64; ml_id3=0.43; ml_id4=0.28; ml_id5=0.19; ml_id6=0.13;
    ml_inst_decay=0.92;
    ml_inst_bright=0.52;
    ml_inst_metal=0.72;
    ml_inst_res=0.48;
    ml_inst_motor=0.00;
    ml_inst_action=0.38;
    ml_inst_res_ratio=1.00;
  ) : ( // Metallophone
    ml_ir1=1; ml_ir2=3.20; ml_ir3=7.40; ml_ir4=12.80; ml_ir5=19.10; ml_ir6=27.00;
    ml_iw1=1.00; ml_iw2=0.54; ml_iw3=0.34; ml_iw4=0.21; ml_iw5=0.14; ml_iw6=0.09;
    ml_id1=1.00; ml_id2=0.78; ml_id3=0.61; ml_id4=0.46; ml_id5=0.34; ml_id6=0.26;
    ml_inst_decay=1.46;
    ml_inst_bright=0.78;
    ml_inst_metal=0.92;
    ml_inst_res=0.78;
    ml_inst_motor=0.15;
    ml_inst_action=0.68;
    ml_inst_res_ratio=1.00;
  );
);

function ml_mal_decay_for(ml_mode_index,ml_base_decay,ml_mode_scale)
local(ml_highpos,ml_hd)
(
  ml_highpos=(ml_mode_index-1)/5;
  ml_hd=(1-ml_highpos)+ml_highpos*ml_high_decay;
  max(0.008,ml_base_decay*ml_mode_scale*ml_hd);
);

function ml_mal_voice_recalc(ml_i)
local(ml_note,ml_f,ml_keypos,ml_key_decay,ml_base_decay,ml_resdec)
(
  ml_note=ml_VNOTE[ml_i];
  ml_f=440*(2^(((ml_note-69)+ml_octave_semi+ml_fine_semi+ml_pitch_bend_semi)/12));
  ml_VFREQ[ml_i]=ml_f;

  ml_keypos=max(-1,min(1,(ml_note-60)/48));
  ml_key_decay=2^(-0.24*ml_keypos);
  ml_base_decay=ml_bar_decay*ml_inst_decay*ml_key_decay;

  ml_VDAMPED[ml_i] ? (
    ml_base_decay=max(0.008,ml_damper_ms*0.001);
  );

  ml_mal_mode_coeff(ml_f*ml_ir1,ml_mal_decay_for(1,ml_base_decay,ml_id1));
  ml_M1C1[ml_i]=ml_mal_tmp_c1; ml_M1C2[ml_i]=ml_mal_tmp_c2;

  ml_mal_mode_coeff(ml_f*ml_ir2,ml_mal_decay_for(2,ml_base_decay,ml_id2));
  ml_M2C1[ml_i]=ml_mal_tmp_c1; ml_M2C2[ml_i]=ml_mal_tmp_c2;

  ml_mal_mode_coeff(ml_f*ml_ir3,ml_mal_decay_for(3,ml_base_decay,ml_id3));
  ml_M3C1[ml_i]=ml_mal_tmp_c1; ml_M3C2[ml_i]=ml_mal_tmp_c2;

  ml_mal_mode_coeff(ml_f*ml_ir4,ml_mal_decay_for(4,ml_base_decay,ml_id4));
  ml_M4C1[ml_i]=ml_mal_tmp_c1; ml_M4C2[ml_i]=ml_mal_tmp_c2;

  ml_mal_mode_coeff(ml_f*ml_ir5,ml_mal_decay_for(5,ml_base_decay,ml_id5));
  ml_M5C1[ml_i]=ml_mal_tmp_c1; ml_M5C2[ml_i]=ml_mal_tmp_c2;

  ml_mal_mode_coeff(ml_f*ml_ir6,ml_mal_decay_for(6,ml_base_decay,ml_id6));
  ml_M6C1[ml_i]=ml_mal_tmp_c1; ml_M6C2[ml_i]=ml_mal_tmp_c2;

  ml_resdec=max(0.025,(0.18+2.8*ml_resonator_depth)*ml_inst_res);
  ml_VDAMPED[ml_i] ? ml_resdec=min(ml_resdec,max(0.008,ml_damper_ms*0.001*1.4));
  ml_mal_mode_coeff(ml_f*ml_inst_res_ratio,ml_resdec);
  ml_RC1[ml_i]=ml_mal_tmp_c1; ml_RC2[ml_i]=ml_mal_tmp_c2;
);

function ml_mal_alloc_voice()
local(ml_i,ml_best,ml_beststamp)
(
  ml_best=-1;
  ml_i=0;
  loop(ml_voice_count,
    ml_best<0 && !ml_VACTIVE[ml_i] ? ml_best=ml_i;
    ml_i+=1;
  );

  ml_best<0 ? (
    ml_best=0;
    ml_beststamp=ml_VSTAMP[0];
    ml_i=1;
    loop(ml_voice_count-1,
      ml_VSTAMP[ml_i]<ml_beststamp ? (
        ml_best=ml_i;
        ml_beststamp=ml_VSTAMP[ml_i];
      );
      ml_i+=1;
    );
  ) : (
    ml_active_count+=1;
  );

  ml_best;
);

function ml_mal_action_strike(ml_i,ml_note,ml_amp,ml_hard)
local(ml_tone,ml_f1,ml_f2,ml_d1,ml_d2,ml_l1,ml_l2,ml_w1,ml_w2)
(
  ml_tone=ml_mal_clip01(0.18+0.64*ml_bar_brightness+0.18*ml_hard);

  ml_f1=(240+980*ml_tone)*(1+0.002*(ml_note-60));
  ml_f2=(1800+7200*ml_tone)*(1-0.001*(ml_note-60));

  ml_d1=0.018-0.006*ml_hard;
  ml_d2=0.0065-0.0020*ml_hard;

  ml_mal_mode_coeff(ml_f1,max(0.004,ml_d1));
  ml_A1C1[ml_i]=ml_mal_tmp_c1; ml_A1C2[ml_i]=ml_mal_tmp_c2;

  ml_mal_mode_coeff(ml_f2,max(0.0025,ml_d2));
  ml_A2C1[ml_i]=ml_mal_tmp_c1; ml_A2C2[ml_i]=ml_mal_tmp_c2;

  ml_l1=ml_amp*ml_inst_action*(0.30+0.42*ml_mallet_weight)*(0.72-0.24*ml_hard);
  ml_l2=ml_amp*ml_inst_action*(0.05+0.44*(ml_hard^1.7));

  ml_w1=ml_twopi*ml_f1/srate;
  ml_w2=ml_twopi*ml_f2/srate;

  ml_A1Y2[ml_i]=0; ml_A1Y1[ml_i]=ml_l1*sin(ml_w1);
  ml_A2Y2[ml_i]=0; ml_A2Y1[ml_i]=ml_l2*sin(ml_w2);
);

function ml_mal_note_on(ml_note,ml_vel)
local(ml_i,ml_v,ml_vc,ml_amp,ml_keypos,ml_hard,ml_weight,ml_bright,ml_complex,
      ml_f,ml_sp,ml_a1,ml_a2,ml_a3,ml_a4,ml_a5,ml_a6,ml_ra,ml_w)
(
  ml_i=ml_mal_alloc_voice();

  ml_VACTIVE[ml_i]=1;
  ml_VNOTE[ml_i]=ml_note;
  ml_VGATE[ml_i]=1;
  ml_VDAMPED[ml_i]=0;
  ml_VQUIET[ml_i]=0;
  ml_VSTAMP[ml_i]=ml_voice_stamp_counter;
  ml_voice_stamp_counter+=1;

  ml_v=ml_vel/127;
  ml_vc=ml_v^ml_velocity_curve;
  ml_VVEL[ml_i]=ml_vc;

  ml_amp=ml_strike_level*((1-ml_velocity_amount)+ml_velocity_amount*ml_vc);

  ml_hard=ml_mal_clip01(
      ml_mallet_hardness
    + ml_velocity_tone*(ml_vc-0.5)*0.62
    + (ml_inst_metal-0.5)*0.12
  );

  ml_weight=ml_mallet_weight;
  ml_bright=ml_mal_clip01(
      0.20
    + 0.56*ml_bar_brightness
    + 0.26*ml_inst_bright
    + ml_velocity_tone*(ml_vc-0.5)*0.34
  );

  ml_complex=ml_bar_complexity;

  ml_mal_voice_recalc(ml_i);
  ml_f=ml_VFREQ[ml_i];

  // Soft velocity can have a slightly softer/slower contact.
  ml_VATT[ml_i]=0;
  ml_VATTSTEP[ml_i]=1/max(
    1,
    (0.00015 + ml_velocity_attack*((1-ml_vc)^1.45)*0.0045)*srate
  );

  // Approximate strike-position coupling to modal shapes.
  ml_sp=ml_mallet_position;

  ml_a1=ml_amp*ml_iw1*(0.88+0.20*ml_weight)*(0.82+0.18*ml_bar_tone);
  ml_a2=ml_amp*ml_iw2*(0.42+0.58*ml_bright)*abs(sin($pi*ml_ir2*ml_sp));
  ml_a3=ml_amp*ml_iw3*(0.28+0.72*ml_bright)*abs(sin($pi*ml_ir3*ml_sp));

  // Complexity is mainly the upper/torsional-like content.
  ml_a4=ml_amp*ml_iw4*ml_complex*(0.18+0.82*ml_bright)*abs(sin($pi*ml_ir4*ml_sp));
  ml_a5=ml_amp*ml_iw5*(ml_complex^1.25)*(0.12+0.88*ml_bright)*abs(sin($pi*ml_ir5*ml_sp));
  ml_a6=ml_amp*ml_iw6*(ml_complex^1.50)*(0.08+0.92*ml_bright)*abs(sin($pi*ml_ir6*ml_sp));

  // Tone tilts energy toward or away from upper modes.
  ml_a1*=1.12-0.26*ml_bar_tone;
  ml_a2*=0.86+0.28*ml_bar_tone;
  ml_a3*=0.76+0.48*ml_bar_tone;
  ml_a4*=0.66+0.68*ml_bar_tone;
  ml_a5*=0.58+0.84*ml_bar_tone;
  ml_a6*=0.52+0.98*ml_bar_tone;

  ml_M1Y2[ml_i]=0; ml_M1Y1[ml_i]=ml_a1*sin(ml_twopi*ml_f*ml_ir1/srate);
  ml_f*ml_ir2<srate*0.475 ? (ml_M2Y2[ml_i]=0; ml_M2Y1[ml_i]=ml_a2*sin(ml_twopi*ml_f*ml_ir2/srate);) : (ml_M2Y1[ml_i]=ml_M2Y2[ml_i]=0;);
  ml_f*ml_ir3<srate*0.475 ? (ml_M3Y2[ml_i]=0; ml_M3Y1[ml_i]=ml_a3*sin(ml_twopi*ml_f*ml_ir3/srate);) : (ml_M3Y1[ml_i]=ml_M3Y2[ml_i]=0;);
  ml_f*ml_ir4<srate*0.475 ? (ml_M4Y2[ml_i]=0; ml_M4Y1[ml_i]=ml_a4*sin(ml_twopi*ml_f*ml_ir4/srate);) : (ml_M4Y1[ml_i]=ml_M4Y2[ml_i]=0;);
  ml_f*ml_ir5<srate*0.475 ? (ml_M5Y2[ml_i]=0; ml_M5Y1[ml_i]=ml_a5*sin(ml_twopi*ml_f*ml_ir5/srate);) : (ml_M5Y1[ml_i]=ml_M5Y2[ml_i]=0;);
  ml_f*ml_ir6<srate*0.475 ? (ml_M6Y2[ml_i]=0; ml_M6Y1[ml_i]=ml_a6*sin(ml_twopi*ml_f*ml_ir6/srate);) : (ml_M6Y1[ml_i]=ml_M6Y2[ml_i]=0;);

  // Acoustic tube / resonator: strongly present for marimba/vibe,
  // much less for glock/celesta.
  ml_ra=ml_amp*ml_resonator_level*ml_resonator_coupling*ml_inst_res*(0.18+0.34*ml_weight);
  ml_RY2[ml_i]=0;
  ml_RY1[ml_i]=ml_ra*sin(ml_twopi*ml_f*ml_inst_res_ratio/srate);

  ml_mal_action_strike(ml_i,ml_note,ml_amp,ml_hard);

  ml_keypos=max(-1,min(1,(ml_note-60)/42));
  ml_pan=max(-1,min(1,ml_keypos*ml_keyboard_stereo));
  ml_VPANL[ml_i]=sqrt(max(0,0.5*(1-ml_pan)))*1.41421356237;
  ml_VPANR[ml_i]=sqrt(max(0,0.5*(1+ml_pan)))*1.41421356237;
);

function ml_mal_damp_voice(ml_i)
(
  ml_VACTIVE[ml_i] ? (
    ml_VDAMPED[ml_i]=1;
    ml_mal_voice_recalc(ml_i);
  );
);

function ml_mal_note_off(ml_note)
local(ml_i)
(
  ml_i=0;
  loop(ml_voice_count,
    ml_VACTIVE[ml_i] && ml_VNOTE[ml_i]==ml_note && ml_VGATE[ml_i] ? (
      ml_VGATE[ml_i]=0;
      !ml_sustain_pedal ? ml_mal_damp_voice(ml_i);
    );
    ml_i+=1;
  );
);

function ml_mal_release_pedal()
local(ml_i)
(
  ml_i=0;
  loop(ml_voice_count,
    ml_VACTIVE[ml_i] && !ml_VGATE[ml_i] ? ml_mal_damp_voice(ml_i);
    ml_i+=1;
  );
);

function ml_mal_recalc_all()
local(ml_i)
(
  ml_i=0;
  loop(ml_voice_count,
    ml_VACTIVE[ml_i] ? ml_mal_voice_recalc(ml_i);
    ml_i+=1;
  );
);



// ============================================================
// WIND FAMILY ENGINE — EMBEDDED 0.12 CORE
// Sixth top-level engine; six internal instruments with independent Current Banks.
// Physical waveguide RAM is relocated below the shared Delay buffers.
// ============================================================
wi_WIN_RT_BASE=2320000;
wi_twopi=2*$pi;
wi_ln2=log(2);
wi_poly_voice_count=6;
wi_mono_voice=6;
wi_voice_count=7; // six independent poly voices + one dedicated mono voice

// ------------------------------------------------------------
// Per-voice scalar memory, stride 8.
// ------------------------------------------------------------
wi_VACTIVE=wi_WIN_RT_BASE+0; wi_VNOTE=wi_WIN_RT_BASE+8; wi_VGATE=wi_WIN_RT_BASE+16; wi_VVEL=wi_WIN_RT_BASE+24;
wi_VENV=wi_WIN_RT_BASE+32; wi_VSTAGE=wi_WIN_RT_BASE+40; wi_VRELSTEP=wi_WIN_RT_BASE+48; wi_VSTAMP=wi_WIN_RT_BASE+56;
wi_VQUIET=wi_WIN_RT_BASE+64; wi_VFREQ=wi_WIN_RT_BASE+72; wi_VPANL=wi_WIN_RT_BASE+80; wi_VPANR=wi_WIN_RT_BASE+88;
wi_VBOREW=wi_WIN_RT_BASE+96; wi_VJETW=wi_WIN_RT_BASE+104; wi_VBOREOUT=wi_WIN_RT_BASE+112; wi_VREFLP=wi_WIN_RT_BASE+120;
wi_VJETDCX=wi_WIN_RT_BASE+128; wi_VJETDCY=wi_WIN_RT_BASE+136; wi_VBREATHLP=wi_WIN_RT_BASE+144; wi_VKEYENV=wi_WIN_RT_BASE+152;
wi_VKEYLP=wi_WIN_RT_BASE+160; wi_VVIBPHASE=wi_WIN_RT_BASE+168; wi_VVIBCOUNT=wi_WIN_RT_BASE+176; wi_VBODYLP=wi_WIN_RT_BASE+184;
wi_VBASEDELAY=wi_WIN_RT_BASE+192; wi_VTAIL=wi_WIN_RT_BASE+200; wi_VCURDELAY=wi_WIN_RT_BASE+208; wi_VIGNITE=wi_WIN_RT_BASE+216;

wi_KEYHELD=wi_WIN_RT_BASE+256; // 128 cells, mono physical key state
wi_KEYORDER=wi_WIN_RT_BASE+384; // 128 cells, mono last-note priority serial
wi_KEYVEL=wi_WIN_RT_BASE+512;   // 128 cells, mono fallback velocity

// Two circular delay lines per voice.
// 4096 samples each: ample for the Wind pitch range even at high SR.
wi_BORE_BUF=wi_WIN_RT_BASE+2000;
wi_BORE_LEN=4096;
wi_JET_BUF=wi_BORE_BUF+wi_voice_count*wi_BORE_LEN;
wi_JET_LEN=4096;
wi_REALTIME_END=wi_JET_BUF+wi_voice_count*wi_JET_LEN+64;

wi_voice_stamp_counter=1;
wi_active_count=0;
wi_sustain_pedal=0;
wi_pitch_bend_norm=0;
wi_modwheel=0;
wi_aftertouch=0;
wi_held_count=0;
wi_note_serial=0;
wi_win_prev_voice_mode=1;

// ============================================================
// PER-INSTRUMENT CURRENT BANKS
// 6 instruments x 26 active timbre controls. slider214 is selector; slider240 Voice Mode is global and not banked.
// The bank stride remains 29 only for backward-compatible serialized state; slots 26..28 are legacy/reserved.
// ============================================================
wi_WIN_BANK=2310000;
wi_WIN_BANK_STRIDE=29;
wi_WIN_BANK_COUNT=6;
wi_WIN_BANK_TOTAL=174;
wi_WIN_LIVE_SNAPSHOT=2310200;
wi_WIN_BANK_MAGIC_VALUE=72012;

// @serialize keeps RAM alive, so clear only real-time DSP memory.
memset(wi_WIN_RT_BASE,0,wi_REALTIME_END-wi_WIN_RT_BASE);

function wi_win_live_value(wi_p)
(
  wi_p==0  ? slider213  :
  wi_p==1  ? slider215  :
  wi_p==2  ? slider216  :
  wi_p==3  ? slider217  :
  wi_p==4  ? slider218  :
  wi_p==5  ? slider219  :
  wi_p==6  ? slider220  :
  wi_p==7  ? slider221  :
  wi_p==8  ? slider222 :
  wi_p==9  ? slider223 :
  wi_p==10 ? slider224 :
  wi_p==11 ? slider225 :
  wi_p==12 ? slider226 :
  wi_p==13 ? slider227 :
  wi_p==14 ? slider228 :
  wi_p==15 ? slider229 :
  wi_p==16 ? slider230 :
