);

) : engine_now < 5.5 ? (

// Wind Family MIDI path — Mono Trigger / Mono Legato / Poly 6.
while(midirecv(wi_midi_ofs,wi_midi_msg1,wi_midi_msg23)) (
  wi_midi_status=wi_midi_msg1 & $xF0;
  wi_midi_d1=wi_midi_msg23 & $x7F;
  wi_midi_d2=(wi_midi_msg23>>8) & $x7F;

  wi_midi_status==$x90 ? (
    wi_midi_d2>0 ? wi_win_note_on(wi_midi_d1,wi_midi_d2)
