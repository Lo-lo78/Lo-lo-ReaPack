        );
      ) : (
        held_state[note] = 0;
        !strings_sustain_pedal ? (
          i = 0;
          loop(6,
            v_active[i] && v_note[i] == note ? (
              v_stage[i] = 4;
            );
            i += 1;
          );
        );
      );
    );
  
    );

    // Direct MIDI has already updated voice ownership in this block.
    strings_block_active = mode < 2 ? mono_stage != 0 : poly_active_count > 0;
    strings_block_active ? (
    // ------------------------------------------------------------
    // MOD WHEEL VIBRATO — SINE WITH SLOW RANDOM RATE BREATHING
    // ------------------------------------------------------------
    // Two slow random motions keep Rate recognizable while avoiding a
    // mechanically identical LFO. Combined motion is roughly +/-6%.
    vib_rate_count_a -= samplesblock;
    vib_rate_count_a <= 0 ? (
      vib_rate_target_a = rand(2)-1;
      vib_rate_count_a += floor(srate * (0.55 + rand(1.10)));
    );
  
    vib_rate_count_b -= samplesblock;
    vib_rate_count_b <= 0 ? (
      vib_rate_target_b = rand(2)-1;
      vib_rate_count_b += floor(srate * (1.80 + rand(3.20)));
    );
  
    vib_rate_k_a = 1-exp(-samplesblock/(0.38*srate));
    vib_rate_k_b = 1-exp(-samplesblock/(1.25*srate));
    vib_rate_wander_a += (vib_rate_target_a-vib_rate_wander_a)*vib_rate_k_a;
    vib_rate_wander_b += (vib_rate_target_b-vib_rate_wander_b)*vib_rate_k_b;
  
    vib_rate_current = step_vib_rate_hz
                     * (1 + vib_rate_wander_a*0.040 + vib_rate_wander_b*0.020);
    vib_rate_current = max(0.05, vib_rate_current);
    vib_phase_inc = twopi * vib_rate_current / srate;
  
    // ------------------------------------------------------------
    // FREE TEMPORAL DRIFT AT BLOCK RATE
    // ------------------------------------------------------------
    // This motion is several seconds long, so updating it once per audio block
    // is effectively continuous but avoids 48,000 state updates/second.
    step_drift_on ? (
      samplesblock != drift_last_block_samples ? (
        drift_last_block_samples = samplesblock;
        drift_block_k_a = 1-exp(-samplesblock/(1.35*srate));
        drift_block_k_b = 1-exp(-samplesblock/(2.10*srate));
      );
  
      drift_count_a -= samplesblock;
      drift_count_a <= 0 ? (
